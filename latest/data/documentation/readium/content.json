{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Content"},"metadata":{"role":"article","roleHeading":"Article","title":"Extracting the content of a publication"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"anchor":"Guides"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"The described feature is still experimental and the implementation incomplete."}],"type":"paragraph"}],"name":"Note"},{"type":"paragraph","inlineContent":[{"text":"Many high-level features require access to the raw content (text, media, etc.) of a publication, such as:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Text-to-speech","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Accessibility reader","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Basic search","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full-text search indexing"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Image or audio indexes","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"ContentService","type":"codeVoice"},{"text":" provides a way to iterate through a publication’s content, extracted as semantic elements.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"First, request the publication’s "},{"type":"codeVoice","code":"Content"},{"type":"text","text":", starting from a given "},{"type":"codeVoice","code":"Locator"},{"type":"text","text":". If the locator is missing, the "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" will be extracted from the beginning of the publication."}]},{"code":["guard let content = publication.content(from: startLocator) else {","    \/\/ Abort as the content cannot be extracted","    return","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Extracting the raw text content","anchor":"Extracting-the-raw-text-content"},{"type":"paragraph","inlineContent":[{"text":"Getting the whole raw text of a publication is such a common use case that a helper is available on ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["let wholeText = content.text()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is an expensive operation, proceed with caution and cache the result if you need to reuse it."}]},{"type":"heading","level":2,"text":"Iterating through the content","anchor":"Iterating-through-the-content"},{"type":"paragraph","inlineContent":[{"text":"The individual ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" elements can be iterated through with a regular ","type":"text"},{"code":"for","type":"codeVoice"},{"text":" loop by converting it to a sequence:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["for element in content.sequence() {","    \/\/ Process element","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternatively, you can get the whole list of elements with "},{"type":"codeVoice","code":"content.elements()"},{"type":"text","text":", or use the lower level APIs to iterate the content manually:"}]},{"type":"codeListing","syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.next() {","    print(element)","}"]},{"type":"paragraph","inlineContent":[{"text":"Some ","type":"text"},{"type":"codeVoice","code":"Content"},{"text":" implementations support bidirectional iterations. To iterate backwards, use:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.previous() {","    print(element)","}"]},{"type":"heading","level":2,"text":"Processing the elements","anchor":"Processing-the-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"Content","type":"codeVoice"},{"type":"text","text":" iterator yields "},{"code":"ContentElement","type":"codeVoice"},{"type":"text","text":" objects representing a single semantic portion of the publication, such as a heading, a paragraph or an embedded image."}]},{"type":"paragraph","inlineContent":[{"text":"Every element has a ","type":"text"},{"code":"locator","type":"codeVoice"},{"text":" property targeting it in the publication. You can use the locator, for example, to navigate to the element or to draw a ","type":"text"},{"code":"Decoration","type":"codeVoice"},{"text":" on top of it.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["navigator.go(to: element.locator)"]},{"type":"heading","level":3,"text":"Types of elements","anchor":"Types-of-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Depending on the actual implementation of "},{"type":"codeVoice","code":"ContentElement"},{"type":"text","text":", more properties are available to access the actual data. The toolkit ships with a number of default implementations for common types of elements."}]},{"type":"heading","level":4,"text":"Embedded media","anchor":"Embedded-media"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"EmbeddedContentElement"},{"type":"text","text":" protocol is implemented by any element referencing an external resource. It contains an "},{"type":"codeVoice","code":"embeddedLink"},{"type":"text","text":" property you can use to get the actual content of the resource."}]},{"type":"codeListing","syntax":"swift","code":["if let element = element as? EmbeddedContentElement {","    let bytes = try publication","        .get(element.embeddedLink)","        .read().get()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here are the default available implementations:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"AudioContentElement"},{"type":"text","text":" - audio clips"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"VideoContentElement"},{"type":"text","text":" - video clips"}]}]},{"content":[{"inlineContent":[{"code":"ImageContentElement","type":"codeVoice"},{"type":"text","text":" - bitmap images, with the additional property:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"caption: String?"},{"type":"text","text":" - figure caption, when available"}]}]}],"type":"unorderedList"}]}]},{"type":"heading","level":4,"text":"Text","anchor":"Text"},{"type":"heading","level":5,"text":"Textual elements","anchor":"Textual-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"TextualContentElement"},{"type":"text","text":" protocol is implemented by any element which can be represented as human-readable text. This is useful when you want to extract the text content of a publication without caring for each individual type of elements."}]},{"type":"codeListing","syntax":"swift","code":["let wholeText = publication.content()","    .elements()","    .compactMap { ($0 as? TextualContentElement)?.text.takeIf { !$0.isEmpty } }","    .joined(separator: \"\\n\")"]},{"type":"heading","level":5,"text":"Text elements","anchor":"Text-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actual text elements are instances of "},{"code":"TextContentElement","type":"codeVoice"},{"type":"text","text":", which represent a single block of text such as a heading, a paragraph or a list item. It is comprised of a "},{"code":"role","type":"codeVoice"},{"type":"text","text":" and a list of "},{"code":"segments","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"role","type":"codeVoice"},{"type":"text","text":" is the nature of the text element in the document. For example a heading, body, footnote or a quote. It can be used to reconstruct part of the structure of the original document."}]},{"type":"paragraph","inlineContent":[{"text":"A text element is composed of individual segments with their own ","type":"text"},{"code":"locator","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"attributes","type":"codeVoice"},{"text":". They are useful to associate attributes with a portion of a text element. For example, given the HTML paragraph:","type":"text"}]},{"type":"codeListing","syntax":"html","code":["<p>It is pronounced <span lang=\"fr\">croissant<\/span>.<\/p>"]},{"type":"paragraph","inlineContent":[{"text":"The following ","type":"text"},{"type":"codeVoice","code":"TextContentElement"},{"text":" will be produced:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["TextContentElement(","    role: .body,","    segments: [","        TextContentElement.Segment(text: \"It is pronounced \"),","        TextContentElement.Segment(text: \"croissant\", attributes: [ContentAttribute(key: .language, value: \"fr\")]),","        TextContentElement.Segment(text: \".\")","    ]",")"]},{"type":"paragraph","inlineContent":[{"text":"If you are not interested in the segment attributes, you can also use ","type":"text"},{"type":"codeVoice","code":"element.text"},{"text":" to get the concatenated raw text.","type":"text"}]},{"type":"heading","level":3,"text":"Element attributes","anchor":"Element-attributes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All types of "},{"type":"codeVoice","code":"ContentElement"},{"type":"text","text":" can have associated attributes. Custom "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":" implementations can use this as an extensibility point."}]},{"type":"heading","level":2,"text":"Use cases","anchor":"Use-cases"},{"type":"heading","level":3,"text":"An index of all images embedded in the publication","anchor":"An-index-of-all-images-embedded-in-the-publication"},{"type":"paragraph","inlineContent":[{"text":"This example extracts all the embedded images in the publication and displays them in a SwiftUI list. Clicking on an image jumps to its location in the publication.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ImageIndex: View {","    struct Item: Hashable {","        let locator: Locator","        let text: String?","        let image: UIImage","    }","","    let publication: Publication","    let navigator: Navigator","    @State private var items: [Item] = []","","    init(publication: Publication, navigator: Navigator) {","        self.publication = publication","        self.navigator = navigator","    }","","    var body: some View {","        ScrollView {","            LazyVStack {","                ForEach(items, id: \\.self) { item in","                    VStack() {","                        Image(uiImage: item.image)","                        Text(item.text ?? \"No caption\")","                    }","                    .onTapGesture {","                        navigator.go(to: item.locator)","                    }","                }","            }","        }","        .onAppear {","            items = publication.content()?","                .elements()","                .compactMap { element in","                    guard","                        let element = element as? ImageContentElement,","                        let image = try? publication.get(element.embeddedLink)","                            .read().map(UIImage.init).get()","                    else {","                        return nil","                    }","","                    return Item(","                        locator: element.locator,","                        text: element.caption ?? element.accessibilityLabel,","                        image: image","                    )","                }","                ?? []","        }","    }","}"]},{"type":"heading","level":2,"text":"References","anchor":"References"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","type":"reference"}],"type":"paragraph"}]}]}]}],"references":{"doc://Readium/documentation/Readium/Getting-Started":{"abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","title":"Getting started","role":"article","url":"\/documentation\/readium\/getting-started","kind":"article"},"doc://Readium/documentation/Readium/NavigatorOverview":{"abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","kind":"article","role":"article","title":"Navigator Overview","url":"\/documentation\/readium\/navigatoroverview","type":"topic"},"https://github.com/readium/architecture/pull/177":{"type":"link","title":"Content Iterator proposal","identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","titleInlineContent":[{"type":"text","text":"Content Iterator proposal"}],"url":"https:\/\/github.com\/readium\/architecture\/pull\/177"},"doc://Readium/documentation/Readium":{"title":"Readium","type":"topic","url":"\/documentation\/readium","role":"collection","identifier":"doc:\/\/Readium\/documentation\/Readium","kind":"article","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}]},"https://www.edrlab.org/readium-lcp/":{"type":"link","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","title":"Readium LCP","url":"https:\/\/www.edrlab.org\/readium-lcp\/","titleInlineContent":[{"text":"Readium LCP","type":"text"}]},"doc://Readium/documentation/Readium/Migration-Guide":{"title":"Migration Guide","url":"\/documentation\/readium\/migration-guide","abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","type":"topic","kind":"article"},"doc://Readium/documentation/Readium/Readium-LCP":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","title":"Supporting Readium LCP","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference"},{"type":"text","text":" DRM."}],"type":"topic","url":"\/documentation\/readium\/readium-lcp","kind":"article","role":"article"},"doc://Readium/documentation/Readium/TTS":{"abstract":[],"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","title":"Text-to-speech","role":"article","url":"\/documentation\/readium\/tts","kind":"article"},"doc://Readium/documentation/Readium/Search":{"kind":"article","abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":". EPUB and PDF publications are supported."}],"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","title":"Searching a publication","role":"article","url":"\/documentation\/readium\/search"},"doc://Readium/documentation/Readium/Accessibility":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","role":"article","url":"\/documentation\/readium\/accessibility","type":"topic","kind":"article","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","isActive":true,"type":"reference"},{"text":" specification.","type":"text"}],"title":"Accessibility"},"https://www.w3.org/TR/epub-a11y-11":{"type":"link","title":"EPUB Accessibility","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/Open-Publication":{"url":"\/documentation\/readium\/open-publication","abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":" and a "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":"."}],"title":"Opening a publication","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","type":"topic","role":"article"}}}