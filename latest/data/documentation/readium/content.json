{"metadata":{"role":"article","title":"Extracting the content of a publication","roleHeading":"Article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"]}],"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Content","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readium\/content"]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"content":[{"type":"paragraph","inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"The described feature is still experimental and the implementation incomplete.","type":"text"}]}],"type":"aside","style":"note","name":"Note"},{"inlineContent":[{"type":"text","text":"Many high-level features require access to the raw content (text, media, etc.) of a publication, such as:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Text-to-speech"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Accessibility reader"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Basic search"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full-text search indexing"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Image or audio indexes"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":" provides a way to iterate through a publication’s content, extracted as semantic elements."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"First, request the publication’s "},{"type":"codeVoice","code":"Content"},{"type":"text","text":", starting from a given "},{"code":"Locator","type":"codeVoice"},{"text":". If the locator is missing, the ","type":"text"},{"code":"Content","type":"codeVoice"},{"type":"text","text":" will be extracted from the beginning of the publication."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["guard let content = publication.content(from: startLocator) else {","    \/\/ Abort as the content cannot be extracted","    return","}"]},{"type":"heading","level":2,"anchor":"Extracting-the-raw-text-content","text":"Extracting the raw text content"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Getting the whole raw text of a publication is such a common use case that a helper is available on "},{"type":"codeVoice","code":"Content"},{"type":"text","text":":"}]},{"type":"codeListing","code":["let wholeText = content.text()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is an expensive operation, proceed with caution and cache the result if you need to reuse it."}]},{"level":2,"anchor":"Iterating-through-the-content","type":"heading","text":"Iterating through the content"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The individual "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" elements can be iterated through with a regular "},{"type":"codeVoice","code":"for"},{"type":"text","text":" loop by converting it to a sequence:"}]},{"type":"codeListing","syntax":"swift","code":["for element in content.sequence() {","    \/\/ Process element","}"]},{"inlineContent":[{"text":"Alternatively, you can get the whole list of elements with ","type":"text"},{"code":"content.elements()","type":"codeVoice"},{"text":", or use the lower level APIs to iterate the content manually:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.next() {","    print(element)","}"]},{"inlineContent":[{"text":"Some ","type":"text"},{"type":"codeVoice","code":"Content"},{"type":"text","text":" implementations support bidirectional iterations. To iterate backwards, use:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.previous() {","    print(element)","}"]},{"text":"Processing the elements","type":"heading","level":2,"anchor":"Processing-the-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" iterator yields "},{"type":"codeVoice","code":"ContentElement"},{"type":"text","text":" objects representing a single semantic portion of the publication, such as a heading, a paragraph or an embedded image."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every element has a "},{"type":"codeVoice","code":"locator"},{"type":"text","text":" property targeting it in the publication. You can use the locator, for example, to navigate to the element or to draw a "},{"type":"codeVoice","code":"Decoration"},{"type":"text","text":" on top of it."}]},{"type":"codeListing","code":["navigator.go(to: element.locator)"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Types-of-elements","text":"Types of elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Depending on the actual implementation of "},{"type":"codeVoice","code":"ContentElement"},{"type":"text","text":", more properties are available to access the actual data. The toolkit ships with a number of default implementations for common types of elements."}]},{"type":"heading","text":"Embedded media","anchor":"Embedded-media","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"EmbeddedContentElement"},{"type":"text","text":" protocol is implemented by any element referencing an external resource. It contains an "},{"type":"codeVoice","code":"embeddedLink"},{"type":"text","text":" property you can use to get the actual content of the resource."}]},{"type":"codeListing","syntax":"swift","code":["if let element = element as? EmbeddedContentElement {","    let bytes = try publication","        .get(element.embeddedLink)","        .read().get()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here are the default available implementations:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"AudioContentElement","type":"codeVoice"},{"text":" - audio clips","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"VideoContentElement","type":"codeVoice"},{"text":" - video clips","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ImageContentElement","type":"codeVoice"},{"text":" - bitmap images","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All of them expose an additional "},{"type":"codeVoice","code":"caption: String?"},{"type":"text","text":" property - the caption from an enclosing figure’s "},{"type":"codeVoice","code":"figcaption"},{"type":"text","text":", when available."}]},{"type":"heading","text":"Text","anchor":"Text","level":4},{"type":"heading","text":"Textual elements","anchor":"Textual-elements","level":5},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"TextualContentElement"},{"type":"text","text":" protocol is implemented by any element which can be represented as human-readable text. This is useful when you want to extract the text content of a publication without caring for each individual type of elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For media elements (image, SVG, audio and video), "},{"type":"codeVoice","code":"text"},{"type":"text","text":" returns the accessible name only."}]},{"type":"codeListing","syntax":"swift","code":["let wholeText = publication.content()","    .elements()","    .compactMap { ($0 as? TextualContentElement)?.text.takeIf { !$0.isEmpty } }","    .joined(separator: \"\\n\")"]},{"type":"heading","text":"Text elements","anchor":"Text-elements","level":5},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actual text elements are instances of "},{"type":"codeVoice","code":"TextContentElement"},{"type":"text","text":", which represent a single block of text such as a heading, a paragraph or a list item. It is comprised of a "},{"type":"codeVoice","code":"role"},{"type":"text","text":" and a list of "},{"type":"codeVoice","code":"segments"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"role"},{"type":"text","text":" is the nature of the text element in the document. For example a heading, body, footnote or a quote. It can be used to reconstruct part of the structure of the original document."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A text element is composed of individual segments with their own "},{"type":"codeVoice","code":"locator"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"attributes"},{"text":". They are useful to associate attributes with a portion of a text element. For example, given the HTML paragraph:","type":"text"}]},{"type":"codeListing","syntax":"html","code":["<p>It is pronounced <span lang=\"fr\">croissant<\/span>.<\/p>"]},{"inlineContent":[{"type":"text","text":"The following "},{"type":"codeVoice","code":"TextContentElement"},{"type":"text","text":" will be produced:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["TextContentElement(","    role: .body,","    segments: [","        TextContentElement.Segment(text: \"It is pronounced \"),","        TextContentElement.Segment(text: \"croissant\", attributes: [ContentAttribute(key: .language, value: \"fr\")]),","        TextContentElement.Segment(text: \".\")","    ]",")"]},{"inlineContent":[{"type":"text","text":"If you are not interested in the segment attributes, you can also use "},{"type":"codeVoice","code":"element.text"},{"type":"text","text":" to get the concatenated raw text."}],"type":"paragraph"},{"type":"heading","text":"Element attributes","anchor":"Element-attributes","level":3},{"inlineContent":[{"type":"text","text":"All types of "},{"type":"codeVoice","code":"ContentElement"},{"type":"text","text":" can have associated attributes. Custom "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":" implementations can use this as an extensibility point."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The HTML content iterator fills in accessibility attributes for media elements:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"accessibleName","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"accessibleDescription","type":"codeVoice"},{"text":" - flat strings computed following a subset of ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/accname-1.2"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"extendedDescription","type":"codeVoice"},{"text":" - a ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" to an extended description declared with ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/daisy.github.io\/transitiontoepub\/best-practices\/extended-desc\/ExtendedDescriptionsBestPractices.html"},{"text":", repeated when the element declares several targets.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","text":"Use cases","anchor":"Use-cases","level":2},{"type":"heading","text":"An index of all images embedded in the publication","anchor":"An-index-of-all-images-embedded-in-the-publication","level":3},{"inlineContent":[{"type":"text","text":"This example extracts all the embedded images in the publication and displays them in a SwiftUI list. Clicking on an image jumps to its location in the publication."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct ImageIndex: View {","    struct Item: Hashable {","        let locator: Locator","        let text: String?","        let image: UIImage","    }","","    let publication: Publication","    let navigator: Navigator","    @State private var items: [Item] = []","","    init(publication: Publication, navigator: Navigator) {","        self.publication = publication","        self.navigator = navigator","    }","","    var body: some View {","        ScrollView {","            LazyVStack {","                ForEach(items, id: \\.self) { item in","                    VStack() {","                        Image(uiImage: item.image)","                        Text(item.text ?? \"No caption\")","                    }","                    .onTapGesture {","                        navigator.go(to: item.locator)","                    }","                }","            }","        }","        .onAppear {","            items = publication.content()?","                .elements()","                .compactMap { element in","                    guard","                        let element = element as? ImageContentElement,","                        let image = try? publication.get(element.embeddedLink)","                            .read().map(UIImage.init).get()","                    else {","                        return nil","                    }","","                    return Item(","                        locator: element.locator,","                        text: element.caption ?? element.accessibleName,","                        image: image","                    )","                }","                ?? []","        }","    }","}"]},{"type":"heading","text":"References","anchor":"References","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177"}]}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"article","sections":[],"references":{"https://www.w3.org/TR/epub-a11y-11":{"type":"link","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","titleInlineContent":[{"text":"EPUB Accessibility","type":"text"}],"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility"},"doc://Readium/documentation/Readium/Migration-Guide":{"url":"\/documentation\/readium\/migration-guide","title":"Migration Guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","type":"topic","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}],"kind":"article"},"https://github.com/readium/architecture/pull/177":{"type":"link","url":"https:\/\/github.com\/readium\/architecture\/pull\/177","titleInlineContent":[{"type":"text","text":"Content Iterator proposal"}],"identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","title":"Content Iterator proposal"},"doc://Readium/documentation/Readium/Search":{"url":"\/documentation\/readium\/search","title":"Searching a publication","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","role":"article","type":"topic","abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"kind":"article"},"https://daisy.github.io/transitiontoepub/best-practices/extended-desc/ExtendedDescriptionsBestPractices.html":{"type":"link","identifier":"https:\/\/daisy.github.io\/transitiontoepub\/best-practices\/extended-desc\/ExtendedDescriptionsBestPractices.html","url":"https:\/\/daisy.github.io\/transitiontoepub\/best-practices\/extended-desc\/ExtendedDescriptionsBestPractices.html","title":"aria-details","titleInlineContent":[{"type":"codeVoice","code":"aria-details"}]},"doc://Readium/documentation/Readium/TTS":{"url":"\/documentation\/readium\/tts","title":"Text-to-speech","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","role":"article","type":"topic","abstract":[],"kind":"article"},"https://www.w3.org/TR/accname-1.2":{"url":"https:\/\/www.w3.org\/TR\/accname-1.2","title":"the W3C accessible name computation","titleInlineContent":[{"type":"text","text":"the W3C accessible name computation"}],"type":"link","identifier":"https:\/\/www.w3.org\/TR\/accname-1.2"},"doc://Readium/documentation/Readium/NavigatorOverview":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","title":"Navigator Overview","url":"\/documentation\/readium\/navigatoroverview","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}],"kind":"article","role":"article"},"doc://Readium/documentation/Readium/Open-Publication":{"url":"\/documentation\/readium\/open-publication","title":"Opening a publication","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","role":"article","type":"topic","abstract":[{"text":"To open a publication with Readium, you need to instantiate a couple of components: an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":".","type":"text"}],"kind":"article"},"doc://Readium/documentation/Readium/Accessibility":{"url":"\/documentation\/readium\/accessibility","title":"Accessibility","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","role":"article","type":"topic","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference"},{"text":" specification.","type":"text"}],"kind":"article"},"doc://Readium/documentation/Readium/Readium-LCP":{"url":"\/documentation\/readium\/readium-lcp","title":"Supporting Readium LCP","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","role":"article","type":"topic","abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference"},{"text":" DRM.","type":"text"}],"kind":"article"},"doc://Readium/documentation/Readium/Getting-Started":{"url":"\/documentation\/readium\/getting-started","title":"Getting started","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","role":"article","type":"topic","abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"kind":"article"},"doc://Readium/documentation/Readium":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium","title":"Readium","url":"\/documentation\/readium","abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"kind":"article","role":"collection"},"https://www.edrlab.org/readium-lcp/":{"url":"https:\/\/www.edrlab.org\/readium-lcp\/","title":"Readium LCP","titleInlineContent":[{"type":"text","text":"Readium LCP"}],"type":"link","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"}}}