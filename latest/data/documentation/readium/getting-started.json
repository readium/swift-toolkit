{"metadata":{"title":"Getting started","role":"article","roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"title":"Guides","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readium\/getting-started"]}],"abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"Readium offers only low-level tools. You are responsible for creating a user interface for reading and managing books, as well as a data layer to store the user’s publications. The Test App is an example of such integration."}],"type":"paragraph"}],"style":"note","type":"aside"},{"text":"Design principles","level":2,"anchor":"Design-principles","type":"heading"},{"inlineContent":[{"text":"The toolkit has been designed following these core tenets:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Modular"}],"type":"strong"},{"text":": It is divided into separate modules that can be used independently.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Extensible"}],"type":"strong"},{"text":": Integrators should be able to support a custom DRM, publication format or inject their own stylesheets without modifying the toolkit itself.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Opiniated"}],"type":"strong"},{"text":": We adhere to open standards but sometimes interpret them for practicality.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Packages","level":2,"anchor":"Packages","type":"heading"},{"text":"Main packages","level":3,"anchor":"Main-packages","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ReadiumShared","type":"codeVoice"},{"text":" contains shared ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" models and utilities.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ReadiumStreamer","type":"codeVoice"},{"text":" parses publication files (e.g. an EPUB) into a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" object.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"Navigator\/Navigator.md","type":"reference"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"text":"Specialized packages","level":3,"anchor":"Specialized-packages","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ReadiumOPDS","type":"codeVoice"},{"text":" parses ","type":"text"},{"isActive":true,"identifier":"https:\/\/opds.io","type":"reference"},{"text":" (both OPDS 1 and 2).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"Readium%20LCP.md","type":"reference"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"text":"Overview of the shared models (`ReadiumShared`)","level":2,"anchor":"Overview-of-the-shared-models-ReadiumShared","type":"heading"},{"inlineContent":[{"text":"The Readium toolkit provides models used as exchange types between packages.","type":"text"}],"type":"paragraph"},{"text":"Publication models","level":3,"anchor":"Publication-models","type":"heading"},{"text":"Publication","level":4,"anchor":"Publication","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Publication"},{"text":" and its sub-components represent a single publication – ebook, audiobook or comic. It is loosely based on the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/webpub-manifest\/"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" instance:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"holds the metadata of a publication, such as its author or table of contents,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"allows to read the contents of a publication, e.g. XHTML or audio resources,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"provides additional services, for example content extraction or text search.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Link","level":4,"anchor":"Link","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object"},{"text":" holds a pointer (URL) to a resource or service along with additional metadata, such as its media type or title.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" contains several ","type":"text"},{"type":"codeVoice","code":"Link"},{"text":" collections, for example:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"readingOrder","type":"codeVoice"},{"text":" lists the publication resources arranged in the order they should be read.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"resources","type":"codeVoice"},{"text":" contains secondary resources necessary for rendering the ","type":"text"},{"code":"readingOrder","type":"codeVoice"},{"text":", such as an image or a font file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"tableOfContents","type":"codeVoice"},{"text":" represents the table of contents as a tree of ","type":"text"},{"code":"Link","type":"codeVoice"},{"type":"text","text":" objects."}]}]},{"content":[{"inlineContent":[{"code":"links","type":"codeVoice"},{"text":" exposes additional resources, such as a canonical link to the manifest or a search web service.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Locator","level":4,"anchor":"Locator","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/architecture\/models\/locators\/"},{"text":" represents a precise location in a publication resource in a format that can be stored and shared across reading systems. It is more accurate than a ","type":"text"},{"type":"codeVoice","code":"Link"},{"text":" and contains additional information about the location, e.g. progression percentage, position or textual context.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"Locator","type":"codeVoice"},{"text":" objects are used for various features, including:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"reporting the current progression in the publication","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"saving bookmarks, highlights and annotations","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"navigating search results","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Data models","anchor":"Data-models","level":3},{"type":"heading","text":"Asset","anchor":"Asset","level":4},{"inlineContent":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" represents a single file or package and provides access to its content. There are two types of "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ContainerAsset"},{"type":"text","text":" for packages which contains several resources, such as a ZIP archive."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ResourceAsset","type":"codeVoice"},{"text":" for accessing a single resource, such as a JSON or PDF file.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"code":"Asset","type":"codeVoice"},{"text":" instances are obtained through an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can use the ","type":"text"},{"code":"asset.format","type":"codeVoice"},{"text":" to identify the media type and capabilities of the asset.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["if asset.format.conformsTo(.lcp) {","    \/\/ The asset is protected with LCP.","}","if asset.format.conformsTo(.epub) {","    \/\/ The asset represents an EPUB publication.","}"],"type":"codeListing"},{"anchor":"Resource","level":4,"text":"Resource","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"Resource","type":"codeVoice"},{"text":" provides read access to a single resource, such as a file or an entry in an archive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"Resource","type":"codeVoice"},{"text":" instances are usually created by a ","type":"text"},{"code":"ResourceFactory","type":"codeVoice"},{"text":". The toolkit ships with various implementations supporting different data access protocols such as local files or HTTP.","type":"text"}],"type":"paragraph"},{"anchor":"Container","level":4,"text":"Container","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"Container","type":"codeVoice"},{"type":"text","text":" provides read access to a collection of resources. "},{"type":"codeVoice","code":"Container"},{"type":"text","text":" instances representing an archive are usually created by an "},{"type":"codeVoice","code":"ArchiveOpener"},{"type":"text","text":". The toolkit ships with a "},{"type":"codeVoice","code":"ZIPArchiveOpener"},{"text":" supporting both local and remote (HTTP) ZIP files.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"Publication","type":"codeVoice"},{"text":" objects internally use a ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" to expose its content.","type":"text"}],"type":"paragraph"},{"anchor":"Opening-a-publication-ReadiumStreamer","level":2,"text":"Opening a publication (`ReadiumStreamer`)","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"To retrieve a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" object from a publication file like an EPUB or audiobook, you can use an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    )",")","","let url: URL = URL(...)","","\/\/ Retrieve an `Asset` to access the file content.","switch await assetRetriever.retrieve(url: url.anyURL.absoluteURL!) {","case .success(let asset):","    \/\/ Open a `Publication` from the `Asset`.","    switch await publicationOpener.open(asset: asset, allowUserInteraction: true) {","    case .success(let publication):","        print(\"Opened \\(publication.metadata.title)\")","","    case .failure(let error):","        \/\/ Failed to access or parse the publication","    }","","case .failure(let error):","    \/\/ Failed to retrieve the asset","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" parameter is useful when supporting a DRM like Readium LCP. It indicates if the toolkit can prompt the user for credentials when the publication is protected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"Open%20Publication.md","type":"reference"},{"text":".","type":"text"}]},{"type":"heading","text":"Accessing the metadata of a publication","anchor":"Accessing-the-metadata-of-a-publication","level":2},{"type":"paragraph","inlineContent":[{"text":"After opening a publication, you may want to read its metadata to insert a new entity into your bookshelf database, for instance. The ","type":"text"},{"code":"publication.metadata","type":"codeVoice"},{"text":" object contains everything you need, including ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"code":"authors","type":"codeVoice"},{"text":" and the ","type":"text"},{"code":"published","type":"codeVoice"},{"text":" date.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can retrieve the publication cover using ","type":"text"},{"code":"await publication.cover()","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","text":"Rendering the publication on the screen (`ReadiumNavigator`)","anchor":"Rendering-the-publication-on-the-screen-ReadiumNavigator","level":2},{"inlineContent":[{"type":"text","text":"You can use a Readium navigator to present the publication to the user. The "},{"type":"codeVoice","code":"Navigator"},{"type":"text","text":" renders resources on the screen and offers APIs and user interactions for navigating the contents."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Please refer to the "},{"type":"reference","overridingTitle":"Navigator guide","isActive":true,"identifier":"Navigator\/Navigator.md","overridingTitleInlineContent":[{"text":"Navigator guide","type":"text"}]},{"type":"text","text":" for more information."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","sections":[],"references":{"doc://Readium/documentation/Readium":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium","title":"Readium","url":"\/documentation\/readium","abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"kind":"article","role":"collection"},"doc://Readium/documentation/Readium/Readium-LCP":{"url":"\/documentation\/readium\/readium-lcp","title":"Supporting Readium LCP","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","role":"article","type":"topic","abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference"},{"text":" DRM.","type":"text"}],"kind":"article"},"https://readium.org/architecture/models/locators/":{"url":"https:\/\/readium.org\/architecture\/models\/locators\/","type":"link","identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","title":"Locator object","titleInlineContent":[{"code":"Locator","type":"codeVoice"},{"text":" object","type":"text"}]},"doc://Readium/documentation/Readium/Migration-Guide":{"url":"\/documentation\/readium\/migration-guide","title":"Migration Guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","type":"topic","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}],"kind":"article"},"doc://Readium/documentation/Readium/Search":{"url":"\/documentation\/readium\/search","title":"Searching a publication","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","role":"article","type":"topic","abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"kind":"article"},"doc://Readium/documentation/Readium/Accessibility":{"url":"\/documentation\/readium\/accessibility","title":"Accessibility","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","role":"article","type":"topic","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference"},{"text":" specification.","type":"text"}],"kind":"article"},"Navigator/Navigator.md":{"url":"Navigator\/Navigator.md","type":"link","identifier":"Navigator\/Navigator.md","title":"ReadiumNavigator renders the content of a publication","titleInlineContent":[{"code":"ReadiumNavigator","type":"codeVoice"},{"text":" renders the content of a publication","type":"text"}]},"https://www.w3.org/TR/epub-a11y-11":{"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"link","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility","titleInlineContent":[{"text":"EPUB Accessibility","type":"text"}]},"https://opds.io":{"url":"https:\/\/opds.io","type":"link","identifier":"https:\/\/opds.io","title":"OPDS catalog feeds","titl