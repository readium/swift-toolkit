{"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Getting started"},"seeAlsoSections":[{"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"generated":true,"anchor":"Guides","title":"Guides"}],"abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"Readium offers only low-level tools. You are responsible for creating a user interface for reading and managing books, as well as a data layer to store the user’s publications. The Test App is an example of such integration."}]}]},{"type":"heading","level":2,"anchor":"Design-principles","text":"Design principles"},{"type":"paragraph","inlineContent":[{"text":"The toolkit has been designed following these core tenets:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modular"}]},{"text":": It is divided into separate modules that can be used independently.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Extensible"}]},{"type":"text","text":": Integrators should be able to support a custom DRM, publication format or inject their own stylesheets without modifying the toolkit itself."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Opiniated"}],"type":"strong"},{"text":": We adhere to open standards but sometimes interpret them for practicality.","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"Packages","text":"Packages"},{"type":"heading","level":3,"anchor":"Main-packages","text":"Main packages"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ReadiumShared","type":"codeVoice"},{"text":" contains shared ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" models and utilities.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"ReadiumStreamer","type":"codeVoice"},{"type":"text","text":" parses publication files (e.g. an EPUB) into a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":" object."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"Navigator\/Navigator.md"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"anchor":"Specialized-packages","text":"Specialized packages"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"ReadiumOPDS","type":"codeVoice"},{"type":"text","text":" parses "},{"identifier":"https:\/\/opds.io","type":"reference","isActive":true},{"type":"text","text":" (both OPDS 1 and 2)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"Readium%20LCP.md","type":"reference","isActive":true},{"type":"text","text":"."}]}]}]},{"type":"heading","level":2,"anchor":"Overview-of-the-shared-models-ReadiumShared","text":"Overview of the shared models (`ReadiumShared`)"},{"type":"paragraph","inlineContent":[{"text":"The Readium toolkit provides models used as exchange types between packages.","type":"text"}]},{"type":"heading","level":3,"anchor":"Publication-models","text":"Publication models"},{"type":"heading","level":4,"anchor":"Publication","text":"Publication"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Publication"},{"type":"text","text":" and its sub-components represent a single publication – ebook, audiobook or comic. It is loosely based on the "},{"type":"reference","isActive":true,"identifier":"https:\/\/readium.org\/webpub-manifest\/"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"holds the metadata of a publication, such as its author or table of contents,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"allows to read the contents of a publication, e.g. XHTML or audio resources,","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"provides additional services, for example content extraction or text search.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":4,"anchor":"Link","text":"Link"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","isActive":true},{"type":"text","text":" holds a pointer (URL) to a resource or service along with additional metadata, such as its media type or title."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" contains several "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" collections, for example:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"readingOrder"},{"type":"text","text":" lists the publication resources arranged in the order they should be read."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"resources","type":"codeVoice"},{"type":"text","text":" contains secondary resources necessary for rendering the "},{"code":"readingOrder","type":"codeVoice"},{"type":"text","text":", such as an image or a font file."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"tableOfContents","type":"codeVoice"},{"text":" represents the table of contents as a tree of ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" objects.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"links"},{"type":"text","text":" exposes additional resources, such as a canonical link to the manifest or a search web service."}]}]}]},{"type":"heading","level":4,"anchor":"Locator","text":"Locator"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","isActive":true},{"type":"text","text":" represents a precise location in a publication resource in a format that can be stored and shared across reading systems. It is more accurate than a "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" and contains additional information about the location, e.g. progression percentage, position or textual context."}],"type":"paragraph"},{"inlineContent":[{"code":"Locator","type":"codeVoice"},{"type":"text","text":" objects are used for various features, including:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"reporting the current progression in the publication","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"saving bookmarks, highlights and annotations"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"navigating search results"}]}]}]},{"text":"Data models","anchor":"Data-models","type":"heading","level":3},{"text":"Asset","anchor":"Asset","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" represents a single file or package and provides access to its content. There are two types of "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ContainerAsset","type":"codeVoice"},{"text":" for packages which contains several resources, such as a ZIP archive.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"ResourceAsset","type":"codeVoice"},{"text":" for accessing a single resource, such as a JSON or PDF file.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"codeVoice","code":"Asset"},{"text":" instances are obtained through an ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can use the "},{"code":"asset.format","type":"codeVoice"},{"type":"text","text":" to identify the media type and capabilities of the asset."}],"type":"paragraph"},{"code":["if asset.format.conformsTo(.lcp) {","    \/\/ The asset is protected with LCP.","}","if asset.format.conformsTo(.epub) {","    \/\/ The asset represents an EPUB publication.","}"],"type":"codeListing","syntax":"swift"},{"text":"Resource","anchor":"Resource","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"A "},{"code":"Resource","type":"codeVoice"},{"type":"text","text":" provides read access to a single resource, such as a file or an entry in an archive."}],"type":"paragraph"},{"inlineContent":[{"code":"Resource","type":"codeVoice"},{"type":"text","text":" instances are usually created by a "},{"code":"ResourceFactory","type":"codeVoice"},{"type":"text","text":". The toolkit ships with various implementations supporting different data access protocols such as local files or HTTP."}],"type":"paragraph"},{"text":"Container","anchor":"Container","type":"heading","level":4},{"inlineContent":[{"text":"A ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" provides read access to a collection of resources. ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" instances representing an archive are usually created by an ","type":"text"},{"code":"ArchiveOpener","type":"codeVoice"},{"text":". The toolkit ships with a ","type":"text"},{"code":"ZIPArchiveOpener","type":"codeVoice"},{"text":" supporting both local and remote (HTTP) ZIP files.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Publication"},{"type":"text","text":" objects internally use a "},{"type":"codeVoice","code":"Container"},{"type":"text","text":" to expose its content."}],"type":"paragraph"},{"text":"Opening a publication (`ReadiumStreamer`)","anchor":"Opening-a-publication-ReadiumStreamer","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"To retrieve a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":" object from a publication file like an EPUB or audiobook, you can use an "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":" and "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    )",")","","let url: URL = URL(...)","","\/\/ Retrieve an `Asset` to access the file content.","switch await assetRetriever.retrieve(url: url.anyURL.absoluteURL!) {","case .success(let asset):","    \/\/ Open a `Publication` from the `Asset`.","    switch await publicationOpener.open(asset: asset, allowUserInteraction: true, sender: view) {","    case .success(let publication):","        print(\"Opened \\(publication.metadata.title)\")","","    case .failure(let error):","        \/\/ Failed to access or parse the publication","    }","","case .failure(let error):","    \/\/ Failed to retrieve the asset","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" parameter is useful when supporting a DRM like Readium LCP. It indicates if the toolkit can prompt the user for credentials when the publication is protected."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"Open%20Publication.md","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Accessing the metadata of a publication","anchor":"Accessing-the-metadata-of-a-publication","type":"heading","level":2},{"inlineContent":[{"text":"After opening a publication, you may want to read its metadata to insert a new entity into your bookshelf database, for instance. The ","type":"text"},{"code":"publication.metadata","type":"codeVoice"},{"text":" object contains everything you need, including ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"code":"authors","type":"codeVoice"},{"text":" and the ","type":"text"},{"code":"published","type":"codeVoice"},{"text":" date.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can retrieve the publication cover using "},{"type":"codeVoice","code":"await publication.cover()"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Rendering the publication on the screen (`ReadiumNavigator`)","anchor":"Rendering-the-publication-on-the-screen-ReadiumNavigator","type":"heading","level":2},{"inlineContent":[{"text":"You can use a Readium navigator to present the publication to the user. The ","type":"text"},{"code":"Navigator","type":"codeVoice"},{"text":" renders resources on the screen and offers APIs and user interactions for navigating the contents.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Please refer to the ","type":"text"},{"identifier":"Navigator\/Navigator.md","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Navigator guide"}],"overridingTitle":"Navigator guide","type":"reference"},{"text":" for more information.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"Navigator/Navigator.md":{"url":"Navigator\/Navigator.md","title":"ReadiumNavigator renders the content of a publication","type":"link","identifier":"Navigator\/Navigator.md","titleInlineContent":[{"type":"codeVoice","code":"ReadiumNavigator"},{"text":" renders the content of a publication","type":"text"}]},"doc://Readium/documentation/Readium/TTS":{"abstract":[],"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","title":"Text-to-speech","role":"article","url":"\/documentation\/readium\/tts","kind":"article"},"doc://Readium/documentation/Readium/Content":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","kind":"article","title":"Extracting the content of a publication","type":"topic","url":"\/documentation\/readium\/content","role":"article","abstract":[]},"doc://Readium/documentation/Readium/NavigatorOverview":{"abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","kind":"article","role":"article","title":"Navigator Overview","url":"\/documentation\/readium\/navigatoroverview","type":"topic"},"https://opds.io":{"url":"https:\/\/opds.io","title":"OPDS catalog feeds","type":"link","identifier":"https:\/\/opds.io","titleInlineContent":[{"type":"text","text":"OPDS catalog feeds"}]},"doc://Readium/documentation/Readium":{"title":"Readium","type":"topic","url":"\/documentation\/readium","role":"collection","identifier":"doc:\/\/Readium\/documentation\/Readium","kind":"article","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}]},"Readium%20LCP.md":{"url":"Readium%20LCP.md","title":"ReadiumLCP downloads and decrypts LCP-protected publications","type":"link","identifier":"Readium%20LCP.md","titleInlineContent":[{"type":"codeVoice","code":"ReadiumLCP"},{"text":" downloads and decrypts LCP-protected publications","type":"text"}]},"doc://Readium/documentation/Readium/Migration-Guide":{"title":"Migration Guide","url":"\/documentation\/readium\/migration-guide","abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","type":"topic","kind":"article"},"doc://Readium/documentation/Readium/Accessibility":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","role":"article","url":"\/documentation\/readium\/accessibility","type":"topic","kind":"article","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","isActive":true,"type":"reference"},{"text":" specification.","type":"text"}],"title":"Accessibility"},"Open%20Publication.md":{"url":"Open%20Publication.md","title":"See the dedicated user guide for more information","type":"link","identifier":"Open%20Publication.md","titleInlineContent":[{"type":"text","text":"See the dedicated user guide for more information"}]},"https://www.edrlab.org/readium-lcp/":{"url":"https:\/\/www.edrlab.org\/readium-lcp\/","title":"Readium LCP","type":"link