{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Checking if a publication is searchable","anchor":"Checking-if-a-publication-is-searchable","type":"heading"},{"inlineContent":[{"text":"Not every publication has a search service attached. Check ","type":"text"},{"inlineContent":[{"code":"isSearchable","type":"codeVoice"}],"type":"strong"},{"text":" before offering a search UI.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["guard publication.isSearchable else {","    \/\/ Hide or disable the search UI.","    return","}"],"type":"codeListing"},{"level":2,"text":"Performing a search","anchor":"Performing-a-search","type":"heading"},{"inlineContent":[{"type":"text","text":"Call "},{"inlineContent":[{"type":"codeVoice","code":"publication.search(query:options:)"}],"type":"strong"},{"type":"text","text":" to start a new search. This method returns a "},{"inlineContent":[{"type":"codeVoice","code":"SearchResult<SearchIterator>"}],"type":"strong"},{"type":"text","text":" — either a cursor to page through results, or a "},{"inlineContent":[{"type":"codeVoice","code":"SearchError"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["let result = await publication.search(query: \"red panda\")","","switch result {","case .success(let iterator):","    \/\/ Use the iterator to page through results.","case .failure(let error):","    handleSearchError(error)","}"],"type":"codeListing"},{"level":2,"text":"Iterating through results","anchor":"Iterating-through-results","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SearchIterator"}]},{"type":"text","text":" is a cursor that fetches results one page at a time. Each page is a "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"LocatorCollection"}]},{"type":"text","text":" containing an array of "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"Locator"}]},{"type":"text","text":" values, one per match."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Call "},{"inlineContent":[{"code":"iterator.next()","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" to retrieve the next page. It returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" on success when all results have been exhausted, or "},{"code":".failure","type":"codeVoice"},{"type":"text","text":" if a read error occurs."}],"type":"paragraph"},{"syntax":"swift","code":["while let page = try await iterator.next().get() {","    for locator in page.locators {","        print(\"Found result at: \\(locator.href)\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"To navigate directly to a result, pass the locator to the Navigator:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["await navigator.go(to: locator)"],"type":"codeListing"},{"level":3,"text":"Pagination strategies","anchor":"Pagination-strategies","type":"heading"},{"inlineContent":[{"type":"text","text":"Results may arrive in pages to progressively load results. In practice there are two common approaches:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Background load:"}]},{"text":" start a ","type":"text"},{"type":"codeVoice","code":"Task"},{"text":" that accumulates every result progressively. Simple to implement; the full list updates every time a new page is fetched.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"On-scroll load:","type":"text"}],"type":"strong"},{"type":"text","text":" hold onto the iterator and call "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" only when the user scrolls to the bottom of the current batch. This keeps memory and CPU usage low, at the cost of slightly more state management."}]}]}],"type":"unorderedList"},{"level":3,"text":"Grouping results by section","anchor":"Grouping-results-by-section","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"locator.title"}]},{"type":"text","text":" is the title of the table of contents entry that contains the match — for example, a chapter or section title. Use it to group consecutive results that fall within the same entry:"}],"type":"paragraph"},{"syntax":"swift","code":["var sections: [(title: String?, locators: [Locator])] = []","for locator in page.locators {","    if locator.title == sections.last?.title {","        sections[sections.count - 1].locators.append(locator)","    } else {","        sections.append((title: locator.title, locators: [locator]))","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This preserves order and keeps sections with the same title distinct when they are not consecutive."}],"type":"paragraph"},{"level":3,"text":"Displaying a result snippet","anchor":"Displaying-a-result-snippet","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"locator.text"}]},{"type":"text","text":" contains the matched text and its surrounding context:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"highlight"},{"type":"text","text":" — the exact string that matched the query."}]}]},{"content":[{"inlineContent":[{"code":"before","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"after","type":"codeVoice"},{"type":"text","text":" — a short snippet of text on either side of the match."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Here is a SwiftUI view that renders a single result with the matched text in bold:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SearchResultRow: View {","    let locator: Locator","","    var body: some View {","        Text(snippet)","    }","","    private var snippet: AttributedString {","        var result = AttributedString()","        if let before = locator.text?.before {","            result += AttributedString(before)","        }","        if let highlight = locator.text?.highlight {","            var bold = AttributedString(highlight)","            bold.font = .body.bold()","            result += bold","        }","        if let after = locator.text?.after {","            result += AttributedString(after)","        }","        return result","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"In a real UI you will typically want to truncate ","type":"text"},{"type":"codeVoice","code":"before"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"after"},{"text":" so the UI stays compact.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Search options","anchor":"Search-options","type":"heading"},{"inlineContent":[{"type":"text","text":"Pass a "},{"inlineContent":[{"type":"codeVoice","code":"SearchOptions"}],"type":"strong"},{"type":"text","text":" value to "},{"code":"search(query:options:)","type":"codeVoice"},{"type":"text","text":" to override the defaults. Any option you leave as "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" falls back to the default behavior."}],"type":"paragraph"},{"syntax":"swift","code":["let result = await publication.search(","    query: \"Red Panda\",","    options: SearchOptions(","        caseSensitive: true,","        diacriticSensitive: false","    )",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The full set of available options:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Option","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"caseSensitive"}]}],[{"type":"paragraph","inlineContent":[{"code":"Bool?","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the search distinguishes upper- and lower-case letters."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"diacriticSensitive"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bool?"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", accented and unaccented letters are treated as distinct.","type":"text"}]}]],[[{"inlineContent":[{"code":"wholeWord","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", only complete words are matched, not substrings."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"exact"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the query is matched exactly, including stop words and word order."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"language","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Language?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Overrides the publication’s language for this search."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"regularExpression"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bool?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", the query is interpreted as a regular expression."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"otherOptions"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"[String: String]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"–"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Custom options specific to the search service implementation.","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"inlineContent":[{"type":"text","text":"Built-in"}],"type":"strong"},{"text":" column indicates whether the default Readium configuration handles the option. Options marked ","type":"text"},{"inlineContent":[{"type":"text","text":"No"}],"type":"strong"},{"text":" are silently ignored unless you provide a custom algorithm that implements them.","type":"text"}]},{"level":3,"text":"Supported options","type":"heading","anchor":"Supported-options"},{"type":"paragraph","inlineContent":[{"text":"Before displaying search-option controls – e.g. a case sensitivity toggle, or regex mode – inspect ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"publication.searchOptions"}]},{"text":" to learn which options the service actually supports. An option whose value is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not supported"}]},{"text":" by the current service; do not show it in the UI. The actual value indicates the default behavior when the option is not overridden.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let options = publication.searchOptions","","\/\/ Only show the case-sensitivity toggle if the service supports it.","if let caseSensitive = options.caseSensitive {","    showCaseSensitiveToggle(defaultValue: caseSensitive)","}"]},{"level":2,"text":"Error handling","type":"heading","anchor":"Error-handling"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"SearchError"}],"type":"strong"},{"text":" describes what can go wrong:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".publicationNotSearchable"}]},{"type":"text","text":" – The publication has no search service. Guard on "},{"type":"codeVoice","code":"isSearchable"},{"type":"text","text":" first."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".badQuery(Error)","type":"codeVoice"}]},{"type":"text","text":" – The query string is invalid. Not all implementations produce this; custom services may use it to signal a malformed query (for example, an invalid regular expression)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".reading(ReadError)"}]},{"type":"text","text":" – An I\/O error occurred while reading a resource."}]}]}]},{"syntax":"swift","type":"codeListing","code":["switch searchError {","case .publicationNotSearchable:","    break \/\/ Should not happen if you check isSearchable first.","case .badQuery(let error):","    showAlert(\"Invalid query\")","case .reading(let error):","    showAlert(\"Failed to read the publication resources\")","}"]},{"level":2,"text":"Advanced customization","type":"heading","anchor":"Advanced-customization"},{"level":3,"text":"Configuring the search service","type":"heading","anchor":"Configuring-the-search-service"},{"type":"paragraph","inlineContent":[{"text":"The default parsers automatically register ","type":"text"},{"type":"strong","inlineContent":[{"code":"ContentSearchService","type":"codeVoice"}]},{"text":" for EPUB and PDF publications, which relies on the ","type":"text"},{"type":"reference","identifier":"Content.md","isActive":true},{"text":" to inspect the publication content. You do not need to do anything for the default behavior.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To customize the default service — for example, to adjust the snippet length or plug in a different search algorithm — override it in the "},{"type":"codeVoice","code":"onCreatePublication"},{"type":"text","text":" callback when opening a publication:"}]},{"syntax":"swift","type":"codeListing","code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    onCreatePublication: { _, _, services in","        services.setSearchServiceFactory(","            ContentSearchService.makeFactory(","                snippetLength: 300,","                searchAlgorithm: BasicStringSearchAlgorithm()","            )","        )","    }",")"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"snippetLength"},{"text":" parameter controls how many characters of context are included in the ","type":"text"},{"type":"codeVoice","code":"before"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"after"},{"text":" text of each result’s ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"Locator.Text"}]},{"text":".","type":"text"}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"code":"ContentSearchService","type":"codeVoice"},{"text":" depends on a ","type":"text"},{"code":"ContentService","type":"codeVoice"},{"text":" being registered for the publication. This is set up automatically by the default parsers.","type":"text"}]}],"style":"note"},{"level":3,"text":"Implementing a custom search algorithm","type":"heading","anchor":"Implementing-a-custom-search-algorithm"},{"type":"paragraph","inlineContent":[{"text":"The actual text-matching logic is separated into the ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"StringSearchAlgorithm"}]},{"text":" protocol. You can swap it out without changing anything else about the service.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"BasicStringSearchAlgorithm","type":"codeVoice"}]},{"type":"text","text":" is the built-in implementation. It uses the native "},{"type":"codeVoice","code":"String.range(of:options:)"},{"type":"text","text":" APIs and supports "},{"type":"codeVoice","code":"caseSensitive"},{"type":"text","text":", "},{"type":"codeVoice","code":"diacriticSensitive"},{"type":"text","text":", "},{"type":"codeVoice","code":"exact"},{"type":"text","text":", and "},{"type":"codeVoice","code":"regularExpression"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"To use a custom algorithm, pass it to ","type":"text"},{"code":"ContentSearchService.makeFactory","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["ContentSearchService.makeFactory(searchAlgorithm: MyFuzzySearchAlgorithm())"]}]}],"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"title":"Guides","generated":true}],"kind":"article","identifier":{"url":"doc:\/\/Readium\/documen