"},{"type":"text","text":" depends on a "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":" being registered for the publication. This is set up automatically by the default parsers."}]}],"type":"aside"},{"anchor":"Implementing-a-custom-search-algorithm","level":3,"text":"Implementing a custom search algorithm","type":"heading"},{"inlineContent":[{"text":"The actual text-matching logic is separated into the ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"StringSearchAlgorithm"}]},{"text":" protocol. You can swap it out without changing anything else about the service.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"BasicStringSearchAlgorithm"}]},{"text":" is the built-in implementation. It uses the native ","type":"text"},{"code":"String.range(of:options:)","type":"codeVoice"},{"text":" APIs and supports ","type":"text"},{"code":"caseSensitive","type":"codeVoice"},{"text":", ","type":"text"},{"code":"diacriticSensitive","type":"codeVoice"},{"text":", ","type":"text"},{"code":"exact","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"regularExpression","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To use a custom algorithm, pass it to ","type":"text"},{"code":"ContentSearchService.makeFactory","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["ContentSearchService.makeFactory(searchAlgorithm: MyFuzzySearchAlgorithm())"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"The Search API lets you look for a textual query in the content of a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":". EPUB and PDF publications are supported.","type":"text"}],"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Read