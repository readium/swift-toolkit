{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"seeAlsoSections":[{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication"},"variants":[{"paths":["\/documentation\/readium\/open-publication"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"AssetRetriever","text":"`AssetRetriever`"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" grants access to the content of an asset located at a given URL, such as a publication package, manifest, or LCP license.","type":"text"}]},{"type":"heading","level":3,"anchor":"Constructing-an-AssetRetriever","text":"Constructing an `AssetRetriever`"},{"type":"paragraph","inlineContent":[{"text":"You can create an instance of ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" with:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"HTTPClient"},{"type":"text","text":" to enable the toolkit to perform HTTP requests and support the "},{"type":"codeVoice","code":"http"},{"type":"text","text":" and "},{"type":"codeVoice","code":"https"},{"type":"text","text":" URL schemes. You can use "},{"type":"codeVoice","code":"DefaultHTTPClient"},{"type":"text","text":" which provides callbacks for handling authentication when needed."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","code":["let assetRetriever = AssetRetriever(httpClient: DefaultHTTPClient())"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Retrieving-an-Asset","text":"Retrieving an `Asset`"},{"type":"paragraph","inlineContent":[{"text":"With your fresh instance of ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":", you can open an ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":" from any ","type":"text"},{"code":"AbsoluteURL","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":["\/\/ From a local file.","let url = FileURL(string: \"file:\/\/\/path\/to\/book.epub\")","\/\/ or from an HTTP URL.","let url = HTTPURL(string: \"https:\/\/domain\/book.epub\")","","switch await assetRetriever.retrieve(url: url) {","    case .success(let asset):","        ...","    case .failure(let error):","        \/\/ Failed to retrieve the asset.","}"],"syntax":"swift"},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"[!IMPORTANT]","type":"text"},{"text":" ","type":"text"},{"text":"Assets created with an HTTP URL are not downloaded; they will be streamed. If that is not your intention, you need to download the file first, for example using ","type":"text"},{"type":"codeVoice","code":"HTTPClient.download()"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Note"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" will sniff the media type of the asset, which you can store in your bookshelf database to speed up the process next time you retrieve the ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":". This will improve performance, especially with HTTP URL schemes.","type":"text"}]},{"type":"codeListing","code":["let mediaType = asset.format.mediaType","","\/\/ Speed up the retrieval with a known media type.","let result = await assetRetriever.retrieve(url: url, mediaType: mediaType)"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"PublicationOpener","text":"`PublicationOpener`"},{"type":"paragraph","inlineContent":[{"code":"PublicationOpener","type":"codeVoice"},{"text":" builds a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" object from an ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":" using:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"PublicationParser"},{"type":"text","text":" to parse the asset structure and publication metadata."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"DefaultPublicationParser","type":"codeVoice"},{"text":" handles all the formats supported by Readium out of the box.","type":"text"}]}]}]}]},{"content":[{"inlineContent":[{"type":"text","text":"An optional list of "},{"type":"codeVoice","code":"ContentProtection"},{"type":"text","text":" to decrypt DRM-protected publications."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If you support Readium LCP, you can get one from the ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":".","type":"text"}]}]}]}]}],"type":"unorderedList"},{"type":"codeListing","code":["let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"Readium%20LCP.md#opening-a-publication-protected-with-lcp","type":"reference"},{"text":" to learn how to create the ","type":"text"},{"code":"LCPAuthenticating","type":"codeVoice"},{"text":" instance.","type":"text"}]},{"type":"heading","level":3,"anchor":"Opening-a-Publication","text":"Opening a `Publication`"},{"type":"paragraph","inlineContent":[{"text":"Now that you have a ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":" ready, you can use it to create a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" from an ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":" that was previously obtained using the ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" parameter is useful when supporting Readium LCP. When enabled and using a ","type":"text"},{"code":"LCPDialogAuthentication","type":"codeVoice"},{"text":", the toolkit will prompt the user if the passphrase is missing.","type":"text"}]},{"type":"codeListing","code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true",")"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Supporting-additional-formats-or-URL-schemes","text":"Supporting additional formats or URL schemes"},{"type":"paragraph","inlineContent":[{"code":"DefaultPublicationParser","type":"codeVoice"},{"text":" accepts additional parsers. You also have the option to use your own parser list by using ","type":"text"},{"code":"CompositePublicationParser","type":"codeVoice"},{"text":" or create your own ","type":"text"},{"code":"PublicationParser","type":"codeVoice"},{"text":" for a fully customized parsing resolution strategy.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" offers an additional constructor that provides greater extensibility options, using:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ResourceFactory"},{"type":"text","text":" which handles the URL schemes through which you can access content."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ArchiveOpener"},{"type":"text","text":" which determines the types of archives (ZIP, RAR, etc.) that can be opened by the "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FormatSniffer"},{"type":"text","text":" which identifies the file formats that "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" can recognize."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"You can use either the default implementations or implement your own for each of these components using the composite pattern. The toolkit’s ","type":"text"},{"code":"CompositeResourceFactory","type":"codeVoice"},{"text":", ","type":"text"},{"code":"CompositeArchiveOpener","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"CompositeFormatSniffer","type":"codeVoice"},{"text":" provide a simple resolution strategy.","type":"text"}]}]}],"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Opening a publication"},"references":{"doc://Readium/documentation/Readium/Readium-LCP":{"url":"\/documentation\/readium\/readium-lcp","title":"Supporting Readium LCP","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","role":"article","type":"topic","abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.ed