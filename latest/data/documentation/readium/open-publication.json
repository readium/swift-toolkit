{"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","interfaceLanguage":"swift"},"metadata":{"role":"article","roleHeading":"Article","title":"Opening a publication"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":"."}],"seeAlsoSections":[{"anchor":"Guides","title":"Guides","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"`AssetRetriever`","anchor":"AssetRetriever","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" grants access to the content of an asset located at a given URL, such as a publication package, manifest, or LCP license.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Constructing an `AssetRetriever`","anchor":"Constructing-an-AssetRetriever","type":"heading"},{"inlineContent":[{"text":"You can create an instance of ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" with:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"HTTPClient"},{"type":"text","text":" to enable the toolkit to perform HTTP requests and support the "},{"type":"codeVoice","code":"http"},{"type":"text","text":" and "},{"type":"codeVoice","code":"https"},{"type":"text","text":" URL schemes. You can use "},{"type":"codeVoice","code":"DefaultHTTPClient"},{"type":"text","text":" which provides callbacks for handling authentication when needed."}]}]}],"type":"unorderedList"},{"code":["let assetRetriever = AssetRetriever(httpClient: DefaultHTTPClient())"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Retrieving an `Asset`","anchor":"Retrieving-an-Asset","type":"heading"},{"inlineContent":[{"type":"text","text":"With your fresh instance of "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":", you can open an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" from any "},{"type":"codeVoice","code":"AbsoluteURL"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ From a local file.","let url = FileURL(string: \"file:\/\/\/path\/to\/book.epub\")","\/\/ or from an HTTP URL.","let url = HTTPURL(string: \"https:\/\/domain\/book.epub\")","","switch await assetRetriever.retrieve(url: url) {","    case .success(let asset):","        ...","    case .failure(let error):","        \/\/ Failed to retrieve the asset.","}"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!IMPORTANT]"},{"type":"text","text":" "},{"type":"text","text":"Assets created with an HTTP URL are not downloaded; they will be streamed. If that is not your intention, you need to download the file first, for example using "},{"type":"codeVoice","code":"HTTPClient.download()"},{"type":"text","text":"."}]}],"type":"aside"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" will sniff the media type of the asset, which you can store in your bookshelf database to speed up the process next time you retrieve the ","type":"text"},{"type":"codeVoice","code":"Asset"},{"text":". This will improve performance, especially with HTTP URL schemes.","type":"text"}],"type":"paragraph"},{"code":["let mediaType = asset.format.mediaType","","\/\/ Speed up the retrieval with a known media type.","let result = await assetRetriever.retrieve(url: url, mediaType: mediaType)"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"`PublicationOpener`","anchor":"PublicationOpener","type":"heading"},{"inlineContent":[{"code":"PublicationOpener","type":"codeVoice"},{"text":" builds a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" object from an ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":" using:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"PublicationParser"},{"type":"text","text":" to parse the asset structure and publication metadata."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"DefaultPublicationParser"},{"text":" handles all the formats supported by Readium out of the box.","type":"text"}]}]}]}]},{"content":[{"inlineContent":[{"type":"text","text":"An optional list of "},{"type":"codeVoice","code":"ContentProtection"},{"type":"text","text":" to decrypt DRM-protected publications."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"If you support Readium LCP, you can get one from the "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"type":"unorderedList"},{"code":["let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication())","    ]",")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Opening a `Publication`","anchor":"Opening-a-Publication","type":"heading"},{"inlineContent":[{"text":"Now that you have a ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":" ready, you can use it to create a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" from an ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":" that was previously obtained using the ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" parameter is useful when supporting Readium LCP. When enabled and using a ","type":"text"},{"code":"LCPDialogAuthentication","type":"codeVoice"},{"text":", the toolkit will prompt the user if the passphrase is missing.","type":"text"}],"type":"paragraph"},{"code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: sender",")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Supporting additional formats or URL schemes","anchor":"Supporting-additional-formats-or-URL-schemes","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"DefaultPublicationParser"},{"type":"text","text":" accepts additional parsers. You also have the option to use your own parser list by using "},{"type":"codeVoice","code":"CompositePublicationParser"},{"type":"text","text":" or create your own "},{"type":"codeVoice","code":"PublicationParser"},{"type":"text","text":" for a fully customized parsing resolution strategy."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" offers an additional constructor that provides greater extensibility options, using:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ResourceFactory"},{"text":" which handles the URL schemes through which you can access content.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ArchiveOpener","type":"codeVoice"},{"text":" which determines the types of archives (ZIP, RAR, etc.) that can be opened by the ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FormatSniffer","type":"codeVoice"},{"text":" which identifies the file formats that ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" can recognize.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"You can use either the default implementations or implement your own for each of these components using the composite pattern. The toolkit’s ","type":"text"},{"code":"CompositeResourceFactory","type":"codeVoice"},{"text":", ","type":"text"},{"code":"CompositeArchiveOpener","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"CompositeFormatSniffer","type":"codeVoice"},{"text":" provide a simple resolution strategy.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://Readium/documentation/Readium/Search":{"kind":"article","abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":". EPUB and PDF publications are supported."}],"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","title":"Searching a publication","role":"article","url":"\/documentation\/readium\/search"},"doc://Readium/documentation/Readium/NavigatorOverview":{"abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","kind":"article","role":"article","title":"Navigator Overview","url":"\/documentation\/readium\/navigatoroverview","type":"topic"},"doc://Readium/documentation/Readium/Readium-LCP":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","title":"Supporting Readium LCP","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference"},{"type":"text","text":" DRM."}],"type":"topic","url":"\/documentation\/readium\/readium-lcp","kind":"article","role":"article"},"doc://Readium/documentation/Readium":{"title":"Readium","type":"topic","url":"\/documentation\/readium","role":"collection","identifier":"doc:\/\/Readium\/documentation\/Readium","kind":"article","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}]},"https://www.edrlab.org/readium-lcp/":{"title":"Readium LCP","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","titleInlineContent":[{"text":"Readium LCP","type":"text"}],"type":"link","url":"https:\/\/www.edrlab.org\/readium-lcp\/"},"https://www.w3.org/TR/epub-a11y-11":{"title":"EPUB Accessibility","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"type":"link","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/Content":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","kind":"article","title":"Extracting the content of a publication","type":"topic","url":"\/documentation\/readium\/content","role":"article","abstract":[]},"doc://Readium/documentation/Readium/Getting-Started":{"abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Rea