{"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Audiobook"},"metadata":{"roleHeading":"Article","role":"article","title":"Audiobooks"},"primaryContentSections":[{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"content":[{"inlineContent":[{"text":"[!IMPORTANT]","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"AudioNavigator","type":"codeVoice"},{"text":" is chromeless and does not provide any user interface. You are responsible for the playback controls, the progress bar, the table of contents, etc.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"level":2,"anchor":"Playing-an-audiobook","type":"heading","text":"Playing an audiobook"},{"type":"paragraph","inlineContent":[{"text":"Create an ","type":"text"},{"code":"AudioNavigator","type":"codeVoice"},{"text":" from a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" conforming to the ","type":"text"},{"code":"audiobook","type":"codeVoice"},{"text":" profile, then start the playback.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["guard publication.conforms(to: .audiobook) else {","    return","}","","let navigator = AudioNavigator(","    publication: publication,","    initialLocation: lastReadLocation",")","","navigator.play()"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"AudioNavigator","type":"codeVoice"},{"text":" implements the ","type":"text"},{"code":"Navigator","type":"codeVoice"},{"text":" interface. See the ","type":"text"},{"type":"reference","isActive":true,"identifier":"Navigator.md"},{"text":" to navigate in the publication, for example to a link of the table of contents, and to save the last read location.","type":"text"}]},{"level":3,"anchor":"Observing-the-playback","type":"heading","text":"Observing the playback"},{"type":"paragraph","inlineContent":[{"text":"You are responsible for the playback controls. Implement an ","type":"text"},{"code":"AudioNavigatorDelegate","type":"codeVoice"},{"text":" to update them when the playback changes.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ The Navigator does not retain its delegate, keep a reference to it.","let delegate = MyAudioNavigatorDelegate()","navigator.delegate = delegate","","@MainActor class MyAudioNavigatorDelegate: AudioNavigatorDelegate {","","    func navigator(_ navigator: AudioNavigator, playbackDidChange info: MediaPlaybackInfo) {","        \/\/ Show a pause button while playing or loading, a play button otherwise.","        updatePlayPauseButton(isPlaying: info.state.playsWhenReady)","        updateProgress(time: info.time, duration: info.duration)","","        if info.state == .ended {","            didReachEndOfPublication()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"state"},{"type":"text","text":" of the playback is one of:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"State"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"paused"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The playback is paused, "},{"type":"codeVoice","code":"play()"},{"type":"text","text":" resumes it."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"loading"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The playback is requested, but the player is buffering or completing a seek."}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"playing"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The player is playing."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ended"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The playback reached the end of the publication, "},{"type":"codeVoice","code":"play()"},{"type":"text","text":" restarts from the start."}]}]]],"type":"table","header":"row"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"codeVoice","code":"playbackDidChange"},{"type":"text","text":" may be called several times while the playback is ended. Compare with the previous state if your code must run only once."}]}],"type":"aside","style":"note"},{"type":"heading","level":3,"anchor":"Controlling-the-playback","text":"Controlling the playback"},{"items":[{"content":[{"inlineContent":[{"code":"play()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"pause()","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"playPause()"},{"text":" control the playback.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"seek(to:)","type":"codeVoice"},{"text":" moves to a time in the current resource, and ","type":"text"},{"code":"seek(by:)","type":"codeVoice"},{"text":" skips forward or backward, moving over to the adjacent resources when needed.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"stop()","type":"codeVoice"},{"text":" stops the playback and ends the audio session, for example when the user closes the player.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, the Navigator plays the next resource when it reaches the end of the current one. To hold the playback at the end of a resource instead, return "},{"type":"codeVoice","code":"false"},{"type":"text","text":" from "},{"type":"codeVoice","code":"navigator(_:shouldPlayNextResource:)"},{"type":"text","text":". The playback is then "},{"type":"codeVoice","code":".paused"},{"type":"text","text":", and "},{"type":"codeVoice","code":"play()"},{"type":"text","text":" moves on to the next resource."}]},{"type":"heading","level":2,"anchor":"Metadata-of-audio-files","text":"Metadata of audio files"},{"type":"paragraph","inlineContent":[{"text":"Audio files embed their own metadata as tags (MP4 atoms and ID3 frames). When you open a ZIP or folder of audio files, or a standalone M4B or MP3 file, there is no manifest to describe the publication, so Readium reads these tags to build the ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":":","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"type":"text","text":"metadata"}],"type":"strong"},{"type":"text","text":", following the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/readium\/architecture\/blob\/master\/streamer\/parser\/audio-metadata.md"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"type":"text","text":"table of contents"}],"type":"strong"},{"type":"text","text":", from the chapters embedded in each file. Without any chapter, the titles of the files make the table of contents when at least two files have one."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"type":"text","text":"cover"}],"type":"strong"},{"type":"text","text":", from the first file holding one in reading order."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each link of the "},{"type":"codeVoice","code":"readingOrder"},{"type":"text","text":" holds the title, the duration and the bitrate of its audio file."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Readium reads the audio files stored on the device, including the ones inside a ZIP or ZAB package. The audio files of a remote package are not read by default, as each one takes multiple requests."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"[!IMPORTANT]","type":"text"},{"text":" ","type":"text"},{"text":"The audio files of a package are only read when they are stored without compression. A compressed file is still played, but it has no title, duration or chapters, and gives no metadata or cover to the publication. Package your audiobooks without compression, for example with ","type":"text"},{"code":"zip -0","type":"codeVoice"},{"text":". Audio formats are already compressed, so this barely changes the size of the package.","type":"text"}]}],"name":"Note"},{"type":"heading","level":3,"anchor":"Choosing-when-the-audio-files-of-a-container-are-read","text":"Choosing when the audio files of a container are read"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading the tags opens every audio file of a container (e.g. ZIP file or folder). The "},{"type":"codeVoice","code":"containerEntriesMetadataPolicy"},{"type":"text","text":" of the "},{"type":"codeVoice","code":"AudioParser"},{"type":"text","text":" tells when to do it:"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".localOnly"},{"type":"text","text":" (default) reads only a container stored on the device."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".always"},{"type":"text","text":" also reads a remote container. Each audio file takes several requests, so opening the publication can last minutes with a slow server."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".never"},{"type":"text","text":" reads no container, to open a large one faster."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A container which is not read gives a publication without metadata, table of contents or cover. A standalone audio file is always read, even a remote one."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"Reading or playing a remote audio file needs a server supporting HTTP byte range requests.","type":"text"}]}],"name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To change the policy, create an "},{"type":"codeVoice","code":"AudioParser"},{"type":"text","text":" and give it to the "},{"type":"codeVoice","code":"DefaultPublicationParser"},{"type":"text","text":"."}]},{"type":"codeListing","code":["let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        ...,","        additionalParsers: [","            AudioParser(","                assetRetriever: assetRetriever,","                containerEntriesMetadataPolicy: .always","            ),","        ]","    )",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the "},{"type":"reference","isActive":true,"identifier":"..\/Open%20Publication.md"},{"type":"text","text":" for more information on the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":"."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"A container is stored on the device when its ","type":"text"},{"code":"sourceURL","type":"codeVoice"},{"text":" is a file URL. If you build your own ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":", for example with a ","type":"text"},{"code":"TransformingContainer","type":"codeVoice"},{"text":", it has no source URL and is only read with ","type":"text"},{"code":".always","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The audio files of a container are read three at a time. Set "},{"type":"codeVoice","code":"maxConcurrentMetadataReads"},{"type":"text","text":" on the "},{"type":"codeVoice","code":"AudioParser"},{"type":"text","text":" to change it: a larger value opens a container faster, and a smaller one uses less memory."}]},{"type":"heading","level":3,"anchor":"Customizing-the-metadata","text":"Customizing the metadata"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To change the metadata of the audio files, or to read them from another source, implement an "},{"type":"codeVoice","code":"AudioMetadataReader"},{"type":"text","text":". It returns the "},{"type":"codeVoice","code":"AudioMetadata"},{"type":"text","text":" of one audio file. The "},{"type":"codeVoice","code":"AudioParser"},{"type":"text","text":" calls it for each file and builds the "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" from the results."}]},{"type":"codeListing","code":["final class MyMetadataReader: AudioMetadataReader {","    private let defaultReader = DefaultAudioMetadataReader()","","    func read(_ request: AudioMetadataRequest) async -> Result<AudioMetadata, AudioMetadataReadError> {","        await defaultReader.read(request).map { metadata in","            var metadata = metadata","            metadata.narrators = metadata.narrators.map(normalizeName)","            return metadata","        }","    }","}","","let parser = AudioParser(","    assetRetriever: assetRetriever,","    metadataReader: MyMetadataReader()",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The error returned by the reader decides what happens to the audio file:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Error"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Result"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".resourceNotSupported"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The file is kept in the reading order, without metadata."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".reading(.decoding)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Same, and an "},{"type":"codeVoice","code":"AudioMetadataWarning"},{"type":"text","text":" is logged."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Any other "},{"type":"codeVoice","code":".reading"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Opening the publication fails with this error."}],"type":"paragraph"}]]]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"[!TIP]"},{"type":"text","text":" "},{"type":"text","text":"Skip the extraction of the cover when "},{"type":"codeVoice","code":"request.includesCover"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":": the parser already found one in a previous file."}],"type":"paragraph"}],"name":"Note"}],"kind":"content"}],"abstract":[{"text":"The ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"AudioNavigator"}]},{"text":" plays the audio publications: Readium Audiobooks (","type":"text"},{"code":".audiobook","type":"codeVoice"},{"text":", ","type":"text"},{"code":".lcpa","type":"codeVoice"},{"text":"), Zipped Audio Books (","type":"text"},{"code":".zab","type":"codeVoice"},{"text":"), and standalone audio files such as an M4B or MP3. This guide explains how to play an audiobook, and how Readium reads the metadata embedded in audio files.","type":"text"}],"kind":"article","seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Navigator","doc:\/\/Readium\/documentation\/Readium\/Preferences","doc:\/\/Readium\/documentation\/Readium\/SwiftUI","doc:\/\/Readium\/documentation\/Readium\/Input","doc:\/\/Readium\/documentation\/Readium\/Highlights","doc:\/\/Readium\/documentation\/Readium\/Decorations","doc:\/\/Readium\/documentation\/Readium\/EPUB-Fonts","doc:\/\/Readium\/documentation\/Readium\/EPUB-Image-Preview"],"generated":true,"anchor":"Essentials"}],"variants":[{"paths":["\/documentation\/readium\/audiobook"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Readium/documentation/Readium":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium","title":"Readium","url":"\/documentation\/readium","abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"kind":"article","role":"collection"},"doc://Readium/documentation/Readium/SwiftUI":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/SwiftUI","title":"Integrating the Navigator with SwiftUI","url":"\/documentation\/readium\/swiftui","abstract":[{"type":"text","text":"The Navigator is built with UIKit and provides "},{"type":"codeVoice","code":"UIViewController"},{"type":"text","text":" implementations. Nevertheless, you can integrate them into a SwiftUI view hierarchy using Apple’s "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/swiftui\/uiviewrepresentable","isActive":true},{"type":"text","text":"."}],"kind":"article","role":"article"},"Highlights.md":{"type":"link","url":"Highlights.md","titleInlineContent":[{"text":"Highlighting guide","type":"text"}],"identifier":"Highlights.md","title":"Highlighting guide"},"doc://Readium/documentation/Readium/EPUB-Fonts":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/EPUB-Fonts","title":"Font families in the EPUB navigator","url":"\/documentation\/readium\/epub-fonts","abstract":[{"type":"text","text":"Readium allows users to customize the font family used to render a reflowable EPUB, by changing the "},{"type":"reference","identifier":"Preferences.md","isActive":true},{"text":".","type":"text"}],"kind":"article","role":"article"},"Preferences.md":{"type":"link","url":"Preferences.md","titleInlineContent":[{"text":"EPUB navigator preferences","type":"text"}],"identifier":"Preferences.md","title":"EPUB navigator preferences"},"doc://Readium/documentation/Readium/Decorations":{"url":"\/documentation\/readium\/decorations","title":"Decorations","identifier":"doc:\/\/Readium\/documentation\/Readium\/Decorations","role":"article","abstract":[{"type":"text","text":"The Decoration API lets you overlay visual elements on publication content – highlights, search result markers, TTS playback indicators, page-number labels in the margin, and more. For the common case of implementing user highlights, see the "},{"isActive":true,"type":"reference","identifier":"Highlights.md"},{"type":"text","text":"."}],"type":"topic","kind":"article"},"Decorations.md":{"type":"link","url":"Decorations.md","titleInlineContent":[{"text":"Decorations guide","type":"text"}],"identifier":"Decorations.md","title":"Decorations guide"},"doc://Readium/documentation/Readium/NavigatorOverview":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","title":"Navigator Overview","url":"\/documentation\/readium\/navigatoroverview","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}],"kind":"article","role":"article"},"https://developer.apple.com/documentation/swiftui/uiviewrepresentable":{"type":"link","url":"https:\/\/developer.apple.com\/documentation\/swiftui\/uiviewrepresentable","titleInlineContent":[{"code":"UIViewRepresentable","type":"codeVoice"}],"identifier":"https:\/\/developer.apple.com\/documentation\/swiftui\/uiviewrepresentable","title":"UIViewRepresentable"},"../Migration%20Guide.md":{"type":"link","url":"..\/Migration%20Guide.md","titleInlineContent":[{"text":"migration guide","type":"text"}],"identifier":"..\/Migration%20Guide.md","title":"migration guide"},"Navigator.md":{"type":"link","url":"Navigator.md","titleInlineContent":[{"text":"Navigator guide","type":"text"}],"identifier":"Navigator.md","title":"Navigator guide"},"doc://Readium/documentation/Readium/Navigator":{"url":"\/documentation\/readium\/navigator","title":"Navigator","identifier":"doc:\/\/Readium\/documentation\/Readium\/Navigator","role":"article","abstract":[{"type":"text","text":"You can use a Readium Navigator to present the publication to the user. The "},{"type":"codeVoice","code":"Navigator"},{"type":"text","text":" renders resources on the screen and offers APIs and user interactions for navigating the contents."}],"type":"topic","kind":"article"},"doc://Readium/documentation/Readium/Highlights":{"url":"\/documentation\/readium\/highlights","title":"Implementing Highlights","identifier":"doc:\/\/Readium\/documentation\/Readium\/Highlights","role":"article","abstract":[{"text":"Highlighting lets users mark up passages in a publication for later reference - a core feature of any reading app. In Readium, highlights are built on top of the ","type":"text"},{"inlineContent":[{"type":"text","text":"Decoration API"}],"type":"strong"},{"text":". If you want to understand that API in depth or build a custom decoration style, see the ","type":"text"},{"isActive":true,"identifier":"Decorations.md","type":"reference"},{"text":".","type":"text"}],"type":"topic","kind":"article"},"doc://Readium/documentation/Readium/Preferences":{"title":"Configuring the Navigator","type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Preferences","abstract":[{"text":"Take a look at the ","type":"text"},{"type":"reference","isActive":true,"identifier":"..\/Migration%20Guide.md"},{"text":" if you are already using the legacy EPUB settings.","type":"text"}],"kind":"article","role":"article","url":"\/documentation\/readium\/preferences"},"doc://Readium/documentation/Readium/EPUB-Image-Preview":{"url":"\/documentation\/readium\/epub-image-preview","title":"EPUB Image Preview","identifier":"doc:\/\/Readium\/documentation\/Readium\/EPUB-Image-Preview","role":"article","abstract":[{"type":"text","text":"This guide explains how to detect when a user taps an image in an EPUB publication to present it in a dedicated view, using the "},{"type":"codeVoice","code":"PointerEvent.targetElement"},{"type":"text","text":" API."}],"type":"topic","kind":"article"},"doc://Readium/documentation/Readium/Input":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Input","title":"Observing user input","url":"\/documentation\/readium\/input","abstract":[{"text":"In visual publications like EPUB or PDF, users can interact with the ","type":"text"},{"type":"codeVoice","code":"VisualNavigator"},{"text":" instance using gestures, a keyboard, a mouse, a pencil, or a trackpad. When the publication does not override user input events, you may want to intercept them to trigger actions in your user interface. For example, you can turn pages or toggle the navigation bar on taps, or open a bookmarks screen when pressing the Command-Shift-D hotkey.","type":"text"}],"kind":"article","role":"article"},"https://github.com/readium/architecture/blob/master/streamer/parser/audio-metadata.md":{"type":"link","url":"https:\/\/github.com\/readium\/architecture\/blob\/master\/streamer\/parser\/audio-metadata.md","titleInlineContent":[{"text":"Readium audio metadata rules","type":"text"}],"identifier":"https:\/\/github.com\/readium\/architecture\/blob\/master\/streamer\/parser\/audio-metadata.md","title":"Readium audio metadata rules"},"../Open%20Publication.md":{"type":"link","url":"..\/Open%20Publication.md","titleInlineContent":[{"text":"Opening a publication guide","type":"text"}],"identifier":"..\/Open%20Publication.md","title":"Opening a publication guide"}}}