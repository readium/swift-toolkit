","url":"#using-the-swiftui-lcp-authentication-dialog","type":"link","identifier":"#using-the-swiftui-lcp-authentication-dialog","titleInlineContent":[{"text":"prefer using the new ","type":"text"},{"code":"LCPDialog","type":"codeVoice"}]},"doc://Readium/documentation/Readium/Accessibility":{"url":"\/documentation\/readium\/accessibility","title":"Accessibility","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","role":"article","type":"topic","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference"},{"text":" specification.","type":"text"}],"kind":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"url":"\/documentation\/readium\/migration-guide","title":"Migration Guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","type":"topic","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}],"kind":"article"}}}