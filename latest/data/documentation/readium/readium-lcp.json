{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"[!IMPORTANT]","type":"text"},{"text":" ","type":"text"},{"text":"To use LCP with the Readium toolkit, you must first obtain the ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" private library by contacting ","type":"text"},{"identifier":"https:\/\/www.edrlab.org\/contact\/","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"An LCP publication is protected with a ","type":"text"},{"inlineContent":[{"type":"text","text":"user passphrase"}],"type":"emphasis"},{"text":" and distributed using an LCP License Document (","type":"text"},{"code":".lcpl","type":"codeVoice"},{"text":") .","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The user flow typically goes as follows:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The user imports a ","type":"text"},{"code":".lcpl","type":"codeVoice"},{"text":" file into your application.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The application uses the Readium toolkit to download the protected publication from the "},{"code":".lcpl","type":"codeVoice"},{"type":"text","text":" file to the user’s bookshelf. The downloaded file can be a "},{"code":".epub","type":"codeVoice"},{"type":"text","text":", "},{"code":".lcpdf","type":"codeVoice"},{"type":"text","text":" (PDF), or "},{"code":".lcpa","type":"codeVoice"},{"type":"text","text":" (audiobook) package."}]}]},{"content":[{"inlineContent":[{"text":"The user opens the protected publication from the bookshelf.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the passphrase isn’t already recorded in the "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" internal database, the user will be asked to enter it to unlock the contents."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The publication is decrypted and rendered on the screen.","type":"text"}]}]}]},{"anchor":"Setup","type":"heading","text":"Setup","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support LCP in your application, you require two components:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" package from the toolkit provides APIs for downloading and decrypting protected publications. Import it as you would any other Readium package, such as "},{"type":"codeVoice","code":"R2Navigator"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"The private ","type":"text"},{"type":"codeVoice","code":"R2LCPClient"},{"text":" library customized for your application ","type":"text"},{"identifier":"https:\/\/www.edrlab.org\/contact\/","overridingTitle":"is available from EDRLab","type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"is available from EDRLab"}]},{"text":". They will provide instructions for integrating the ","type":"text"},{"type":"codeVoice","code":"R2LCPClient"},{"text":" framework into your application.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"File-formats","type":"heading","text":"File formats","level":3},{"type":"paragraph","inlineContent":[{"text":"Readium LCP specifies new file formats.","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Name"}]}],[{"type":"paragraph","inlineContent":[{"text":"File extension","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Media type"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".lcpl"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/vnd.readium.lcp.license.v1.0+json"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".lcpdf"}]}],[{"type":"paragraph","inlineContent":[{"code":"application\/pdf+lcp","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-audiobooks.html","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":".lcpa","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/audiobook+lcp"}]}]]],"header":"row"},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"EPUB files protected by LCP are supported without a special file extension or media type because EPUB accommodates any DRM scheme in its specification.","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"To support these formats in your application, you need to ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/defining_file_and_data_types_for_your_app"},{"text":" as imported types.","type":"text"}]},{"syntax":"xml","type":"codeListing","code":["<dict>","    <key>UTImportedTypeDeclarations<\/key>","    <array>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpl<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.json<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP License Document<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpl<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/vnd.readium.lcp.license.v1.0+json<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpdf<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for PDF package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpdf<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/pdf+lcp<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpa<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpa<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/audiobook+lcp<\/string>","            <\/dict>","        <\/dict>","    <\/array>","<\/dict>"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Next, declare the imported types as "},{"type":"reference","identifier":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd","isActive":true},{"type":"text","text":" in the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" to have your application listed in the “Open with…” dialogs."}]},{"syntax":"xml","type":"codeListing","code":["<dict>","    <key>CFBundleDocumentTypes<\/key>","    <array>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP License Document<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpl<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for PDF package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpdf<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpa<\/string>","            <\/array>","        <\/dict>","    <\/array>","<\/dict>"]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!TIP]"},{"type":"text","text":" "},{"type":"text","text":"If EPUB is not included in your document types, now is a good time to add it."}]}]},{"anchor":"Allow-insecure-HTTP-requests","type":"heading","text":"Allow insecure HTTP requests","level":3},{"type":"paragraph","inlineContent":[{"text":"A file required by the LCP library needs to be downloaded from an insecure HTTP location. You must authorize this download by adding the following to your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" file:","type":"text"}]},{"syntax":"xml","type":"codeListing","code":["<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSExceptionDomains<\/key>","    <dict>","        <key>crl.edrlab.telesec.de<\/key>","        <dict>","            <key>NSExceptionAllowsInsecureHTTPLoads<\/key>","            <true\/>","        <\/dict>","    <\/dict>","<\/dict>"]},{"anchor":"Device-name-for-LCP-registration","type":"heading","text":"Device name for LCP registration","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"When registering a license with an LSD server, Readium LCP identifies the device by name using "},{"type":"codeVoice","code":"UIDevice.current.name"},{"type":"text","text":". Since iOS 16, this returns a generic string such as “iPhone” instead of the user-assigned device name."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To obtain the actual device name, add the "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/bundleresources\/entitlements\/com_apple_developer_device-information_user-assigned-device-name"},{"type":"text","text":" entitlement to your app’s "},{"type":"codeVoice","code":".entitlements"},{"type":"text","text":" file. This entitlement requires approval from Apple."}]},{"syntax":"xml","type":"codeListing","code":["<key>com.apple.developer.device-information.user-assigned-device-name<\/key>","<true\/>"]},{"type":"paragraph","inlineContent":[{"text":"Alternatively, you can supply your own device name when initializing ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" via the ","type":"text"},{"code":"deviceName","type":"codeVoice"},{"text":" parameter.","type":"text"}]},{"anchor":"Initializing-the-LCPService","type":"heading","text":"Initializing the `LCPService`","level":2},{"type":"paragraph","inlineContent":[{"code":"ReadiumLCP","type":"codeVoice"},{"type":"text","text":" offers an "},{"code":"LCPService","type":"codeVoice"},{"type":"text","text":" object that exposes its API. Since the "},{"code":"ReadiumLCP","type":"codeVoice"},{"type":"text","text":" package is not linked with "},{"code":"R2LCPClient","type":"codeVoice"},{"type":"text","text":", you need to create your own adapter when setting up the "},{"code":"LCPService","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" expects repositories to store the opened licenses and passphrases. ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" provides built-in Keychain-based implementations that store data securely in the iOS\/macOS Keychain. Unlike database-based storage, Keychain data persists across app reinstalls and can optionally be synchronized across the user’s devices via iCloud Keychain.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import R2LCPClient","import ReadiumLCP","","let httpClient = DefaultHTTPClient()","","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","","let lcpService = LCPService(","    client: LCPClientAdapter(),","    licenseRepository: LCPKeychainLicenseRepository(),","    passphraseRepository: LCPKeychainPassphraseRepository(),","    assetRetriever: assetRetriever,","    httpClient: httpClient",")","","\/\/\/ Facade to the private R2LCPClient.framework.","class LCPClientAdapter: ReadiumLCP.LCPClient {","    func createContext(jsonLicense: String, hashedPassphrase: LCPPassphraseHash, pemCrl: String) throws -> LCPClientContext {","        try R2LCPClient.createContext(jsonLicense: jsonLicense, hashedPassphrase: hashedPassphrase, pemCrl: pemCrl)","    }","","    func decrypt(data: Data, using context: LCPClientContext) -> Data? {","        R2LCPClient.decrypt(data: data, using: context as! DRMContext)","    }","","    func findOneValidPassphrase(jsonLicense: String, hashedPassphrases: [LCPPassphraseHash]) -> LCPPassphraseHash? {","        R2LCPClient.findOneValidPassphrase(jsonLicense: jsonLicense, hashedPassphrases: hashedPassphrases)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"To disable iCloud synchronization, pass ","type":"text"},{"code":"synchronizable: false","type":"codeVoice"},{"text":" when creating the repositories.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You may also implement your own persistence layer by conforming to ","type":"text"},{"code":"LCPLicenseRepository","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"LCPPassphraseRepository","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Acquiring-a-publication-from-a-License-Document-LCPL","type":"heading","text":"Acquiring a publication from a License Document (LCPL)","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Users need to import a License Document into your application to download the protected publication ("},{"type":"codeVoice","code":".epub"},{"type":"text","text":", "},{"type":"codeVoice","code":".lcpdf"},{"type":"text","text":", or "},{"type":"codeVoice","code":".lcpa"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":" offers an API to retrieve the full publication from an LCPL on the filesystem.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let result = await lcpService.acquirePublication(","    from: .file(lcplURL),","    onProgress: { progress in","        switch progress {","            case .indefinite:","                \/\/ Display an activity indicator.","            case .percent(let percent):","                \/\/ Display a progress bar with percent from 0 to 1.","        }","    }",")","","switch result {","case let .success(publication):","    \/\/ Import the `publication.localURL` file as any publication.","case let .failure(error):","    \/\/ Display the error message.","}"]},{"type":"paragraph","inlineContent":[{"text":"After the download is completed, import the ","type":"text"},{"type":"codeVoice","code":"publication.localURL"},{"text":" file into the bookshelf like any other publication file.","type":"text"}]},{"anchor":"Opening-a-publication-protected-with-LCP","type":"heading","text":"Opening a publication protected with LCP","level":2},{"anchor":"Initializing-the-PublicationOpener","type":"heading","text":"Initializing the `PublicationOpener`","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A publication protected with LCP can be opened using the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" component, just like a non-protected publication. However, you must provide a "},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/architecture\/proposals\/006-content-protection.html"},{"type":"text","text":" implementation when initializing the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" to enable LCP. Luckily, "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" has you covered."}]},{"syntax":"swift","type":"codeListing","code":["let httpClient = DefaultHTTPClient()","","let authentication = LCPDialogAuthentication()","","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: AssetRetriever(httpClient: httpClient),","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"]},{"type":"paragraph","inlineContent":[{"text":"An LCP package is secured with a ","type":"text"},{"inlineContent":[{"type":"text","text":"user passphrase"}],"type":"emphasis"},{"text":" for decrypting the content. The ","type":"text"},{"type":"codeVoice","code":"LCPAuthenticating"},{"text":" protocol used by ","type":"text"},{"type":"codeVoice","code":"LCPService.contentProtection(with:)"},{"text":" provides the passphrase when needed. You can use the default UIKit ","type":"text"},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"text":" which displays a pop-up to enter the passphrase, or implement your own method for passphrase retrieval. If your application is built using SwiftUI, ","type":"text"},{"identifier":"#using-the-swiftui-lcp-authentication-dialog","type":"reference","isActive":true}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"The user will be prompted once per passphrase since "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" stores known passphrases on the device."}]}]},{"anchor":"Opening-the-publication","type":"heading","text":"Opening the publication","level":3},{"type":"paragraph","inlineContent":[{"text":"You are now ready to open the publication file with your ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":" instance.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Retrieve an `Asset` to access the file content.","let url = FileURL(path: \"\/path\/to\/lcp-protected-book.epub\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the `Asset`.","let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: hostViewController",")","","switch result {","case .success(let publication):","    \/\/ Import or present the publication.","case .failure(let error):","    \/\/ Present the error.","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sender","type":"codeVoice"},{"text":" arguments are forwarded to the ","type":"text"},{"code":"LCPAuthenticating","type":"codeVoice"},{"text":" implementation when the passphrase is unknown. ","type":"text"},{"code":"LCPDialogAuthentication","type":"codeVoice"},{"text":" shows a pop-up only if ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", using the ","type":"text"},{"code":"sender","type":"codeVoice"},{"text":" as the pop-up’s host ","type":"text"},{"code":"UIViewController","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When importing the publication to the bookshelf, set "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" as you don’t need the passphrase for accessing the publication metadata and cover. If you intend to present the publication using a Navigator, set "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" as decryption will be required."}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!TIP]"},{"type":"text","text":" "},{"type":"text","text":"To check if an asset is protected with LCP before opening it, you can use "},{"type":"codeVoice","code":"asset.format.conformsTo(.lcp)"},{"type":"text","text":"."}]}]},{"anchor":"Using-the-opened-Publication","type":"heading","text":"Using the opened `Publication`","level":3},{"type":"paragraph","inlineContent":[{"text":"After obtaining a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" instance, you can access the publication’s metadata to import it into the user’s bookshelf. The user passphrase is not needed for reading the metadata or cover.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"However, if you want to display the publication with a Navigator, verify it is not restricted. It could be restricted if the user passphrase is unknown or if the license is no longer valid (e.g., expired loan, revoked purchase, etc.).","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["if publication.isRestricted {","    if let error = publication.protectionError as? LCPError {","        \/\/ The user is not allowed to open the publication. You should display the error.","    } else {","        \/\/ We don't have the user passphrase.","        \/\/ You may use `publication` to access its metadata, but not to render its content.","    }","} else {","    \/\/ The publication is not restricted, you may render it with a Navigator component.","}"]},{"anchor":"Streaming-an-LCP-protected-package","type":"heading","text":"Streaming an LCP protected package","level":2},{"type":"paragraph","inlineContent":[{"text":"If the server hosting the LCP protected package supports the ","type":"text"},{"identifier":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"https:\/\/httpwg.org\/specs\/rfc7233.html","type":"reference","isActive":true},{"text":", it is possible to stream directly an LCP protected publication from a License Document (","type":"text"},{"code":".lcpl","type":"codeVoice"},{"text":") file, without downloading the whole publication first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Simply open the License Document directly using the "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":". Make sure you provide an "},{"code":"HTTPClient","type":"codeVoice"},{"type":"text","text":" (or an "},{"code":"HTTPResourceFactory","type":"codeVoice"},{"type":"text","text":" for additional customization) to the "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(httpClient: httpClient)","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication()),","    ]",")","","\/\/ Retrieve an `Asset` to access the LCPL content.","let url = FileURL(path: \"\/path\/to\/license.lcpl\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the LCPL `Asset`.","let publication = try await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: hostViewController",").get()","    ","print(\"Opened \\(publication.metadata.title)\")"]},{"anchor":"Obtaining-information-on-an-LCP-license","type":"heading","text":"Obtaining information on an LCP license","level":2},{"type":"paragraph","inlineContent":[{"text":"An LCP License Document contains metadata such as its expiration date, the remaining number of characters to copy and the user name. You can access this information using an ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" object.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"code":"LCPService","type":"codeVoice"},{"type":"text","text":" to retrieve the "},{"code":"LCPLicense","type":"codeVoice"},{"type":"text","text":" instance for a publication."}]},{"syntax":"swift","type":"codeListing","code":["let result = await lcpService.retrieveLicense(","    from: asset,","    authentication: LCPDialogAuthentication(),","    allowUserInteraction: true,","    sender: hostViewController",")","","switch result {","case .success(let lcpLicense):","    if let user = lcpLicense.license.user.name {","        print(\"The publication was acquired by \\(user)\")","    }","    if let endDate = lcpLicense.license.rights.end {","        print(\"The loan expires on \\(endDate)\")","    }","    if let copyLeft = await lcpLicense.charactersToCopyLeft() {","        print(\"You can copy up to \\(copyLeft) characters remaining.\")","    }","case .failure(let error):","    \/\/ Display the error.","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have already opened a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":", you can directly obtain the "},{"type":"codeVoice","code":"LCPLicense"},{"type":"text","text":" using "},{"type":"codeVoice","code":"publication.lcpLicense"},{"type":"text","text":"."}]},{"anchor":"Managing-a-loan","type":"heading","text":"Managing a loan","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Readium LCP allows borrowing publications for a specific period. Use the "},{"code":"LCPLicense","type":"codeVoice"},{"type":"text","text":" object to manage a loan and retrieve its end date using "},{"code":"lcpLicense.license.rights.end","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Returning-a-loan","type":"heading","text":"Returning a loan","level":3},{"type":"paragraph","inlineContent":[{"text":"Some loans can be returned before the end date. You can confirm this by using ","type":"text"},{"type":"codeVoice","code":"lcpLicense.canReturnPublication"},{"text":". To return the publication, execute:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let result = await lcpLicense.returnPublication()","switch result {","case .success:","    \/\/ The publication was returned.","case .failure(let error):","    \/\/ Present the error.","}"]},{"anchor":"Renewing-a-loan","type":"heading","text":"Renewing a loan","level":3},{"type":"paragraph","inlineContent":[{"text":"The loan end date may also be extended. You can confirm this by using ","type":"text"},{"code":"lcpLicense.canRenewLoan","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Readium LCP supports "},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Programmatic: You show your own user interface."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interactive: You display a web view, and the Readium LSD server manages the renewal for you."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"You need to support both interactions by implementing the ","type":"text"},{"code":"LCPRenewDelegate","type":"codeVoice"},{"text":" protocol. A default implementation is available with ","type":"text"},{"code":"LCPDefaultRenewDelegate","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let result = await lcpLicense.renewLoan(","    with: LCPDefaultRenewDelegate(","        presentingViewController: hostViewController","    )",")","","switch result {","case .success:","    \/\/ The publication was renewed.","case let .failure(error):","    \/\/ Display the error.","}"]},{"anchor":"Handling-LCPError","type":"heading","text":"Handling `LCPError`","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The APIs may fail with an "},{"type":"codeVoice","code":"LCPError"},{"type":"text","text":". These errors "},{"type":"strong","inlineContent":[{"type":"text","text":"must"}]},{"type":"text","text":" be displayed to the user with a suitable message."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an example, "},{"identifier":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221","type":"reference","isActive":true},{"type":"text","text":"."}]},{"anchor":"Using-the-SwiftUI-LCP-Authentication-dialog","type":"heading","text":"Using the SwiftUI LCP Authentication dialog","level":2},{"type":"paragraph","inlineContent":[{"text":"If your application is built using SwiftUI, you cannot use ","type":"text"},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"text":" because it requires a UIKit view controller as its host. Instead, use an ","type":"text"},{"type":"codeVoice","code":"LCPObservableAuthentication"},{"text":" combined with our SwiftUI ","type":"text"},{"type":"codeVoice","code":"LCPDialog"},{"text":" presented as a sheet.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@main","struct MyApp: App {","    private let lcpService: LCPService","    private let publicationOpener: PublicationOpener","","    @StateObject private var lcpAuthentication: LCPObservableAuthentication","","    init() {","        \/\/ Create an `LCPObservableAuthentication` which will be used","        \/\/ to initialize the `LCPContentProtection`.","        \/\/","        \/\/ With SwiftUI, it must be stored in a `@StateObject` property","        \/\/ to observe the authentication requests.","        let lcpAuthentication = LCPObservableAuthentication()","        _lcpAuthentication = StateObject(wrappedValue: lcpAuthentication)","","        lcpService = LCPService(...)","","        publicationOpener = PublicationOpener(","            ...,","            contentProtections: [","                lcpService.contentProtection(with: lcpAuthentication)","            ]","        )","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                \/\/ You can present an `LCPDialog` when the `LCPObservableAuthentication`","                \/\/ `request` property is updated.","                .sheet(item: $lcpAuthentication.request) {","                    LCPDialog(request: $0)","                }","            }","        }","    }","}"]}]}],"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility"],"generated":true,"anchor":"Guides","title":"Guides"}],"sections":[],"metadata":{"title":"Supporting Readium LCP","role":"article","roleHeading":"Article"},"abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference"},{"text":" DRM.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"kind":"article","references":{"doc://Readium/documentation/Readium/NavigatorOverview":{"abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","kind":"article","role":"article","title":"Navigator Overview","url":"\/documentation\/readium\/navigatoroverview","type":"topic"},"doc://Readium/documentation/Readium/Search":{"kin