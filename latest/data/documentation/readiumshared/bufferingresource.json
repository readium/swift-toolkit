{"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/ReadiumShared"]]},"sections":[],"abstract":[{"type":"text","text":"Wraps an existing "},{"type":"codeVoice","code":"Resource"},{"type":"text","text":" and buffers its content."}],"identifier":{"url":"doc:\/\/Readium\/documentation\/ReadiumShared\/BufferingResource","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"BufferingResource"}],"languages":["swift"],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Expensive interaction with the underlying resource is minimized, since most"},{"type":"text","text":" "},{"type":"text","text":"(smaller) requests can be satisfied by accessing the buffer alone. The"},{"type":"text","text":" "},{"type":"text","text":"drawback is that some extra space is required to hold the buffer and that"},{"type":"text","text":" "},{"type":"text","text":"copying takes place when filling that buffer, but this is usually"},{"type":"text","text":" "},{"type":"text","text":"outweighed by the performance benefits."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that this implementation is pretty limited and the benefits are only"},{"type":"text","text":" "},{"type":"text","text":"apparent when reading forward and consecutively – e.g. when downloading the"},{"type":"text","text":" "},{"type":"text","text":"resource by chunks. The buffer is ignored when reading backward or far"},{"type":"text","text":" "},{"type":"text","text":"ahead."}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readiumshared\/bufferingresource"]}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/Bufferin