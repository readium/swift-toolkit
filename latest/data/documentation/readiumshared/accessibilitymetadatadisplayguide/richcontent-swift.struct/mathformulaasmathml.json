er extended descriptions are"},{"type":"text","text":" "},{"type":"text","text":"available for information-rich images. In addition, it indicates the"},{"type":"text","text":" "},{"type":"text","text":"presence of videos and if closed captions, open captions, or transcripts"},{"type":"text","text":" "},{"type":"text","text":"for prerecorded audio are available."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"RichContent"}],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RichContent"}],"url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct"},"doc://Readium/documentation/ReadiumShared":{"abstract":[],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared","title":"ReadiumShared","role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/readiumshared"}}}