{"sections":[],"abstract":[{"text":"According to the EPUB specification, the HREFs in the EPUB package must","type":"text"},{"text":" ","type":"text"},{"text":"be valid URLs (so percent-encoded). Unfortunately, many EPUBs don’t","type":"text"},{"text":" ","type":"text"},{"text":"follow this rule, and use invalid HREFs such as ","type":"text"},{"code":"﻿my chapter.html","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or ﻿","type":"text"},{"code":"\/dir\/my chapter.html","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readiumshared\/relativeurl\/init(epubhref:)"]}],"identifier":{"url":"doc:\/\/Readium\/documentation\/ReadiumShared\/RelativeURL\/init(epubHREF:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"?(","kind":"text"},{"text":"epubHREF","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"As a workaround, we assume the HREFs are valid percent-encoded URLs,"},{"type":"text","text":" "},{"type":"text","text":"and fallback to decoded paths if we can’t parse the URL."}],"type":"paragraph"},{"inlineContent":[{"text":"When falling back to a decoded path, only the path portion is","type":"text"},{"text":" ","type":"text"},{"text":"percent-encoded: any ","type":"text"},{"code":"?query","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"#fragment","type":"codeVoice"},{"text":" are split off and","type":"text"},{"text":" ","type":"text"},{"text":"reattached verbatim. This keeps their ","type":"text"},{"code":"?","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"#","type":"codeVoice"},{"text":" separators intact (a plain","type":"text"},{"text":" ","type":"text"},{"text":"path encoding would turn them into ","type":"text"},{"code":"%3F","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"%23","type":"codeVoice"},{"text":") and preserves any","type":"text"},{"text":" ","type":"text"},{"text":"existing encoding in the query or fragment instead of double-encoding it.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/ReadiumShared","doc:\/\/Readium\/documentation\/ReadiumShared\/RelativeURL"]]},"metadata":{"roleHeading":"Initializer","externalID":"s:13ReadiumShared11RelativeURLV8epubHREFACSgSS_tcfc","role":"symbol","extendedModule":"ReadiumShared","fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"epubHREF","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"title":"init(epubHREF:)","symbolKind":"init","modules":[{"name":"ReadiumShared"}]},"kind":"symbol","references":{"doc://Readium/documentation/ReadiumShared":{"abstract":[],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared","title":"ReadiumShared","role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/readiumshared"},"doc://Readium/documentation/ReadiumShared/RelativeURL/init(epubHREF:)":{"abstract":[{"type":"text","text":"According to the EPUB specification, the HREFs in the EPUB package must"},{"type":"text","text":" "},{"type":"text","text":"be valid URLs (so percent-encoded). Unfortunately, many EPUBs don’t"},{"type":"text","text":" "},{"type":"text","text":"follow this rule, and use invalid HREFs such as "},{"type":"codeVoice","code":"﻿my chapter.html"},{"type":"text","text":" "},{"type":"text","text":"or ﻿"},{"type":"codeVoice","code":"\/dir\/my chapter.html"},{"type":"text","text":"."}],"fragments":[{"kind":"identifier","text":"init"},{"kind