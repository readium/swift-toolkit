 object"},{"type":"text","text":" "},{"type":"text","text":"represents a “collapsed” range that has identical "},{"type":"codeVoice","code":"start"},{"type":"text","text":" and "},{"type":"codeVoice","code":"end"},{"type":"text","text":" boundary points."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"https:\/\/github.com\/readium\/architecture\/blob\/master\/models\/locators\/extensions\/html.md#the-domrange-object"}]}],"kind":"content"}],"references":{"doc://Readium/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/Readium\/SH"},"doc://Readium/documentation/ReadiumShared/JSONValueDecodable":{"title":"JSONValueDecodable","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/JSONValueDecodable","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"JSONValueDecodable"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONValueDecodable"}],"url":"\/documentation\/readiumshared\/jsonvaluedecodable","type":"topic","abstract":[{"text":"A type that can be decoded from a ","type":"text"},{"type":"codeVoice","code":"JSONValue"},{"type":"text","text":"."}],"role":"symbol"},"doc://Readium/documentation/ReadiumShared/DOMRange":{"type":"topic","title":"DOMRange","abstract":[{"text":"This construct enables a serializable representation of a DOM Range.","type":"text"}],"url":"\/documentation\/readiumshared\/domrange","navigatorTitle":[{"kind":"identifier","text":"DOMRange"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DOMRange"}],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange","kind":"symbol"},"doc://Readium/documentation/ReadiumShared":{"abstract":[],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared","title":"ReadiumShared","role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/readiumshared"},"doc://Readium/documentation/ReadiumShared/DOMR