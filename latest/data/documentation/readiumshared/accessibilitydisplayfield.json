:"text","text":"Indicates the presence of math, chemical formulas, extended descriptions"},{"type":"text","text":" "},{"type":"text","text":"for information rich images, e.g., charts, diagrams, figures, graphs,"},{"type":"text","text":" "},{"type":"text","text":"and whether these are in an accessible format or available in an"},{"type":"text","text":" "},{"type":"text","text":"alternative form, e.g., whether math and chemical formulas are navigable"},{"type":"text","text":" "},{"type":"text","text":"with assistive technologies, or whether extended descriptions are"},{"type":"text","text":" "},{"type":"text","text":"available for information-rich images. In addition, it indicates the"},{"type":"text","text":" "},{"type":"text","text":"presence of videos and if closed captions, open captions, or transcripts"},{"type":"text","text":" "},{"type":"text","text":"for prerecorded audio are available."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"RichContent"}],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RichContent"}],"url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct"},"doc://Readium/documentation/ReadiumShared":{"abstract":[],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared","title":"ReadiumShared","role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/readiumshared"},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide/Legal-swift.struct":{"role":"symbol","url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/legal-swift.struct","type":"topic","kind":"symbol","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/Legal-swift.struct","abstract":[{"type":"text","text":"In some jurisdi