{
  "name": "readium-js",
  "description": "A set of scripts for the EPUB navigator",
  "author": "Readium Foundation",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "private": true,
  "scripts": {
    "bundle": "webpack",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "checkformat": "prettier --check '**/*.{js,ts}'",
    "format": "prettier --list-different --write '**/*.{js,ts}'"
  },
  "browserslist": [
    "iOS 13"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "babel-loader": "^8.4.1",
    "eslint": "^7.32.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "2.3.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "approx-string-match": "^1.1.0",
    "css-selector-generator": "^3.9.2",
    "string.prototype.matchall": "^4.0.12"
  },
  "packageManager": "pnpm@8.15.1"
}
