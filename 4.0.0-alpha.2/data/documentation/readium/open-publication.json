ublicationOpener"},{"inlineContent":[{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" builds a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" object from an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" using:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"code":"PublicationParser","type":"codeVoice"},{"text":" to parse the asset structure and publication metadata.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"DefaultPublicationParser"},{"text":" handles all the formats supported by Readium out of the box.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"text":"An optional list of ","type":"text"},{"code":"ContentProtection","type":"codeVoice"},{"text":" to decrypt DRM-protected publications.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"If you support Readium LCP, you can get one from the ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"type":"unorderedList"},{"syntax":"swift","code":["let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"],"type":"codeListing"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"Readium%20LCP.md#opening-a-publication-protected-with-lcp"},{"type":"text","text":" to learn how to create the "},{"type":"codeVoice","code":"LCPAuthenticating"},{"type":"text","text":" instance."}],"type":"paragraph"},{"text":"Opening a `Publication`","level":3,"type":"heading","anchor":"Opening-a-Publication"},{"inlineContent":[{"type":"text","text":"Now that you have a "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" ready, you can use it to create a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" from an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" that was previously obtained using the "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" parameter is useful when supporting Readium LCP. When enabled and using a "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":", the toolkit will prompt the user if the passphrase is missing."}],"type":"paragraph"},{"syntax":"swift","code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true",")"],"type":"codeListing"},{"text":"Supporting additional formats or URL schemes","level":2,"type":"heading","anchor":"Supporting-additional-formats-or-URL-schemes"},{"inlineContent":[{"type":"codeVoice","code":"DefaultPublicationParser"},{"type":"text","text":" accepts additional parsers. You also have the option to use your own parser list by using "},{"type":"codeVoice","code":"CompositePublicationParser"},{"type":"text","text":" or create your own "},{"type":"codeVoice","code":"PublicationParser"},{"type":"text","text":" for a fully customized parsing resolution strategy."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" offers an additional constructor that provides greater extensibility options, using:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"ResourceFactory","type":"codeVoice"},{"text":" which handles the URL schemes through which you can access content.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"c