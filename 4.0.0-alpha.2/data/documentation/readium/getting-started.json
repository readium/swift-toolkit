{"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"Readium offers only low-level tools. You are responsible for creating a user interface for reading and managing books, as well as a data layer to store the user’s publications. The Test App is an example of such integration."}],"type":"paragraph"}],"style":"note"},{"type":"heading","text":"Design principles","level":2,"anchor":"Design-principles"},{"type":"paragraph","inlineContent":[{"text":"The toolkit has been designed following these core tenets:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Modular","type":"text"}],"type":"strong"},{"text":": It is divided into separate modules that can be used independently.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Extensible","type":"text"}]},{"text":": Integrators should be able to support a custom DRM, publication format or inject their own stylesheets without modifying the toolkit itself.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Opiniated","type":"text"}]},{"text":": We adhere to open standards but sometimes interpret them for practicality.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Packages","level":2,"anchor":"Packages"},{"type":"heading","text":"Main packages","level":3,"anchor":"Main-packages"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ReadiumShared","type":"codeVoice"},{"text":" contains shared ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" models and utilities.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"ReadiumStreamer","type":"codeVoice"},{"text":" parses publication files (e.g. an EPUB) into a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" object.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"Navigator\/Navigator.md","type":"reference"},{"text":".","type":"text"}]}]}]},{"type":"heading","text":"Specialized packages","level":3,"anchor":"Specialized-packages"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ReadiumOPDS","type":"codeVoice"},{"text":" parses ","type":"text"},{"identifier":"https:\/\/opds.io","type":"reference","isActive":true},{"text":" (both OPDS 1 and 2).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"Readium%20LCP.md","type":"reference","isActive":true},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Overview-of-the-shared-models-ReadiumShared","text":"Overview of the shared models (`ReadiumShared`)","type":"heading"},{"inlineContent":[{"type":"text","text":"The Readium toolkit provides models used as exchange types between packages."}],"type":"paragraph"},{"level":3,"anchor":"Publication-models","text":"Publication models","type":"heading"},{"level":4,"anchor":"Publication","text":"Publication","type":"heading"},{"inlineContent":[{"code":"Publication","type":"codeVoice"},{"type":"text","text":" and its sub-components represent a single publication – ebook, audiobook or comic. It is loosely based on the "},{"isActive":true,"identifier":"https:\/\/readium.org\/webpub-manifest\/","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"holds the metadata of a publication, such as its author or table of contents,","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"allows to read the contents of a publication, e.g. XHTML or audio resources,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"provides additional services, for example content extraction or text search.","type":"text"}]}]}],"type":"unorderedList"},{"level":4,"anchor":"Link","text":"Link","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","type":"reference"},{"text":" holds a pointer (URL) to a resource or service along with additional metadata, such as its media type or title.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" contains several ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" collections, for example:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"readingOrder","type":"codeVoice"},{"text":" lists the publication resources arranged in the order they should be read.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"resources","type":"codeVoice"},{"text":" contains secondary resources necessary for rendering the ","type":"text"},{"code":"readingOrder","type":"codeVoice"},{"text":", such as an image or a font file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"tableOfContents","type":"codeVoice"},{"text":" represents the table of contents as a tree of ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" objects.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"links","type":"codeVoice"},{"text":" exposes additional resources, such as a canonical link to the manifest or a search web service.","type":"text"}]}]}],"type":"unorderedList"},{"level":4,"text":"Locator","anchor":"Locator","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","type":"reference"},{"text":" represents a precise location in a publication resource in a format that can be stored and shared across reading systems. It is more accurate than a ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" and contains additional information about the location, e.g. progression percentage, position or textual context.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"Locator","type":"codeVoice"},{"text":" objects are used for various features, including:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"reporting the current progression in the publication"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"saving bookmarks, highlights and annotations"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"navigating search results","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Data-models","text":"Data models","type":"heading","level":3},{"anchor":"Asset","text":"Asset","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":" represents a single file or package and provides access to its content. There are two types of ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":":","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ContainerAsset","type":"codeVoice"},{"text":" for packages which contains several resources, such as a ZIP archive.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"ResourceAsset","type":"codeVoice"},{"text":" for accessing a single resource, such as a JSON or PDF file.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"code":"Asset","type":"codeVoice"},{"text":" instances are obtained through an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can use the ","type":"text"},{"type":"codeVoice","code":"asset.format"},{"type":"text","text":" to identify the media type and capabilities of the asset."}],"type":"paragraph"},{"code":["if asset.format.conformsTo(.lcp) {","    \/\/ The asset is protected with LCP.","}","if asset.format.conformsTo(.epub) {","    \/\/ The asset represents an EPUB publication.","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Resource","text":"Resource","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"A "},{"code":"Resource","type":"codeVoice"},{"type":"text","text":" provides read access to a single resource, such as a file or an entry in an archive."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Resource"},{"type":"text","text":" instances are usually created by a "},{"type":"codeVoice","code":"ResourceFactory"},{"text":". The toolkit ships with various implementations supporting different data access protocols such as local files or HTTP.","type":"text"}]},{"level":4,"text":"Container","anchor":"Container","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"Container","type":"codeVoice"},{"type":"text","text":" provides read access to a collection of resources. "},{"code":"Container","type":"codeVoice"},{"text":" instances representing an archive are usually created by an ","type":"text"},{"code":"ArchiveOpener","type":"codeVoice"},{"text":". The toolkit ships with a ","type":"text"},{"code":"ZIPArchiveOpener","type":"codeVoice"},{"text":" supporting both local and remote (HTTP) ZIP files.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Publication"},{"text":" objects internally use a ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" to expose its content.","type":"text"}]},{"anchor":"Opening-a-publication-ReadiumStreamer","text":"Opening a publication (`ReadiumStreamer`)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To retrieve a "},{"type":"codeVoice","code":"Publication"},{"text":" object from a publication file like an EPUB or audiobook, you can use an ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" and ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":"."}]},{"code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    )",")","","let url: URL = URL(...)","","\/\/ Retrieve an `Asset` to access the file content.","switch await assetRetriever.retrieve(url: url.anyURL.absoluteURL!) {","case .success(let asset):","    \/\/ Open a `Publication` from the `Asset`.","    switch await publicationOpener.open(asset: asset, allowUserInteraction: true) {","    case .success(let publication):","        print(\"Opened \\(publication.metadata.title)\")","","    case .failure(let error):","        \/\/ Failed to access or parse the publication","    }","","case .failure(let error):","    \/\/ Failed to retrieve the asset","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"allowUserInteraction"},{"text":" parameter is useful when supporting a DRM like Readium LCP. It indicates if the toolkit can prompt the user for credentials when the publication is protected.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"Open%20Publication.md"},{"text":".","type":"text"}]},{"level":2,"text":"Accessing the metadata of a publication","anchor":"Accessing-the-metadata-of-a-publication","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"After opening a publication, you may want to read its metadata to insert a new entity into your bookshelf database, for instance. The ","type":"text"},{"code":"publication.metadata","type":"codeVoice"},{"text":" object contains everything you need, including ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"code":"authors","type":"codeVoice"},{"text":" and the ","type":"text"},{"code":"published","type":"codeVoice"},{"text":" date.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can retrieve the publication cover using ","type":"text"},{"code":"await publication.cover()","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Rendering-the-publication-on-the-screen-ReadiumNavigator","text":"Rendering the publication on the screen (`ReadiumNavigator`)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"You can use a Readium navigator to present the publication to the user. The ","type":"text"},{"code":"Navigator","type":"codeVoice"},{"text":" renders resources on the screen and offers APIs and user interactions for navigating the contents.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Please refer to the ","type":"text"},{"overridingTitleInlineContent":[{"text":"Navigator guide","type":"text"}],"overridingTitle":"Navigator guide","isActive":true,"identifier":"Navigator\/Navigator.md","type":"reference"},{"text":" for more information.","type":"text"}]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"title":"Guides","generated":true,"anchor":"Guides"}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"variants":[{"paths":["\/documentation\/readium\/getting-started"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Article","title":"Getting started","role":"article"},"sections":[],"references":{"https://www.w3.org/TR/epub-a11y-11":{"titleInlineContent":[{"text":"EPUB Accessibility","type":"text"}],"type":"link","title":"EPUB Accessibility","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/TTS":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","kind":"article","title":"Text-to-speech","abstract":[],"url":"\/documentation\/readium\/tts","role":"article"},"doc://Readium/documentation/Readium/Content":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","kind":"article","title":"Extracting the content of a publication","abstract":[],"url":"\/documentation\/readium\/content","role":"article"},"doc://Readium/documentation/Readium/NavigatorOverview":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","kind":"article","title":"Navigator Overview","abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"url":"\/documentation\/readium\/navigatoroverview","role":"article"},"doc://Readium/documentation/Readium/Search":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","kind":"article","title":"Searching a publication","abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"url":"\/documentation\/readium\/search","role":"article"},"doc://Readium/documentation/Readium":{"identifier":"doc:\/\/Readium\/documentation\/Readium","type":"topic","kind":"article","title":"Readium","abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"url":"\/documentation\/readium","role":"collection"},"doc://Readium/documentation/Readium/Migration-Guide":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","kind":"article","title":"Migration Guide","abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}],"url":"\/documentation\/readium\/migration-guide","role":"article"},"doc://Readium/documentation/Readium/Readium-LCP":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","kind":"article","title":"Supporting Readium LCP","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true},{"type":"text","text":" DRM."}],"url":"\/documentation\/readium\/readium-lcp","role":"article"},"https://readium.org/architecture/models/locators/":{"titleInlineContent":[{"type":"codeVoice","code":"Locator"},{"type":"text","text":" object"}],"type":"link","title":"Locator object","identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","url":"https:\/\/readium.org\/architecture\/models\/locators\/"},"https://www.edrlab.org/readium-lcp/":{"titleInlineContent":[{"text":"Readium LCP","type":"text"}],"type":"link","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","url":"https:\/\/www.edrlab.org\/readium-lcp\/","title":"Readium LCP"},"Open%20Publication.md":{"titleInlineContent":[{"type":"text","text":"See the dedicated user guide for more information"}],"type":"link","title":"See the dedicated user guide for more information","identifier":"Open%20Publication.md","url":"Open%20Publication.md"},"https://readium.org/webpub-manifest/#24-the-link-object":{"titleInlineContent":[{"code":"Link","type":"codeVoice"},{"type":"text","text":" object"}],"type":"link","title":"Link object","identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","url":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object"},"Readium%20LCP.md":{"titleInlineContent":[{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" downloads and decrypts LCP-protected publications"}],"type":"link","title":"ReadiumLCP downloads and decrypts LCP-protected publications","identifier":"Readium%20LCP.md","url":"Readium%20LCP.md"},"https://readium.org/webpub-manifest/":{"titleInlineContent":[{"text":"Readium Web Publication Manifest","type":"text"}],"identifier":"https:\/\/readium.org\/webpub-manifest\/","type":"link","title":"Readium Web Publication Manifest","url":"https:\/\/readium.org\/webpub-manifest\/"},"Navigator/Navigator.md":{"titleInlineContent":[{"type":"codeVoice","code":"ReadiumNavigator"},{"text":" renders the content of a publication","type":"text"}],"type":"link","title":"ReadiumNavigator renders the content of a publication","identifier":"Navigator\/Navigator.md","url":"Navigator\/Navigator.md"},"https://opds.io":{"titleInlineContent":[{"type":"text","text":"OPDS catalog feeds"}],"type":"link","title":"OPDS catalog feeds","identifier":"https:\/\/opds.io","url":"https:\/\/opds.io"},"doc://Readium/documentation/Readium/Open-Publication":{"kind":"article","url":"\/documentation\/readium\/open-publication","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","title":"Opening a publication","abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":"."}],"role":"article","type":"topic"},"doc://Readium/documentation/Readium/Accessibility":{"kind":"article","url":"\/documentation\/readium\/accessibility","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","title":"Accessibility","abstract":[{"type":"text","text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the "},{"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","isActive":true},{"text":" specification.","type":"text"}],"role":"article","type":"topic"}}}