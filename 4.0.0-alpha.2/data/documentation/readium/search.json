{"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Search","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","sections":[],"abstract":[{"text":"The Search API lets you look for a textual query in the content of a ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":". EPUB and PDF publications are supported.","type":"text"}],"seeAlsoSections":[{"anchor":"Guides","title":"Guides","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Checking-if-a-publication-is-searchable","text":"Checking if a publication is searchable","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Not every publication has a search service attached. Check ","type":"text"},{"type":"strong","inlineContent":[{"code":"isSearchable","type":"codeVoice"}]},{"text":" before offering a search UI.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["guard publication.isSearchable else {","    \/\/ Hide or disable the search UI.","    return","}"]},{"anchor":"Performing-a-search","text":"Performing a search","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"type":"strong","inlineContent":[{"code":"publication.search(query:options:)","type":"codeVoice"}]},{"text":" to start a new search. This method returns a ","type":"text"},{"type":"strong","inlineContent":[{"code":"SearchResult<SearchIterator>","type":"codeVoice"}]},{"text":" — either a cursor to page through resul