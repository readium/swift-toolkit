{"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"name":"Note","content":[{"inlineContent":[{"text":"[!IMPORTANT]","type":"text"},{"text":" ","type":"text"},{"text":"To use LCP with the Readium toolkit, you must first obtain the ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" private library by contacting ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.edrlab.org\/contact\/","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"An LCP publication is protected with a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"user passphrase","type":"text"}]},{"text":" and distributed using an LCP License Document (","type":"text"},{"type":"codeVoice","code":".lcpl"},{"text":") .","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The user flow typically goes as follows:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The user imports a ","type":"text"},{"code":".lcpl","type":"codeVoice"},{"text":" file into your application.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The application uses the Readium toolkit to download the protected publication from the ","type":"text"},{"code":".lcpl","type":"codeVoice"},{"text":" file to the user’s bookshelf. The downloaded file can be a ","type":"text"},{"code":".epub","type":"codeVoice"},{"text":", ","type":"text"},{"code":".lcpdf","type":"codeVoice"},{"text":" (PDF), or ","type":"text"},{"code":".lcpa","type":"codeVoice"},{"text":" (audiobook) package.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user opens the protected publication from the bookshelf.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If the passphrase isn’t already recorded in the ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" internal database, the user will be asked to enter it to unlock the contents.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The publication is decrypted and rendered on the screen.","type":"text"}]}]}]},{"text":"Setup","anchor":"Setup","type":"heading","level":2},{"inlineContent":[{"text":"To support LCP in your application, you require two components:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" package from the toolkit provides APIs for downloading and decrypting protected publications. Import it as you would any other Readium package, such as ","type":"text"},{"code":"R2Navigator","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The private ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" library customized for your application ","type":"text"},{"overridingTitleInlineContent":[{"text":"is available from EDRLab","type":"text"}],"overridingTitle":"is available from EDRLab","isActive":true,"identifier":"https:\/\/www.edrlab.org\/contact\/","type":"reference"},{"text":". They will provide instructions for integrating the ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" framework into your application.","type":"text"}]}]}]},{"text":"File formats","anchor":"File-formats","type":"heading","level":3},{"inlineContent":[{"text":"Readium LCP specifies new file formats.","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Name","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"File extension","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Media type","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".lcpl"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/vnd.readium.lcp.license.v1.0+json"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".lcpdf"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/pdf+lcp"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-audiobooks.html"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".lcpa"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/audiobook+lcp"}]}]]],"type":"table","header":"row"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"EPUB files protected by LCP are supported without a special file extension or media type because EPUB accommodates any DRM scheme in its specification.","type":"text"}]}],"type":"aside","style":"note"},{"inlineContent":[{"text":"To support these formats in your application, you need to ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/defining_file_and_data_types_for_your_app"},{"text":" as imported types.","type":"text"}],"type":"paragraph"},{"code":["<dict>","    <key>UTImportedTypeDeclarations<\/key>","    <array>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpl<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.json<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP License Document<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpl<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/vnd.readium.lcp.license.v1.0+json<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpdf<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for PDF package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpdf<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/pdf+lcp<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpa<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpa<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/audiobook+lcp<\/string>","            <\/dict>","        <\/dict>","    <\/array>","<\/dict>"],"syntax":"xml","type":"codeListing"},{"inlineContent":[{"text":"Next, declare the imported types as ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd"},{"text":" in the ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":" to have your application listed in the “Open with…” dialogs.","type":"text"}],"type":"paragraph"},{"code":["<dict>","    <key>CFBundleDocumentTypes<\/key>","    <array>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP License Document<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpl<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for PDF package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpdf<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpa<\/string>","            <\/array>","        <\/dict>","    <\/array>","<\/dict>"],"syntax":"xml","type":"codeListing"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"[!TIP]","type":"text"},{"text":" ","type":"text"},{"text":"If EPUB is not included in your document types, now is a good time to add it.","type":"text"}]}],"type":"aside","style":"note"},{"text":"Allow insecure HTTP requests","anchor":"Allow-insecure-HTTP-requests","type":"heading","level":3},{"inlineContent":[{"text":"A file required by the LCP library needs to be downloaded from an insecure HTTP location. You must authorize this download by adding the following to your ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":" file:","type":"text"}],"type":"paragraph"},{"code":["<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSExceptionDomains<\/key>","    <dict>","        <key>crl.edrlab.telesec.de<\/key>","        <dict>","            <key>NSExceptionAllowsInsecureHTTPLoads<\/key>","            <true\/>","        <\/dict>","    <\/dict>","<\/dict>"],"syntax":"xml","type":"codeListing"},{"text":"Device name for LCP registration","anchor":"Device-name-for-LCP-registration","type":"heading","level":3},{"inlineContent":[{"text":"When registering a license with an LSD server, Readium LCP identifies the device by name using ","type":"text"},{"type":"codeVoice","code":"UIDevice.current.name"},{"text":". Since iOS 16, this returns a generic string such as “iPhone” instead of the user-assigned device name.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To obtain the actual device name, add the ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/bundleresources\/entitlements\/com_apple_developer_device-information_user-assigned-device-name"},{"text":" entitlement to your app’s ","type":"text"},{"type":"codeVoice","code":".entitlements"},{"text":" file. This entitlement requires approval from Apple.","type":"text"}],"type":"paragraph"},{"code":["<key>com.apple.developer.device-information.user-assigned-device-name<\/key>","<true\/>"],"syntax":"xml","type":"codeListing"},{"inlineContent":[{"text":"Alternatively, you can supply your own device name when initializing ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":" via the ","type":"text"},{"type":"codeVoice","code":"deviceName"},{"text":" parameter.","type":"text"}],"type":"paragraph"},{"text":"Initializing the `LCPService`","anchor":"Initializing-the-LCPService","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"ReadiumLCP"},{"text":" offers an ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":" object that exposes its API. Since the ","type":"text"},{"type":"codeVoice","code":"ReadiumLCP"},{"text":" package is not linked with ","type":"text"},{"type":"codeVoice","code":"R2LCPClient"},{"text":", you need to create your own adapter when setting up the ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":" expects repositories to store the opened licenses and passphrases. ","type":"text"},{"type":"codeVoice","code":"ReadiumLCP"},{"text":" provides built-in Keychain-based implementations that store data securely in the iOS\/macOS Keychain. Unlike database-based storage, Keychain data persists across app reinstalls and can optionally be synchronized across the user’s devices via iCloud Keychain.","type":"text"}],"type":"paragraph"},{"code":["@preconcurrency import R2LCPClient","import ReadiumLCP","","let httpClient = DefaultHTTPClient()","","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","","let lcpService = LCPService(","    client: LCPClientAdapter(),","    licenseRepository: LCPKeychainLicenseRepository(),","    passphraseRepository: LCPKeychainPassphraseRepository(),","    assetRetriever: assetRetriever,","    httpClient: httpClient",")","","\/\/\/ Facade to the private R2LCPClient.framework.","class LCPClientAdapter: ReadiumLCP.LCPClient {","    func createContext(jsonLicense: String, hashedPassphrase: LCPPassphraseHash, pemCrl: String) throws -> LCPClientContext {","        try R2LCPClient.createContext(jsonLicense: jsonLicense, hashedPassphrase: hashedPassphrase, pemCrl: pemCrl)","    }","","    func decrypt(data: Data, using context: LCPClientContext) -> Data? {","        R2LCPClient.decrypt(data: data, using: context as! DRMContext)","    }","","    func findOneValidPassphrase(jsonLicense: String, hashedPassphrases: [LCPPassphraseHash]) -> LCPPassphraseHash? {","        R2LCPClient.findOneValidPassphrase(jsonLicense: jsonLicense, hashedPassphrases: hashedPassphrases)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"To disable iCloud synchronization, pass ","type":"text"},{"type":"codeVoice","code":"synchronizable: false"},{"text":" when creating the repositories.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You may also implement your own persistence layer by conforming to ","type":"text"},{"type":"codeVoice","code":"LCPLicenseRepository"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"LCPPassphraseRepository"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Acquiring a publication from a License Document (LCPL)","anchor":"Acquiring-a-publication-from-a-License-Document-LCPL","type":"heading","level":2},{"inlineContent":[{"text":"Users need to import a License Document into your application to download the protected publication (","type":"text"},{"type":"codeVoice","code":".epub"},{"text":", ","type":"text"},{"type":"codeVoice","code":".lcpdf"},{"text":", or ","type":"text"},{"type":"codeVoice","code":".lcpa"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":" offers an API to retrieve the full publication from an LCPL on the filesystem.","type":"text"}],"type":"paragraph"},{"code":["let result = await lcpService.acquirePublication(","    from: .file(lcplURL),","    onProgress: { progress in","        switch progress {","            case .indefinite:","                \/\/ Display an activity indicator.","            case .percent(let percent):","                \/\/ Display a progress bar with percent from 0 to 1.","        }","    }",")","","switch result {","case let .success(publication):","    \/\/ Import the `publication.localURL` file as any publication.","case let .failure(error):","    \/\/ Display the error message.","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"After the download is completed, import the ","type":"text"},{"type":"codeVoice","code":"publication.localURL"},{"text":" file into the bookshelf like any other publication file.","type":"text"}],"type":"paragraph"},{"text":"Opening a publication protected with LCP","anchor":"Opening-a-publication-protected-with-LCP","type":"heading","level":2},{"text":"Initializing the `PublicationOpener`","anchor":"Initializing-the-PublicationOpener","type":"heading","level":3},{"inlineContent":[{"text":"A publication protected with LCP can be opened using the ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":" component, just like a non-protected publication. However, you must provide a ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/readium.org\/architecture\/proposals\/006-content-protection.html"},{"text":" implementation when initializing the ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":" to enable LCP. Luckily, ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":" has you covered.","type":"text"}],"type":"paragraph"},{"code":["let httpClient = DefaultHTTPClient()","","let dialogPresenter = LCPDialogPresenter()","let authentication = LCPDialogAuthentication(delegate: dialogPresenter)","","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: AssetRetriever(httpClient: httpClient),","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"An LCP package is secured with a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"user passphrase","type":"text"}]},{"text":" for decrypting the content. The ","type":"text"},{"type":"codeVoice","code":"LCPAuthenticating"},{"text":" protocol used by ","type":"text"},{"type":"codeVoice","code":"LCPService.contentProtection(with:)"},{"text":" provides the passphrase when needed. You can use the default UIKit ","type":"text"},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"text":" which displays a pop-up to enter the passphrase, or implement your own method for passphrase retrieval. If your application is built using SwiftUI, ","type":"text"},{"type":"reference","isActive":true,"identifier":"#using-the-swiftui-lcp-authentication-dialog"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"LCPDialogAuthentication"},{"text":" delegates the presentation of the dialog to an ","type":"text"},{"type":"codeVoice","code":"LCPDialogAuthenticationDelegate"},{"text":", for example on the top-most view controller of your application. As the delegate is held weakly, you must retain it yourself for the lifetime of the authentication.","type":"text"}],"type":"paragraph"},{"code":["@MainActor","final class LCPDialogPresenter: LCPDialogAuthenticationDelegate {","    func lcpDialogAuthentication(","        _ authentication: LCPDialogAuthentication,","        present dialogViewController: UIViewController","    ) {","        \/\/ Present the dialog on your top-most view controller. It will","        \/\/ dismiss itself automatically once the user submits or cancels.","        hostViewController.present(dialogViewController, animated: true)","    }","}"],"syntax":"swift","type":"codeListing"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"The user will be prompted once per passphrase since ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" stores known passphrases on the device.","type":"text"}]}],"type":"aside","style":"note"},{"text":"Opening the publication","anchor":"Opening-the-publication","type":"heading","level":3},{"inlineContent":[{"text":"You are now ready to open the publication file with your ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Retrieve an `Asset` to access the file content.","let url = FileURL(path: \"\/path\/to\/lcp-protected-book.epub\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the `Asset`.","let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true",")","","switch result {","case .success(let publication):","    \/\/ Import or present the publication.","case .failure(let error):","    \/\/ Present the error.","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" argument is forwarded to the ","type":"text"},{"code":"LCPAuthenticating","type":"codeVoice"},{"text":" implementation when the passphrase is unknown. ","type":"text"},{"code":"LCPDialogAuthentication","type":"codeVoice"},{"text":" shows a pop-up only if ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When importing the publication to the bookshelf, set ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" as you don’t need the passphrase for accessing the publication metadata and cover. If you intend to present the publication using a Navigator, set ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" as decryption will be required.","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"text":"[!TIP]","type":"text"},{"text":" ","type":"text"},{"text":"To check if an asset is protected with LCP before opening it, you can use ","type":"text"},{"code":"asset.format.conformsTo(.lcp)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"text":"Using the opened `Publication`","anchor":"Using-the-opened-Publication","type":"heading","level":3},{"inlineContent":[{"text":"After obtaining a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" instance, you can access the publication’s metadata to import it into the user’s bookshelf. The user passphrase is not needed for reading the metadata or cover.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"However, if you want to display the publication with a Navigator, verify it is not restricted. It could be restricted if the user passphrase is unknown or if the license is no longer valid (e.g., expired loan, revoked purchase, etc.).","type":"text"}],"type":"paragraph"},{"code":["if publication.isRestricted {","    if let error = publication.protectionError as? LCPError {","        \/\/ The user is not allowed to open the publication. You should display the error.","    } else {","        \/\/ We don't have the user passphrase.","        \/\/ You may use `publication` to access its metadata, but not to render its content.","    }","} else {","    \/\/ The publication is not restricted, you may render it with a Navigator component.","}"],"syntax":"swift","type":"codeListing"},{"text":"Streaming an LCP protected package","anchor":"Streaming-an-LCP-protected-package","type":"heading","level":2},{"inlineContent":[{"text":"If the server hosting the LCP protected package supports the ","type":"text"},{"isActive":true,"identifier":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"https:\/\/httpwg.org\/specs\/rfc7233.html","type":"reference"},{"text":", it is possible to stream directly an LCP protected publication from a License Document (","type":"text"},{"code":".lcpl","type":"codeVoice"},{"text":") file, without downloading the whole publication first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Simply open the License Document directly using the ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":". Make sure you provide an ","type":"text"},{"code":"HTTPClient","type":"codeVoice"},{"text":" (or an ","type":"text"},{"code":"HTTPResourceFactory","type":"codeVoice"},{"text":" for additional customization) to the ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(httpClient: httpClient)","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication(delegate: dialogPresenter)),","    ]",")","","\/\/ Retrieve an `Asset` to access the LCPL content.","let url = FileURL(path: \"\/path\/to\/license.lcpl\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the LCPL `Asset`.","let publication = try await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true",").get()","    ","print(\"Opened \\(publication.metadata.title)\")"],"syntax":"swift","type":"codeListing"},{"text":"Obtaining information on an LCP license","anchor":"Obtaining-information-on-an-LCP-license","type":"heading","level":2},{"inlineContent":[{"text":"An LCP License Document contains metadata such as its expiration date, the remaining number of characters to copy and the user name. You can access this information using an ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" object.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" to retrieve the ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" instance for a publication.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let result = await lcpService.retrieveLicense(","    from: asset,","    authentication: LCPDialogAuthentication(delegate: dialogPresenter),","    allowUserInteraction: true",")","","switch result {","case .success(let lcpLicense):","    if let user = lcpLicense.license.user.name {","        print(\"The publication was acquired by \\(user)\")","    }","    if let endDate = lcpLicense.license.rights.end {","        print(\"The loan expires on \\(endDate)\")","    }","    if let copyLeft = await lcpLicense.charactersToCopyLeft() {","        print(\"You can copy up to \\(copyLeft) characters remaining.\")","    }","case .failure(let error):","    \/\/ Display the error.","}"],"type":"codeListing"},{"inlineContent":[{"text":"If you have already opened a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":", you can directly obtain the ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" using ","type":"text"},{"code":"publication.lcpLicense","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Managing a loan","anchor":"Managing-a-loan","type":"heading","level":2},{"inlineContent":[{"text":"Readium LCP allows borrowing publications for a specific period. Use the ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" object to manage a loan and retrieve its end date using ","type":"text"},{"code":"lcpLicense.license.rights.end","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Returning a loan","anchor":"Returning-a-loan","type":"heading","level":3},{"inlineContent":[{"text":"Some loans can be returned before the end date. You can confirm this by using ","type":"text"},{"code":"lcpLicense.canReturnPublication","type":"codeVoice"},{"text":". To return the publication, execute:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let result = await lcpLicense.returnPublication()","switch result {","case .success:","    \/\/ The publication was returned.","case .failure(let error):","    \/\/ Present the error.","}"],"type":"codeListing"},{"text":"Renewing a loan","level":3,"type":"heading","anchor":"Renewing-a-loan"},{"inlineContent":[{"text":"The loan end date may also be extended. You can confirm this by using ","type":"text"},{"code":"lcpLicense.canRenewLoan","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Readium LCP supports ","type":"text"},{"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Programmatic: You show your own user interface."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Interactive: You display a web view, and the Readium LSD server manages the renewal for you.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"You need to support both interactions by implementing the "},{"type":"codeVoice","code":"LCPRenewDelegate"},{"type":"text","text":" protocol. A default implementation is available with "},{"code":"LCPDefaultRenewDelegate","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":["let result = await lcpLicense.renewLoan(","    with: LCPDefaultRenewDelegate(","        presentingViewController: hostViewController","    )",")","","switch result {","case .success:","    \/\/ The publication was renewed.","case let .failure(error):","    \/\/ Display the error.","}"],"syntax":"swift"},{"text":"Handling `LCPError`","level":2,"type":"heading","anchor":"Handling-LCPError"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The APIs may fail with an "},{"code":"LCPError","type":"codeVoice"},{"type":"text","text":". These errors "},{"inlineContent":[{"type":"text","text":"must"}],"type":"strong"},{"text":" be displayed to the user with a suitable message.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For an example, ","type":"text"},{"identifier":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","text":"Using the SwiftUI LCP Authentication dialog","level":2,"anchor":"Using-the-SwiftUI-LCP-Authentication-dialog"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your application is built using SwiftUI, you cannot use "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" because it requires a UIKit view controller as its host. Instead, use an "},{"type":"codeVoice","code":"LCPObservableAuthentication"},{"type":"text","text":" combined with our SwiftUI "},{"type":"codeVoice","code":"LCPDialog"},{"type":"text","text":" presented as a sheet."}]},{"code":["@main","struct MyApp: App {","    private let lcpService: LCPService","    private let publicationOpener: PublicationOpener","","    @StateObject private var lcpAuthentication: LCPObservableAuthentication","","    init() {","        \/\/ Create an `LCPObservableAuthentication` which will be used","        \/\/ to initialize the `LCPContentProtection`.","        \/\/","        \/\/ With SwiftUI, it must be stored in a `@StateObject` property","        \/\/ to observe the authentication requests.","        let lcpAuthentication = LCPObservableAuthentication()","        _lcpAuthentication = StateObject(wrappedValue: lcpAuthentication)","","        lcpService = LCPService(...)","","        publicationOpener = PublicationOpener(","            ...,","            contentProtections: [","                lcpService.contentProtection(with: lcpAuthentication)","            ]","        )","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                \/\/ You can present an `LCPDialog` when the `LCPObservableAuthentication`","                \/\/ `request` property is updated.","                .sheet(item: $lcpAuthentication.request) {","                    LCPDialog(request: $0)","                }","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"}]}],"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility"],"title":"Guides","generated":true}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference","isActive":true},{"text":" DRM.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readium\/readium-lcp"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","roleHeading":"Article","title":"Supporting Readium LCP"},"sections":[],"references":{"#using-the-swiftui-lcp-authentication-dialog":{"titleInlineContent":[{"text":"prefer using the new ","type":"text"},{"type":"codeVoice","code":"LCPDialog"}],"type":"link","title":"prefer using the new LCPDialog","identifier":"#using-the-swiftui-lcp-authentication-dialog","url":"#using-the-swiftui-lcp-authentication-dialog"},"https://httpwg.org/specs/rfc7233.html":{"titleInlineContent":[{"text":"HTTP Range requests","type":"text"}],"type":"link","title":"HTTP Range requests","identifier":"https:\/\/httpwg.org\/specs\/rfc7233.html","url":"https:\/\/httpwg.org\/specs\/rfc7233.html"},"https://github.com/readium/swift-toolkit/blob/3.0.0/TestApp/Sources/App/Readium.swift#L221":{"titleInlineContent":[{"text":"take a look at the Test App","type":"text"}],"type":"link","title":"take a look at the Test App","identifier":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221","url":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221"},"doc://Readium/documentation/Readium/Migration-Guide":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","kind":"article","title":"Migration Guide","abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}],"url":"\/documentation\/readium\/migration-guide","role":"article"},"https://readium.org/architecture/proposals/006-content-protection.html":{"titleInlineConten