r."}],"url":"\/documentation\/readium\/navigatoroverview","role":"article"},"https://httpwg.org/specs/rfc9110.html#HEAD":{"titleInlineContent":[{"text":"HTTP ","type":"text"},{"type":"codeVoice","code":"HEAD"},{"text":" method","type":"text"}],"type":"link","title":"HTTP HEAD method","identifier":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD","url":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD"},"doc://Readium/documentation/Readium/Getting-Started":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","type":"topic","kind":"article","title":"Getting started","abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"url":"\/documentation\/readium\/getting-started","role":"article"},"https://help.apple.com/xcode/mac/current/#/devddd273fdd":{"titleInlineContent":[{"text":"Document Types","type":"text"}],"type":"link","title":"Document Types","identifier":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd","url":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd"}}}