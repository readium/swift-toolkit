{"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Content"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"name":"Note","type":"aside","content":[{"inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"The described feature is still experimental and the implementation incomplete.","type":"text"}],"type":"paragraph"}],"style":"note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Many high-level features require access to the raw content (text, media, etc.) of a publication, such as:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Text-to-speech","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Accessibility reader","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Basic search","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Full-text search indexing","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Image or audio indexes","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"ContentService","type":"codeVoice"},{"type":"text","text":" provides a way to iterate through a publication’s content, extracted as semantic elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"First, request the publication’s "},{"code":"Content","type":"codeVoice"},{"type":"text","text":", starting from a given "},{"code":"Locator","type":"codeVoice"},{"type":"text","text":". If the locator is missing, the "},{"code":"Content","type":"codeVoice"},{"type":"text","text":" will be extracted from the beginning of the publication."}]},{"type":"codeListing","code":["guard let content = publication.content(from: startLocator) else {","    \/\/ Abort as the content cannot be extracted","    return","}"],"syntax":"swift"},{"level":2,"type":"heading","text":"Extracting the raw text content","anchor":"Extracting-the-raw-text-content"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Getting the whole raw text of a publication is such a common use case that a helper is available on "},{"code":"Content","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["let wholeText = content.text()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is an expensive operation, proceed with caution and cache the result if you need to reuse it."}]},{"level":2,"type":"heading","text":"Iterating through the content","anchor":"Iterating-through-the-content"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The individual "},{"code":"Content","type":"codeVoice"},{"type":"text","text":" elements can be iterated through with a regular "},{"code":"for","type":"codeVoice"},{"type":"text","text":" loop by converting it to a sequence:"}]},{"type":"codeListing","code":["for element in content.sequence() {","    \/\/ Process element","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Alternatively, you can get the whole list of elements with ","type":"text"},{"code":"content.elements()","type":"codeVoice"},{"text":", or use the lower level APIs to iterate the content manually:","type":"text"}]},{"type":"codeListing","code":["let iterator = content.iterator()","while let element = try iterator.next() {","    print(element)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Some ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" implementations support bidirectional iterations. To iterate backwards, use:","type":"text"}]},{"type":"codeListing","code":["let iterator = content.iterator()","while let element = try iterator.previous() {","    print(element)","}"],"syntax":"swift"},{"level":2,"type":"heading","text":"Processing the elements","anchor":"Processing-the-elements"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" iterator yields ","type":"text"},{"code":"ContentElement","type":"codeVoice"},{"text":" objects representing a single semantic portion of the publication, such as a heading, a paragraph or an embedded image.","type":"text"}]},{"inlineContent":[{"text":"Every element has a ","type":"text"},{"type":"codeVoice","code":"locator"},{"text":" property targeting it in the publication. You can use the locator, for example, to navigate to the element or to draw a ","type":"text"},{"code":"Decoration","type":"codeVoice"},{"text":" on top of it.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["navigator.go(to: element.locator)"],"type":"codeListing"},{"level":3,"text":"Types of elements","anchor":"Types-of-elements","type":"heading"},{"inlineContent":[{"text":"Depending on the actual implementation of ","type":"text"},{"code":"ContentElement","type":"codeVoice"},{"text":", more properties are available to access the actual data. The toolkit ships with a number of default implementations for common types of elements.","type":"text"}],"type":"paragraph"},{"level":4,"text":"Embedded media","anchor":"Embedded-media","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"EmbeddedContentElement","type":"codeVoice"},{"text":" protocol is implemented by any element referencing an external resource. It contains an ","type":"text"},{"code":"embeddedLink","type":"codeVoice"},{"text":" property you can use to get the actual content of the resource.","type":"text"}],"type":"paragraph"},{"code":["if let element = element as? EmbeddedContentElement {","    let bytes = try publication","        .get(element.embeddedLink)","        .read().get()","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Here are the default available implementations:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AudioContentElement"},{"text":" - audio clips","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"VideoContentElement"},{"type":"text","text":" - video clips"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ImageContentElement","type":"codeVoice"},{"text":" - bitmap images","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"All of them expose an additional ","type":"text"},{"code":"caption: String?","type":"codeVoice"},{"text":" property - the caption from an enclosing figure’s ","type":"text"},{"code":"figcaption","type":"codeVoice"},{"text":", when available.","type":"text"}]},{"anchor":"Text","text":"Text","type":"heading","level":4},{"anchor":"Textual-elements","text":"Textual elements","type":"heading","level":5},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"TextualContentElement","type":"codeVoice"},{"text":" protocol is implemented by any element which can be represented as human-readable text. This is useful when you want to extract the text content of a publication without caring for each individual type of elements.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For media elements (image, SVG, audio and video), ","type":"text"},{"code":"text","type":"codeVoice"},{"text":" returns the accessible name only.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let wholeText = publication.content()","    .elements()","    .compactMap { ($0 as? TextualContentElement)?.text.takeIf { !$0.isEmpty } }","    .joined(separator: \"\\n\")"]},{"anchor":"Text-elements","text":"Text elements","type":"heading","level":5},{"type":"paragraph","inlineContent":[{"text":"Actual text elements are instances of ","type":"text"},{"code":"TextContentElement","type":"codeVoice"},{"text":", which represent a single block of text such as a heading, a paragraph or a list item. It is comprised of a ","type":"text"},{"code":"role","type":"codeVoice"},{"text":" and a list of ","type":"text"},{"code":"segments","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"role","type":"codeVoice"},{"text":" is the nature of the text element in the document. For example a heading, body, footnote or a quote. It can be used to reconstruct part of the structure of the original document.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A text element is composed of individual segments with their own ","type":"text"},{"code":"locator","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"attributes","type":"codeVoice"},{"text":". They are useful to associate attributes with a portion of a text element. For example, given the HTML paragraph:","type":"text"}]},{"type":"codeListing","syntax":"html","code":["<p>It is pronounced <span lang=\"fr\">croissant<\/span>.<\/p>"]},{"type":"paragraph","inlineContent":[{"text":"The following ","type":"text"},{"code":"TextContentElement","type":"codeVoice"},{"text":" will be produced:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["TextContentElement(","    role: .body,","    segments: [","        TextContentElement.Segment(text: \"It is pronounced \"),","        TextContentElement.Segment(text: \"croissant\", attributes: [ContentAttribute(key: .language, value: \"fr\")]),","        TextContentElement.Segment(text: \".\")","    ]",")"]},{"type":"paragraph","inlineContent":[{"text":"If you are not interested in the segment attributes, you can also use ","type":"text"},{"code":"element.text","type":"codeVoice"},{"text":" to get the concatenated raw text.","type":"text"}]},{"anchor":"Element-attributes","text":"Element attributes","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"All types of ","type":"text"},{"code":"ContentElement","type":"codeVoice"},{"text":" can have associated attributes. Custom ","type":"text"},{"code":"ContentService","type":"codeVoice"},{"text":" implementations can use this as an extensibility point.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The HTML content iterator fills in accessibility attributes for media elements:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"accessibleName","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"accessibleDescription","type":"codeVoice"},{"text":" - flat strings computed following a subset of ","type":"text"},{"identifier":"https:\/\/www.w3.org\/TR\/accname-1.2","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"extendedDescription","type":"codeVoice"},{"text":" - a ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" to an extended description declared with ","type":"text"},{"identifier":"https:\/\/daisy.github.io\/transitiontoepub\/best-practices\/extended-desc\/ExtendedDescriptionsBestPractices.html","isActive":true,"type":"reference"},{"text":", repeated when the element declares several targets.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Use-cases","text":"Use cases","type":"heading","level":2},{"anchor":"An-index-of-all-images-embedded-in-the-publication","text":"An index of all images embedded in the publication","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"This example extracts all the embedded images in the publication and displays them in a SwiftUI list. Clicking on an image jumps to its location in the publication.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ImageIndex: View {","    struct Item: Hashable {","        let locator: Locator","        let text: String?","        let image: UIImage","    }","","    let publication: Publication","    let navigator: Navigator","    @State private var items: [Item] = []","","    init(publication: Publication, navigator: Navigator) {","        self.publication = publication","        self.navigator = navigator","    }","","    var body: some View {","        ScrollView {","            LazyVStack {","                ForEach(items, id: \\.self) { item in","                    VStack() {","                        Image(uiImage: item.image)","                        Text(item.text ?? \"No caption\")","                    }","                    .onTapGesture {","                        navigator.go(to: item.locator)","                    }","                }","            }","        }","        .onAppear {","            items = publication.content()?","                .elements()","                .compactMap { element in","                    guard","                        let element = element as? ImageContentElement,","                        let image = try? publication.get(element.embeddedLink)","                            .read().map(UIImage.init).get()","                    else {","                        return nil","                    }","","                    return Item(","                        locator: element.locator,","                        text: element.caption ?? element.accessibleName,","                        image: image","                    )","                }","                ?? []","        }","    }","}"]},{"anchor":"References","text":"References","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","isActive":true,"type":"reference"}],"type":"paragraph"}]}]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"title":"Guides","generated":true,"anchor":"Guides"}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readium\/content"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Article","title":"Extracting the content of a publication","role":"article"},"sections":[],"references":{"https://www.w3.org/TR/epub-a11y-11":{"titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"title":"EPUB Accessibility","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"link"},"doc://Readium/documentation/Readium/TTS":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","kind":"article","title":"Text-to-speech","abstract":[],"url":"\/documentation\/readium\/tts","role":"article"},"https://github.com/readium/architecture/pull/177":{"titleInlineContent":[{"text":"Content Iterator proposal","type":"text"}],"title":"Content Iterator proposal","type":"link","url":"https:\/\/github.com\/readium\/architecture\/pull\/177","identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177"},"doc://Readium/documentation/Readium":{"identifier":"doc:\/\/Readium\/documentation\/Readium","type":"topic","kind":"article","title":"Readium","abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"url":"\/documentation\/readium","role":"collection"},"doc://Readium/documentation/Readium/Getting-Started":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","type":"topic","kind":"article","title":"Getting started","abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"url":"\/documentation\/readium\/getting-started","role":"article"},"doc://Readium/documentation/Readium/Search":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","kind":"article","title":"Searching a publication","abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"url":"\/documentation\/readium\/search","role":"article"},"doc://Readium/documentation/Readium/NavigatorOverview":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","kind":"article","title":"Navigator Overview","abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"url":"\/documentation\/readium\/navigatoroverview","role":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","kind":"article","title":"Migration Guide","abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}],"url":"\/documentation\/readium\/migration-guide","role":"article"},"doc://Readium/documentation/Readium/Readium-LCP":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","kind":"article","title":"Supporting Readium LCP","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true},{"type":"text","text":" DRM."}],"url":"\/documentation\/readium\/readium-lcp","role":"article"},"https://daisy.github.io/transitiontoepub/best-practices/extended-desc/ExtendedDescriptionsBestPractices.html":{"titleInlineContent":[{"type":"codeVoice","code":"aria-details"}],"title":"aria-details","url":"https:\/\/daisy.github.io\/transitiontoepub\/best-practices\/extended-desc\/ExtendedDescriptionsBestPractices.html","identifier":"https:\/\/daisy.github.io\/transitiontoepub\/best-practices\/extended-desc\/ExtendedDescriptionsBestPractices.html","type":"link"},"https://www.edrlab.org/readium-lcp/":{"titleInlineContent":[{"text":"Readium LCP","type":"text"}],"title":"Readium LCP","url":"https:\/\/www.edrlab.org\/readium-lcp\/","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"link"},"https://www.w3.org/TR/accname-1.2":{"title":"the W3C accessible name computation","titleInlineContent":[{"text":"the W3C accessible name computation","type":"text"}],"url":"https:\/\/www.w3.org\/TR\/accname-1.2","identifier":"https:\/\/www.w3.org\/TR\/accname-1.2","type":"link"},"doc://Readium/documentation/Readium/Open-Publication":{"kind":"article","url":"\/documentation\/readium\/open-publication","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","title":"Opening a publication","abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":"."}],"role":"article","type":"topic"},"doc://Readium/documentation/Readium/Accessibility":{"kind":"article","url":"\/documentation\/readium\/accessibility","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","title":"Accessibility","abstract":[{"type":"text","text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the "},{"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","isActive":true},{"text":" specification.","type":"text"}],"role":"article","type":"topic"}}}