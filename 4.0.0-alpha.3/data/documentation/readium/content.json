{"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Content","interfaceLanguage":"swift"},"kind":"article","hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"metadata":{"title":"Extracting the content of a publication","role":"article","roleHeading":"Article"},"primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The described feature is still experimental and the implementation incomplete."}]}],"type":"aside","name":"Note"},{"inlineContent":[{"text":"Many high-level features require access to the raw content (text, media, etc.) of a publication, such as:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Text-to-speech","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Accessibility reader","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Basic search","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Full-text search indexing","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Image or audio indexes","type":"text"}]}]}]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"ContentService","type":"codeVoice"},{"text":" provides a way to iterate through a publication’s content, extracted as semantic elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"First, request the publication’s ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":", starting from a given ","type":"text"},{"code":"Locator","type":"codeVoice"},{"text":". If the locator is missing, the ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" will be extracted from the beginning of the publication.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["guard let content = publication.content(from: startLocator) else {","    \/\/ Abort as the content cannot be extracted","    return","}"]},{"anchor":"Extracting-the-raw-text-content","type":"heading","level":2,"text":"Extracting the raw text content"},{"inlineContent":[{"text":"Getting the whole raw text of a publication is such a common use case that a helper is available on ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let wholeText = content.text()"]},{"inlineContent":[{"text":"This is an expensive operation, proceed with caution and cache the result if you need to reuse it.","type":"text"}],"type":"paragraph"},{"anchor":"Iterating-through-the-content","type":"heading","level":2,"text":"Iterating through the content"},{"inlineContent":[{"text":"The individual ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" elements can be iterated through with a regular ","type":"text"},{"code":"for","type":"codeVoice"},{"text":" loop by converting it to a sequence:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["for element in content.sequence() {","    \/\/ Process element","}"]},{"inlineContent":[{"text":"Alternatively, you can get the whole list of elements with ","type":"text"},{"code":"content.elements()","type":"codeVoice"},{"text":", or use the lower level APIs to iterate the content manually:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.next() {","    print(element)","}"]},{"inlineContent":[{"text":"Some ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" implementations support bidirectional iterations. To iterate backwards, use:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.previous() {","    print(element)","}"]},{"anchor":"Processing-the-elements","type":"heading","level":2,"text":"Processing the elements"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" iterator yields ","type":"text"},{"code":"ContentElement","type":"codeVoice"},{"text":" objects representing a single semantic portion of the publication, such as a heading, a paragraph or an embedded image.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every element has a ","type":"text"},{"code":"locator","type":"codeVoice"},{"text":" property targeting it in the publication. You can use the locator, for example, to navigate to the element or to draw a ","type":"text"},{"code":"Decoration","type":"codeVoice"},{"text":" on top of it.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["navigator.go(to: element.locator)"]},{"anchor":"Types-of-elements","type":"heading","level":3,"text":"Types of elements"},{"inlineContent":[{"text":"Depending on the actual implementation of ","type":"text"},{"code":"ContentElement","type":"codeVoice"},{"text":", more properties are available to access the actual data. The toolkit ships with a number of default implementations for common types of elements.","type":"text"}],"type":"paragraph"},{"anchor":"Embedded-media","type":"heading","level":4,"text":"Embedded media"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"EmbeddedContentElement","type":"codeVoice"},{"text":" protocol is implemented by any element referencing an external resource. It contains an ","type":"text"},{"code":"embeddedLink","type":"codeVoice"},{"text":" property you can use to get the actual content of the resource.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["if let element = element as? EmbeddedContentElement {","    let bytes = try publication","        .get(element.embeddedLink)","        .read().get()","}"]},{"inlineContent":[{"text":"Here are the default available implementations:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AudioContentElement"},{"text":" - audio clips","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"VideoContentElement"},{"text":" - video clips","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ImageContentElement"},{"text":" - bitmap images","type":"text"}]}]}]},{"inlineContent":[{"text":"All of them expose an additional ","type":"text"},{"code":"caption: String?","type":"codeVoice"},{"text":" property - the caption from an enclosing figure’s ","type":"text"},{"code":"figcaption","type":"codeVoice"},{"text":", when available.","type":"text"}],"type":"paragraph"},{"anchor":"Text","type":"heading","level":4,"text":"Text"},{"anchor":"Textual-elements","type":"heading","level":5,"text":"Textual elements"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"TextualContentElement","type":"codeVoice"},{"text":" protocol is implemented by any element which can be represented as human-readable text. This is useful when you want to extract the text content of a publication without caring for each individual type of elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For media elements (image, SVG, audio and video), ","type":"text"},{"code":"text","type":"codeVoice"},{"text":" returns the accessible name only.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let wholeText = publication.content()","    .elements()","    .compactMap { ($0 as? TextualContentElement)?.text.takeIf { !$0.isEmpty } }","    .joined(separator: \"\\n\")"]},{"anchor":"Text-elements","type":"heading","level":5,"text":"Text elements"},{"inlineContent":[{"text":"Actual text elements are instances of ","type":"text"},{"code":"TextContentElement","type":"codeVoice"},{"text":", which represent a single block of text such as a heading, a paragraph or a list item. It is comprised of a ","type":"text"},{"code":"role","type":"codeVoice"},{"text":" and a list of ","type":"text"},{"code":"segments","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"role","type":"codeVoice"},{"text":" is the nature of the text element in the document. For example a heading, body, footnote or a quote. It can be used to reconstruct part of the structure of the original document.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A text element is composed of individual segments with their own ","type":"text"},{"code":"locator","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"attributes","type":"codeVoice"},{"text":". They are useful to associate attributes with a portion of a text element. For example, given the HTML paragraph:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"html","code":["<p>It is pronounced <span lang=\"fr\">croissant<\/span>.<\/p>"]},{"inlineContent":[{"text":"The following ","type":"text"},{"code":"TextContentElement","type":"codeVoice"},{"text":" will be produced:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["TextContentElement(","    role: .body,","    segments: [","        TextContentElement.Segment(text: \"It is pronounced \"),","        TextContentElement.Segment(text: \"croissant\", attributes: [ContentAttribute(key: .language, value: \"fr\")]),","        TextContentElement.Segment(text: \".\")","    ]",")"]},{"inlineContent":[{"text":"If you are not interested in the segment attributes, you can also use ","type":"text"},{"code":"element.text","type":"codeVoice"},{"text":" to get the concatenated raw text.","type":"text"}],"type":"paragraph"},{"anchor":"Element-attributes","type":"heading","level":3,"text":"Element attributes"},{"inlineContent":[{"text":"All types of ","type":"text"},{"code":"ContentElement","type":"codeVoice"},{"text":" can have associated attributes. Custom ","type":"text"},{"code":"ContentService","type":"codeVoice"},{"text":" implementations can use this as an extensibility point.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The HTML content iterator fills in accessibility attributes for media elements:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"accessibleName"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"accessibleDescription"},{"text":" - flat strings computed following a subset of ","type":"text"},{"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/accname-1.2","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"extendedDescription"},{"text":" - a ","type":"text"},{"type":"codeVoice","code":"Link"},{"text":" to an extended description declared with ","type":"text"},{"type":"reference","identifier":"https:\/\/daisy.github.io\/transitiontoepub\/best-practices\/extended-desc\/ExtendedDescriptionsBestPractices.html","isActive":true},{"text":", repeated when the element declares several targets.","type":"text"}]}]}]},{"anchor":"Use-cases","type":"heading","level":2,"text":"Use cases"},{"anchor":"An-index-of-all-images-embedded-in-the-publication","type":"heading","level":3,"text":"An index of all images embedded in the publication"},{"inlineContent":[{"text":"This example extracts all the embedded images in the publication and displays them in a SwiftUI list. Clicking on an image jumps to its location in the publication.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct ImageIndex: View {","    struct Item: Hashable {","        let locator: Locator","        let text: String?","        let image: UIImage","    }","","    let publication: Publication","    let navigator: Navigator","    @State private var items: [Item] = []","","    init(publication: Publication, navigator: Navigator) {","        self.publication = publication","        self.navigator = navigator","    }","","    var body: some View {","        ScrollView {","            LazyVStack {","                ForEach(items, id: \\.self) { item in","                    VStack() {","                        Image(uiImage: item.image)","                        Text(item.text ?? \"No caption\")","                    }","                    .onTapGesture {","                        navigator.go(to: item.locator)","                    }","                }","            }","        }","        .onAppear {","            items = publication.content()?","                .elements()","                .compactMap { element in","                    guard","                        let element = element as? ImageContentElement,","                        let image = try? publication.get(element.embeddedLink)","                            .read().map(UIImage.init).get()","                    else {","                        return nil","                    }","","                    return Item(","                        locator: element.locator,","                        text: element.caption ?? element.accessibleName,","                        image: image","                    )","                }","                ?? []","        }","    }","}"]},{"anchor":"References","type":"heading","level":2,"text":"References"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","isActive":true}]}]}]}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/readium\/content"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Timeline","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"generated":true,"anchor":"Guides"}],"references":{"doc://Readium/documentation/Readium/TTS":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","title":"Text-to-speech","abstract":[],"url":"\/documentation\/readium\/tts","kind":"article","role":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"kind":"article","title":"Migration Guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","url":"\/documentation\/readium\/migration-guide","type":"topic","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}]},"https://daisy.github.io/transitiontoepub/best-practices/extended-desc/ExtendedDescriptionsBestPractices.html":{"identifier":"https:\/\/daisy.github.io\/transitiontoepub\/best-practices\/extended-desc\/ExtendedDescriptionsBestPractices.html","title":"aria-details","titleInlineContent":[{"type":"codeVoice","code":"aria-details"}],"url":"https:\/\/daisy.github.io\/transitiontoepub\/best-practices\/extended-desc\/ExtendedDescriptionsBestPractices.html","type":"link"},"https://github.com/readium/architecture/pull/177":{"identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","title":"Content Iterator proposal","titleInlineContent":[{"type":"text","text":"Content Iterator proposal"}],"url":"https:\/\/github.com\/readium\/architecture\/pull\/177","type":"link"},"doc://Readium/documentation/Readium/Getting-Started":{"title":"Getting started","url":"\/documentation\/readium\/getting-started","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","type":"topic","abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"kind":"article"},"doc://Readium/documentation/Readium/Timeline":{"title":"Timeline","url":"\/documentation\/readium\/timeline","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Timeline","type":"topic","abstract":[{"type":"text","text":"The Timeline API lays out the table of contents of a publication on its reading order. It answers questions such as “which chapter am I in?”, “what is the next chapter?” or “how much is left in this chapter?”. Use it to show where each chapter starts in a table of contents, to display the current chapter in a running header, to step through the chapters of a publication, or to pause the playback at the end of an audiobook chapter."}],"kind":"article"},"doc://Readium/documentation/Readium/Search":{"title":"Searching a publication","url":"\/documentation\/readium\/search","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","type":"topic","abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"kind":"article"},"doc://Readium/documentation/Readium/Accessibility":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","title":"Accessibility","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference","isActive":true},{"type":"text","text":" specification."}],"url":"\/documentation\/readium\/accessibility","kind":"article","role":"article"},"doc://Readium/documentation/Readium/Open-Publication":{"title":"Opening a publication","url":"\/documentation\/readium\/open-publication","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","type":"topic","abstract":[{"text":"To open a publication with Readium, you need to instantiate a couple of components: an ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":".","type":"text"}],"kind":"article"},"doc://Readium/documentation/Readium/Readium-LCP":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","title":"Supporting Readium LCP","url":"\/documentation\/readium\/readium-lcp","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"isActive":true,"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},{"type":"text","text":" DRM."}],"type":"topic","kind":"article","role":"article"},"doc://Readium/documentation/Readium":{"url":"\/documentation\/readium","identifier":"doc:\/\/Readium\/documentation\/Readium","abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"type":"topic","role":"collection","kind":"article","title":"Readium"},"https://www.edrlab.org/readium-lcp/":{"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","title":"Readium LCP","titleInlineContent":[{"type":"text","text":"Readium LCP"}],"url":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"link"},"https://www.w3.org/TR/accname-1.2":{"identifier":"https:\/\/www.w3.org\/TR\/accname-1.2","title":"the W3C accessible name computation","titleInlineContent":[{"type":"text","text":"the W3C accessible name computation"}],"url":"https:\/\/www.w3.org\/TR\/accname-1.2","type":"link"},"doc://Readium/documentation/Readium/NavigatorOverview":{"url":"\/documentation\/readium\/navigatoroverview","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}],"type":"topic","role":"article","kind":"article","title":"Navigator Overview"},"https://www.w3.org/TR/epub-a11y-11":{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"link"}}}