{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview"},"abstract":[{"type":"text","text":"Learn about the architecture, configuration, and usage of the Readium Navigator."}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"kind":"article","metadata":{"roleHeading":"Article","title":"Navigator Overview","role":"article"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Navigator","doc:\/\/Readium\/documentation\/Readium\/Preferences","doc:\/\/Readium\/documentation\/Readium\/SwiftUI","doc:\/\/Readium\/documentation\/Readium\/Input","doc:\/\/Readium\/documentation\/Readium\/Highlights","doc:\/\/Readium\/documentation\/Readium\/Decorations","doc:\/\/Readium\/documentation\/Readium\/EPUB-Fonts","doc:\/\/Readium\/documentation\/Readium\/EPUB-Image-Preview","doc:\/\/Readium\/documentation\/Readium\/Audiobook"],"anchor":"Essentials","title":"Essentials"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/Timeline","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"anchor":"Guides","title":"Guides","generated":true}],"variants":[{"paths":["\/documentation\/readium\/navigatoroverview"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Readium/documentation/Readium/TTS":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","title":"Text-to-speech","abstract":[],"url":"\/documentation\/readium\/tts","kind":"article","role":"article"},"doc://Readium/documentation/Readium/SwiftUI":{"type":"topic","abstract":[{"type":"text","text":"The Navigator is built with UIKit and provides "},{"code":"UIViewController","type":"codeVoice"},{"type":"text","text":" implementations. Nevertheless, you can integrate them into a SwiftUI view hierarchy using Apple’s "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/swiftui\/uiviewrepresentable"},{"type":"text","text":"."}],"url":"\/documentation\/readium\/swiftui","identifier":"doc:\/\/Readium\/documentation\/Readium\/SwiftUI","title":"Integrating the Navigator with SwiftUI","kind":"article","role":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"kind":"article","title":"Migration Guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","url":"\/documentation\/readium\/migration-guide","type":"topic","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}]},"doc://Readium/documentation/Readium/Getting-Started":{"title":"Getting started","url":"\/documentation\/readium\/getting-started","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","type":"topic","abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"kind":"article"},"doc://Readium/documentation/Readium/Decorations":{"kind":"article","title":"Decorations","identifier":"doc:\/\/Readium\/documentation\/Readium\/Decorations","role":"article","url":"\/documentation\/readium\/decorations","abstract":[{"type":"text","text":"The Decoration API lets you overlay visual elements on publication content – highlights, search result markers, TTS playback indicators, page-number labels in the margin, and more. For the common case of implementing user highlights, see the "},{"type":"reference","overridingTitle":"Highlighting guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Highlights","overridingTitleInlineContent":[{"type":"text","text":"Highlighting guide"}],"isActive":true},{"type":"text","text":"."}],"type":"topic"},"doc://Readium/documentation/Readium/Input":{"kind":"article","title":"Observing user input","identifier":"doc:\/\/Readium\/documentation\/Readium\/Input","role":"article","url":"\/documentation\/readium\/input","abstract":[{"type":"text","text":"In visual publications like EPUB or PDF, users can interact with the "},{"type":"codeVoice","code":"VisualNavigator"},{"type":"text","text":" instance using gestures, a keyboard, a mouse, a pencil, or a trackpad. When the publication does not override user input events, you may want to intercept them to trigger actions in your user interface. For example, you can turn pages or toggle the navigation bar on taps, or open a bookmarks screen when pressing the Command-Shift-D hotkey."}],"type":"topic"},"doc://Readium/documentation/Readium/Navigator":{"url":"\/documentation\/readium\/navigator","identifier":"doc:\/\/Readium\/documentation\/Readium\/Navigator","abstract":[{"type":"text","text":"You can use a Readium Navigator to present the publication to the user. The "},{"type":"codeVoice","code":"Navigator"},{"type":"text","text":" renders resources on the screen and offers APIs and user interactions for navigating the contents."}],"type":"topic","role":"article","kind":"article","title":"Navigator"},"doc://Readium/documentation/Readium/Preferences":{"kind":"article","title":"Configuring the Navigator","identifier":"doc:\/\/Readium\/documentation\/Readium\/Preferences","role":"article","url":"\/documentation\/readium\/preferences","abstract":[{"type":"text","text":"Take a look at the "},{"type":"reference","overridingTitle":"migration guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","overridingTitleInlineContent":[{"type":"text","text":"migration guide"}],"isActive":true},{"type":"text","text":" if you are already using the legacy EPUB settings."}],"type":"topic"},"doc://Readium/documentation/Readium/Content":{"title":"Extracting the content of a publication","url":"\/documentation\/readium\/content","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","type":"topic","abstract":[],"kind":"article"},"doc://Readium/documentation/Readium/Timeline":{"title":"Timeline","url":"\/documentation\/readium\/timeline","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Timeline","type":"topic","abstract":[{"type":"text","text":"The Timeline API lays out the table of contents of a publication on its reading order. It answers questions such as “which chapter am I in?”, “what is the next chapter?” or “how much is left in this chapter?”. Use it to show where each chapter starts in a table of contents, to display the current chapter in a running header, to step through the chapters of a publication, or to pause the playback at the end of an audiobook chapter."}],"kind":"article"},"doc://Readium/documentation/Readium/Accessibility":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","title":"Accessibility","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference","isActive":true},{"type":"text","text":" specification."}],"url":"\/documentation\/readium\/accessibility","kind":"article","role":"article"},"doc://Readium/documentation/Readium/EPUB-Image-Preview":{"kind":"article","title":"EPUB Image Preview","identifier":"doc:\/\/Readium\/documentation\/Readium\/EPUB-Image-Preview","role":"article","url":"\/documentation\/readium\/epub-image-preview","abstract":[{"type":"text","text":"This guide explains how to detect when a user taps an image in an EPUB publication to present it in a dedicated view, using the "},{"type":"codeVoice","code":"PointerEvent.targetElement"},{"type":"text","text":" API."}],"type":"topic"},"doc://Readium/documentation/Readium/Search":{"title":"Searching a publication","url":"\/documentation\/readium\/search","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","type":"topic","abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"kind":"article"},"doc://Readium/documentation/Readium/Open-Publication":{"title":"Opening a publication","url":"\/documentation\/readium\/open-publication","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","type":"topic","abstract":[{"text":"To open a publication with Readium, you need to instantiate a couple of components: an ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":".","type":"text"}],"kind":"article"},"doc://Readium/documentation/Readium/EPUB-Fonts":{"kind":"article","title":"Font families in the EPUB navigator","identifier":"doc:\/\/Readium\/documentation\/Readium\/EPUB-Fonts","role":"article","url":"\/documentation\/readium\/epub-fonts","abstract":[{"type":"text","text":"Readium allows users to customize the font family used to render a reflowable EPUB, by changing the "},{"type":"reference","overridingTitle":"EPUB navigator preferences","identifier":"doc:\/\/Readium\/documentation\/Readium\/Preferences","overridingTitleInlineContent":[{"type":"text","text":"EPUB navigator preferences"}],"isActive":true},{"type":"text","text":"."}],"type":"topic"},"https://developer.apple.com/documentation/swiftui/uiviewrepresentable":{"url":"https:\/\/developer.apple.com\/documentation\/swiftui\/uiviewrepresentable","type":"link","identifier":"https:\/\/developer.apple.com\/documentation\/swiftui\/uiviewrepresentable","title":"UIViewRepresentable","titleInlineContent":[{"code":"UIViewRepresentable","type":"codeVoice"}]},"doc://Readium/documentation/Readium/Readium-LCP":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","title":"Supporting Readium LCP","url":"\/documentation\/readium\/readium-lcp","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"isActive":true,"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},{"type":"text","text":" DRM."}],"type":"topic","kind":"article","role":"article"},"doc://Readium/documentation/Readium":{"url":"\/documentation\/readium","identifier":"doc:\/\/Readium\/documentation\/Readium","abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"type":"topic","role":"collection","kind":"article","title":"Readium"},"doc://Readium/documentation/Readium/Highlights":{"kind":"article","title":"Implementing Highlights","identifier":"doc:\/\/Readium\/documentation\/Readium\/Highlights","role":"article","url":"\/documentation\/readium\/highlights","abstract":[{"type":"text","text":"Highlighting lets users mark up passages in a publication for later reference - a core feature of any reading app. In Readium, highlights are built on top of the "},{"type":"strong","inlineContent":[{"type":"text","text":"Decoration API"}]},{"type":"text","text":". If you want to understand that API in depth or build a custom decoration style, see the "},{"type":"reference","overridingTitle":"Decorations guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Decorations","overridingTitleInlineContent":[{"type":"text","text":"Decorations guide"}],"isActive":true},{"type":"text","text":"."}],"type":"topic"},"https://www.edrlab.org/readium-lcp/":{"url":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"link","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","title":"Readium LCP","titleInlineContent":[{"type":"text","text":"Readium LCP"}]},"https://www.w3.org/TR/epub-a11y-11":{"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"type":"link","title":"EPUB Accessibility","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/Audiobook":{"kind":"article","title":"Audiobooks","identifier":"doc:\/\/Readium\/documentation\/Readium\/Audiobook","role":"article","url":"\/documentation\/readium\/audiobook","abstract":[{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"AudioNavigator"}]},{"type":"text","text":" plays the audio publications: Readium Audiobooks ("},{"type":"codeVoice","code":".audiobook"},{"type":"text","text":", "},{"type":"codeVoice","code":".lcpa"},{"type":"text","text":"), Zipped Audio Books ("},{"type":"codeVoice","code":".zab"},{"type":"text","text":"), and standalone audio files such as an M4B or MP3. This guide explains how to play an audiobook, and how Readium reads the metadata embedded in audio files."}],"type":"topic"}}}