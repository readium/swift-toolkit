{"kind":"article","sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Readium offers only low-level tools. You are responsible for creating a user interface for reading and managing books, as well as a data layer to store the user’s publications. The Test App is an example of such integration."}]}],"style":"note","name":"Note"},{"type":"heading","text":"Design principles","level":2,"anchor":"Design-principles"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The toolkit has been designed following these core tenets:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modular"}]},{"text":": It is divided into separate modules that can be used independently.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Extensible"}]},{"text":": Integrators should be able to support a custom DRM, publication format or inject their own stylesheets without modifying the toolkit itself.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Opiniated"}]},{"text":": We adhere to open standards but sometimes interpret them for practicality.","type":"text"}]}]}]},{"type":"heading","text":"Packages","level":2,"anchor":"Packages"},{"type":"heading","text":"Main packages","level":3,"anchor":"Main-packages"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumShared"},{"text":" contains shared ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" models and utilities.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumStreamer"},{"text":" parses publication files (e.g. an EPUB) into a ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" object.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"overridingTitleInlineContent":[{"type":"codeVoice","code":"ReadiumNavigator"},{"type":"text","text":" renders the content of a publication"}],"isActive":true,"type":"reference","identifier":"doc:\/\/Readium\/documentation\/Readium\/Navigator","overridingTitle":"ReadiumNavigator renders the content of a publication"},{"text":".","type":"text"}]}]}]},{"type":"heading","text":"Specialized packages","level":3,"anchor":"Specialized-packages"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumOPDS"},{"text":" parses ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/opds.io"},{"text":" (both OPDS 1 and 2).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"overridingTitleInlineContent":[{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" downloads and decrypts LCP-protected publications"}],"isActive":true,"type":"reference","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","overridingTitle":"ReadiumLCP downloads and decrypts LCP-protected publications"},{"text":".","type":"text"}]}]}]},{"type":"heading","text":"Overview of the shared models (ReadiumShared)","level":2,"anchor":"Overview-of-the-shared-models-ReadiumShared"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Readium toolkit provides models used as exchange types between packages."}]},{"type":"heading","text":"Publication models","level":3,"anchor":"Publication-models"},{"type":"heading","level":4,"anchor":"Publication","text":"Publication"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Publication"},{"type":"text","text":" and its sub-components represent a single publication – ebook, audiobook or comic. It is loosely based on the "},{"type":"reference","identifier":"https:\/\/readium.org\/webpub-manifest\/","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"holds the metadata of a publication, such as its author or table of contents,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"allows to read the contents of a publication, e.g. XHTML or audio resources,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"provides additional services, for example content extraction or text search."}]}]}]},{"level":4,"text":"Link","type":"heading","anchor":"Link"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","isActive":true},{"type":"text","text":" holds a pointer (URL) to a resource or service along with additional metadata, such as its media type or title."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" contains several "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" collections, for example:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"readingOrder"},{"type":"text","text":" lists the publication resources arranged in the order they should be read."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"resources"},{"type":"text","text":" contains secondary resources necessary for rendering the "},{"type":"codeVoice","code":"readingOrder"},{"type":"text","text":", such as an image or a font file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"tableOfContents"},{"type":"text","text":" represents the table of contents as a tree of "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" objects."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"links"},{"type":"text","text":" exposes additional resources, such as a canonical link to the manifest or a search web service."}]}]}]},{"level":4,"text":"Locator","type":"heading","anchor":"Locator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","isActive":true},{"type":"text","text":" represents a precise location in a publication resource in a format that can be stored and shared across reading systems. It is more accurate than a "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" and contains additional information about the location, e.g. progression percentage, position or textual context."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Locator"},{"type":"text","text":" objects are used for various features, including:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reporting the current progression in the publication"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"saving bookmarks, highlights and annotations"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"navigating search results"}]}]}]},{"level":3,"text":"Data models","type":"heading","anchor":"Data-models"},{"level":4,"text":"Asset","type":"heading","anchor":"Asset"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" represents a single file or package and provides access to its content. There are two types of "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ContainerAsset"},{"type":"text","text":" for packages which contains several resources, such as a ZIP archive."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ResourceAsset"},{"type":"text","text":" for accessing a single resource, such as a JSON or PDF file."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Asset"},{"type":"text","text":" instances are obtained through an "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the "},{"type":"codeVoice","code":"asset.format"},{"type":"text","text":" to identify the media type and capabilities of the asset."}]},{"type":"codeListing","syntax":"swift","code":["if asset.format.conformsTo(.lcp) {","    \/\/ The asset is protected with LCP.","}","if asset.format.conformsTo(.epub) {","    \/\/ The asset represents an EPUB publication.","}"]},{"type":"heading","level":4,"anchor":"Resource","text":"Resource"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Resource"},{"type":"text","text":" provides read access to a single resource, such as a file or an entry in an archive."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Resource"},{"type":"text","text":" instances are usually created by a "},{"type":"codeVoice","code":"ResourceFactory"},{"text":". The toolkit ships with various implementations supporting different data access protocols such as local files or HTTP.","type":"text"}]},{"level":4,"anchor":"Container","text":"Container","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" provides read access to a collection of resources. ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" instances representing an archive are usually created by an ","type":"text"},{"code":"ArchiveOpener","type":"codeVoice"},{"text":". The toolkit ships with a ","type":"text"},{"type":"codeVoice","code":"ZIPArchiveOpener"},{"text":" supporting both local and remote (HTTP) ZIP files.","type":"text"}]},{"inlineContent":[{"code":"Publication","type":"codeVoice"},{"type":"text","text":" objects internally use a "},{"code":"Container","type":"codeVoice"},{"type":"text","text":" to expose its content."}],"type":"paragraph"},{"text":"Opening a publication (ReadiumStreamer)","level":2,"anchor":"Opening-a-publication-ReadiumStreamer","type":"heading"},{"inlineContent":[{"type":"text","text":"To retrieve a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":" object from a publication file like an EPUB or audiobook, you can use an "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    )",")","","let url: URL = URL(...)","","\/\/ Retrieve an `Asset` to access the file content.","switch await assetRetriever.retrieve(url: url.anyURL.absoluteURL!) {","case .success(let asset):","    \/\/ Open a `Publication` from the `Asset`.","    switch await publicationOpener.open(asset: asset, allowUserInteraction: true) {","    case .success(let publication):","        print(\"Opened \\(publication.metadata.title)\")","","    case .failure(let error):","        \/\/ Failed to access or parse the publication","    }","","case .failure(let error):","    \/\/ Failed to retrieve the asset","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"code":"allowUserInteraction","type":"codeVoice"},{"type":"text","text":" parameter is useful when supporting a DRM like Readium LCP. It indicates if the toolkit can prompt the user for credentials when the publication is protected."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"overridingTitle":"See the dedicated user guide for more information","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"See the dedicated user guide for more information"}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Accessing the metadata of a publication","level":2,"anchor":"Accessing-the-metadata-of-a-publication","type":"heading"},{"inlineContent":[{"type":"text","text":"After opening a publication, you may want to read its metadata to insert a new entity into your bookshelf database, for instance. The "},{"code":"publication.metadata","type":"codeVoice"},{"type":"text","text":" object contains everything you need, including "},{"code":"title","type":"codeVoice"},{"type":"text","text":", "},{"code":"authors","type":"codeVoice"},{"type":"text","text":" and the "},{"code":"published","type":"codeVoice"},{"type":"text","text":" date."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can retrieve the publication cover using "},{"code":"await publication.cover()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Rendering the publication on the screen (ReadiumNavigator)","level":2,"anchor":"Rendering-the-publication-on-the-screen-ReadiumNavigator","type":"heading"},{"inlineContent":[{"type":"text","text":"You can use a Readium navigator to present the publication to the user. The "},{"code":"Navigator","type":"codeVoice"},{"type":"text","text":" renders resources on the screen and offers APIs and user interactions for navigating the contents."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Please refer to the "},{"isActive":true,"overridingTitle":"Navigator guide","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Navigator guide"}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Navigator"},{"type":"text","text":" for more information."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/readium\/getting-started"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Timeline","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"anchor":"Guides","generated":true}],"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"metadata":{"title":"Getting started","role":"article","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"references":{"doc://Readium/documentation/Readium/TTS":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","title":"Text-to-speech","abstract":[],"url":"\/documentation\/readium\/tts","kind":"article","role":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"kind":"article","title":"Migration Guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","url":"\/documentation\/readium\/migration-guide","type":"topic","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}]},"https://readium.org/webpub-manifest/#24-the-link-object":{"type":"link","identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","title":"Link object","titleInlineContent":[{"code":"Link","type":"codeVoice"},{"text":" object","type":"text"}],"url":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object"},"doc://Readium/documentation/Readium/Navigator":{"url":"\/documentation\/readium\/navigator","identifier":"doc:\/\/Readium\/documentation\/Readium\/Navigator","abstract":[{"type":"text","text":"You can use a Readium Navigator to present the publication to the user. The "},{"type":"codeVoice","code":"Navigator"},{"type":"text","text":" renders resources on the screen and offers APIs and user interactions for navigating the contents."}],"type":"topic","role":"article","kind":"article","title":"Navigator"},"doc://Readium/documentation/Readium/Timeline":{"title":"Timeline","url":"\/documentation\/readium\/timeline","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Timeline","type":"topic","abstract":[{"type":"text","text":"The Timeline API lays out the table of contents of a publication on its reading order. It answers questions such as “which chapter am I in?”, “what is the next chapter?” or “how much is left in this chapter?”. Use it to show where each chapter starts in a table of contents, to display the current chapter in a running header, to step through the chapters of a publication, or to pause the playback at the end of an audiobook chapter."}],"kind":"article"},"doc://Readium/documentation/Readium/Search":{"title":"Searching a publication","url":"\/documentation\/readium\/search","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","type":"topic","abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"kind":"article"},"doc://Readium/documentation/Readium/Accessibility":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","title":"Accessibility","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference","isActive":true},{"type":"text","text":" specification."}],"url":"\/documentation\/readium\/accessibility","kind":"article","role":"article"},"doc://Readium/documentation/Readium/Content":{"title":"Extracting the content of a publication","url":"\/documentation\/readium\/content","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","type":"topic","abstract":[],"kind":"article"},"doc://Readium/documentation/Readium/Open-Publication":{"title":"Opening a publication","url":"\/documentation\/readium\/open-publication","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","type":"topic","abstract":[{"text":"To open a publication with Readium, you need to instantiate a couple of components: an ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":".","type":"text"}],"kind":"article"},"https://opds.io":{"url":"https:\/\/opds.io","titleInlineContent":[{"text":"OPDS catalog feeds","type":"text"}],"type":"link","title":"OPDS catalog feeds","identifier":"https:\/\/opds.io"},"doc://Readium/documentation/Readium/Readium-LCP":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","title":"Supporting Readium LCP","url":"\/documentation\/readium\/readium-lcp","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"isActive":true,"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},{"type":"text","text":" DRM."}],"type":"topic","kind":"article","role":"article"},"doc://Readium/documentation/Readium":{"url":"\/documentation\/readium","identifier":"doc:\/\/Readium\/documentation\/Readium","abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"type":"topic","role":"collection","kind":"article","title":"Readium"},"https://readium.org/architecture/models/locators/":{"type":"link","identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","title":"Locator object","titleInlineContent":[{"code":"Locator","type":"codeVoice"},{"text":" object","type":"text"}],"url":"https:\/\/readium.org\/architecture\/models\/locators\/"},"https://www.edrlab.org/readium-lcp/":{"url":"https:\/\/www.edrlab.org\/readium-lcp\/","titleInlineContent":[{"text":"Readium LCP","type":"text"}],"type":"link","title":"Readium LCP","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},"doc://Readium/documentation/Readium/NavigatorOverview":{"url":"\/documentation\/readium\/navigatoroverview","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}],"type":"topic","role":"article","kind":"article","title":"Navigator Overview"},"https://readium.org/webpub-manifest/":{"url":"https:\/\/readium.org\/webpub-manifest\/","titleInlineContent":[{"text":"Readium Web Publication Manifest","type":"text"}],"type":"link","title":"Readium Web Publication Manifest","identifier":"https:\/\/readium.org\/webpub-manifest\/"},"https://www.w3.org/TR/epub-a11y-11":{"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","titleInlineContent":[{"text":"EPUB Accessibility","type":"text"}],"type":"link","title":"EPUB Accessibility","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"}}}