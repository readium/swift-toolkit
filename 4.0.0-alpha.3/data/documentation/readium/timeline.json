Readium\/documentation\/Readium\/Accessibility","title":"Accessibility","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference","isActive":true},{"type":"text","text":" specification."}],"url":"\/documentation\/readium\/accessibility","kind":"article","role":"article"},"doc://Readium/documentation/Readium/Content":{"title":"Extracting the content of a publication","url":"\/documentation\/readium\/content","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","type":"topic","abstract":[],"kind":"article"},"timeline-epub-positions.svg":{"type":"image","identifier":"timeline-epub-positions.svg","alt":"The five resources of the EPUB laid end to end on a line of 40 positions: preface.xhtml from position 1, chapter1.xhtml from 6, chapter2.xhtml from 14, chapter2-part2.xhtml from 26 and chapter3.xhtml from 33, with a position at 20, halfway through chapter2.xhtml","variants":[{"url":"\/images\/Readium\/timeline-epub-positions.svg","svgID":"timeline-epub-positions","traits":["1x","light"]},{"traits":["1x","dark"],"svgID":"timeline-epub-positions-dark","url":"\/images\/Readium\/timeline-epub-positions~dark.svg"}]},"doc://Readium/documentation/Readium/Open-Publication":{"title":"Opening a publication","url":"\/documentation\/readium\/open-publication","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","type":"topic","abstract":[{"text":"To open a publication with Readium, you need to instantiate a couple of components: an ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":".","type":"text"}],"kind":"article"},"timeline-segments.svg":{"type":"image","identifier":"timeline-segments.svg","alt":"The segments of the audiobook. With all the depths: no entry in intro.mp3, no entry at the start of track1.mp3, then Part I, Chapter 1, Chapter 2, Scene 2.1, Part II and Chapter 3. With a maximum depth of 1: the same two segments without entry, then Part I and Part II","variants":[{"traits":["1x","light"],"url":"\/images\/Readium\/timeline-segments.svg","svgID":"timeline-segments"},{"traits":["1x","dark"],"svgID":"timeline-segments-dark","url":"\/images\/Readium\/timeline-segments~dark.svg"}]},"timeline-toc-tree.svg":{"variants":[{"url":"\/images\/Readium\/timeline-toc-tree.svg","svgID":"timeline-toc-tree","traits":["1x","light"]},{"traits":["1x","dark"],"url":"\/images\/Readium\/timeline-toc-tree~dark.svg","svgID":"timeline-toc-tree-dark"}],"type":"image","alt":"The table of contents tree, then the same entries flattened in pre-order with their depth and start: Part I, Chapter 1, Chapter 2, Scene 2.1, Part II, Chapter 3, and Bonus which is not placed","identifier":"timeline-toc-tree.svg"},"#entries-of-an-epub":{"url":"#entries-of-an-epub","titleInlineContent":[{"type":"text","text":"Limitations"}],"type":"link","title":"Limitations","identifier":"#entries-of-an-epub"},"doc://Readium/documentation/Readium/Readium-LCP":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","title":"Supporting Readium LCP","url":"\/documentation\/readium\/readium-lcp","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"isActive":true,"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},{"type":"text","text":" DRM."}],"type":"topic","kind":"article","role":"article"},"doc://Readium/documentation/Readium":{"url":"\/documentation\/readium","identifier":"doc:\/\/Readium\/documentation\/Readium","abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"type":"topic","role":"collection","kind":"article","title":"Readium"},"timeline-toc-ranges.svg":