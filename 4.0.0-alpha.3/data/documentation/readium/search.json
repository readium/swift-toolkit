{"kind":"article","sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Checking-if-a-publication-is-searchable","text":"Checking if a publication is searchable"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not every publication has a search service attached. Check "},{"inlineContent":[{"code":"isSearchable","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" before offering a search UI."}]},{"type":"codeListing","syntax":"swift","code":["guard publication.isSearchable else {","    \/\/ Hide or disable the search UI.","    return","}"]},{"type":"heading","level":2,"anchor":"Performing-a-search","text":"Performing a search"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"inlineContent":[{"code":"publication.search(query:options:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" to start a new search. This method returns a "},{"inlineContent":[{"code":"SearchResult<SearchIterator>","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — either a cursor to page through results, or a "},{"inlineContent":[{"code":"SearchError","type":"codeVoice"}],"type":"strong"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let result = await publication.search(query: \"red panda\")","","switch result {","case .success(let iterator):","    \/\/ Use the iterator to page through results.","case .failure(let error):","    handleSearchError(error)","}"]},{"type":"heading","level":2,"anchor":"Iterating-through-results","text":"Iterating through results"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"code":"SearchIterator","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" is a cursor that fetches results one page at a time. Each page is a "},{"inlineContent":[{"code":"LocatorCollection","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" containing an array of "},{"inlineContent":[{"code":"Locator","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" values, one per match."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"inlineContent":[{"code":"iterator.next()","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" to retrieve the next page. It returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" on success when all results have been exhausted, or "},{"type":"codeVoice","code":".failure"},{"type":"text","text":" if a read error occurs."}]},{"type":"codeListing","syntax":"swift","code":["while let page = try await iterator.next().get() {","    for locator in page.locators {","        print(\"Found result at: \\(locator.href)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To navigate directly to a result, pass the locator to the Navigator:"}]},{"type":"codeListing","syntax":"swift","code":["await navigator.go(to: locator)"]},{"type":"heading","level":3,"anchor":"Pagination-strategies","text":"Pagination strategies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Results may arrive in pages to progressively load results. In practice there are two common approaches:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Background load:"}]},{"text":" start a ","type":"text"},{"type":"codeVoice","code":"Task"},{"text":" that accumulates every result progressively. Simple to implement; the full list updates every time a new page is fetched.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"On-scroll load:"}]},{"text":" hold onto the iterator and call ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" only when the user scrolls to the bottom of the current batch. This keeps memory and CPU usage low, at the cost of slightly more state management.","type":"text"}]}]}]},{"type":"heading","level":3,"anchor":"Grouping-results-by-section","text":"Grouping results by section"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"locator.title","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" is the title of the table of contents entry that contains the match — for example, a chapter or section title. Use it to group consecutive results that fall within the same entry:"}]},{"type":"codeListing","syntax":"swift","code":["var sections: [(title: String?, locators: [Locator])] = []","for locator in page.locators {","    if locator.title == sections.last?.title {","        sections[sections.count - 1].locators.append(locator)","    } else {","        sections.append((title: locator.title, locators: [locator]))","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This preserves order and keeps sections with the same title distinct when they are not consecutive."}]},{"type":"heading","level":3,"anchor":"Displaying-a-result-snippet","text":"Displaying a result snippet"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"locator.text","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" contains the matched text and its surrounding context:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"highlight"},{"text":" — the exact string that matched the query.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"before"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"after"},{"text":" — a short snippet of text on either side of the match.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here is a SwiftUI view that renders a single result with the matched text in bold:"}]},{"type":"codeListing","syntax":"swift","code":["struct SearchResultRow: View {","    let locator: Locator","","    var body: some View {","        Text(snippet)","    }","","    private var snippet: AttributedString {","        var result = AttributedString()","        if let before = locator.text?.before {","            result += AttributedString(before)","        }","        if let highlight = locator.text?.highlight {","            var bold = AttributedString(highlight)","            bold.font = .body.bold()","            result += bold","        }","        if let after = locator.text?.after {","            result += AttributedString(after)","        }","        return result","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In a real UI you will typically want to truncate "},{"type":"codeVoice","code":"before"},{"type":"text","text":" and "},{"type":"codeVoice","code":"after"},{"type":"text","text":" so the UI stays compact."}]},{"type":"heading","level":2,"anchor":"Search-options","text":"Search options"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass a "},{"inlineContent":[{"code":"SearchOptions","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" value to "},{"type":"codeVoice","code":"search(query:options:)"},{"type":"text","text":" to override the defaults. Any option you leave as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" falls back to the default behavior."}]},{"type":"codeListing","syntax":"swift","code":["let result = await publication.search(","    query: \"Red Panda\",","    options: SearchOptions(","        caseSensitive: true,","        diacriticSensitive: false","    )",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The full set of available options:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Option"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Built-in"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"caseSensitive","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", the search distinguishes upper- and lower-case letters."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"diacriticSensitive","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", accented and unaccented letters are treated as distinct."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"wholeWord","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", only complete words are matched, not substrings."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"exact","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", the query is matched exactly, including stop words and word order."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"language","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Language?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Overrides the publication’s language for this search."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"regularExpression","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", the query is interpreted as a regular expression."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"otherOptions","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"[String: String]","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"–"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Custom options specific to the search service implementation."}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"type":"text","text":"Built-in"}],"type":"strong"},{"type":"text","text":" column indicates whether the default Readium configuration handles the option. Options marked "},{"inlineContent":[{"type":"text","text":"No"}],"type":"strong"},{"type":"text","text":" are silently ignored unless you provide a custom algorithm that implements them."}]},{"type":"heading","level":3,"anchor":"Supported-options","text":"Supported options"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before displaying search-option controls – e.g. a case sensitivity toggle, or regex mode – inspect "},{"inlineContent":[{"code":"publication.searchOptions","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" to learn which options the service actually supports. An option whose value is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" is "},{"inlineContent":[{"type":"text","text":"not supported"}],"type":"strong"},{"type":"text","text":" by the current service; do not show it in the UI. The actual value indicates the default behavior when the option is not overridden."}]},{"type":"codeListing","syntax":"swift","code":["let options = publication.searchOptions","","\/\/ Only show the case-sensitivity toggle if the service supports it.","if let caseSensitive = options.caseSensitive {","    showCaseSensitiveToggle(defaultValue: caseSensitive)","}"]},{"type":"heading","level":2,"anchor":"Error-handling","text":"Error handling"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"SearchError","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" describes what can go wrong:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".publicationNotSearchable"}]},{"text":" – The publication has no search service. Guard on ","type":"text"},{"type":"codeVoice","code":"isSearchable"},{"text":" first.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".badQuery(Error)"}]},{"text":" – The query string is invalid. Not all implementations produce this; custom services may use it to signal a malformed query (for example, an invalid regular expression).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".reading(ReadError)"}]},{"text":" – An I\/O error occurred while reading a resource.","type":"text"}]}]}]},{"type":"codeListing","syntax":"swift","code":["switch searchError {","case .publicationNotSearchable:","    break \/\/ Should not happen if you check isSearchable first.","case .badQuery(let error):","    showAlert(\"Invalid query\")","case .reading(let error):","    showAlert(\"Failed to read the publication resources\")","}"]},{"type":"heading","level":2,"anchor":"Advanced-customization","text":"Advanced customization"},{"type":"heading","level":3,"anchor":"Configuring-the-search-service","text":"Configuring the search service"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default parsers automatically register "},{"inlineContent":[{"code":"ContentSearchService","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" for EPUB and PDF publications, which relies on the "},{"overridingTitleInlineContent":[{"type":"text","text":"Content API"}],"isActive":true,"type":"reference","overridingTitle":"Content API","identifier":"doc:\/\/Readium\/documentation\/Readium\/Content"},{"type":"text","text":" to inspect the publication content. You do not need to do anything for the default behavior."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To customize the default service — for example, to adjust the snippet length or plug in a different search algorithm — override it in the "},{"type":"codeVoice","code":"onCreatePublication"},{"type":"text","text":" callback when opening a publication:"}]},{"type":"codeListing","syntax":"swift","code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    onCreatePublication: { _, _, services in","        services.setSearchServiceFactory(","            ContentSearchService.makeFactory(","                snippetLength: 300,","                searchAlgorithm: BasicStringSearchAlgorithm()","            )","        )","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"snippetLength"},{"type":"text","text":" parameter controls how many characters of context are included in the "},{"type":"codeVoice","code":"before"},{"type":"text","text":" and "},{"type":"codeVoice","code":"after"},{"type":"text","text":" text of each result’s "},{"inlineContent":[{"type":"codeVoice","code":"Locator.Text"}],"type":"strong"},{"type":"text","text":"."}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"ContentSearchService"},{"type":"text","text":" depends on a "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":" being registered for the publication. This is set up automatically by the default parsers."}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"heading","level":3,"anchor":"Implementing-a-custom-search-algorithm","text":"Implementing a custom search algorithm"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The actual text-matching logic is separated into the "},{"inlineContent":[{"type":"codeVoice","code":"StringSearchAlgorithm"}],"type":"strong"},{"type":"text","text":" protocol. You can swap it out without changing anything else about the service."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"BasicStringSearchAlgorithm"}],"type":"strong"},{"type":"text","text":" is the built-in implementation. It uses the native "},{"type":"codeVoice","code":"String.range(of:options:)"},{"type":"text","text":" APIs and supports "},{"type":"codeVoice","code":"caseSensitive"},{"type":"text","text":", "},{"type":"codeVoice","code":"diacriticSensitive"},{"type":"text","text":", "},{"type":"codeVoice","code":"exact"},{"type":"text","text":", and "},{"type":"codeVoice","code":"regularExpression"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use a custom algorithm, pass it to "},{"code":"ContentSearchService.makeFactory","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["ContentSearchService.makeFactory(searchAlgorithm: MyFuzzySearchAlgorithm())"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/readium\/search"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Timeline","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"anchor":"Guides","title":"Guides"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Search"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"metadata":{"roleHeading":"Article","role":"article","title":"Searching a publication"},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"references":{"doc://Readium/documentation/Readium/Readium-LCP":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","title":"Supporting Readium LCP","url":"\/documentation\/readium\/readium-lcp","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"isActive":true,"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},{"type":"text","text":" DRM."}],"type":"topic","kind":"article","role":"article"},"doc://Readium/documentation/Readium/TTS":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","title":"Text-to-speech","abstract":[],"url":"\/documentation\/readium\/tts","kind":"article","role":"article"},"doc://Readium/documentation/Readium":{"url":"\/documentation\/readium","identifier":"doc:\/\/Readium\/documentation\/Readium","abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"type":"topic","role":"collection","kind":"article","title":"Readium"},"doc://Readium/documentation/Readium/Content":{"title":"Extracting the content of a publication","url":"\/documentation\/readium\/content","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","type":"topic","abstract":[],"kind":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"kind":"article","title":"Migration Guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","url":"\/documentation\/readium\/migration-guide","type":"topic","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}]},"doc://Readium/documentation/Readium/Getting-Started":{"title":"Getting started","url":"\/documentation\/readium\/getting-started","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","type":"topic","abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"kind":"article"},"doc://Readium/documentation/Readium/NavigatorOverview":{"url":"\/documentation\/readium\/navigatoroverview","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}],"type":"topic","role":"article","kind":"article","title":"Navigator Overview"},"https://www.w3.org/TR/epub-a11y-11":{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility","type":"link","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}]},"doc://Readium/documentation/Readium/Open-Publication":{"title":"Opening a publication","url":"\/documentation\/readium\/open-publication","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","type":"topic","abstract":[{"text":"To open a publication with Readium, you need to instantiate a couple of components: an ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":".","type":"text"}],"kind":"article"},"doc://Readium/documentation/Readium/Accessibility":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","title":"Accessibility","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference","isActive":true},{"type":"text","text":" specification."}],"url":"\/documentation\/readium\/accessibility","kind":"article","role":"article"},"doc://Readium/documentation/Readium/Timeline":{"title":"Timeline","url":"\/documentation\/readium\/timeline","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Timeline","type":"topic","abstract":[{"type":"text","text":"The Timeline API lays out the table of contents of a publication on its reading order. It answers questions such as “which chapter am I in?”, “what is the next chapter?” or “how much is left in this chapter?”. Use it to show where each chapter starts in a table of contents, to display the current chapter in a running header, to step through the chapters of a publication, or to pause the playback at the end of an audiobook chapter."}],"kind":"article"},"https://www.edrlab.org/readium-lcp/":{"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","title":"Readium LCP","type":"link","url":"https:\/\/www.edrlab.org\/readium-lcp\/","titleInlineContent":[{"type":"text","text":"Readium LCP"}]}}}