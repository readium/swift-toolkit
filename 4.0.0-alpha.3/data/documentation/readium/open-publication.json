{"sections":[],"kind":"article","primaryContentSections":[{"content":[{"level":2,"anchor":"AssetRetriever","text":"AssetRetriever","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" grants access to the content of an asset located at a given URL, such as a publication package, manifest, or LCP license."}],"type":"paragraph"},{"level":3,"anchor":"Constructing-an-AssetRetriever","text":"Constructing an AssetRetriever","type":"heading"},{"inlineContent":[{"type":"text","text":"You can create an instance of "},{"type":"codeVoice","code":"AssetRetriever"},{"text":" with:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"HTTPClient"},{"type":"text","text":" to enable the toolkit to perform HTTP requests and support the "},{"type":"codeVoice","code":"http"},{"type":"text","text":" and "},{"type":"codeVoice","code":"https"},{"type":"text","text":" URL schemes. You can use "},{"type":"codeVoice","code":"DefaultHTTPClient"},{"type":"text","text":" which provides callbacks for handling authentication when needed."}]}]}],"type":"unorderedList"},{"code":["let assetRetriever = AssetRetriever(httpClient: DefaultHTTPClient())"],"syntax":"swift","type":"codeListing"},{"text":"Retrieving an Asset","level":3,"anchor":"Retrieving-an-Asset","type":"heading"},{"inlineContent":[{"type":"text","text":"With your fresh instance of "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":", you can open an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" from any "},{"type":"codeVoice","code":"AbsoluteURL"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ From a local file.","let url = FileURL(string: \"file:\/\/\/path\/to\/book.epub\")","\/\/ or from an HTTP URL.","let url = HTTPURL(string: \"https:\/\/domain\/book.epub\")","","switch await assetRetriever.retrieve(url: url) {","    case .success(let asset):","        ...","    case .failure(let error):","        \/\/ Failed to retrieve the asset.","}"],"syntax":"swift","type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Assets created with an HTTP URL are not downloaded; they will be streamed. If that is not your intention, you need to download the file first, for example using "},{"type":"codeVoice","code":"HTTPClient.download()"},{"type":"text","text":"."}]}],"name":"Important","style":"important","type":"aside"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" will sniff the media type of the asset, which you can store in your bookshelf database to speed up the process next time you retrieve the "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":". This will improve performance, especially with HTTP URL schemes."}],"type":"paragraph"},{"code":["let mediaType = asset.format.mediaType","","\/\/ Speed up the retrieval with a known media type.","let result = await assetRetriever.retrieve(url: url, mediaType: mediaType)"],"syntax":"swift","type":"codeListing"},{"text":"PublicationOpener","level":2,"anchor":"PublicationOpener","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" builds a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" object from an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" using:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"PublicationParser"},{"text":" to parse the asset structure and publication metadata.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"DefaultPublicationParser","type":"codeVoice"},{"text":" handles all the formats supported by Readium out of the box.","type":"text"}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An optional list of ","type":"text"},{"type":"codeVoice","code":"ContentProtection"},{"text":" to decrypt DRM-protected publications.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If you support Readium LCP, you can get one from the ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":".","type":"text"}]}]}]}]}],"type":"unorderedList"},{"code":["let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP#Opening-a-publication-protected-with-LCP","overridingTitle":"See the Readium LCP guide","overridingTitleInlineContent":[{"type":"text","text":"See the Readium LCP guide"}]},{"type":"text","text":" to learn how to create the "},{"type":"codeVoice","code":"LCPAuthenticating"},{"type":"text","text":" instance."}],"type":"paragraph"},{"text":"Opening a Publication","level":3,"anchor":"Opening-a-Publication","type":"heading"},{"inlineContent":[{"type":"text","text":"Now that you have a "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" ready, you can use it to create a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" from an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" that was previously obtained using the "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" parameter is useful when supporting Readium LCP. When enabled and using a "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":", the toolkit will prompt the user if the passphrase is missing."}],"type":"paragraph"},{"code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true",")"],"syntax":"swift","type":"codeListing"},{"text":"Supporting additional formats or URL schemes","level":2,"anchor":"Supporting-additional-formats-or-URL-schemes","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"DefaultPublicationParser"},{"type":"text","text":" accepts additional parsers. You also have the option to use your own parser list by using "},{"type":"codeVoice","code":"CompositePublicationParser"},{"type":"text","text":" or create your own "},{"type":"codeVoice","code":"PublicationParser"},{"type":"text","text":" for a fully customized parsing resolution strategy."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" offers an additional constructor that provides greater extensibility options, using:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ResourceFactory"},{"text":" which handles the URL schemes through which you can access content.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ArchiveOpener"},{"text":" which determines the types of archives (ZIP, RAR, etc.) that can be opened by the ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FormatSniffer"},{"text":" which identifies the file formats that ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" can recognize.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"You can use either the default implementations or implement your own for each of these components using the composite pattern. The toolkit’s "},{"type":"codeVoice","code":"CompositeResourceFactory"},{"type":"text","text":", "},{"type":"codeVoice","code":"CompositeArchiveOpener"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CompositeFormatSniffer"},{"type":"text","text":" provide a simple resolution strategy."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/readium\/open-publication"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Guides","generated":true,"anchor":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Timeline","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"code":"AssetRetriever","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"roleHeading":"Article","role":"article","title":"Opening a publication"},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"references":{"doc://Readium/documentation/Readium/Readium-LCP#Opening-a-publication-protected-with-LCP":{"type":"topic","kind":"section","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP#Opening-a-publication-protected-with-LCP","title":"Opening a publication protected with LCP","abstract":[],"url":"\/documentation\/readium\/readium-lcp#Opening-a-publication-protected-with-LCP"},"doc://Readium/documentation/Readium/TTS":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","title":"Text-to-speech","abstract":[],"url":"\/documentation\/readium\/tts","kind":"article","role":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"kind":"article","title":"Migration Guide","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","url":"\/documentation\/readium\/migration-guide","type":"topic","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}]},"doc://Readium/documentation/Readium/Getting-Started":{"title":"Getting started","url":"\/documentation\/readium\/getting-started","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","type":"topic","abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"kind":"article"},"doc://Readium/documentation/Readium/Timeline":{"title":"Timeline","url":"\/documentation\/readium\/timeline","role":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Timeline","type":"topic","abstract":[{"type":"text","text":"The Timeline API lays out the table of contents of a publication on its reading order. It answers questions such as “which chapter am I in?”, “what is the next chapter?” or “how much is left in this chapter?”. Use it to show where each chapter starts in a table of contents, to display the current chapter in a running header, to step through the chapters of a publication, or to pause the playback at the end of an audiobook chapter."}],"kind":"article"},"doc://Readium/documentation/Readium/Searc