{"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference","isActive":true},{"type":"text","text":" DRM."}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"metadata":{"roleHeading":"Article","title":"Supporting Readium LCP","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"To use LCP with the Readium toolkit, you must first obtain the "},{"type":"codeVoice","code":"R2LCPClient"},{"type":"text","text":" private library by contacting "},{"type":"reference","identifier":"https:\/\/www.edrlab.org\/contact\/","isActive":true},{"type":"text","text":"."}]}],"name":"Important"},{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An LCP publication is protected with a "},{"type":"emphasis","inlineContent":[{"text":"user passphrase","type":"text"}]},{"type":"text","text":" and distributed using an LCP License Document ("},{"code":".lcpl","type":"codeVoice"},{"type":"text","text":") ."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The user flow typically goes as follows:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user imports a "},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":" file into your application."}]}]},{"content":[{"inlineContent":[{"text":"The application uses the Readium toolkit to download the protected publication from the ","type":"text"},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":" file to the user’s bookshelf. The downloaded file can be a "},{"type":"codeVoice","code":".epub"},{"type":"text","text":", "},{"type":"codeVoice","code":".lcpdf"},{"type":"text","text":" (PDF), or "},{"type":"codeVoice","code":".lcpa"},{"type":"text","text":" (audiobook) package."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The user opens the protected publication from the bookshelf."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If the passphrase isn’t already recorded in the "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" internal database, the user will be asked to enter it to unlock the contents."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The publication is decrypted and rendered on the screen."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Setup","text":"Setup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support LCP in your application, you require two components:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" package from the toolkit provides APIs for downloading and decrypting protected publications. Import it as you would any other Readium package, such as "},{"type":"codeVoice","code":"R2Navigator"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The private "},{"type":"codeVoice","code":"R2LCPClient"},{"type":"text","text":" library customized for your application "},{"overridingTitleInlineContent":[{"type":"text","text":"is available from EDRLab"}],"isActive":true,"type":"reference","overridingTitle":"is available from EDRLab","identifier":"https:\/\/www.edrlab.org\/contact\/"},{"type":"text","text":". They will provide instructions for integrating the "},{"type":"codeVoice","code":"R2LCPClient"},{"type":"text","text":" framework into your application."}],"type":"paragraph"}]}]},{"type":"heading","level":3,"anchor":"File-formats","text":"File formats"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Readium LCP specifies new file formats."}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Name"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"File extension"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Media type"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance"}]}],[{"inlineContent":[{"code":".lcpl","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"application\/vnd.readium.lcp.license.v1.0+json","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html"}],"type":"paragraph"}],[{"inlineContent":[{"code":".lcpdf","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"application\/pdf+lcp","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-audiobooks.html"}],"type":"paragraph"}],[{"inlineContent":[{"code":".lcpa","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"application\/audiobook+lcp","type":"codeVoice"}],"type":"paragraph"}]]]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"EPUB files protected by LCP are supported without a special file extension or media type because EPUB accommodates any DRM scheme in its specification."}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support these formats in your application, you need to "},{"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/defining_file_and_data_types_for_your_app","type":"reference","isActive":true},{"type":"text","text":" as imported types."}]},{"type":"codeListing","syntax":"xml","code":["<dict>","    <key>UTImportedTypeDeclarations<\/key>","    <array>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpl<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.json<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP License Document<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpl<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/vnd.readium.lcp.license.v1.0+json<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpdf<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for PDF package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpdf<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/pdf+lcp<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpa<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpa<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/audiobook+lcp<\/string>","            <\/dict>","        <\/dict>","    <\/array>","<\/dict>"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Next, declare the imported types as "},{"identifier":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd","type":"reference","isActive":true},{"type":"text","text":" in the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" to have your application listed in the “Open with…” dialogs."}]},{"type":"codeListing","syntax":"xml","code":["<dict>","    <key>CFBundleDocumentTypes<\/key>","    <array>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP License Document<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpl<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for PDF package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpdf<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpa<\/string>","            <\/array>","        <\/dict>","    <\/array>","<\/dict>"]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"If EPUB is not included in your document types, now is a good time to add it."}],"type":"paragraph"}],"style":"tip","name":"Tip"},{"type":"heading","level":3,"anchor":"Allow-insecure-HTTP-requests","text":"Allow insecure HTTP requests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A file required by the LCP library needs to be downloaded from an insecure HTTP location. You must authorize this download by adding the following to your "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" file:"}]},{"type":"codeListing","syntax":"xml","code":["<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSExceptionDomains<\/key>","    <dict>","        <key>crl.edrlab.telesec.de<\/key>","        <dict>","            <key>NSExceptionAllowsInsecureHTTPLoads<\/key>","            <true\/>","        <\/dict>","    <\/dict>","<\/dict>"]},{"type":"heading","level":3,"anchor":"Device-name-for-LCP-registration","text":"Device name for LCP registration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When registering a license with an LSD server, Readium LCP identifies the device by name using "},{"type":"codeVoice","code":"UIDevice.current.name"},{"type":"text","text":". Since iOS 16, this returns a generic string such as “iPhone” instead of the user-assigned device name."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To obtain the actual device name, add the "},{"identifier":"https:\/\/developer.apple.com\/documentation\/bundleresources\/entitlements\/com_apple_developer_device-information_user-assigned-device-name","type":"reference","isActive":true},{"type":"text","text":" entitlement to your app’s "},{"type":"codeVoice","code":".entitlements"},{"type":"text","text":" file. This entitlement requires approval from Apple."}]},{"type":"codeListing","syntax":"xml","code":["<key>com.apple.developer.device-information.user-assigned-device-name<\/key>","<true\/>"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternatively, you can supply your own device name when initializing "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" via the "},{"type":"codeVoice","code":"deviceName"},{"type":"text","text":" parameter."}]},{"type":"heading","level":2,"anchor":"Initializing-the-LCPService","text":"Initializing the LCPService"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" offers an "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" object that exposes its API. Since the "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" package is not linked with "},{"type":"codeVoice","code":"R2LCPClient"},{"type":"text","text":", you need to create your own adapter when setting up the "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" expects repositories to store the opened licenses and passphrases. "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" provides built-in Keychain-based implementations that store data securely in the iOS\/macOS Keychain. Unlike database-based storage, Keychain data persists across app reinstalls and can optionally be synchronized across the user’s devices via iCloud Keychain."}]},{"type":"codeListing","syntax":"swift","code":["@preconcurrency import R2LCPClient","import ReadiumLCP","","let httpClient = DefaultHTTPClient()","","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","","let lcpService = LCPService(","    client: LCPClientAdapter(),","    licenseRepository: LCPKeychainLicenseRepository(),","    passphraseRepository: LCPKeychainPassphraseRepository(),","    assetRetriever: assetRetriever,","    httpClient: httpClient",")","","\/\/\/ Facade to the private R2LCPClient.framework.","class LCPClientAdapter: ReadiumLCP.LCPClient {","    func createContext(jsonLicense: String, hashedPassphrase: LCPPassphraseHash, pemCrl: String) throws -> LCPClientContext {","        try R2LCPClient.createContext(jsonLicense: jsonLicense, hashedPassphrase: hashedPassphrase, pemCrl: pemCrl)","    }","","    func decrypt(data: Data, using context: LCPClientContext) -> Data? {","        R2LCPClient.decrypt(data: data, using: context as! DRMContext)","    }","","    func findOneValidPassphrase(jsonLicense: String, hashedPassphrases: [LCPPassphraseHash]) -> LCPPassphraseHash? {","        R2LCPClient.findOneValidPassphrase(jsonLicense: jsonLicense, hashedPassphrases: hashedPassphrases)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To disable iCloud synchronization, pass "},{"type":"codeVoice","code":"synchronizable: false"},{"type":"text","text":" when creating the repositories."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You may also implement your own persistence layer by conforming to "},{"type":"codeVoice","code":"LCPLicenseRepository"},{"type":"text","text":" and "},{"type":"codeVoice","code":"LCPPassphraseRepository"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Acquiring-a-publication-from-a-License-Document-LCPL","text":"Acquiring a publication from a License Document (LCPL)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Users need to import a License Document into your application to download the protected publication ("},{"type":"codeVoice","code":".epub"},{"type":"text","text":", "},{"type":"codeVoice","code":".lcpdf"},{"type":"text","text":", or "},{"type":"codeVoice","code":".lcpa"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" offers an API to retrieve the full publication from an LCPL on the filesystem."}]},{"type":"codeListing","syntax":"swift","code":["let result = await lcpService.acquirePublication(","    from: .file(lcplURL),","    onProgress: { progress in","        switch progress {","            case .indefinite:","                \/\/ Display an activity indicator.","            case .percent(let percent):","                \/\/ Display a progress bar with percent from 0 to 1.","        }","    }",")","","switch result {","case let .success(publication):","    \/\/ Import the `publication.localURL` file as any publication.","case let .failure(error):","    \/\/ Display the error message.","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After the download is completed, import the "},{"type":"codeVoice","code":"publication.localURL"},{"type":"text","text":" file into the bookshelf like any other publication file."}]},{"type":"heading","level":2,"anchor":"Opening-a-publication-protected-with-LCP","text":"Opening a publication protected with LCP"},{"type":"heading","level":3,"anchor":"Initializing-the-PublicationOpener","text":"Initializing the PublicationOpener"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A publication protected with LCP can be opened using the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" component, just like a non-protected publication. However, you must provide a "},{"identifier":"https:\/\/readium.org\/architecture\/proposals\/006-content-protection.html","type":"reference","isActive":true},{"type":"text","text":" implementation when initializing the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" to enable LCP. Luckily, "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" has you covered."}]},{"type":"codeListing","syntax":"swift","code":["let httpClient = DefaultHTTPClient()","","let dialogPresenter = LCPDialogPresenter()","let authentication = LCPDialogAuthentication(delegate: dialogPresenter)","","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: AssetRetriever(httpClient: httpClient),","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An LCP package is secured with a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"user passphrase"}]},{"type":"text","text":" for decrypting the content. The "},{"code":"LCPAuthenticating","type":"codeVoice"},{"type":"text","text":" protocol used by "},{"code":"LCPService.contentProtection(with:)","type":"codeVoice"},{"type":"text","text":" provides the passphrase when needed. You can use the default UIKit "},{"code":"LCPDialogAuthentication","type":"codeVoice"},{"type":"text","text":" which displays a pop-up to enter the passphrase, or implement your own method for passphrase retrieval. If your application is built using SwiftUI, "},{"isActive":true,"type":"reference","identifier":"#using-the-swiftui-lcp-authentication-dialog"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"code":"LCPDialogAuthentication","type":"codeVoice"},{"type":"text","text":" delegates the presentation of the dialog to an "},{"code":"LCPDialogAuthenticationDelegate","type":"codeVoice"},{"type":"text","text":", for example on the top-most view controller of your application. As the delegate is held weakly, you must retain it yourself for the lifetime of the authentication."}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","final class LCPDialogPresenter: LCPDialogAuthenticationDelegate {","    func lcpDialogAuthentication(","        _ authentication: LCPDialogAuthentication,","        present dialogViewController: UIViewController","    ) {","        \/\/ Present the dialog on your top-most view controller. It will","        \/\/ dismiss itself automatically once the user submits or cancels.","        hostViewController.present(dialogViewController, animated: true)","    }","}"]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user will be prompted once per passphrase since "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" stores known passphrases on the device."}]}],"style":"note","name":"Note"},{"type":"heading","level":3,"anchor":"Opening-the-publication","text":"Opening the publication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You are now ready to open the publication file with your "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":" instance."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Retrieve an `Asset` to access the file content.","let url = FileURL(path: \"\/path\/to\/lcp-protected-book.epub\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the `Asset`.","let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true",")","","switch result {","case .success(let publication):","    \/\/ Import or present the publication.","case .failure(let error):","    \/\/ Present the error.","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" argument is forwarded to the "},{"type":"codeVoice","code":"LCPAuthenticating"},{"type":"text","text":" implementation when the passphrase is unknown. "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" shows a pop-up only if "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When importing the publication to the bookshelf, set "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" as you don’t need the passphrase for accessing the publication metadata and cover. If you intend to present the publication using a Navigator, set "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" as decryption will be required."}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"To check if an asset is protected with LCP before opening it, you can use "},{"type":"codeVoice","code":"asset.format.conformsTo(.lcp)"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"tip","name":"Tip"},{"type":"heading","level":3,"anchor":"Using-the-opened-Publication","text":"Using the opened Publication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After obtaining a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance, you can access the publication’s metadata to import it into the user’s bookshelf. The user passphrase is not needed for reading the metadata or cover."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"However, if you want to display the publication with a Navigator, verify it is not restricted. It could be restricted if the user passphrase is unknown or if the license is no longer valid (e.g., expired loan, revoked purchase, etc.)."}]},{"type":"codeListing","syntax":"swift","code":["if publication.isRestricted {","    if let error = publication.protectionError as? LCPError {","        \/\/ The user is not allowed to open the publication. You should display the error.","    } else {","        \/\/ We don't have the user passphrase.","        \/\/ You may use `publication` to access its metadata, but not to render its content.","    }","} else {","    \/\/ The publication is not restricted, you may render it with a Navigator component.","}"]},{"type":"heading","level":2,"anchor":"Streaming-an-LCP-protected-package","text":"Streaming an LCP protected package"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the server hosting the LCP protected package supports the "},{"isActive":true,"type":"reference","identifier":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"https:\/\/httpwg.org\/specs\/rfc7233.html"},{"type":"text","text":", it is possible to stream directly an LCP protected publication from a License Document ("},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":") file, without downloading the whole publication first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Simply open the License Document directly using the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":". Make sure you provide an "},{"type":"codeVoice","code":"HTTPClient"},{"type":"text","text":" (or an "},{"type":"codeVoice","code":"HTTPResourceFactory"},{"type":"text","text":" for additional customization) to the "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(httpClient: httpClient)","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication(delegate: dialogPresenter)),","    ]",")","","\/\/ Retrieve an `Asset` to access the LCPL content.","let url = FileURL(path: \"\/path\/to\/license.lcpl\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the LCPL `Asset`.","let publication = try await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true",").get()","    ","print(\"Opened \\(publication.metadata.title)\")"]},{"type":"heading","level":2,"anchor":"Obtaining-information-on-an-LCP-license","text":"Obtaining information on an LCP license"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An LCP License Document contains metadata such as its expiration date, the remaining number of characters to copy and the user name. You can access this information using an "},{"type":"codeVoice","code":"LCPLicense"},{"type":"text","text":" object."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" to retrieve the "},{"type":"codeVoice","code":"LCPLicense"},{"type":"text","text":" instance for a publication."}]},{"type":"codeListing","syntax":"swift","code":["let result = await lcpService.retrieveLicense(","    from: asset,","    authentication: LCPDialogAuthentication(delegate: dialogPresenter),","    allowUserInteraction: true",")","","switch result {","case .success(let lcpLicense):","    if let user = lcpLicense.license.user.name {","        print(\"The publication was acquired by \\(user)\")","    }","    if let endDate = lcpLicense.license.rights.end {","        print(\"The loan expires on \\(endDate)\")","    }","    if let copyLeft = await lcpLicense.charactersToCopyLeft() {","        print(\"You can copy up to \\(copyLeft) characters remaining.\")","    }","case .failure(let error):","    \/\/ Display the error.","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have already opened a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":", you can directly obtain the "},{"type":"codeVoice","code":"LCPLicense"},{"type":"text","text":" using "},{"type":"codeVoice","code":"publication.lcpLicense"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Managing-a-loan","text":"Managing a loan"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Readium LCP allows borrowing publications for a specific period. Use the "},{"type":"codeVoice","code":"LCPLicense"},{"type":"text","text":" object to manage a loan and retrieve its end date using "},{"type":"codeVoice","code":"lcpLicense.license.rights.end"},{"type":"text","text":"."}]},{"type":"heading","level":3,"anchor":"Returning-a-loan","text":"Returning a loan"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some loans can be returned before the end date. You can confirm this by using "},{"type":"codeVoice","code":"lcpLicense.canReturnPublication"},{"type":"text","text":". To return the publication, execute:"}]},{"type":"codeListing","syntax":"swift","code":["let result = await lcpLicense.returnPublication()","switch result {","case .success:","    \/\/ The publication was returned.","case .failure(let error):","    \/\/ Present the error.","}"]},{"type":"heading","level":3,"anchor":"Renewing-a-loan","text":"Renewing a loan"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The loan end date may also be extended. You can confirm this by using "},{"type":"codeVoice","code":"lcpLicense.canRenewLoan"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Readium LCP supports "},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Programmatic: You show your own user interface.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Interactive: You display a web view, and the Readium LSD server manages the renewal for you.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You need to support both interactions by implementing the "},{"type":"codeVoice","code":"LCPRenewDelegate"},{"type":"text","text":" protocol. A default implementation is available with "},{"type":"codeVoice","code":"LCPDefaultRenewDelegate"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let result = await lcpLicense.renewLoan(","    with: LCPDefaultRenewDelegate(","        presentingViewController: hostViewController","    )",")","","switch result {","case .success:","    \/\/ The publication was renewed.","case let .failure(error):","    \/\/ Display the error.","}"]},{"type":"heading","level":2,"anchor":"Handling-LCPError","text":"Handling LCPError"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The APIs may fail with an "},{"type":"codeVoice","code":"LCPError"},{"type":"text","text":". These errors "},{"inlineContent":[{"type":"text","text":"must"}],"type":"strong"},{"type":"text","text":" be displayed to the user with a suitable message."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an example, "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Using-the-SwiftUI-LCP-Authentication-dialog","text":"Using the SwiftUI LCP Authentication dialog"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your application is built using SwiftUI, you cannot use "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" because it requires a UIKit view controller as its host. Instead, use an "},{"type":"codeVoice","code":"LCPObservableAuthentication"},{"type":"text","text":" combined with our SwiftUI "},{"type":"codeVoice","code":"LCPDialog"},{"type":"text","text":" presented as a sheet."}]},{"type":"codeListing","syntax":"swift","code":["@main","struct MyApp: App {","    private let lcpService: LCPService","    private let publicationOpener: PublicationOpener","","    @StateObject private var lcpAuthentication: LCPObservableAuthentication","","    init() {","        \/\/ Create an `LCPObservableAuthentication` which will be used","        \/\/ to initialize the `LCPContentProtection`.","        \/\/","        \/\/ With SwiftUI, it must be stored in a `@StateObject` property","        \/\/ to observe the authentication requests.","        let lcpAuthentication = LCPObservableAuthentication()","        _lcpAuthentication = StateObject(wrappedValue: lcpAuthentication)","","        lcpService = LCPService(...)","","        publicationOpener = PublicationOpener(","            ...,","            contentProtections: [","                lcpService.contentProtection(with: lcpAuthentication)","            ]","        )","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                \/\/ You can present an `LCPDialog` when the `LCPObservableAuthentication`","                \/\/ `request` property is updated.","                .sheet(item: $lcpAuthentication.request) {","                    LCPDialog(request: $0)","                }","            }","        }","    }","}"]}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readium\/readium-lcp"]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Timeline","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readiu