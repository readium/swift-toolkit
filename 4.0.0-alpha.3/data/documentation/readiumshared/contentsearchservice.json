ymbol","roleHeading":"Class","externalID":"s:13ReadiumShared20ContentSearchServiceC","title":"ContentSearchService","modules":[{"name":"ReadiumShared"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentSearchService","kind":"identifier"}],"navigatorTitle":[{"text":"ContentSearchService","kind":"identifier"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentSearchService","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"It supports cross-element matching within the same resource via a"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"sliding window"}]},{"type":"text","text":" over the resource’s concatenated element texts. The window"},{"type":"text","text":" "},{"type":"text","text":"maintains a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"danger zone"}]},{"type":"text","text":" (last "},{"type":"emphasis","inlineContent":[{"type":"text","text":"T"}]},{"type":"text","text":" characters) where matches are deferred"},{"type":"text","text":" "},{"type":"text","text":"to the next iteration, enabling queries that span element boundaries (e.g.,"},{"type":"text","text":" "},{"type":"codeVoice","code":"<p>The quick<\/p><p>brown fox.<\/p>"},{"type":"text","text":" matches “quick brown”)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Cross-resource matching is intentionally not supported (the window is"},{"type":"text","text":" "},{"type":"text","text":"flushed at every resource boundary)."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Regex limitation:"}],"type":"strong"},{"type":"text","text":" for variable-length or greedy patterns the danger-zone"},{"type":"text","text":" "},{"type":"text","text":"heuristic (last 256 chars) is an approximation. A greedy pattern that starts"},{"type":"text","text":" "},{"type":"text","text":"before the danger zone but could extend further into the next element may be"},{"type":"text","text":" "},{"type":"text","text":"emitted prematurely, with a shorter-than-optimal match. Plain-text queries"},{"type":"text","text":" "},{"type":"text","text":"are not affected by this limitation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This service requires the publication to have a configured "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService"},"references":{"doc://Readium/documentation/ReadiumShared":{"title":"ReadiumShared","url":"\/documentation\/readiumshared","role":"collection","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared","type":"topic","abstract":[],"kind":"symbol"},"doc://Readium/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/Readium\/s8SendableP"},"doc://Readium/documentation/ReadiumShared/ContentSearchService/search(query:options:)":{"abstract":[],"url":"\/documentation\/readiumshared\/contentsearchservice\/search(query:options:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"search","kind":"identifier"},{"text":"(","kind":"text"},{"text":"query","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"options","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13ReadiumShared13SearchOptionsV","text":"SearchOptions","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":"