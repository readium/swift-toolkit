{"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"seeAlsoSections":[{"anchor":"Guides","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"title":"Guides"}],"variants":[{"paths":["\/documentation\/readium\/getting-started"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","sections":[],"metadata":{"roleHeading":"Article","role":"article","title":"Getting started"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"Readium offers only low-level tools. You are responsible for creating a user interface for reading and managing books, as well as a data layer to store the user’s publications. The Test App is an example of such integration."}]}]},{"text":"Design principles","anchor":"Design-principles","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The toolkit has been designed following these core tenets:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Modular","type":"text"}],"type":"strong"},{"type":"text","text":": It is divided into separate modules that can be used independently."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Extensible"}]},{"text":": Integrators should be able to support a custom DRM, publication format or inject their own stylesheets without modifying the toolkit itself.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Opiniated"}],"type":"strong"},{"type":"text","text":": We adhere to open standards but sometimes interpret them for practicality."}],"type":"paragraph"}]}]},{"text":"Packages","anchor":"Packages","level":2,"type":"heading"},{"text":"Main packages","anchor":"Main-packages","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumShared"},{"text":" contains shared ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" models and utilities.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumStreamer"},{"type":"text","text":" parses publication files (e.g. an EPUB) into a "},{"type":"codeVoice","code":"Publication"},{"text":" object.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"Navigator\/Navigator.md"},{"type":"text","text":"."}]}]}]},{"type":"heading","anchor":"Specialized-packages","level":3,"text":"Specialized packages"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ReadiumOPDS"},{"type":"text","text":" parses "},{"type":"reference","isActive":true,"identifier":"https:\/\/opds.io"},{"type":"text","text":" (both OPDS 1 and 2)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"Readium%20LCP.md","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Overview-of-the-shared-models-ReadiumShared","level":2,"text":"Overview of the shared models (`ReadiumShared`)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Readium toolkit provides models used as exchange types between packages."}]},{"type":"heading","anchor":"Publication-models","level":3,"text":"Publication models"},{"type":"heading","anchor":"Publication","level":4,"text":"Publication"},{"type":"paragraph","inlineContent":[{"code":"Publication","type":"codeVoice"},{"text":" and its sub-components represent a single publication – ebook, audiobook or comic. It is loosely based on the ","type":"text"},{"identifier":"https:\/\/readium.org\/webpub-manifest\/","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"holds the metadata of a publication, such as its author or table of contents,"}]}]},{"content":[{"inlineContent":[{"text":"allows to read the contents of a publication, e.g. XHTML or audio resources,","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"provides additional services, for example content extraction or text search."}],"type":"paragraph"}]}]},{"anchor":"Link","type":"heading","text":"Link","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","isActive":true},{"type":"text","text":" holds a pointer (URL) to a resource or service along with additional metadata, such as its media type or title."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" contains several "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" collections, for example:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"readingOrder"},{"type":"text","text":" lists the publication resources arranged in the order they should be read."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"resources","type":"codeVoice"},{"type":"text","text":" contains secondary resources necessary for rendering the "},{"code":"readingOrder","type":"codeVoice"},{"type":"text","text":", such as an image or a font file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"tableOfContents"},{"text":" represents the table of contents as a tree of ","type":"text"},{"type":"codeVoice","code":"Link"},{"type":"text","text":" objects."}]}]},{"content":[{"inlineContent":[{"code":"links","type":"codeVoice"},{"text":" exposes additional resources, such as a canonical link to the manifest or a search web service.","type":"text"}],"type":"paragraph"}]}]},{"level":4,"type":"heading","text":"Locator","anchor":"Locator"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/architecture\/models\/locators\/"},{"text":" represents a precise location in a publication resource in a format that can be stored and shared across reading systems. It is more accurate than a ","type":"text"},{"type":"codeVoice","code":"Link"},{"text":" and contains additional information about the location, e.g. progression percentage, position or textual context.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Locator"},{"text":" objects are used for various features, including:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"reporting the current progression in the publication"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"saving bookmarks, highlights and annotations","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"navigating search results","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"type":"heading","text":"Data models","anchor":"Data-models"},{"level":4,"type":"heading","text":"Asset","anchor":"Asset"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":" represents a single file or package and provides access to its content. There are two types of ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":":","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ContainerAsset"},{"text":" for packages which contains several resources, such as a ZIP archive.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ResourceAsset"},{"text":" for accessing a single resource, such as a JSON or PDF file.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"code":"Asset","type":"codeVoice"},{"type":"text","text":" instances are obtained through an "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"You can use the ","type":"text"},{"type":"codeVoice","code":"asset.format"},{"text":" to identify the media type and capabilities of the asset.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["if asset.format.conformsTo(.lcp) {","    \/\/ The asset is protected with LCP.","}","if asset.format.conformsTo(.epub) {","    \/\/ The asset represents an EPUB publication.","}"],"syntax":"swift"},{"text":"Resource","type":"heading","anchor":"Resource","level":4},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Resource"},{"text":" provides read access to a single resource, such as a file or an entry in an archive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"Resource","type":"codeVoice"},{"text":" instances are usually created by a ","type":"text"},{"code":"ResourceFactory","type":"codeVoice"},{"text":". The toolkit ships with various implementations supporting different data access protocols such as local files or HTTP.","type":"text"}],"type":"paragraph"},{"text":"Container","type":"heading","anchor":"Container","level":4},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Container"},{"type":"text","text":" provides read access to a collection of resources. "},{"type":"codeVoice","code":"Container"},{"type":"text","text":" instances representing an archive are usually created by an "},{"type":"codeVoice","code":"ArchiveOpener"},{"type":"text","text":". The toolkit ships with a "},{"type":"codeVoice","code":"ZIPArchiveOpener"},{"type":"text","text":" supporting both local and remote (HTTP) ZIP files."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Publication"},{"type":"text","text":" objects internally use a "},{"type":"codeVoice","code":"Container"},{"type":"text","text":" to expose its content."}],"type":"paragraph"},{"level":2,"text":"Opening a publication (`ReadiumStreamer`)","anchor":"Opening-a-publication-ReadiumStreamer","type":"heading"},{"inlineContent":[{"type":"text","text":"To retrieve a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":" object from a publication file like an EPUB or audiobook, you can use an "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":" and "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    )",")","","let url: URL = URL(...)","","\/\/ Retrieve an `Asset` to access the file content.","switch await assetRetriever.retrieve(url: url.anyURL.absoluteURL!) {","case .success(let asset):","    \/\/ Open a `Publication` from the `Asset`.","    switch await publicationOpener.open(asset: asset, allowUserInteraction: true) {","    case .success(let publication):","        print(\"Opened \\(publication.metadata.title)\")","","    case .failure(let error):","        \/\/ Failed to access or parse the publication","    }","","case .failure(let error):","    \/\/ Failed to retrieve the asset","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" parameter is useful when supporting a DRM like Readium LCP. It indicates if the toolkit can prompt the user for credentials when the publication is protected.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"Open%20Publication.md","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Accessing the metadata of a publication","anchor":"Accessing-the-metadata-of-a-publication","type":"heading"},{"inlineContent":[{"type":"text","text":"After opening a publication, you may want to read its metadata to insert a new entity into your bookshelf database, for instance. The "},{"type":"codeVoice","code":"publication.metadata"},{"type":"text","text":" object contains everything you need, including "},{"type":"codeVoice","code":"title"},{"type":"text","text":", "},{"type":"codeVoice","code":"authors"},{"type":"text","text":" and the "},{"type":"codeVoice","code":"published"},{"type":"text","text":" date."}],"type":"paragraph"},{"inlineContent":[{"text":"You can retrieve the publication cover using ","type":"text"},{"type":"codeVoice","code":"await publication.cover()"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Rendering the publication on the screen (`ReadiumNavigator`)","anchor":"Rendering-the-publication-on-the-screen-ReadiumNavigator","type":"heading"},{"inlineContent":[{"text":"You can use a Readium navigator to present the publication to the user. The ","type":"text"},{"code":"Navigator","type":"codeVoice"},{"text":" renders resources on the screen and offers APIs and user interactions for navigating the contents.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Please refer to the "},{"type":"reference","identifier":"Navigator\/Navigator.md","isActive":true,"overridingTitle":"Navigator guide","overridingTitleInlineContent":[{"type":"text","text":"Navigator guide"}]},{"type":"text","text":" for more information."}],"type":"paragraph"}]}],"references":{"Navigator/Navigator.md":{"identifier":"Navigator\/Navigator.md","title":"ReadiumNavigator renders the content of a publication","type":"link","url":"Navigator\/Navigator.md","titleInlineContent":[{"code":"ReadiumNavigator","type":"codeVoice"},{"type":"text","text":" renders the content of a publication"}]},"https://www.w3.org/TR/epub-a11y-11":{"type":"link","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}]},"doc://Readium/documentation/Readium/NavigatorOverview":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","title":"Navigator Overview","type":"topic","url":"\/documentation\/readium\/navigatoroverview","role":"article","kind":"article","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}]},"doc://Readium/documentation/Readium/TTS":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","abstract":[],"role":"article","type":"topic","kind":"article","title":"Text-to-speech","url":"\/documentation\/readium\/tts"},"https://readium.org/webpub-manifest/#24-the-link-object":{"identifier":"https:\/\/readi