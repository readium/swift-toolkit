":"topic","url":"\/documentation\/readium\/navigatoroverview","role":"article","kind":"article","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}]},"doc://Readium/documentation/Readium/Accessibility":{"role":"article","url":"\/documentation\/readium\/accessibility","type":"topic","abstract":[{"type":"text","text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the "},{"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","isActive":true},{"type":"text","text":" specification."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","title":"Accessibility","kind":"article"},"doc://Readium/documentation/Readium":{"type":"topic","kind":"article","title":"Readium","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}],"role":"collection","url":"\/documentation\/readium","identifier":"doc:\/\/Readium\/documentation\/Readium"},"doc://Readium/documentation/Readium/Readium-LCP":{"role":"article","url":"\/documentation\/readium\/readium-lcp","type":"topic","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},{"type":"text","text":" DRM."}],"kind":"article","title":"Supporting Readium LCP","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"},"doc://Readium/documentation/Readium/Open-Publication":{"role":"article","url":"\/documentation\/readium\/open-publication","type":"topic","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","title":"Opening a publication","abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"code":"AssetRetriever","t