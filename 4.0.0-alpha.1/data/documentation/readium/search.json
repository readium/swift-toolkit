{"sections":[],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Checking-if-a-publication-is-searchable","level":2,"type":"heading","text":"Checking if a publication is searchable"},{"type":"paragraph","inlineContent":[{"text":"Not every publication has a search service attached. Check ","type":"text"},{"inlineContent":[{"code":"isSearchable","type":"codeVoice"}],"type":"strong"},{"text":" before offering a search UI.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["guard publication.isSearchable else {","    \/\/ Hide or disable the search UI.","    return","}"]},{"type":"heading","anchor":"Performing-a-search","text":"Performing a search","level":2},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"type":"strong","inlineContent":[{"code":"publication.search(query:options:)","type":"codeVoice"}]},{"text":" to start a new search. This method returns a ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SearchResult<SearchIterator>"}]},{"text":" — either a cursor to page through results, or a ","type":"text"},{"type":"strong","inlineContent":[{"code":"SearchError","type":"codeVoice"}]},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let result = await publication.search(query: \"red panda\")","","switch result {","case .success(let iterator):","    \/\/ Use the iterator to page through results.","case .failure(let error):","    handleSearchError(error)","}"]},{"type":"heading","anchor":"Iterating-through-results","text":"Iterating through results","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SearchIterator"}]},{"type":"text","text":" is a cursor that fetches results one page at a time. Each page is a "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"LocatorCollection"}]},{"type":"text","text":" containing an array of "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"Locator"}]},{"type":"text","text":" values, one per match."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"iterator.next()"}]},{"type":"text","text":" to retrieve the next page. It returns "},{"code":"nil","type":"codeVoice"},{"text":" on success when all results have been exhausted, or ","type":"text"},{"code":".failure","type":"codeVoice"},{"text":" if a read error occurs.","type":"text"}]},{"type":"codeListing","code":["while let page = try await iterator.next().get() {","    for locator in page.locators {","        print(\"Found result at: \\(locator.href)\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To navigate directly to a result, pass the locator to the Navigator:"}]},{"type":"codeListing","code":["await navigator.go(to: locator)"],"syntax":"swift"},{"type":"heading","anchor":"Pagination-strategies","text":"Pagination strategies","level":3},{"type":"paragraph","inlineContent":[{"text":"Results may arrive in pages to progressively load results. In practice there are two common approaches:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Background load:"}]},{"text":" start a ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":" that accumulates every result progressively. Simple to implement; the full list updates every time a new page is fetched.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"On-scroll load:","type":"text"}]},{"type":"text","text":" hold onto the iterator and call "},{"code":"next()","type":"codeVoice"},{"type":"text","text":" only when the user scrolls to the bottom of the current batch. This keeps memory and CPU usage low, at the cost of slightly more state management."}]}]}]},{"type":"heading","anchor":"Grouping-results-by-section","text":"Grouping results by section","level":3},{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"locator.title","type":"codeVoice"}],"type":"strong"},{"text":" is the title of the table of contents entry that contains the match — for example, a chapter or section title. Use it to group consecutive results that fall within the same entry:","type":"text"}]},{"type":"codeListing","code":["var sections: [(title: String?, locators: [Locator])] = []","for locator in page.locators {","    if locator.title == sections.last?.title {","        sections[sections.count - 1].locators.append(locator)","    } else {","        sections.append((title: locator.title, locators: [locator]))","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This preserves order and keeps sections with the same title distinct when they are not consecutive."}]},{"type":"heading","anchor":"Displaying-a-result-snippet","text":"Displaying a result snippet","level":3},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"locator.text"}],"type":"strong"},{"text":" contains the matched text and its surrounding context:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"highlight"},{"type":"text","text":" — the exact string that matched the query."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"before"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"after"},{"text":" — a short snippet of text on either side of the match.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Here is a SwiftUI view that renders a single result with the matched text in bold:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct SearchResultRow: View {","    let locator: Locator","","    var body: some View {","        Text(snippet)","    }","","    private var snippet: AttributedString {","        var result = AttributedString()","        if let before = locator.text?.before {","            result += AttributedString(before)","        }","        if let highlight = locator.text?.highlight {","            var bold = AttributedString(highlight)","            bold.font = .body.bold()","            result += bold","        }","        if let after = locator.text?.after {","            result += AttributedString(after)","        }","        return result","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"In a real UI you will typically want to truncate ","type":"text"},{"code":"before","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"after","type":"codeVoice"},{"text":" so the UI stays compact.","type":"text"}]},{"level":2,"type":"heading","text":"Search options","anchor":"Search-options"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass a "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SearchOptions"}]},{"type":"text","text":" value to "},{"type":"codeVoice","code":"search(query:options:)"},{"type":"text","text":" to override the defaults. Any option you leave as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" falls back to the default behavior."}]},{"syntax":"swift","type":"codeListing","code":["let result = await publication.search(","    query: \"Red Panda\",","    options: SearchOptions(","        caseSensitive: true,","        diacriticSensitive: false","    )",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The full set of available options:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Option","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"caseSensitive"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bool?"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the search distinguishes upper- and lower-case letters."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"diacriticSensitive"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bool?"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", accented and unaccented letters are treated as distinct."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"wholeWord"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bool?"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", only complete words are matched, not substrings."}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"exact"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bool?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", the query is matched exactly, including stop words and word order."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"language","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Language?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Overrides the publication’s language for this search.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"regularExpression","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bool?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", the query is interpreted as a regular expression.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"otherOptions"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"[String: String]"}],"type":"paragraph"}],[{"inlineContent":[{"text":"–","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Custom options specific to the search service implementation."}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"type":"text","text":"Built-in"}]},{"type":"text","text":" column indicates whether the default Readium configuration handles the option. Options marked "},{"type":"strong","inlineContent":[{"type":"text","text":"No"}]},{"type":"text","text":" are silently ignored unless you provide a custom algorithm that implements them."}],"type":"paragraph"},{"anchor":"Supported-options","level":3,"text":"Supported options","type":"heading"},{"inlineContent":[{"type":"text","text":"Before displaying search-option controls – e.g. a case sensitivity toggle, or regex mode – inspect "},{"type":"strong","inlineContent":[{"code":"publication.searchOptions","type":"codeVoice"}]},{"type":"text","text":" to learn which options the service actually supports. An option whose value is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"text":"not supported","type":"text"}]},{"type":"text","text":" by the current service; do not show it in the UI. The actual value indicates the default behavior when the option is not overridden."}],"type":"paragraph"},{"syntax":"swift","code":["let options = publication.searchOptions","","\/\/ Only show the case-sensitivity toggle if the service supports it.","if let caseSensitive = options.caseSensitive {","    showCaseSensitiveToggle(defaultValue: caseSensitive)","}"],"type":"codeListing"},{"anchor":"Error-handling","level":2,"text":"Error handling","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"code":"SearchError","type":"codeVoice"}]},{"type":"text","text":" describes what can go wrong:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".publicationNotSearchable"}]},{"text":" – The publication has no search service. Guard on ","type":"text"},{"code":"isSearchable","type":"codeVoice"},{"text":" first.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".badQuery(Error)","type":"codeVoice"}]},{"text":" – The query string is invalid. Not all implementations produce this; custom services may use it to signal a malformed query (for example, an invalid regular expression).","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".reading(ReadError)"}],"type":"strong"},{"text":" – An I\/O error occurred while reading a resource.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["switch searchError {","case .publicationNotSearchable:","    break \/\/ Should not happen if you check isSearchable first.","case .badQuery(let error):","    showAlert(\"Invalid query\")","case .reading(let error):","    showAlert(\"Failed to read the publication resources\")","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Advanced customization","anchor":"Advanced-customization"},{"level":3,"type":"heading","text":"Configuring the search service","anchor":"Configuring-the-search-service"},{"inlineContent":[{"type":"text","text":"The default parsers automatically register "},{"type":"strong","inlineContent":[{"code":"ContentSearchService","type":"codeVoice"}]},{"type":"text","text":" for EPUB and PDF publications, which relies on the "},{"type":"reference","identifier":"Content.md","isActive":true},{"type":"text","text":" to inspect the publication content. You do not need to do anything for the default behavior."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To customize the default service — for example, to adjust the snippet length or plug in a different search algorithm — override it in the "},{"type":"codeVoice","code":"onCreatePublication"},{"type":"text","text":" callback when opening a publication:"}],"type":"paragraph"},{"code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    onCreatePublication: { _, _, services in","        services.setSearchServiceFactory(","            ContentSearchService.makeFactory(","                snippetLength: 300,","                searchAlgorithm: BasicStringSearchAlgorithm()","            )","        )","    }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"snippetLength"},{"type":"text","text":" parameter controls how many characters of context are included in the "},{"type":"codeVoice","code":"before"},{"type":"text","text":" and "},{"type":"codeVoice","code":"after"},{"text":" text of each result’s ","type":"text"},{"inlineContent":[{"code":"Locator.Text","type":"codeVoice"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"code":"ContentSearchService","type":"codeVoice"},{"text":" depends on a ","type":"text"},{"code":"ContentService","type":"codeVoice"},{"text":" being registered for the publication. This is set up automatically by the default parsers.","type":"text"}]}],"type":"aside"},{"level":3,"text":"Implementing a custom search algorithm","anchor":"Implementing-a-custom-search-algorithm","type":"heading"},{"inlineContent":[{"text":"The actual text-matching logic is separated into the ","type":"text"},{"inlineContent":[{"type":"codeVoice","code":"StringSearchAlgorithm"}],"type":"strong"},{"text":" protocol. You can swap it out without changing anything else about the service.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"BasicStringSearchAlgorithm"}]},{"type":"text","text":" is the built-in implementation. It uses the native "},{"type":"codeVoice","code":"String.range(of:options:)"},{"type":"text","text":" APIs and supports "},{"type":"codeVoice","code":"caseSensitive"},{"type":"text","text":", "},{"type":"codeVoice","code":"diacriticSensitive"},{"type":"text","text":", "},{"type":"codeVoice","code":"exact"},{"type":"text","text":", and "},{"type":"codeVoice","code":"regularExpression"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To use a custom algorithm, pass it to "},{"type":"codeVoice","code":"ContentSearchService.makeFactory"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["ContentSearchService.makeFactory(searchAlgorithm: MyFuzzySearchAlgorithm())"],"type":"codeListing"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/readium\/search"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Search"},"abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":". EPUB and PDF publications are supported."}],"metadata":{"roleHeading":"Article","role":"article","title":"Searching a publication"},"kind":"article","seeAlsoSe