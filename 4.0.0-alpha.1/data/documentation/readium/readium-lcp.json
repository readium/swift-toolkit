{"variants":[{"paths":["\/documentation\/readium\/readium-lcp"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"metadata":{"roleHeading":"Article","role":"article","title":"Supporting Readium LCP"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"name":"Note","type":"aside","content":[{"inlineContent":[{"text":"[!IMPORTANT]","type":"text"},{"text":" ","type":"text"},{"text":"To use LCP with the Readium toolkit, you must first obtain the ","type":"text"},{"type":"codeVoice","code":"R2LCPClient"},{"text":" private library by contacting ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/www.edrlab.org\/contact\/"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note"},{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"An LCP publication is protected with a ","type":"text"},{"inlineContent":[{"text":"user passphrase","type":"text"}],"type":"emphasis"},{"text":" and distributed using an LCP License Document (","type":"text"},{"type":"codeVoice","code":".lcpl"},{"text":") .","type":"text"}]},{"inlineContent":[{"type":"text","text":"The user flow typically goes as follows:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The user imports a "},{"code":".lcpl","type":"codeVoice"},{"type":"text","text":" file into your application."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The application uses the Readium toolkit to download the protected publication from the "},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":" file to the user’s bookshelf. The downloaded file can be a "},{"type":"codeVoice","code":".epub"},{"type":"text","text":", "},{"type":"codeVoice","code":".lcpdf"},{"type":"text","text":" (PDF), or "},{"type":"codeVoice","code":".lcpa"},{"type":"text","text":" (audiobook) package."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user opens the protected publication from the bookshelf.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If the passphrase isn’t already recorded in the ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" internal database, the user will be asked to enter it to unlock the contents.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The publication is decrypted and rendered on the screen."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Setup","text":"Setup","type":"heading","level":2},{"inlineContent":[{"text":"To support LCP in your application, you require two components:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"ReadiumLCP"},{"text":" package from the toolkit provides APIs for downloading and decrypting protected publications. Import it as you would any other Readium package, such as ","type":"text"},{"type":"codeVoice","code":"R2Navigator"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The private ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" library customized for your application ","type":"text"},{"identifier":"https:\/\/www.edrlab.org\/contact\/","isActive":true,"overridingTitle":"is available from EDRLab","overridingTitleInlineContent":[{"type":"text","text":"is available from EDRLab"}],"type":"reference"},{"text":". They will provide instructions for integrating the ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":" framework into your application.","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"text":"File formats","anchor":"File-formats","type":"heading"},{"inlineContent":[{"type":"text","text":"Readium LCP specifies new file formats."}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Name"}],"type":"paragraph"}],[{"inlineContent":[{"text":"File extension","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Media type"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":".lcpl","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"application\/vnd.readium.lcp.license.v1.0+json"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".lcpdf"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/pdf+lcp"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-audiobooks.html","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".lcpa"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/audiobook+lcp"}]}]]],"type":"table"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"EPUB files protected by LCP are supported without a special file extension or media type because EPUB accommodates any DRM scheme in its specification."}]}],"style":"note"},{"inlineContent":[{"text":"To support these formats in your application, you need to ","type":"text"},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/defining_file_and_data_types_for_your_app","isActive":true},{"text":" as imported types.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["<dict>","    <key>UTImportedTypeDeclarations<\/key>","    <array>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpl<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.json<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP License Document<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpl<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/vnd.readium.lcp.license.v1.0+json<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpdf<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for PDF package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpdf<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/pdf+lcp<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpa<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpa<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/audiobook+lcp<\/string>","            <\/dict>","        <\/dict>","    <\/array>","<\/dict>"],"syntax":"xml"},{"inlineContent":[{"type":"text","text":"Next, declare the imported types as "},{"type":"reference","identifier":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd","isActive":true},{"type":"text","text":" in the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" to have your application listed in the “Open with…” dialogs."}],"type":"paragraph"},{"type":"codeListing","code":["<dict>","    <key>CFBundleDocumentTypes<\/key>","    <array>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP License Document<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpl<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for PDF package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpdf<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpa<\/string>","            <\/array>","        <\/dict>","    <\/array>","<\/dict>"],"syntax":"xml"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"[!TIP]","type":"text"},{"text":" ","type":"text"},{"text":"If EPUB is not included in your document types, now is a good time to add it.","type":"text"}]}],"style":"note"},{"text":"Allow insecure HTTP requests","type":"heading","anchor":"Allow-insecure-HTTP-requests","level":3},{"inlineContent":[{"text":"A file required by the LCP library needs to be downloaded from an insecure HTTP location. You must authorize this download by adding the following to your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" file:","type":"text"}],"type":"paragraph"},{"code":["<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSExceptionDomains<\/key>","    <dict>","        <key>crl.edrlab.telesec.de<\/key>","        <dict>","            <key>NSExceptionAllowsInsecureHTTPLoads<\/key>","            <true\/>","        <\/dict>","    <\/dict>","<\/dict>"],"type":"codeListing","syntax":"xml"},{"text":"Device name for LCP registration","level":3,"anchor":"Device-name-for-LCP-registration","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When registering a license with an LSD server, Readium LCP identifies the device by name using "},{"code":"UIDevice.current.name","type":"codeVoice"},{"type":"text","text":". Since iOS 16, this returns a generic string such as “iPhone” instead of the user-assigned device name."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To obtain the actual device name, add the "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/bundleresources\/entitlements\/com_apple_developer_device-information_user-assigned-device-name","isActive":true},{"type":"text","text":" entitlement to your app’s "},{"type":"codeVoice","code":".entitlements"},{"type":"text","text":" file. This entitlement requires approval from Apple."}]},{"syntax":"xml","code":["<key>com.apple.developer.device-information.user-assigned-device-name<\/key>","<true\/>"],"type":"codeListing"},{"inlineContent":[{"text":"Alternatively, you can supply your own device name when initializing ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" via the ","type":"text"},{"code":"deviceName","type":"codeVoice"},{"text":" parameter.","type":"text"}],"type":"paragraph"},{"anchor":"Initializing-the-LCPService","level":2,"text":"Initializing the `LCPService`","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" offers an "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" object that exposes its API. Since the "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" package is not linked with "},{"type":"codeVoice","code":"R2LCPClient"},{"type":"text","text":", you need to create your own adapter when setting up the "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" expects repositories to store the opened licenses and passphrases. ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" provides built-in Keychain-based implementations that store data securely in the iOS\/macOS Keychain. Unlike database-based storage, Keychain data persists across app reinstalls and can optionally be synchronized across the user’s devices via iCloud Keychain.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@preconcurrency import R2LCPClient","import ReadiumLCP","","let httpClient = DefaultHTTPClient()","","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","","let lcpService = LCPService(","    client: LCPClientAdapter(),","    licenseRepository: LCPKeychainLicenseRepository(),","    passphraseRepository: LCPKeychainPassphraseRepository(),","    assetRetriever: assetRetriever,","    httpClient: httpClient",")","","\/\/\/ Facade to the private R2LCPClient.framework.","class LCPClientAdapter: ReadiumLCP.LCPClient {","    func createContext(jsonLicense: String, hashedPassphrase: LCPPassphraseHash, pemCrl: String) throws -> LCPClientContext {","        try R2LCPClient.createContext(jsonLicense: jsonLicense, hashedPassphrase: hashedPassphrase, pemCrl: pemCrl)","    }","","    func decrypt(data: Data, using context: LCPClientContext) -> Data? {","        R2LCPClient.decrypt(data: data, using: context as! DRMContext)","    }","","    func findOneValidPassphrase(jsonLicense: String, hashedPassphrases: [LCPPassphraseHash]) -> LCPPassphraseHash? {","        R2LCPClient.findOneValidPassphrase(jsonLicense: jsonLicense, hashedPassphrases: hashedPassphrases)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To disable iCloud synchronization, pass "},{"code":"synchronizable: false","type":"codeVoice"},{"type":"text","text":" when creating the repositories."}],"type":"paragraph"},{"inlineContent":[{"text":"You may also implement your own persistence layer by conforming to ","type":"text"},{"type":"codeVoice","code":"LCPLicenseRepository"},{"type":"text","text":" and "},{"type":"codeVoice","code":"LCPPassphraseRepository"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Acquiring a publication from a License Document (LCPL)","type":"heading","level":2,"anchor":"Acquiring-a-publication-from-a-License-Document-LCPL"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Users need to import a License Document into your application to download the protected publication ("},{"type":"codeVoice","code":".epub"},{"type":"text","text":", "},{"type":"codeVoice","code":".lcpdf"},{"type":"text","text":", or "},{"type":"codeVoice","code":".lcpa"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" offers an API to retrieve the full publication from an LCPL on the filesystem."}]},{"code":["let result = await lcpService.acquirePublication(","    from: .file(lcplURL),","    onProgress: { progress in","        switch progress {","            case .indefinite:","                \/\/ Display an activity indicator.","            case .percent(let percent):","                \/\/ Display a progress bar with percent from 0 to 1.","        }","    }",")","","switch result {","case let .success(publication):","    \/\/ Import the `publication.localURL` file as any publication.","case let .failure(error):","    \/\/ Display the error message.","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"After the download is completed, import the ","type":"text"},{"type":"codeVoice","code":"publication.localURL"},{"text":" file into the bookshelf like any other publication file.","type":"text"}]},{"text":"Opening a publication protected with LCP","type":"heading","level":2,"anchor":"Opening-a-publication-protected-with-LCP"},{"text":"Initializing the `PublicationOpener`","type":"heading","level":3,"anchor":"Initializing-the-PublicationOpener"},{"type":"paragraph","inlineContent":[{"text":"A publication protected with LCP can be opened using the ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":" component, just like a non-protected publication. However, you must provide a ","type":"text"},{"isActive":true,"identifier":"https:\/\/readium.org\/architecture\/proposals\/006-content-protection.html","type":"reference"},{"text":" implementation when initializing the ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":" to enable LCP. Luckily, ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" has you covered.","type":"text"}]},{"code":["let httpClient = DefaultHTTPClient()","","let dialogPresenter = LCPDialogPresenter()","let authentication = LCPDialogAuthentication(delegate: dialogPresenter)","","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: AssetRetriever(httpClient: httpClient),","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An LCP package is secured with a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"user passphrase"}]},{"text":" for decrypting the content. The ","type":"text"},{"code":"LCPAuthenticating","type":"codeVoice"},{"text":" protocol used by ","type":"text"},{"code":"LCPService.contentProtection(with:)","type":"codeVoice"},{"text":" provides the passphrase when needed. You can use the default UIKit ","type":"text"},{"code":"LCPDialogAuthentication","type":"codeVoice"},{"text":" which displays a pop-up to enter the passphrase, or implement your own method for passphrase retrieval. If your application is built using SwiftUI, ","type":"text"},{"isActive":true,"identifier":"#using-the-swiftui-lcp-authentication-dialog","type":"reference"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" delegates the presentation of the dialog to an "},{"type":"codeVoice","code":"LCPDialogAuthenticationDelegate"},{"type":"text","text":", for example on the top-most view controller of your application. As the delegate is held weakly, you must retain it yourself for the lifetime of the authentication."}],"type":"paragraph"},{"syntax":"swift","code":["@MainActor","final class LCPDialogPresenter: LCPDialogAuthenticationDelegate {","    func lcpDialogAuthentication(","        _ authentication: LCPDialogAuthentication,","        present dialogViewController: UIViewController","    ) {","        \/\/ Present the dialog on your top-most view controller. It will","        \/\/ dismiss itself automatically once the user submits or cancels.","        hostViewController.present(dialogViewController, animated: true)","    }","}"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"The user will be prompted once per passphrase since "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" stores known passphrases on the device."}]}],"name":"Note","style":"note","type":"aside"},{"anchor":"Opening-the-publication","level":3,"type":"heading","text":"Opening the publication"},{"inlineContent":[{"text":"You are now ready to open the publication file with your ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Retrieve an `Asset` to access the file content.","let url = FileURL(path: \"\/path\/to\/lcp-protected-book.epub\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the `Asset`.","let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true",")","","switch result {","case .success(let publication):","    \/\/ Import or present the publication.","case .failure(let error):","    \/\/ Present the error.","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"allowUserInteraction"},{"text":" argument is forwarded to the ","type":"text"},{"type":"codeVoice","code":"LCPAuthenticating"},{"type":"text","text":" implementation when the passphrase is unknown. "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" shows a pop-up only if "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"When importing the publication to the bookshelf, set ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" as you don’t need the passphrase for accessing the publication metadata and cover. If you intend to present the publication using a Navigator, set ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" as decryption will be required.","type":"text"}]},{"name":"Note","content":[{"inlineContent":[{"text":"[!TIP]","type":"text"},{"text":" ","type":"text"},{"text":"To check if an asset is protected with LCP before opening it, you can use ","type":"text"},{"code":"asset.format.conformsTo(.lcp)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"},{"text":"Using the opened `Publication`","anchor":"Using-the-opened-Publication","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"After obtaining a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance, you can access the publication’s metadata to import it into the user’s bookshelf. The user passphrase is not needed for reading the metadata or cover."}]},{"type":"paragraph","inlineContent":[{"text":"However, if you want to display the publication with a Navigator, verify it is not restricted. It could be restricted if the user passphrase is unknown or if the license is no longer valid (e.g., expired loan, revoked purchase, etc.).","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["if publication.isRestricted {","    if let error = publication.protectionError as? LCPError {","        \/\/ The user is not allowed to open the publication. You should display the error.","    } else {","        \/\/ We don't have the user passphrase.","        \/\/ You may use `publication` to access its metadata, but not to render its content.","    }","} else {","    \/\/ The publication is not restricted, you may render it with a Navigator component.","}"]},{"text":"Streaming an LCP protected package","anchor":"Streaming-an-LCP-protected-package","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"If the server hosting the LCP protected package supports the ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"https:\/\/httpwg.org\/specs\/rfc7233.html"},{"type":"text","text":", it is possible to stream directly an LCP protected publication from a License Document ("},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":") file, without downloading the whole publication first."}]},{"type":"paragraph","inlineContent":[{"text":"Simply open the License Document directly using the ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":". Make sure you provide an ","type":"text"},{"type":"codeVoice","code":"HTTPClient"},{"text":" (or an ","type":"text"},{"type":"codeVoice","code":"HTTPResourceFactory"},{"text":" for additional customization) to the ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":".","type":"text"}]},{"type":"codeListing","code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(httpClient: httpClient)","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication(delegate: dialogPresenter)),","    ]",")","","\/\/ Retrieve an `Asset` to access the LCPL content.","let url = FileURL(path: \"\/path\/to\/license.lcpl\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the LCPL `Asset`.","let publication = try await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true",").get()","    ","print(\"Opened \\(publication.metadata.title)\")"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Obtaining-information-on-an-LCP-license","text":"Obtaining information on an LCP license"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An LCP License Document contains metadata such as its expiration date, the remaining number of characters to copy and the user name. You can access this information using an "},{"code":"LCPLicense","type":"codeVoice"},{"type":"text","text":" object."}]},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"text":" to retrieve the ","type":"text"},{"type":"codeVoice","code":"LCPLicense"},{"text":" instance for a publication.","type":"text"}]},{"type":"codeListing","code":["let result = await lcpService.retrieveLicense(","    from: asset,","    authentication: LCPDialogAuthentication(delegate: dialogPresenter),","    allowUserInteraction: true",")","","switch result {","case .success(let lcpLicense):","    if let user = lcpLicense.license.user.name {","        print(\"The publication was acquired by \\(user)\")","    }","    if let endDate = lcpLicense.license.rights.end {","        print(\"The loan expires on \\(endDate)\")","    }","    if let copyLeft = await lcpLicense.charactersToCopyLeft() {","        print(\"You can copy up to \\(copyLeft) characters remaining.\")","    }","case .failure(let error):","    \/\/ Display the error.","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If you have already opened a ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":", you can directly obtain the ","type":"text"},{"type":"codeVoice","code":"LCPLicense"},{"text":" using ","type":"text"},{"type":"codeVoice","code":"publication.lcpLicense"},{"text":".","type":"text"}]},{"type":"heading","text":"Managing a loan","anchor":"Managing-a-loan","level":2},{"type":"paragraph","inlineContent":[{"text":"Readium LCP allows borrowing publications for a specific period. Use the ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" object to manage a loan and retrieve its end date using ","type":"text"},{"code":"lcpLicense.license.rights.end","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","text":"Returning a loan","anchor":"Returning-a-loan","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some loans can be returned before the end date. You can confirm this by using "},{"type":"codeVoice","code":"lcpLicense.canReturnPublication"},{"type":"text","text":". To return the publication, execute:"}]},{"type":"codeListing","code":["let result = await lcpLicense.returnPublication()","switch result {","case .success:","    \/\/ The publication was returned.","case .failure(let error):","    \/\/ Present the error.","}"],"syntax":"swift"},{"type":"heading","text":"Renewing a loan","anchor":"Renewing-a-loan","level":3},{"type":"paragraph","inlineContent":[{"text":"The loan end date may also be extended. You can confirm this by using ","type":"text"},{"code":"lcpLicense.canRenewLoan","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Readium LCP supports ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Programmatic: You show your own user interface.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Interactive: You display a web view, and the Readium LSD server manages the renewal for you.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"You need to support both interactions by implementing the ","type":"text"},{"code":"LCPRenewDelegate","type":"codeVoice"},{"text":" protocol. A default implementation is available with ","type":"text"},{"code":"LCPDefaultRenewDelegate","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","code":["let result = await lcpLicense.renewLoan(","    with: LCPDefaultRenewDelegate(","        presentingViewController: hostViewController","    )",")","","switch result {","case .success:","    \/\/ The publication was renewed.","case let .failure(error):","    \/\/ Display the error.","}"],"syntax":"swift"},{"type":"heading","text":"Handling `LCPError`","anchor":"Handling-LCPError","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The APIs may fail with an "},{"type":"codeVoice","code":"LCPError"},{"type":"text","text":". These errors "},{"inlineContent":[{"type":"text","text":"must"}],"type":"strong"},{"type":"text","text":" be displayed to the user with a suitable message."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an example, "},{"type":"reference","identifier":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221","isActive":true},{"type":"text","text":"."}]},{"type":"heading","text":"Using the SwiftUI LCP Authentication dialog","anchor":"Using-the-SwiftUI-LCP-Authentication-dialog","level":2},{"type":"paragraph","inlineContent":[{"text":"If your application is built using SwiftUI, you cannot use ","type":"text"},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"text":" because it requires a UIKit view controller as its host. Instead, use an ","type":"text"},{"type":"codeVoice","code":"LCPObservableAuthentication"},{"text":" combined with our SwiftUI ","type":"text"},{"type":"codeVoice","code":"LCPDialog"},{"text":" presented as a sheet.","type":"text"}]},{"type":"codeListing","code":["@main","struct MyApp: App {","    private let lcpService: LCPService","    private let publicationOpener: PublicationOpener","","    @StateObject private var lcpAuthentication: LCPObservableAuthentication","","    init() {","        \/\/ Create an `LCPObservableAuthentication` which will be used","        \/\/ to initialize the `LCPContentProtection`.","        \/\/","        \/\/ With SwiftUI, it must be stored in a `@StateObject` property","        \/\/ to observe the authentication requests.","        let lcpAuthentication = LCPObservableAuthentication()","        _lcpAuthentication = StateObject(wrappedValue: lcpAuthentication)","","        lcpService = LCPService(...)","","        publicationOpener = PublicationOpener(","            ...,","            contentProtections: [","                lcpService.contentProtection(with: lcpAuthentication)","            ]","        )","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                \/\/ You can present an `LCPDialog` when the `LCPObservableAuthentication`","                \/\/ `request` property is updated.","                .sheet(item: $lcpAuthentication.request) {","                    LCPDialog(request: $0)","                }","            }","        }","    }","}"],"syntax":"swift"}]}],"abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true},{"type":"text","text":" DRM."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publi