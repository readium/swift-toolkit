{"kind":"article","identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Content","interfaceLanguage":"swift"},"metadata":{"role":"article","title":"Extracting the content of a publication","roleHeading":"Article"},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"The described feature is still experimental and the implementation incomplete."}]}]},{"type":"paragraph","inlineContent":[{"text":"Many high-level features require access to the raw content (text, media, etc.) of a publication, such as:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Text-to-speech","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Accessibility reader","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Basic search"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full-text search indexing"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Image or audio indexes"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"ContentService"},{"text":" provides a way to iterate through a publication’s content, extracted as semantic elements.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"First, request the publication’s ","type":"text"},{"type":"codeVoice","code":"Content"},{"type":"text","text":", starting from a given "},{"type":"codeVoice","code":"Locator"},{"type":"text","text":". If the locator is missing, the "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" will be extracted from the beginning of the publication."}]},{"syntax":"swift","code":["guard let content = publication.content(from: startLocator) else {","    \/\/ Abort as the content cannot be extracted","    return","}"],"type":"codeListing"},{"level":2,"type":"heading","text":"Extracting the raw text content","anchor":"Extracting-the-raw-text-content"},{"inlineContent":[{"type":"text","text":"Getting the whole raw text of a publication is such a common use case that a helper is available on "},{"code":"Content","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let wholeText = content.text()"],"type":"codeListing"},{"inlineContent":[{"text":"This is an expensive operation, proceed with caution and cache the result if you need to reuse it.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Iterating through the content","anchor":"Iterating-through-the-content"},{"inlineContent":[{"text":"The individual ","type":"text"},{"code":"Content","type":"codeVoice"},{"text":" elements can be iterated through with a regular ","type":"text"},{"code":"for","type":"codeVoice"},{"text":" loop by converting it to a sequence:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["for element in content.sequence() {","    \/\/ Process element","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Alternatively, you can get the whole list of elements with "},{"type":"codeVoice","code":"content.elements()"},{"type":"text","text":", or use the lower level APIs to iterate the content manually:"}],"type":"paragraph"},{"syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.next() {","    print(element)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Some "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" implementations support bidirectional iterations. To iterate backwards, use:"}],"type":"paragraph"},{"syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.previous() {","    print(element)","}"],"type":"codeListing"},{"level":2,"type":"heading","text":"Processing the elements","anchor":"Processing-the-elements"},{"inlineContent":[{"type":"text","text":"The "},{"code":"Content","type":"codeVoice"},{"type":"text","text":" iterator yields "},{"code":"ContentElement","type":"codeVoice"},{"text":" objects representing a single semantic portion of the publication, such as a heading, a paragraph or an embedded image.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every element has a "},{"type":"codeVoice","code":"locator"},{"type":"text","text":" property targeting it in the publication. You can use the locator, for example, to navigate to the element or to draw a "},{"type":"codeVoice","code":"Decoration"},{"type":"text","text":" on top of it."}]},{"type":"codeListing","syntax":"swift","code":["navigator.go(to: element.locator)"]},{"type":"heading","level":3,"text":"Types of elements","anchor":"Types-of-elements"},{"type":"paragraph","inlineContent":[{"text":"Depending on the actual implementation of ","type":"text"},{"code":"ContentElement","type":"codeVoice"},{"text":", more properties are available to access the actual data. The toolkit ships with a number of default implementations for common types of elements.","type":"text"}]},{"type":"heading","level":4,"text":"Embedded media","anchor":"Embedded-media"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"EmbeddedContentElement"},{"type":"text","text":" protocol is implemented by any element referencing an external resource. It contains an "},{"type":"codeVoice","code":"embeddedLink"},{"type":"text","text":" property you can use to get the actual content of the resource."}]},{"type":"codeListing","syntax":"swift","code":["if let element = element as? EmbeddedContentElement {","    let bytes = try publication","        .get(element.embeddedLink)","        .read().get()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here are the default available implementations:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AudioContentElement"},{"type":"text","text":" - audio clips"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"VideoContentElement","type":"codeVoice"},{"text":" - video clips","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"ImageContentElement","type":"codeVoice"},{"text":" - bitmap images","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"All of them expose an additional ","type":"text"},{"code":"caption: String?","type":"codeVoice"},{"text":" property - the caption from an enclosing figure’s ","type":"text"},{"code":"figcaption","type":"codeVoice"},{"text":", when available.","type":"text"}]},{"text":"Text","type":"heading","level":4,"anchor":"Text"},{"text":"Textual elements","type":"heading","level":5,"anchor":"Textual-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"TextualContentElement"},{"type":"text","text":" protocol is implemented by any element which can be represented as human-readable text. This is useful when you want to extract the text content of a publication without caring for each individual type of elements."}]},{"type":"paragraph","inlineContent":[{"text":"For media elements (image, SVG, audio and video), ","type":"text"},{"type":"codeVoice","code":"text"},{"text":" returns the accessible name only.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let wholeText = publication.content()","    .elements()","    .compactMap { ($0 as? TextualContentElement)?.text.takeIf { !$0.isEmpty } }","    .joined(separator: \"\\n\")"]},{"text":"Text elements","type":"heading","level":5,"anchor":"Text-elements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actual text elements are instances of "},{"type":"codeVoice","code":"TextContentElement"},{"type":"text","text":", which represent a single block of text such as a heading, a paragraph or a list item. It is comprised of a "},{"type":"codeVoice","code":"role"},{"type":"text","text":" and a list of "},{"type":"codeVoice","code":"segments"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"role"},{"type":"text","text":" is the nature of the text element in the document. For example a heading, body, footnote or a quote. It can be used to reconstruct part of the structure of the original document."}]},{"inlineContent":[{"text":"A text element is composed of individual segments with their own ","type":"text"},{"code":"locator","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"attributes","type":"codeVoice"},{"text":". They are useful to associate attributes with a portion of a text element. For example, given the HTML paragraph:","type":"text"}],"type":"paragraph"},{"code":["<p>It is pronounced <span lang=\"fr\">croissant<\/span>.<\/p>"],"type":"codeListing","syntax":"html"},{"inlineContent":[{"type":"text","text":"The following "},{"type":"codeVoice","code":"TextContentElement"},{"type":"text","text":" will be produced:"}],"type":"paragraph"},{"code":["TextContentElement(","    role: .body,","    segments: [","        TextContentElement.Segment(text: \"It is pronounced \"),","        TextContentElement.Segment(text: \"croissant\", attributes: [ContentAttribute(key: .language, value: \"fr\")]),","        TextContentElement.Segment(text: \".\")","    ]",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"If you are not interested in the segment attributes, you can also use ","type":"text"},{"code":"element.text","type":"codeVoice"},{"text":" to get the concatenated raw text.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Element attributes","type":"heading","anchor":"Element-attributes"},{"inlineContent":[{"type":"text","text":"All types of "},{"type":"codeVoice","code":"ContentElement"},{"type":"text","text":" can have associated attributes. Custom "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":" implementations can use this as an extensibility point."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The HTML content iterator fills in accessibility attributes for media elements:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"accessibleName","type":"codeVoice"},{"type":"text","text":" and "},{"code":"accessibleDescription","type":"codeVoice"},{"type":"text","text":" - flat strings computed following a subset of "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.w3.org\/TR\/accname-1.2"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"extendedDescription","type":"codeVoice"},{"type":"text","text":" - a "},{"code":"Link","type":"codeVoice"},{"text":" to an extended description declared with ","type":"text"},{"type":"reference","identifier":"https:\/\/daisy.github.io\/transitiontoepub\/best-practices\/extended-desc\/ExtendedDescriptionsBestPractices.html","isActive":true},{"text":", repeated when the element declares several targets.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Use cases","anchor":"Use-cases"},{"text":"An index of all images embedded in the publication","anchor":"An-index-of-all-images-embedded-in-the-publication","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"This example extracts all the embedded images in the publication and displays them in a SwiftUI list. Clicking on an image jumps to its location in the publication."}],"type":"paragraph"},{"code":["struct ImageIndex: View {","    struct Item: Hashable {","        let locator: Locator","        let text: String?","        let image: UIImage","    }","","    let publication: Publication","    let navigator: Navigator","    @State private var items: [Item] = []","","    init(publication: Publication, navigator: Navigator) {","        self.publication = publication","        self.navigator = navigator","    }","","    var body: some View {","        ScrollView {","            LazyVStack {","                ForEach(items, id: \\.self) { item in","                    VStack() {","                        Image(uiImage: item.image)","                        Text(item.text ?? \"No caption\")","                    }","                    .onTapGesture {","                        navigator.go(to: item.locator)","                    }","                }","            }","        }","        .onAppear {","            items = publication.content()?","                .elements()","                .compactMap { element in","                    guard","                        let element = element as? ImageContentElement,","                        let image = try? publication.get(element.embeddedLink)","                            .read().map(UIImage.init).get()","                    else {","                        return nil","                    }","","                    return Item(","                        locator: element.locator,","                        text: element.caption ?? element.accessibleName,","                        image: image","                    )","                }","                ?? []","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"References","anchor":"References","level":2,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","isActive":true}],"type":"paragraph"}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"generated":true,"anchor":"Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readium\/content"]}],"references":{"https://www.w3.org/TR/epub-a11y-11":{"type":"link","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}]},"doc://Readium/documentation/Readium/NavigatorOverview":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","title":"Navigator Overview","type":"topic","url":"\/documentation\/readium\/navigatoroverview","role":"article","kind":"article","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}]},"doc://Readium/documentation/Readium/Getting-Started":{"role":"article","url":"\/documentation\/readium\/getting-started","type":"topic","abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"title":"Getting started","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","kind":"article"},"doc://Readium/documentation/Readium/TTS":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","abstract":[],"role":"article","type":"topic","kind":"article","title":"Text-to-speech","url":"\/documentation\/readium\/tts"},"https://www.w3.org/TR/accname-1.2":{"type":"link","identifier":"https:\/\/www.w3.org\/TR\/accname-1.2","title":"the W3C accessible name computation","url":"https:\/\/www.w3.org\/TR\/accname-1.2","titleInlineContent":[{"type":"text","text":"the W3C accessible name computation"}]},"doc://Readium/documentation/Readium":{"type":"topic","kind":"article","title":"Readium","abstract":[{"text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin.","type":"text"}],"role":"collection","url":"\/documentation\/readium","identifier":"doc:\/\/Readium\/documentation\/Readium"},"https://daisy.github.io/transitiontoepub/best-practices/extended-desc/ExtendedDescriptionsBestPractices.html":{"title":"aria-details","type":"link","identifier":"https:\/\/daisy.github.io\/transitiontoepub\/best-practices\/extended-desc\/ExtendedDescriptionsBestPractices.html","url":"https:\/\/daisy.github.io\/transitiontoepub\/best-practices\/extended-desc\/ExtendedDescriptionsBestPractices.html","titleInlineContent":[{"code":"aria-details","type":"codeVoice"}]},"doc://Readium/documentation/Readium/Accessibility":{"role":"article","url":"\/documentation\/readium\/accessibility","type":"topic","abstract":[{"type":"text","text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the "},{"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","isActive":true},{"type":"text","text":" specification."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","title":"Accessibility","kind":"article"},"https://www.edrlab.org/readium-lcp/":{"type":"link","title":"Readium LCP","titleInlineContent":[{"type":"text","text":"Readium LCP"}],"url":"https:\/\/www.edrlab.org\/readium-lcp\/","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},"doc://Readium/documentation/Readium/Search":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":". EPUB and PDF publications are supported."}],"role":"article","type":"topic","kind":"article","title":"Searching a publication","url":"\/documentation\/readium\/search"},"doc://Readium/documentation/Readium/Open-Publication":{"role":"article","url":"\/documentation\/readium\/open-publication","type":"topic","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","title":"Opening a publication","abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":" and a "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":"."}]},"doc://Readium/documentation/Readium/Migration-Guide":{"abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","type":"topic","kind":"article","url":"\/documentation\/readium\/migration-guide","title":"Migration Guide"},"https://github.com/readium/architecture/pull/177":{"title":"Content Iterator proposal","type":"link","identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","url":"https:\/\/github.com\/readium\/architecture\/pull\/177","titleInlineContent":[{"text":"Content Iterator proposal","type":"text"}]},"doc://Readium/documentation/Readium/Readium-LCP":{"role":"article","url":"\/documentation\/readium\/readium-lcp","type":"topic","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},{"type":"text","text":" DRM."}],"kind":"article","title":"Supporting Readium LCP","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"}}}