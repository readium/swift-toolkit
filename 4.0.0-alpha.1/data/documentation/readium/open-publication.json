{"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":" and a "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":"."}],"seeAlsoSections":[{"generated":true,"title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"anchor":"Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readium\/open-publication"]}],"kind":"article","sections":[],"metadata":{"role":"article","title":"Opening a publication","roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"AssetRetriever","level":2,"text":"`AssetRetriever`"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" grants access to the content of an asset located at a given URL, such as a publication package, manifest, or LCP license."}],"type":"paragraph"},{"type":"heading","anchor":"Constructing-an-AssetRetriever","level":3,"text":"Constructing an `AssetRetriever`"},{"inlineContent":[{"type":"text","text":"You can create an instance of "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" with:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"HTTPClient","type":"codeVoice"},{"text":" to enable the toolkit to perform HTTP requests and support the ","type":"text"},{"code":"http","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"https","type":"codeVoice"},{"text":" URL schemes. You can use ","type":"text"},{"type":"codeVoice","code":"DefaultHTTPClient"},{"text":" which provides callbacks for handling authentication when needed.","type":"text"}]}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["let assetRetriever = AssetRetriever(httpClient: DefaultHTTPClient())"]},{"type":"heading","text":"Retrieving an `Asset`","level":3,"anchor":"Retrieving-an-Asset"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With your fresh instance of "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":", you can open an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" from any "},{"type":"codeVoice","code":"AbsoluteURL"},{"type":"text","text":"."}]},{"syntax":"swift","code":["\/\/ From a local file.","let url = FileURL(string: \"file:\/\/\/path\/to\/book.epub\")","\/\/ or from an HTTP URL.","let url = HTTPURL(string: \"https:\/\/domain\/book.epub\")","","switch await assetRetriever.retrieve(url: url) {","    case .success(let asset):","        ...","    case .failure(let error):","        \/\/ Failed to retrieve the asset.","}"],"type":"codeListing"},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"[!IMPORTANT]","type":"text"},{"text":" ","type":"text"},{"text":"Assets created with an HTTP URL are not downloaded; they will be streamed. If that is not your intention, you need to download the file first, for example using ","type":"text"},{"code":"HTTPClient.download()","type":"codeVoice"},{"text":".","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" will sniff the media type of the asset, which you can store in your bookshelf database to speed up the process next time you retrieve the ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":". This will improve performance, especially with HTTP URL schemes.","type":"text"}]},{"syntax":"swift","code":["let mediaType = asset.format.mediaType","","\/\/ Speed up the retrieval with a known media type.","let result = await assetRetriever.retrieve(url: url, mediaType: mediaType)"],"type":"codeListing"},{"text":"`PublicationOpener`","type":"heading","level":2,"anchor":"PublicationOpener"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" builds a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" object from an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" using:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"PublicationParser"},{"text":" to parse the asset structure and publication metadata.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DefaultPublicationParser"},{"type":"text","text":" handles all the formats supported by Readium out of the box."}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"text":"An optional list of ","type":"text"},{"type":"codeVoice","code":"ContentProtection"},{"text":" to decrypt DRM-protected publications.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you support Readium LCP, you can get one from the "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":"."}]}]}]}]}]},{"type":"codeListing","syntax":"swift","code":["let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"Readium%20LCP.md#opening-a-publication-protected-with-lcp"},{"type":"text","text":" to learn how to create the "},{"type":"codeVoice","code":"LCPAuthenticating"},{"type":"text","text":" instance."}]},{"type":"heading","text":"Opening a `Publication`","anchor":"Opening-a-Publication","level":3},{"type":"paragraph","inlineContent":[{"text":"Now that you have a ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":" ready, you can use it to create a ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" from an ","type":"text"},{"type":"codeVoice","code":"Asset"},{"text":" that was previously obtained using the ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"allowUserInteraction","type":"codeVoice"},{"text":" parameter is useful when supporting Readium LCP. When enabled and using a ","type":"text"},{"code":"LCPDialogAuthentication","type":"codeVoice"},{"text":", the toolkit will prompt the user if the passphrase is missing.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true",")"]},{"type":"heading","text":"Supporting additional formats or URL schemes","anchor":"Supporting-additional-formats-or-URL-schemes","level":2},{"type":"paragraph","inlineContent":[{"code":"DefaultPublicationParser","type":"codeVoice"},{"text":" accepts additional parsers. You also have the option to use your own parser list by using ","type":"text"},{"code":"CompositePublicationParser","type":"codeVoice"},{"text":" or create your own ","type":"text"},{"code":"PublicationParser","type":"codeVoice"},{"text":" for a fully customized parsing resolution strategy.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" offers an additional constructor that provides greater extensibility options, using:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"ResourceFactory","type":"codeVoice"},{"text":" which handles the URL schemes through which you can access content.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ArchiveOpener","type":"codeVoice"},{"text":" which determines the types of archives (ZIP, RAR, etc.) that can be opened by the ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"FormatSniffer","type":"codeVoice"},{"text":" which identifies the file formats that ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" can recognize.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use either the default implementations or implement your own for each of these components using the composite pattern. The toolkit’s "},{"type":"codeVoice","code":"CompositeResourceFactory"},{"type":"text","text":", "},{"type":"codeVoice","code":"CompositeArchiveOpener"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CompositeFormatSniffer"},{"type":"text","text":" provide a simple resolution strategy."}]}]}],"references":{"doc://Readium/documentation/Readium/NavigatorOverview":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","title":"Navigator Overview","type":"topic","url":"\/documentation\/readium\/navigatoroverview","role":"article","kind":"article","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}]},"https://www.w3.org/TR/epub-a11y-1