fier":"s:Sb"}]},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide/RichContent-swift.struct":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RichContent","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"RichContent"}],"title":"AccessibilityMetadataDisplayGuide.RichContent","abstract":[{"type":"text","text":"Indicates the presence of math, chemical formulas, extended descriptions"},{"type":"text","text":" "},{"type":"text","text":"for information rich images, e.g., charts, diagrams, figures, graphs,"},{"type":"text","text":" "},{"text":"and whether these are in an accessible format or available in an","type":"text"},{"type":"text","text":" "},{"text":"alternative form, e.g., whether math and chemical formulas are navigable","type":"text"},{"type":"text","text":" "},{"text":"with assistive technologies, or whether extended descriptions are","type":"text"},{"text":" ","type":"text"},{"text":"available for information-rich images. In addition, it indicates the","type":"text"},{"text":" ","type":"text"},{"text":"presence of videos and if closed captions, open captions, or transcripts","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"for prerecorded audio are available."}],"role":"symbol","url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct"},"doc://Readium/documentation/ReadiumShared":{"role":"collection","url":"\/documentation\/readiumshared","type":"topic","title":"ReadiumShared","abstract":[],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared","kind":"symbol"}}}