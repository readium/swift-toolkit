type":"text","text":" field is optional. When only the start field is specified, the domRange object"},{"type":"text","text":" "},{"type":"text","text":"represents a “collapsed” range that has identical "},{"code":"start","type":"codeVoice"},{"type":"text","text":" and "},{"code":"end","type":"codeVoice"},{"type":"text","text":" boundary points."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"https:\/\/github.com\/readium\/architecture\/blob\/master\/models\/locators\/extensions\/html.md#the-domrange-object"}],"type":"paragraph"}]}],"references":{"doc://Readium/documentation/ReadiumShared":{"role":"collection","url":"\/documentation\/readiumshared","type":"topic","title":"ReadiumShared","abstract":[],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared","kind":"symbol"},"doc://Readium/documentation/ReadiumShared/DOMRange/JSONValueDecodable-Implementations":{"role":"collectionGroup","url":"\/documentation\/readiumshared\/domrange\/jsonvaluedecodable-implementations","type":"topic","kind":"article","title":"JSONValueDecodable Implementations","abstract":[],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/JSONValueDecodable-Implementations"},"doc://Readium/documentation/ReadiumShared/DOMRange/jsonObject":{"type":"topic","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/DOMRange\/jsonObject","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"jsonObject"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"JSONValue","preciseIdentifier":"s:13ReadiumShared9JSONValueO"},{"kind":"text","text":"]"}],"title":"jsonObject","abstract":[],"role":"symbol","url":"\/documentation\/readiumshared\/domrange\/jsonobject","kind":"symbol"},"doc://Readium/documentation/ReadiumShared/DOMRange/init(start:end:)":{"abstract":[],"identifier":"doc:\/\/Readium\/documentation\/ReadiumSha