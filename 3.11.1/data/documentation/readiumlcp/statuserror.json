{"topicSections":[{"anchor":"Enumeration-Cases","title":"Enumeration Cases","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/cancelled(_:)","doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/expired(start:end:)","doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/returned(_:)","doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/revoked(_:devicesCount:)"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/Error-Implementations"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusError","kind":"identifier"}],"platforms":["iOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"For the case (revoked, returned, cancelled, expired), app should notify the","type":"text"},{"text":" ","type":"text"},{"text":"user and stop there. The message to the user must be clear about the status","type":"text"},{"text":" ","type":"text"},{"text":"of the license: don’t display “expired” if the status is “revoked”. The","type":"text"},{"text":" ","type":"text"},{"text":"date and time corresponding to the new status should be displayed (e.g.","type":"text"},{"text":" ","type":"text"},{"text":"“The license expired on 01 January 2018”).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the license has been revoked, the user message should display the number","type":"text"},{"text":" ","type":"text"},{"text":"of devices which registered to the server. This count can be calculated","type":"text"},{"text":" ","type":"text"},{"text":"from the number of “register” events in the status document. If no event is","type":"text"},{"text":" ","type":"text"},{"text":"logged in the status document, no such message should appear (certainly not","type":"text"},{"text":" ","type":"text"},{"text":"“The license was registered by 0 devices”).","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/ReadiumLCP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Errors while checking the status of the License, using the Status Document.","type":"text"}],"metadata":{"externalID":"s:10ReadiumLCP11StatusErrorO","modules":[{"name":"ReadiumLCP"}],"navigatorTitle":[{"text":"StatusError","kind":"identifier"}],"title":"StatusError","role":"symbol","symbolKind":"enum","roleHeading":"Enumeration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusError","kind":"identifier"}]},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Readium\/s5ErrorP","doc:\/\/Readium\/s8SendableP"],"type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readiumlcp\/statuserror"]}],"sections":[],"references":{"doc://Readium/documentation/ReadiumLCP/StatusError/returned(_:)":{"role":"symbol","kind":"symbol","abstract":[{"text":"This license has been returned on the given date.","type":"text"}],"url":"\/documentation\/readiumlcp\/statuserror\/returned(_:)","identifier":"doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/returned(_:)","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"returned","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV"},{"text":")","kind":"text"}],"title":"StatusError.returned(_:)"},"doc://Readium/documentation/ReadiumLCP/StatusError/expired(start:end:)":{"abstract":[{"type":"text","text":"This license started and expired on the given dates."}],"identifier":"doc:\/\/Read