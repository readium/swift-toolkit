rtion is"},{"type":"text","text":" "},{"type":"text","text":"percent-encoded: any "},{"type":"codeVoice","code":"?query"},{"type":"text","text":" and "},{"type":"codeVoice","code":"#fragment"},{"type":"text","text":" are split off and"},{"type":"text","text":" "},{"type":"text","text":"reattached verbatim. This keeps their "},{"type":"codeVoice","code":"?"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"#"},{"type":"text","text":" separators intact (a plain"},{"type":"text","text":" "},{"type":"text","text":"path encoding would turn them into "},{"type":"codeVoice","code":"%3F"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"%23"},{"type":"text","text":") and preserves any"},{"type":"text","text":" "},{"type":"text","text":"existing encoding in the query or fragment instead of double-encoding it."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/readiumshared\/relativeurl\/init(epubhref:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/ReadiumShared\/RelativeURL\/init(epubHREF:)"},"references":{"doc://Readium/documentation/ReadiumShared/RelativeURL":{"navigatorTitle":[{"text":"RelativeURL","kind":"identifier"}],"type":"topic","role":"symbol","title":"RelativeURL","url":"\/documentation\/readiumshared\/relativeurl","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/RelativeURL","abstract":[{"text":"Represents a relative URL.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RelativeURL","kind":"identifier"}]},"doc://Readium/documentation/ReadiumShared":{"kind":"symbol","abstract":[],"url":"\/documentation\/readiumshared","type":"topic","role":"collection","title":"ReadiumShared","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared"},"doc://Readium/documentation/ReadiumShared/RelativeURL/init(epubHREF:)":{"abstract":[{"type":"text","text":"According to the EPUB specification,