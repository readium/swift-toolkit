imal match. Plain-text queries","type":"text"},{"text":" ","type":"text"},{"text":"are not affected by this limitation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This service requires the publication to have a configured ","type":"text"},{"code":"ContentService","type":"codeVoice"},{"text":".","type":"text"}]}]}],"metadata":{"symbolKind":"class","modules":[{"name":"ReadiumShared"}],"navigatorTitle":[{"text":"ContentSearchService","kind":"identifier"}],"roleHeading":"Class","externalID":"s:13ReadiumShared20ContentSearchServiceC","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContentSearchService","kind":"identifier"}],"title":"ContentSearchService"},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/ReadiumShared"]]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/Closeable","doc:\/\/Readium\/documentation\/ReadiumShared\/Loggable","doc:\/\/Readium\/documentation\/ReadiumShared\/PublicationService","doc:\/\/Readium\/documentation\/ReadiumShared\/SearchService"],"type":"conformsTo"}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/init(publication:language:snippetLength:searchAlgorithm:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/options"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/search(query:options:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Type Methods","identifiers":["doc:\/\/Readium\/documentation\/ReadiumShared\/ContentSearchService\/makeFactory(snippetLength:searchAlgorithm:)"],"generated":true,"anchor":"Type-Methods"},{"title":"Default Implementations","identifiers":["doc