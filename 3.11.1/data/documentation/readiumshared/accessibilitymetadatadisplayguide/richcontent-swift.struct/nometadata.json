/AccessibilityMetadataDisplayGuide","role":"symbol","url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide","navigatorTitle":[{"kind":"identifier","text":"AccessibilityMetadataDisplayGuide"}],"kind":"symbol","abstract":[{"text":"When presenting accessibility metadata provided by the publisher, it is","type":"text"},{"text":" ","type":"text"},{"text":"suggested that the section is introduced using terms such as “claims” or","type":"text"},{"text":" ","type":"text"},{"text":"“declarations” (e.g., “Accessibility Claims”).","type":"text"}]},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide/RichContent-swift.struct":{"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct","title":"AccessibilityMetadataDisplayGuide.RichContent","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RichContent","kind":"identifier"}],"navigatorTitle":[{"text":"RichContent","kind":"identifier"}],"url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct","type":"topic","kind":"symbol","abstract":[{"text":"Indicates the presence of math, chemical formulas, extended descriptions","type":"text"},{"text":" ","type":"text"},{"text":"for information rich images, e.g., charts, diagrams, figures, graphs,","type":"text"},{"text":" ","type":"text"},{"text":"and whether these are in an accessible format or available in an","type":"text"},{"text":" ","type":"text"},{"text":"alternative form, e.g., whether math and chemical formulas are navigable","type":"text"},{"text":" ","type":"text"},{"text":"with assistive technologies, or whether extended descriptions are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"available for information-rich images. In addition, it indicates the"},{"type":"text","text":" "},{"type":"text","text":"presence of videos and if closed captions, open captions, or transcripts"},{"type":"text","text":" "},{"type":"text","text":"for prerecorded audio are available."}]},"doc://Readium/documentation/ReadiumShared":{"kind":"symbol","abstract":[],"url":"\/documentation\/readiumshared","type":"topic","role":"collection","title":"ReadiumShared","identifier":"doc:\/\/Readium\/documentation\/ReadiumShared"},"doc://Readium/documentation/ReadiumShared/AccessibilityMetadataDisplayGuide/RichContent-swift.struct/noMetadata":{"type":"topic","url":"\/documentation\/readiumshared\/accessibilitymetadatadisplayguide\/richcontent-swift.struct\/nometadata","title":"noMetadata","kind":"symbol","abstract":[{"text":"Indicates whether no information about rich content is available.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"noMetadata"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/AccessibilityMetadataDisplayGuide\/RichContent-swift.struct\/noMetadata","role":"symbol"}}}