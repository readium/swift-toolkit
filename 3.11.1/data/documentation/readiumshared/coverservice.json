":"text","text":" "},{"type":"text","text":"implementation actually depends on the publication format:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Some might allow vector images or even HTML pages, in which case they","type":"text"},{"text":" ","type":"text"},{"text":"need to be converted to bitmaps.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Others require to render the cover from a specific file format, e.g. PDF."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Furthermore, a reading app might want to use a custom strategy to choose the"},{"type":"text","text":" "},{"type":"text","text":"cover image, for example by:"}]},{"items":[{"content":[{"inlineContent":[{"text":"iterating through the images collection for a publication parsed from an","type":"text"},{"text":" ","type":"text"},{"text":"OPDS 2 feed","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"generating a bitmap from scratch using the publication’s title"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"using a cover selected by the user"}]}]}],"type":"unorderedList"}],"kind":"content"}],"abstract":[{"type":"text","text":"Provides an easy access to a bitmap version of the publication cover."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/readiumshared\/coverservice"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Readium/documentation/ReadiumShared/Closeable":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Closeable","kind":"identifier"}],"title":"Closeable","navigatorTitle":[{"text":"Closeable","kind":"identifier"}],"identifier":"doc:\/\/Readium\/documentation\/ReadiumShared\/Closeable","abstract":[{"text":"Holds closeable resources, such as open files or streams.","type":"text"}],"type":"topic","url":"