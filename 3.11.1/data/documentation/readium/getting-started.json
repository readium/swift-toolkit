{"metadata":{"title":"Getting started","roleHeading":"Article","role":"article"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"Readium offers only low-level tools. You are responsible for creating a user interface for reading and managing books, as well as a data layer to store the user’s publications. The Test App is an example of such integration."}]}],"type":"aside","name":"Note"},{"level":2,"text":"Design principles","type":"heading","anchor":"Design-principles"},{"inlineContent":[{"text":"The toolkit has been designed following these core tenets:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modular"}]},{"type":"text","text":": It is divided into separate modules that can be used independently."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Extensible","type":"text"}],"type":"strong"},{"text":": Integrators should be able to support a custom DRM, publication format or inject their own stylesheets without modifying the toolkit itself.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Opiniated"}],"type":"strong"},{"text":": We adhere to open standards but sometimes interpret them for practicality.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Packages","type":"heading","anchor":"Packages"},{"level":3,"text":"Main packages","type":"heading","anchor":"Main-packages"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumShared"},{"type":"text","text":" contains shared "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" models and utilities."}]}]},{"content":[{"inlineContent":[{"code":"ReadiumStreamer","type":"codeVoice"},{"type":"text","text":" parses publication files (e.g. an EPUB) into a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":" object."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"Navigator\/Navigator.md"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"level":3,"text":"Specialized packages","type":"heading","anchor":"Specialized-packages"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ReadiumOPDS"},{"type":"text","text":" parses "},{"type":"reference","identifier":"https:\/\/opds.io","isActive":true},{"type":"text","text":" (both OPDS 1 and 2)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"Readium%20LCP.md","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Overview of the shared models (`ReadiumShared`)","type":"heading","anchor":"Overview-of-the-shared-models-ReadiumShared"},{"inlineContent":[{"text":"The Readium toolkit provides models used as exchange types between packages.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Publication models","type":"heading","anchor":"Publication-models"},{"level":4,"text":"Publication","type":"heading","anchor":"Publication"},{"inlineContent":[{"code":"Publication","type":"codeVoice"},{"text":" and its sub-components represent a single publication – ebook, audiobook or comic. It is loosely based on the ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/readium.org\/webpub-manifest\/"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"holds the metadata of a publication, such as its author or table of contents,","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"allows to read the contents of a publication, e.g. XHTML or audio resources,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"provides additional services, for example content extraction or text search.","type":"text"}]}]}],"type":"unorderedList"},{"level":4,"text":"Link","type":"heading","anchor":"Link"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","isActive":true,"type":"reference"},{"text":" holds a pointer (URL) to a resource or service along with additional metadata, such as its media type or title.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" contains several ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" collections, for example:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"readingOrder","type":"codeVoice"},{"text":" lists the publication resources arranged in the order they should be read.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"resources"},{"type":"text","text":" contains secondary resources necessary for rendering the "},{"type":"codeVoice","code":"readingOrder"},{"type":"text","text":", such as an image or a font file."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"tableOfContents"},{"text":" represents the table of contents as a tree of ","type":"text"},{"type":"codeVoice","code":"Link"},{"text":" objects.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"links"},{"type":"text","text":" exposes additional resources, such as a canonical link to the manifest or a search web service."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":4,"text":"Locator","type":"heading","anchor":"Locator"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/architecture\/models\/locators\/"},{"type":"text","text":" represents a precise location in a publication resource in a format that can be stored and shared across reading systems. It is more accurate than a "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" and contains additional information about the location, e.g. progression percentage, position or textual context."}],"type":"paragraph"},{"inlineContent":[{"code":"Locator","type":"codeVoice"},{"text":" objects are used for various features, including:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reporting the current progression in the publication"}]}]},{"content":[{"inlineContent":[{"text":"saving bookmarks, highlights and annotations","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"navigating search results"}]}]}],"type":"unorderedList"},{"level":3,"text":"Data models","type":"heading","anchor":"Data-models"},{"level":4,"text":"Asset","type":"heading","anchor":"Asset"},{"inlineContent":[{"text":"An ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":" represents a single file or package and provides access to its content. There are two types of ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ContainerAsset"},{"type":"text","text":" for packages which contains several resources, such as a ZIP archive."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ResourceAsset"},{"type":"text","text":" for accessing a single resource, such as a JSON or PDF file."}]}]}],"type":"unorderedList"},{"inlineContent":[{"code":"Asset","type":"codeVoice"},{"type":"text","text":" instances are obtained through an "},{"code":"AssetRetriever","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can use the "},{"type":"codeVoice","code":"asset.format"},{"type":"text","text":" to identify the media type and capabilities of the asset."}],"type":"paragraph"},{"syntax":"swift","code":["if asset.format.conformsTo(.lcp) {","    \/\/ The asset is protected with LCP.","}","if asset.format.conformsTo(.epub) {","    \/\/ The asset represents an EPUB publication.","}"],"type":"codeListing"},{"level":4,"text":"Resource","type":"heading","anchor":"Resource"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Resource"},{"type":"text","text":" provides read access to a single resource, such as a file or an entry in an archive."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Resource"},{"type":"text","text":" instances are usually created by a "},{"type":"codeVoice","code":"ResourceFactory"},{"type":"text","text":". The toolkit ships with various implementations supporting different data access protocols such as local files or HTTP."}],"type":"paragraph"},{"level":4,"text":"Container","type":"heading","anchor":"Container"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" provides read access to a collection of resources. ","type":"text"},{"code":"Container","type":"codeVoice"},{"text":" instances representing an archive are usually created by an ","type":"text"},{"code":"ArchiveOpener","type":"codeVoice"},{"text":". The toolkit ships with a ","type":"text"},{"code":"ZIPArchiveOpener","type":"codeVoice"},{"text":" supporting both local and remote (HTTP) ZIP files.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Publication"},{"type":"text","text":" objects internally use a "},{"type":"codeVoice","code":"Container"},{"type":"text","text":" to expose its content."}],"type":"paragraph"},{"level":2,"text":"Opening a publication (`ReadiumStreamer`)","type":"heading","anchor":"Opening-a-publication-ReadiumStreamer"},{"inlineContent":[{"text":"To retrieve a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" object from a publication file like an EPUB or audiobook, you can use an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    )",")","","let url: URL = URL(...)","","\/\/ Retrieve an `Asset` to access the file content.","switch await assetRetriever.retrieve(url: url.anyURL.absoluteURL!) {","case .success(let asset):","    \/\/ Open a `Publication` from the `Asset`.","    switch await publicationOpener.open(asset: asset, allowUserInteraction: true, sender: view) {","    case .success(let publication):","        print(\"Opened \\(publication.metadata.title)\")","","    case .failure(let error):","        \/\/ Failed to access or parse the publication","    }","","case .failure(let error):","    \/\/ Failed to retrieve the asset","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"allowUserInteraction"},{"text":" parameter is useful when supporting a DRM like Readium LCP. It indicates if the toolkit can prompt the user for credentials when the publication is protected.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"Open%20Publication.md"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Accessing the metadata of a publication","type":"heading","anchor":"Accessing-the-metadata-of-a-publication"},{"inlineContent":[{"type":"text","text":"After opening a publication, you may want to read its metadata to insert a new entity into your bookshelf database, for instance. The "},{"type":"codeVoice","code":"publication.metadata"},{"type":"text","text":" object contains everything you need, including "},{"type":"codeVoice","code":"title"},{"type":"text","text":", "},{"type":"codeVoice","code":"authors"},{"type":"text","text":" and the "},{"type":"codeVoice","code":"published"},{"type":"text","text":" date."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can retrieve the publication cover using "},{"type":"codeVoice","code":"await publication.cover()"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Rendering the publication on the screen (`ReadiumNavigator`)","type":"heading","anchor":"Rendering-the-publication-on-the-screen-ReadiumNavigator"},{"inlineContent":[{"text":"You can use a Readium navigator to present the publication to the user. The ","type":"text"},{"code":"Navigator","type":"codeVoice"},{"text":" renders resources on the screen and offers APIs and user interactions for navigating the contents.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Please refer to the ","type":"text"},{"identifier":"Navigator\/Navigator.md","overridingTitle":"Navigator guide","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"Navigator guide","type":"text"}]},{"text":" for more information.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started"},"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"title":"Guides"}],"references":{"Readium%20LCP.md":{"titleInlineContent":[{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" downloads and decrypts LCP-protected publications"}],"type":"link","identifier":"Readium%20LCP.md","url":"Readium%20LCP.md","title":"ReadiumLCP downloads and decrypts LCP-protected publications"},"Open%20Publication.md":{"title":"See the dedicated user guide for more information","titleInlineContent":[{"text":"See the dedicated user guide for more information","type":"text"}],"identifier":"Open%20Publication.md","type":"link","url":"Open%20Publication.md"},"https://opds.io":{"titleInlineContent":[{"text":"OPDS catalog feeds","type":"text"}],"url":"https:\/\/opds.io","type":"link","title":"OPDS catalog feeds","identifier":"https:\/\/opds.io"},"doc://Readium/documentation/Readium/NavigatorOverview":{"type":"topic","url":"\/documentation\/readium\/navigatoroverview","role":"article","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}],"title":"Navigator Overview"},"doc://Readium/documentation/Readium":{"abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"title":"Readium","identifier":"doc:\/\/Readium\/documentation\/Readium","url":"\/documentation\/readium","kind":"article","role":"collection","type":"topic"},"https://readium.org/architecture/models/locators/":{"title":"Locator object","titleInlineContent":[{"type":"codeVoice","code":"Locator"},{"text":" object","type":"text"}],"identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","type":"link","url":"https:\/\/readium.org\/architecture\/models\/locators\/"},"doc://Readium/documentation/Readium/Search":{"type":"topic","url":"\/documentation\/readium\/search","title":"Searching a publication","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","role":"article","kind":"article","abstract":[{"text":"The Search API lets you look for a textual query in the content of a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":". EPUB and PDF publications are supported.","type":"text"}]},"doc://Readium/documentation/Readium/TTS":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","kind":"article","title":"Text-to-speech","type":"topic","url":"\/documentation\/readium\/tts","abstract":[],"role":"article"},"https://www.w3.org/TR/epub-a11y-11":{"titleInlineContent":[{"text":"EPUB Accessibility","type":"text"}],"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"link","title":"EPUB Accessibility","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/Content":{"role":"article","kind":"article","title":"Extracting the content of a publication","url":"\/documentation\/readium\/content","abstract":[],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","type":"topic"},"https://readium.org/webpub-manifest/":{"title":"Readium Web Publication Manifest","titleInlineContent":[{"text":"Readium Web Publication Manifest","type":"text"}],"identifier":"https:\/\/readium.org\/webpub-manifest\/","type":"link","url":"https:\/\/readium.org\/webpub-manifest\/"},"https://readium.org/webpub-manifest/#24-the-link-object":{"titleInlineContent":[{"type":"codeVoice","code":"Link"},{"text":" object","type":"text"}],"url":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","type":"link","title":"Link object","identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object"},"doc://Readium/documentation/Readium/Readium-LCP":{"role":"article","kind":"article","title":"Supporting Readium LCP","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true},{"type":"text","text":" DRM."}],"type":"topic","url":"\/documentation\/readium\/readium-lcp"},"doc://Readium/documentation/Readium/Migration-Guide":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","title":"Migration Guide","url":"\/documentation\/readium\/migration-guide","type":"topic","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}],"kind":"article"},"doc://Readium/documentation/Readium/Accessibility":{"kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","title":"Accessibility","type":"topic","role":"article","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},{"text":" specification.","type":"text"}],"url":"\/documentation\/readium\/accessibility"},"doc://Readium/documentation/Readium/Open-Publication":{"kind":"article","abstract":[{"text":"To open a publication with Readium, you need to instantiate a couple of components: an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/readium\/open-publication","role":"article","title":"Opening a publication","type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication"},"Navigator/Navigator.md":{"title":"ReadiumNavigator renders the content of a publication","titleInlineContent":[{"type":"codeVoice","code":"ReadiumNavigator"},{"text":" renders the content of a publication","type":"text"}],"identifier":"Navigator\/Navigator.md","type":"link","url":"Navigator\/Navigator.md"},"https://www.edrlab.org/readium-lcp/":{"titleInlineContent":[{"text":"Readium LCP","type":"text"}],"url":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"link","title":"Readium LCP","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"}}}