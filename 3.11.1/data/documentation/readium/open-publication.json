{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":"."}],"seeAlsoSections":[{"title":"Guides","generated":true,"anchor":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"]}],"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","interfaceLanguage":"swift"},"metadata":{"title":"Opening a publication","role":"article","roleHeading":"Article"},"primaryContentSections":[{"content":[{"anchor":"AssetRetriever","type":"heading","text":"`AssetRetriever`","level":2},{"inlineContent":[{"text":"The ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" grants access to the content of an asset located at a given URL, such as a publication package, manifest, or LCP license.","type":"text"}],"type":"paragraph"},{"anchor":"Constructing-an-AssetRetriever","type":"heading","text":"Constructing an `AssetRetriever`","level":3},{"inlineContent":[{"type":"text","text":"You can create an instance of "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" with:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"HTTPClient","type":"codeVoice"},{"text":" to enable the toolkit to perform HTTP requests and support the ","type":"text"},{"code":"http","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"https","type":"codeVoice"},{"text":" URL schemes. You can use ","type":"text"},{"code":"DefaultHTTPClient","type":"codeVoice"},{"text":" which provides callbacks for handling authentication when needed.","type":"text"}]}]}],"type":"unorderedList"},{"code":["let assetRetriever = AssetRetriever(httpClient: DefaultHTTPClient())"],"syntax":"swift","type":"codeListing"},{"anchor":"Retrieving-an-Asset","type":"heading","text":"Retrieving an `Asset`","level":3},{"inlineContent":[{"type":"text","text":"With your fresh instance of "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":", you can open an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" from any "},{"type":"codeVoice","code":"AbsoluteURL"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ From a local file.","let url = FileURL(string: \"file:\/\/\/path\/to\/book.epub\")","\/\/ or from an HTTP URL.","let url = HTTPURL(string: \"https:\/\/domain\/book.epub\")","","switch await assetRetriever.retrieve(url: url) {","    case .success(let asset):","        ...","    case .failure(let error):","        \/\/ Failed to retrieve the asset.","}"],"syntax":"swift","type":"codeListing"},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"[!IMPORTANT]"},{"type":"text","text":" "},{"type":"text","text":"Assets created with an HTTP URL are not downloaded; they will be streamed. If that is not your intention, you need to download the file first, for example using "},{"type":"codeVoice","code":"HTTPClient.download()"},{"type":"text","text":"."}],"type":"paragraph"}]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" will sniff the media type of the asset, which you can store in your bookshelf database to speed up the process next time you retrieve the ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":". This will improve performance, especially with HTTP URL schemes.","type":"text"}],"type":"paragraph"},{"code":["let mediaType = asset.format.mediaType","","\/\/ Speed up the retrieval with a known media type.","let result = await assetRetriever.retrieve(url: url, mediaType: mediaType)"],"syntax":"swift","type":"codeListing"},{"anchor":"PublicationOpener","type":"heading","text":"`PublicationOpener`","level":2},{"inlineContent":[{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" builds a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" object from an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" using:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"PublicationParser","type":"codeVoice"},{"text":" to parse the asset structure and publication metadata.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DefaultPublicationParser"},{"type":"text","text":" handles all the formats supported by Readium out of the box."}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional list of "},{"type":"codeVoice","code":"ContentProtection"},{"type":"text","text":" to decrypt DRM-protected publications."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you support Readium LCP, you can get one from the "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":"."}]}]}],"type":"unorderedList"}]}],"type":"unorderedList"},{"code":["let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication())","    ]",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Opening-a-Publication","type":"heading","text":"Opening a `Publication`","level":3},{"inlineContent":[{"type":"text","text":"Now that you have a "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" ready, you can use it to create a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" from an "},{"type":"codeVoice","code":"Asset"},{"type":"text","text":" that was previously obtained using the "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"allowUserInteraction"},{"text":" parameter is useful when supporting Readium LCP. When enabled and using a ","type":"text"},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"text":", the toolkit will prompt the user if the passphrase is missing.","type":"text"}],"type":"paragraph"},{"code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: sender",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Supporting-additional-formats-or-URL-schemes","type":"heading","text":"Supporting additional formats or URL schemes","level":2},{"inlineContent":[{"type":"codeVoice","code":"DefaultPublicationParser"},{"text":" accepts additional parsers. You also have the option to use your own parser list by using ","type":"text"},{"type":"codeVoice","code":"CompositePublicationParser"},{"type":"text","text":" or create your own "},{"type":"codeVoice","code":"PublicationParser"},{"type":"text","text":" for a fully customized parsing resolution strategy."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":" offers an additional constructor that provides greater extensibility options, using:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ResourceFactory","type":"codeVoice"},{"type":"text","text":" which handles the URL schemes through which you can access content."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ArchiveOpener"},{"text":" which determines the types of archives (ZIP, RAR, etc.) that can be opened by the ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FormatSniffer"},{"type":"text","text":" which identifies the file formats that "},{"type":"codeVoice","code":"AssetRetriever"},{"type":"text","text":" can recognize."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use either the default implementations or implement your own for each of these components using the composite pattern. The toolkit’s "},{"type":"codeVoice","code":"CompositeResourceFactory"},{"type":"text","text":", "},{"type":"codeVoice","code":"CompositeArchiveOpener"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CompositeFormatSniffer"},{"type":"text","text":" provide a simple resolution strategy."}]}],"kind":"content"}],"kind":"article","references":{"doc://Readium/documentation/Readium/Readium-LCP":{"role":"article","kind":"article","title":"Supporting Readium LCP","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true},{"type":"text","text":" DRM."}],"type":"topic","url":"\/documentation\/readium\/readium-lcp"},"https://www.w3.org/TR/epub-a11y-11":{"titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"type":"link","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility"},"doc://Readium/docum