{"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"The described feature is still experimental and the implementation incomplete."}]}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"Many high-level features require access to the raw content (text, media, etc.) of a publication, such as:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Text-to-speech","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Accessibility reader","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Basic search","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full-text search indexing"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Image or audio indexes"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ContentService"},{"type":"text","text":" provides a way to iterate through a publication’s content, extracted as semantic elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"First, request the publication’s "},{"type":"codeVoice","code":"Content"},{"type":"text","text":", starting from a given "},{"type":"codeVoice","code":"Locator"},{"type":"text","text":". If the locator is missing, the "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" will be extracted from the beginning of the publication."}]},{"syntax":"swift","code":["guard let content = publication.content(from: startLocator) else {","    \/\/ Abort as the content cannot be extracted","    return","}"],"type":"codeListing"},{"anchor":"Extracting-the-raw-text-content","level":2,"text":"Extracting the raw text content","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Getting the whole raw text of a publication is such a common use case that a helper is available on "},{"code":"Content","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","code":["let wholeText = content.text()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is an expensive operation, proceed with caution and cache the result if you need to reuse it."}]},{"anchor":"Iterating-through-the-content","level":2,"text":"Iterating through the content","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The individual "},{"code":"Content","type":"codeVoice"},{"type":"text","text":" elements can be iterated through with a regular "},{"code":"for","type":"codeVoice"},{"type":"text","text":" loop by converting it to a sequence:"}]},{"syntax":"swift","code":["for element in content.sequence() {","    \/\/ Process element","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Alternatively, you can get the whole list of elements with ","type":"text"},{"type":"codeVoice","code":"content.elements()"},{"text":", or use the lower level APIs to iterate the content manually:","type":"text"}]},{"syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.next() {","    print(element)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Some ","type":"text"},{"type":"codeVoice","code":"Content"},{"text":" implementations support bidirectional iterations. To iterate backwards, use:","type":"text"}]},{"syntax":"swift","code":["let iterator = content.iterator()","while let element = try iterator.previous() {","    print(element)","}"],"type":"codeListing"},{"anchor":"Processing-the-elements","level":2,"text":"Processing the elements","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Content"},{"type":"text","text":" iterator yields "},{"type":"codeVoice","code":"ContentElement"},{"type":"text","text":" objects representing a single semantic portion of the publication, such as a heading, a paragraph or an embedded image."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every element has a "},{"type":"codeVoice","code":"locator"},{"type":"text","text":" property targeting it in the publication. You can use the locator, for example, to navigate to the element or to draw a "},{"type":"codeVoice","code":"Decoration"},{"type":"text","text":" on top of it."}]},{"syntax":"swift","code":["navigator.go(to: element.locator)"],"type":"codeListing"},{"anchor":"Types-of-elements","level":3,"text":"Types of elements","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Depending on the actual implementation of ","type":"text"},{"code":"ContentElement","type":"codeVoice"},{"text":", more properties are available to access the actual data. The toolkit ships with a number of default implementations for common types of elements.","type":"text"}]},{"anchor":"Embedded-media","level":4,"text":"Embedded media","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"EmbeddedContentElement","type":"codeVoice"},{"text":" protocol is implemented by any element referencing an external resource. It contains an ","type":"text"},{"code":"embeddedLink","type":"codeVoice"},{"text":" property you can use to get the actual content of the resource.","type":"text"}]},{"syntax":"swift","code":["if let element = element as? EmbeddedContentElement {","    let bytes = try publication","        .get(element.embeddedLink)","        .read().get()","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here are the default available implementations:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"AudioContentElement","type":"codeVoice"},{"text":" - audio clips","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"VideoContentElement"},{"type":"text","text":" - video clips"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ImageContentElement","type":"codeVoice"},{"text":" - bitmap images, with the additional property:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"caption: String?"},{"type":"text","text":" - figure caption, when available"}],"type":"paragraph"}]}],"type":"unorderedList"}]}]},{"anchor":"Text","level":4,"text":"Text","type":"heading"},{"anchor":"Textual-elements","level":5,"text":"Textual elements","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"TextualContentElement"},{"text":" protocol is implemented by any element which can be represented as human-readable text. This is useful when you want to extract the text content of a publication without caring for each individual type of elements.","type":"text"}]},{"syntax":"swift","code":["let wholeText = publication.content()","    .elements()","    .compactMap { ($0 as? TextualContentElement)?.text.takeIf { !$0.isEmpty } }","    .joined(separator: \"\\n\")"],"type":"codeListing"},{"anchor":"Text-elements","level":5,"text":"Text elements","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Actual text elements are instances of ","type":"text"},{"code":"TextContentElement","type":"codeVoice"},{"text":", which represent a single block of text such as a heading, a paragraph or a list item. It is comprised of a ","type":"text"},{"code":"role","type":"codeVoice"},{"text":" and a list of ","type":"text"},{"code":"segments","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"role","type":"codeVoice"},{"text":" is the nature of the text element in the document. For example a heading, body, footnote or a quote. It can be used to reconstruct part of the structure of the original document.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A text element is composed of individual segments with their own "},{"type":"codeVoice","code":"locator"},{"type":"text","text":" and "},{"type":"codeVoice","code":"attributes"},{"type":"text","text":". They are useful to associate attributes with a portion of a text element. For example, given the HTML paragraph:"}]},{"syntax":"html","code":["<p>It is pronounced <span lang=\"fr\">croissant<\/span>.<\/p>"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The following ","type":"text"},{"code":"TextContentElement","type":"codeVoice"},{"text":" will be produced:","type":"text"}]},{"syntax":"swift","code":["TextContentElement(","    role: .body,","    segments: [","        TextContentElement.Segment(text: \"It is pronounced \"),","        TextContentElement.Segment(text: \"croissant\", attributes: [ContentAttribute(key: .language, value: \"fr\")]),","        TextContentElement.Segment(text: \".\")","    ]",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"If you are not interested in the segment attributes, you can also use ","type":"text"},{"type":"codeVoice","code":"element.text"},{"text":" to get the concatenated raw text.","type":"text"}]},{"anchor":"Element-attributes","level":3,"text":"Element attributes","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All types of "},{"code":"ContentElement","type":"codeVoice"},{"type":"text","text":" can have associated attributes. Custom "},{"code":"ContentService","type":"codeVoice"},{"type":"text","text":" implementations can use this as an extensibility point."}]},{"anchor":"Use-cases","level":2,"text":"Use cases","type":"heading"},{"anchor":"An-index-of-all-images-embedded-in-the-publication","level":3,"text":"An index of all images embedded in the publication","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This example extracts all the embedded images in the publication and displays them in a SwiftUI list. Clicking on an image jumps to its location in the publication.","type":"text"}]},{"syntax":"swift","code":["struct ImageIndex: View {","    struct Item: Hashable {","        let locator: Locator","        let text: String?","        let image: UIImage","    }","","    let publication: Publication","    let navigator: Navigator","    @State private var items: [Item] = []","","    init(publication: Publication, navigator: Navigator) {","        self.publication = publication","        self.navigator = navigator","    }","","    var body: some View {","        ScrollView {","            LazyVStack {","                ForEach(items, id: \\.self) { item in","                    VStack() {","                        Image(uiImage: item.image)","                        Text(item.text ?? \"No caption\")","                    }","                    .onTapGesture {","                        navigator.go(to: item.locator)","                    }","                }","            }","        }","        .onAppear {","            items = publication.content()?","                .elements()","                .compactMap { element in","                    guard","                        let element = element as? ImageContentElement,","                        let image = try? publication.get(element.embeddedLink)","                            .read().map(UIImage.init).get()","                    else {","                        return nil","                    }","","                    return Item(","                        locator: element.locator,","                        text: element.caption ?? element.accessibilityLabel,","                        image: image","                    )","                }","                ?? []","        }","    }","}"],"type":"codeListing"},{"anchor":"References","level":2,"text":"References","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","type":"reference","isActive":true}]}]}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","title":"Extracting the content of a publication","roleHeading":"Article"},"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"generated":true}],"kind":"article","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Content"},"references":{"doc://Readium/documentation/Readium/Getting-Started":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","role":"article","type":"topic","title":"Getting started","kind":"article","url":"\/documentation\/readium\/getting-started","abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}]},"https://github.com/readium/architecture/pull/177":{"titleInlineContent":[{"type":"text","text":"Content Iterator proposal"}],"url":"https:\/\/github.com\/readium\/architecture\/pull\/177","identifier":"https:\/\/github.com\/readium\/architecture\/pull\/177","type":"link","title":"Content Iterator proposal"},"doc://Readium/documentation/Readium/Open-Publication":{"kind":"article","abstract":[{"text":"To open a publication with Readium, you need to instantiate a couple of components: an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/readium\/open-publication","role":"article","title":"Opening a publication","type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication"},"doc://Readium/documentation/Readium/Accessibility":{"kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","title":"Accessibility","type":"topic","role":"article","abstract":[{"text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},{"text":" specification.","type":"text"}],"url":"\/documentation\/readium\/accessibility"},"https://www.w3.org/TR/epub-a11y-11":{"title":"EPUB Accessibility","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"link","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/TTS":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","kind":"article","title":"Text-to-speech","type":"topic","url":"\/documentation\/readium\/tts","abstract":[],"role":"article"},"doc://Readium/documentation/Readium/Migration-Guide":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","title":"Migration Guide","url":"\/documentation\/readium\/migration-guide","type":"topic","abstract":[{"text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file.","type":"text"}],"kind":"article"},"doc://Readium/documentation/Readium/NavigatorOverview":{"type":"topic","url":"\/documentation\/readium\/navigatoroverview","role":"article","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}],"title":"Navigator Overview"},"doc://Readium/documentation/Readium/Search":{"type":"topic","url":"\/documentation\/readium\/search","title":"Searching a publication","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","role":"article","kind":"article","abstract":[{"text":"The Search API lets you look for a textual query in the content of a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":". EPUB and PDF publications are supported.","type":"text"}]},"https://www.edrlab.org/readium-lcp/":{"titleInlineContent":[{"type":"text","text":"Readium LCP"}],"url":"https:\/\/www.edrlab.org\/readium-lcp\/","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"link","title":"Readium LCP"},"doc://Readium/documentation/Readium":{"abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"title":"Readium","identifier":"doc:\/\/Readium\/documentation\/Readium","url":"\/documentation\/readium","kind":"article","role":"collection","type":"topic"},"doc://Readium/documentation/Readium/Readium-LCP":{"role":"article","kind":"article","title":"Supporting Readium LCP","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true},{"type":"text","text":" DRM."}],"type":"topic","url":"\/documentation\/readium\/readium-lcp"}}}