{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"anchor":"Checking-if-a-publication-is-searchable","text":"Checking if a publication is searchable","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Not every publication has a search service attached. Check ","type":"text"},{"inlineContent":[{"code":"isSearchable","type":"codeVoice"}],"type":"strong"},{"text":" before offering a search UI.","type":"text"}]},{"type":"codeListing","code":["guard publication.isSearchable else {","    \/\/ Hide or disable the search UI.","    return","}"],"syntax":"swift"},{"anchor":"Performing-a-search","text":"Performing a search","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"publication.search(query:options:)"}]},{"text":" to start a new search. This method returns a ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SearchResult<SearchIterator>"}]},{"text":" — either a cursor to page through results, or a ","type":"text"},{"type":"strong","inlineContent":[{"code":"SearchError","type":"codeVoice"}]},{"text":".","type":"text"}]},{"type":"codeListing","code":["let result = await publication.search(query: \"red panda\")","","switch result {","case .success(let iterator):","    \/\/ Use the iterator to page through results.","case .failure(let error):","    handleSearchError(error)","}"],"syntax":"swift"},{"anchor":"Iterating-through-results","text":"Iterating through results","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SearchIterator"}]},{"type":"text","text":" is a cursor that fetches results one page at a time. Each page is a "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"LocatorCollection"}]},{"type":"text","text":" containing an array of "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"Locator"}]},{"type":"text","text":" values, one per match."}]},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"type":"strong","inlineContent":[{"code":"iterator.next()","type":"codeVoice"}]},{"text":" to retrieve the next page. It returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" on success when all results have been exhausted, or ","type":"text"},{"type":"codeVoice","code":".failure"},{"text":" if a read error occurs.","type":"text"}]},{"type":"codeListing","code":["while let page = try await iterator.next().get() {","    for locator in page.locators {","        print(\"Found result at: \\(locator.href)\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To navigate directly to a result, pass the locator to the Navigator:","type":"text"}]},{"type":"codeListing","code":["await navigator.go(to: locator)"],"syntax":"swift"},{"anchor":"Pagination-strategies","text":"Pagination strategies","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Results may arrive in pages to progressively load results. In practice there are two common approaches:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Background load:"}]},{"type":"text","text":" start a "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" that accumulates every result progressively. Simple to implement; the full list updates every time a new page is fetched."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"On-scroll load:"}]},{"type":"text","text":" hold onto the iterator and call "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" only when the user scrolls to the bottom of the current batch. This keeps memory and CPU usage low, at the cost of slightly more state management."}]}]}]},{"anchor":"Grouping-results-by-section","text":"Grouping results by section","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"locator.title"}],"type":"strong"},{"type":"text","text":" is the title of the table of contents entry that contains the match — for example, a chapter or section title. Use it to group consecutive results that fall within the same entry:"}]},{"type":"codeListing","code":["var sections: [(title: String?, locators: [Locator])] = []","for locator in page.locators {","    if locator.title == sections.last?.title {","        sections[sections.count - 1].locators.append(locator)","    } else {","        sections.append((title: locator.title, locators: [locator]))","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This preserves order and keeps sections with the same title distinct when they are not consecutive.","type":"text"}]},{"anchor":"Displaying-a-result-snippet","text":"Displaying a result snippet","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"locator.text"}],"type":"strong"},{"text":" contains the matched text and its surrounding context:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"highlight"},{"text":" — the exact string that matched the query.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"before"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"after"},{"text":" — a short snippet of text on either side of the match.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here is a SwiftUI view that renders a single result with the matched text in bold:"}]},{"type":"codeListing","code":["struct SearchResultRow: View {","    let locator: Locator","","    var body: some View {","        Text(snippet)","    }","","    private var snippet: AttributedString {","        var result = AttributedString()","        if let before = locator.text?.before {","            result += AttributedString(before)","        }","        if let highlight = locator.text?.highlight {","            var bold = AttributedString(highlight)","            bold.font = .body.bold()","            result += bold","        }","        if let after = locator.text?.after {","            result += AttributedString(after)","        }","        return result","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In a real UI you will typically want to truncate "},{"type":"codeVoice","code":"before"},{"type":"text","text":" and "},{"type":"codeVoice","code":"after"},{"type":"text","text":" so the UI stays compact."}]},{"anchor":"Search-options","text":"Search options","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Pass a ","type":"text"},{"inlineContent":[{"type":"codeVoice","code":"SearchOptions"}],"type":"strong"},{"text":" value to ","type":"text"},{"code":"search(query:options:)","type":"codeVoice"},{"text":" to override the defaults. Any option you leave as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" falls back to the default behavior.","type":"text"}]},{"type":"codeListing","code":["let result = await publication.search(","    query: \"Red Panda\",","    options: SearchOptions(","        caseSensitive: true,","        diacriticSensitive: false","    )",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The full set of available options:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Option","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"caseSensitive"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bool?"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the search distinguishes upper- and lower-case letters."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"diacriticSensitive","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bool?"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", accented and unaccented letters are treated as distinct."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"wholeWord"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bool?"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}],[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", only complete words are matched, not substrings.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"exact","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Bool?","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", the query is matched exactly, including stop words and word order.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"language","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Language?"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Overrides the publication’s language for this search."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"regularExpression"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bool?"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the query is interpreted as a regular expression."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"otherOptions"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[String: String]"}]}],[{"type":"paragraph","inlineContent":[{"text":"–","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Custom options specific to the search service implementation.","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"type":"text","text":"Built-in"}]},{"type":"text","text":" column indicates whether the default Readium configuration handles the option. Options marked "},{"type":"strong","inlineContent":[{"text":"No","type":"text"}]},{"type":"text","text":" are silently ignored unless you provide a custom algorithm that implements them."}]},{"anchor":"Supported-options","text":"Supported options","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before displaying search-option controls – e.g. a case sensitivity toggle, or regex mode – inspect "},{"inlineContent":[{"code":"publication.searchOptions","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" to learn which options the service actually supports. An option whose value is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" is "},{"inlineContent":[{"text":"not supported","type":"text"}],"type":"strong"},{"type":"text","text":" by the current service; do not show it in the UI. The actual value indicates the default behavior when the option is not overridden."}]},{"type":"codeListing","code":["let options = publication.searchOptions","","\/\/ Only show the case-sensitivity toggle if the service supports it.","if let caseSensitive = options.caseSensitive {","    showCaseSensitiveToggle(defaultValue: caseSensitive)","}"],"syntax":"swift"},{"anchor":"Error-handling","text":"Error handling","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"SearchError","type":"codeVoice"}]},{"type":"text","text":" describes what can go wrong:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".publicationNotSearchable"}]},{"text":" – The publication has no search service. Guard on ","type":"text"},{"type":"codeVoice","code":"isSearchable"},{"text":" first.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".badQuery(Error)"}]},{"type":"text","text":" – The query string is invalid. Not all implementations produce this; custom services may use it to signal a malformed query (for example, an invalid regular expression)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".reading(ReadError)","type":"codeVoice"}],"type":"strong"},{"text":" – An I\/O error occurred while reading a resource.","type":"text"}]}]}]},{"type":"codeListing","code":["switch searchError {","case .publicationNotSearchable:","    break \/\/ Should not happen if you check isSearchable first.","case .badQuery(let error):","    showAlert(\"Invalid query\")","case .reading(let error):","    showAlert(\"Failed to read the publication resources\")","}"],"syntax":"swift"},{"anchor":"Advanced-customization","text":"Advanced customization","type":"heading","level":2},{"anchor":"Configuring-the-search-service","text":"Configuring the search service","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default parsers automatically register "},{"inlineContent":[{"type":"codeVoice","code":"ContentSearchService"}],"type":"strong"},{"type":"text","text":" for EPUB and PDF publications, which relies on the "},{"identifier":"Content.md","isActive":true,"type":"reference"},{"type":"text","text":" to inspect the publication content. You do not need to do anything for the default behavior."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To customize the default service — for example, to adjust the snippet length or plug in a different search algorithm — override it in the "},{"type":"codeVoice","code":"onCreatePublication"},{"type":"text","text":" callback when opening a publication:"}]},{"type":"codeListing","code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    onCreatePublication: { _, _, services in","        services.setSearchServiceFactory(","            ContentSearchService.makeFactory(","                snippetLength: 300,","                searchAlgorithm: BasicStringSearchAlgorithm()","            )","        )","    }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"snippetLength"},{"text":" parameter controls how many characters of context are included in the ","type":"text"},{"type":"codeVoice","code":"before"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"after"},{"text":" text of each result’s ","type":"text"},{"type":"strong","inlineContent":[{"code":"Locator.Text","type":"codeVoice"}]},{"text":".","type":"text"}]},{"content":[{"inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"code":"ContentSearchService","type":"codeVoice"},{"text":" depends on a ","type":"text"},{"code":"ContentService","type":"codeVoice"},{"text":" being registered for the publication. This is set up automatically by the default parsers.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"anchor":"Implementing-a-custom-search-algorithm","text":"Implementing a custom search algorithm","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The actual text-matching logic is separated into the "},{"inlineContent":[{"type":"codeVoice","code":"StringSearchAlgorithm"}],"type":"strong"},{"type":"text","text":" protocol. You can swap it out without changing anything else about the service."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"BasicStringSearchAlgorithm"}],"type":"strong"},{"text":" is the built-in implementation. It uses the native ","type":"text"},{"code":"String.range(of:options:)","type":"codeVoice"},{"text":" APIs and supports ","type":"text"},{"code":"caseSensitive","type":"codeVoice"},{"text":", ","type":"text"},{"code":"diacriticSensitive","type":"codeVoice"},{"text":", ","type":"text"},{"code":"exact","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"regularExpression","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To use a custom algorithm, pass it to ","type":"text"},{"code":"ContentSearchService.makeFactory","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["ContentSearchService.makeFactory(searchAlgorithm: MyFuzzySearchAlgorithm())"],"syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"anchor":"Guides","generated":true}],"metadat