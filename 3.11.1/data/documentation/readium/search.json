}],"url":"\/documentation\/readium\/accessibility"},"doc://Readium/documentation/Readium/Content":{"role":"article","kind":"article","title":"Extracting the content of a publication","url":"\/documentation\/readium\/content","abstract":[],"identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","type":"topic"},"https://www.w3.org/TR/epub-a11y-11":{"type":"link","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/TTS":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","kind":"article","title":"Text-to-speech","type":"topic","url":"\/documentation\/readium\/tts","abstract":[],"role":"article"},"doc://Readium/documentation/Readium/Open-Publication":{"kind":"article","abstract":[{"text":"To open a publication with Readium, you need to instantiate a couple of components: an ","type":"text"},{"code":"AssetRetriever","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/readium\/open-publication","role":"article","title":"Opening a publication","type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication"},"doc://Readium/documentation/Readium/Getting-Started":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","role":"article","type":"topic","title":"Getting started","kind":"article","url":"\/documentation\/readium\/getting-started","abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}]},"doc://Readium/documentation/Readium/Migration-Guide":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","role":"article","title":"Migration Guide","url":"\/doc