{"metadata":{"role":"article","title":"Supporting Readium LCP","roleHeading":"Article"},"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility"],"anchor":"Guides"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true},{"text":" DRM.","type":"text"}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!IMPORTANT]"},{"type":"text","text":" "},{"type":"text","text":"To use LCP with the Readium toolkit, you must first obtain the "},{"type":"codeVoice","code":"R2LCPClient"},{"type":"text","text":" private library by contacting "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.edrlab.org\/contact\/"},{"type":"text","text":"."}]}],"name":"Note","style":"note"},{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An LCP publication is protected with a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"user passphrase"}]},{"type":"text","text":" and distributed using an LCP License Document ("},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":") ."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The user flow typically goes as follows:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"The user imports a ","type":"text"},{"type":"codeVoice","code":".lcpl"},{"text":" file into your application.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The application uses the Readium toolkit to download the protected publication from the ","type":"text"},{"type":"codeVoice","code":".lcpl"},{"text":" file to the user’s bookshelf. The downloaded file can be a ","type":"text"},{"type":"codeVoice","code":".epub"},{"text":", ","type":"text"},{"type":"codeVoice","code":".lcpdf"},{"text":" (PDF), or ","type":"text"},{"type":"codeVoice","code":".lcpa"},{"text":" (audiobook) package.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user opens the protected publication from the bookshelf.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If the passphrase isn’t already recorded in the "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" internal database, the user will be asked to enter it to unlock the contents."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The publication is decrypted and rendered on the screen.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Setup","level":2,"text":"Setup"},{"type":"paragraph","inlineContent":[{"text":"To support LCP in your application, you require two components:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"ReadiumLCP"},{"text":" package from the toolkit provides APIs for downloading and decrypting protected publications. Import it as you would any other Readium package, such as ","type":"text"},{"type":"codeVoice","code":"R2Navigator"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The private "},{"code":"R2LCPClient","type":"codeVoice"},{"type":"text","text":" library customized for your application "},{"identifier":"https:\/\/www.edrlab.org\/contact\/","overridingTitle":"is available from EDRLab","isActive":true,"type":"reference","overridingTitleInlineContent":[{"text":"is available from EDRLab","type":"text"}]},{"type":"text","text":". They will provide instructions for integrating the "},{"code":"R2LCPClient","type":"codeVoice"},{"type":"text","text":" framework into your application."}]}]}]},{"type":"heading","anchor":"File-formats","level":3,"text":"File formats"},{"type":"paragraph","inlineContent":[{"text":"Readium LCP specifies new file formats.","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Name"}],"type":"paragraph"}],[{"inlineContent":[{"text":"File extension","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Media type"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".lcpl"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"application\/vnd.readium.lcp.license.v1.0+json"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".lcpdf"}],"type":"paragraph"}],[{"inlineContent":[{"code":"application\/pdf+lcp","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-audiobooks.html","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".lcpa"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"application\/audiobook+lcp"}],"type":"paragraph"}]]],"header":"row"},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"text":"EPUB files protected by LCP are supported without a special file extension or media type because EPUB accommodates any DRM scheme in its specification.","type":"text"}]}],"style":"note"},{"type":"paragraph","inlineContent":[{"text":"To support these formats in your application, you need to ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/defining_file_and_data_types_for_your_app","type":"reference","isActive":true},{"text":" as imported types.","type":"text"}]},{"type":"codeListing","syntax":"xml","code":["<dict>","    <key>UTImportedTypeDeclarations<\/key>","    <array>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpl<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.json<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP License Document<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpl<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/vnd.readium.lcp.license.v1.0+json<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpdf<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for PDF package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpdf<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/pdf+lcp<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpa<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpa<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/audiobook+lcp<\/string>","            <\/dict>","        <\/dict>","    <\/array>","<\/dict>"]},{"type":"paragraph","inlineContent":[{"text":"Next, declare the imported types as ","type":"text"},{"type":"reference","identifier":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd","isActive":true},{"text":" in the ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":" to have your application listed in the “Open with…” dialogs.","type":"text"}]},{"type":"codeListing","syntax":"xml","code":["<dict>","    <key>CFBundleDocumentTypes<\/key>","    <array>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP License Document<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpl<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for PDF package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpdf<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpa<\/string>","            <\/array>","        <\/dict>","    <\/array>","<\/dict>"]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"[!TIP]","type":"text"},{"text":" ","type":"text"},{"text":"If EPUB is not included in your document types, now is a good time to add it.","type":"text"}]}],"style":"note"},{"level":3,"type":"heading","text":"Allow insecure HTTP requests","anchor":"Allow-insecure-HTTP-requests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A file required by the LCP library needs to be downloaded from an insecure HTTP location. You must authorize this download by adding the following to your "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" file:"}]},{"type":"codeListing","syntax":"xml","code":["<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSExceptionDomains<\/key>","    <dict>","        <key>crl.edrlab.telesec.de<\/key>","        <dict>","            <key>NSExceptionAllowsInsecureHTTPLoads<\/key>","            <true\/>","        <\/dict>","    <\/dict>","<\/dict>"]},{"level":3,"text":"Device name for LCP registration","anchor":"Device-name-for-LCP-registration","type":"heading"},{"inlineContent":[{"type":"text","text":"When registering a license with an LSD server, Readium LCP identifies the device by name using "},{"type":"codeVoice","code":"UIDevice.current.name"},{"type":"text","text":". Since iOS 16, this returns a generic string such as “iPhone” instead of the user-assigned device name."}],"type":"paragraph"},{"inlineContent":[{"text":"To obtain the actual device name, add the ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/bundleresources\/entitlements\/com_apple_developer_device-information_user-assigned-device-name","isActive":true,"type":"reference"},{"text":" entitlement to your app’s ","type":"text"},{"code":".entitlements","type":"codeVoice"},{"text":" file. This entitlement requires approval from Apple.","type":"text"}],"type":"paragraph"},{"syntax":"xml","code":["<key>com.apple.developer.device-information.user-assigned-device-name<\/key>","<true\/>"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Alternatively, you can supply your own device name when initializing "},{"code":"LCPService","type":"codeVoice"},{"type":"text","text":" via the "},{"code":"deviceName","type":"codeVoice"},{"type":"text","text":" parameter."}],"type":"paragraph"},{"level":2,"text":"Initializing the `LCPService`","anchor":"Initializing-the-LCPService","type":"heading"},{"inlineContent":[{"code":"ReadiumLCP","type":"codeVoice"},{"text":" offers an ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" object that exposes its API. Since the ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" package is not linked with ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":", you need to create your own adapter when setting up the ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"code":"LCPService","type":"codeVoice"},{"type":"text","text":" expects repositories to store the opened licenses and passphrases. "},{"code":"ReadiumLCP","type":"codeVoice"},{"type":"text","text":" provides built-in Keychain-based implementations that store data securely in the iOS\/macOS Keychain. Unlike database-based storage, Keychain data persists across app reinstalls and can optionally be synchronized across the user’s devices via iCloud Keychain."}],"type":"paragraph"},{"syntax":"swift","code":["import R2LCPClient","import ReadiumLCP","","let httpClient = DefaultHTTPClient()","","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","","let lcpService = LCPService(","    client: LCPClientAdapter(),","    licenseRepository: LCPKeychainLicenseRepository(),","    passphraseRepository: LCPKeychainPassphraseRepository(),","    assetRetriever: assetRetriever,","    httpClient: httpClient",")","","\/\/\/ Facade to the private R2LCPClient.framework.","class LCPClientAdapter: ReadiumLCP.LCPClient {","    func createContext(jsonLicense: String, hashedPassphrase: LCPPassphraseHash, pemCrl: String) throws -> LCPClientContext {","        try R2LCPClient.createContext(jsonLicense: jsonLicense, hashedPassphrase: hashedPassphrase, pemCrl: pemCrl)","    }","","    func decrypt(data: Data, using context: LCPClientContext) -> Data? {","        R2LCPClient.decrypt(data: data, using: context as! DRMContext)","    }","","    func findOneValidPassphrase(jsonLicense: String, hashedPassphrases: [LCPPassphraseHash]) -> LCPPassphraseHash? {","        R2LCPClient.findOneValidPassphrase(jsonLicense: jsonLicense, hashedPassphrases: hashedPassphrases)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To disable iCloud synchronization, pass "},{"code":"synchronizable: false","type":"codeVoice"},{"text":" when creating the repositories.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You may also implement your own persistence layer by conforming to ","type":"text"},{"code":"LCPLicenseRepository","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"LCPPassphraseRepository","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Acquiring a publication from a License Document (LCPL)","anchor":"Acquiring-a-publication-from-a-License-Document-LCPL","type":"heading"},{"inlineContent":[{"type":"text","text":"Users need to import a License Document into your application to download the protected publication ("},{"type":"codeVoice","code":".epub"},{"type":"text","text":", "},{"type":"codeVoice","code":".lcpdf"},{"type":"text","text":", or "},{"type":"codeVoice","code":".lcpa"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" offers an API to retrieve the full publication from an LCPL on the filesystem.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let result = await lcpService.acquirePublication(","    from: .file(lcplURL),","    onProgress: { progress in","        switch progress {","            case .indefinite:","                \/\/ Display an activity indicator.","            case .percent(let percent):","                \/\/ Display a progress bar with percent from 0 to 1.","        }","    }",")","","switch result {","case let .success(publication):","    \/\/ Import the `publication.localURL` file as any publication.","case let .failure(error):","    \/\/ Display the error message.","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"After the download is completed, import the "},{"code":"publication.localURL","type":"codeVoice"},{"text":" file into the bookshelf like any other publication file.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Opening a publication protected with LCP","anchor":"Opening-a-publication-protected-with-LCP","type":"heading"},{"level":3,"text":"Initializing the `PublicationOpener`","anchor":"Initializing-the-PublicationOpener","type":"heading"},{"inlineContent":[{"type":"text","text":"A publication protected with LCP can be opened using the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" component, just like a non-protected publication. However, you must provide a "},{"type":"reference","isActive":true,"identifier":"https:\/\/readium.org\/architecture\/proposals\/006-content-protection.html"},{"type":"text","text":" implementation when initializing the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" to enable LCP. Luckily, "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" has you covered."}],"type":"paragraph"},{"syntax":"swift","code":["let httpClient = DefaultHTTPClient()","","let authentication = LCPDialogAuthentication()","","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: AssetRetriever(httpClient: httpClient),","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"An LCP package is secured with a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"user passphrase"}]},{"type":"text","text":" for decrypting the content. The "},{"type":"codeVoice","code":"LCPAuthenticating"},{"type":"text","text":" protocol used by "},{"type":"codeVoice","code":"LCPService.contentProtection(with:)"},{"type":"text","text":" provides the passphrase when needed. You can use the default UIKit "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" which displays a pop-up to enter the passphrase, or implement your own method for passphrase retrieval. If your application is built using SwiftUI, "},{"isActive":true,"type":"reference","identifier":"#using-the-swiftui-lcp-authentication-dialog"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"The user will be prompted once per passphrase since "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" stores known passphrases on the device."}]}],"style":"note","name":"Note","type":"aside"},{"level":3,"text":"Opening the publication","anchor":"Opening-the-publication","type":"heading"},{"inlineContent":[{"type":"text","text":"You are now ready to open the publication file with your "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":" instance."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Retrieve an `Asset` to access the file content.","let url = FileURL(path: \"\/path\/to\/lcp-protected-book.epub\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the `Asset`.","let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: hostViewController",")","","switch result {","case .success(let publication):","    \/\/ Import or present the publication.","case .failure(let error):","    \/\/ Present the error.","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sender"},{"type":"text","text":" arguments are forwarded to the "},{"type":"codeVoice","code":"LCPAuthenticating"},{"type":"text","text":" implementation when the passphrase is unknown. "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" shows a pop-up only if "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"text":", using the ","type":"text"},{"code":"sender","type":"codeVoice"},{"text":" as the pop-up’s host ","type":"text"},{"code":"UIViewController","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When importing the publication to the bookshelf, set "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" as you don’t need the passphrase for accessing the publication metadata and cover. If you intend to present the publication using a Navigator, set "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" as decryption will be required."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!TIP]"},{"type":"text","text":" "},{"type":"text","text":"To check if an asset is protected with LCP before opening it, you can use "},{"code":"asset.format.conformsTo(.lcp)","type":"codeVoice"},{"type":"text","text":"."}]}],"style":"note","name":"Note","type":"aside"},{"level":3,"text":"Using the opened `Publication`","anchor":"Using-the-opened-Publication","type":"heading"},{"inlineContent":[{"type":"text","text":"After obtaining a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance, you can access the publication’s metadata to import it into the user’s bookshelf. The user passphrase is not needed for reading the metadata or cover."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"However, if you want to display the publication with a Navigator, verify it is not restricted. It could be restricted if the user passphrase is unknown or if the license is no longer valid (e.g., expired loan, revoked purchase, etc.)."}],"type":"paragraph"},{"syntax":"swift","code":["if publication.isRestricted {","    if let error = publication.protectionError as? LCPError {","        \/\/ The user is not allowed to open the publication. You should display the error.","    } else {","        \/\/ We don't have the user passphrase.","        \/\/ You may use `publication` to access its metadata, but not to render its content.","    }","} else {","    \/\/ The publication is not restricted, you may render it with a Navigator component.","}"],"type":"codeListing"},{"level":2,"text":"Streaming an LCP protected package","anchor":"Streaming-an-LCP-protected-package","type":"heading"},{"inlineContent":[{"text":"If the server hosting the LCP protected package supports the ","type":"text"},{"type":"reference","identifier":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"https:\/\/httpwg.org\/specs\/rfc7233.html","isActive":true},{"text":", it is possible to stream directly an LCP protected publication from a License Document (","type":"text"},{"type":"codeVoice","code":".lcpl"},{"text":") file, without downloading the whole publication first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Simply open the License Document directly using the ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":". Make sure you provide an ","type":"text"},{"type":"codeVoice","code":"HTTPClient"},{"text":" (or an ","type":"text"},{"type":"codeVoice","code":"HTTPResourceFactory"},{"text":" for additional customization) to the ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(httpClient: httpClient)","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication()),","    ]",")","","\/\/ Retrieve an `Asset` to access the LCPL content.","let url = FileURL(path: \"\/path\/to\/license.lcpl\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the LCPL `Asset`.","let publication = try await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    sender: hostViewController",").get()","    ","print(\"Opened \\(publication.metadata.title)\")"],"type":"codeListing"},{"level":2,"text":"Obtaining information on an LCP license","anchor":"Obtaining-information-on-an-LCP-license","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An LCP License Document contains metadata such as its expiration date, the remaining number of characters to copy and the user name. You can access this information using an ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" object.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" to retrieve the "},{"type":"codeVoice","code":"LCPLicense"},{"type":"text","text":" instance for a publication."}]},{"syntax":"swift","code":["let result = await lcpService.retrieveLicense(","    from: asset,","    authentication: LCPDialogAuthentication(),","    allowUserInteraction: true,","    sender: hostViewController",")","","switch result {","case .success(let lcpLicense):","    if let user = lcpLicense.license.user.name {","        print(\"The publication was acquired by \\(user)\")","    }","    if let endDate = lcpLicense.license.rights.end {","        print(\"The loan expires on \\(endDate)\")","    }","    if let copyLeft = await lcpLicense.charactersToCopyLeft() {","        print(\"You can copy up to \\(copyLeft) characters remaining.\")","    }","case .failure(let error):","    \/\/ Display the error.","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"If you have already opened a ","type":"text"},{"code":"Publication","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":", you can directly obtain the ","type":"text"},{"code":"LCPLicense","type":"codeVoice"},{"text":" using ","type":"text"},{"code":"publication.lcpLicense","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Managing a loan","level":2,"anchor":"Managing-a-loan","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Readium LCP allows borrowing publications for a specific period. Use the "},{"type":"codeVoice","code":"LCPLicense"},{"type":"text","text":" object to manage a loan and retrieve its end date using "},{"type":"codeVoice","code":"lcpLicense.license.rights.end"},{"type":"text","text":"."}]},{"text":"Returning a loan","level":3,"anchor":"Returning-a-loan","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Some loans can be returned before the end date. You can confirm this by using ","type":"text"},{"type":"codeVoice","code":"lcpLicense.canReturnPublication"},{"text":". To return the publication, execute:","type":"text"}]},{"syntax":"swift","code":["let result = await lcpLicense.returnPublication()","switch result {","case .success:","    \/\/ The publication was returned.","case .failure(let error):","    \/\/ Present the error.","}"],"type":"codeListing"},{"text":"Renewing a loan","level":3,"anchor":"Renewing-a-loan","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The loan end date may also be extended. You can confirm this by using "},{"type":"codeVoice","code":"lcpLicense.canRenewLoan"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Readium LCP supports "},{"type":"reference","identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license","isActive":true},{"type":"text","text":":"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Programmatic: You show your own user interface.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interactive: You display a web view, and the Readium LSD server manages the renewal for you."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"You need to support both interactions by implementing the ","type":"text"},{"code":"LCPRenewDelegate","type":"codeVoice"},{"text":" protocol. A default implementation is available with ","type":"text"},{"code":"LCPDefaultRenewDelegate","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","code":["let result = await lcpLicense.renewLoan(","    with: LCPDefaultRenewDelegate(","        presentingViewController: hostViewController","    )",")","","switch result {","case .success:","    \/\/ The publication was renewed.","case let .failure(error):","    \/\/ Display the error.","}"],"type":"codeListing"},{"text":"Handling `LCPError`","level":2,"anchor":"Handling-LCPError","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The APIs may fail with an ","type":"text"},{"type":"codeVoice","code":"LCPError"},{"text":". These errors ","type":"text"},{"inlineContent":[{"text":"must","type":"text"}],"type":"strong"},{"text":" be displayed to the user with a suitable message.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an example, "},{"type":"reference","identifier":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221","isActive":true},{"type":"text","text":"."}]},{"text":"Using the SwiftUI LCP Authentication dialog","level":2,"anchor":"Using-the-SwiftUI-LCP-Authentication-dialog","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your application is built using SwiftUI, you cannot use "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" because it requires a UIKit view controller as its host. Instead, use an "},{"type":"codeVoice","code":"LCPObservableAuthentication"},{"type":"text","text":" combined with our SwiftUI "},{"type":"codeVoice","code":"LCPDialog"},{"type":"text","text":" presented as a sheet."}]},{"syntax":"swift","code":["@main","struct MyApp: App {","    private let lcpService: LCPService","    private let publicationOpener: PublicationOpener","","    @StateObject private var lcpAuthentication: LCPObservableAuthentication","","    init() {","        \/\/ Create an `LCPObservableAuthentication` which will be used","        \/\/ to initialize the `LCPContentProtection`.","        \/\/","        \/\/ With SwiftUI, it must be stored in a `@StateObject` property","        \/\/ to observe the authentication requests.","        let lcpAuthentication = LCPObservableAuthentication()","        _lcpAuthentication = StateObject(wrappedValue: lcpAuthentication)","","        lcpService = LCPService(...)","","        publicationOpener = PublicationOpener(","            ...,","            contentProtections: [","                lcpService.contentProtection(with: lcpAuthentication)","            ]","        )","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                \/\/ You can present an `LCPDialog` when the `LCPObservableAuthentication`","                \/\/ `request` property is updated.","                .sheet(item: $lcpAuthentication.request) {","                    LCPDialog(request: $0)","                }","            }","        }","    }","}"],"type":"codeListing"}],"kind":"content"}],"references":{"https://readium.org/lcp-specs/releases/lcp/latest.html#32-content-conformance":{"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance","title":"License Document","type":"link","titleInlineContent":[{"type":"text","text":"License Document"}],"url":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance"},"https://www.edrlab.org/contact/":{"url":"https:\/\/www.edrlab.org\/contact\/","identifier":"https:\/\/www.edrlab.org\/contact\/","title":"EDRLab","type":"link","titleInlineContent":[{"type":"text","text":"EDRLab"}]},"https://readium.org/lcp-specs/releases/lsd/latest#35-renewing-a-license":{"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license","title":"two types of renewal interactions","type":"link","titleInlineContent":[{"type":"text","text":"two types of renewal interactions"}],"url":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license"},"doc://Readium/documentation/Readium/NavigatorOverview":{"type":"topic","url":"\/documentation\/readium\/navigatoroverview","role":"article","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}],"title":"Navigator Overview"},"doc://Readium/documentation/Readium/Getting-Started":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","role":"article","type":"topic","title":"Getting started","kind":"article","url":"\/documentation\/readium\/getting-started","abstract":[{"text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics.","type":"text"}]},"https://httpwg.org/specs/rfc7233.html":{"url":"https:\/\/httpwg.org\/specs\/rfc7233.html","identifier":"https:\/\/httpwg.org\/specs\/rfc7233.html","title":"HTTP Range requests","type":"link","titleInlineContent":[{"type":"text","text":"HTTP Range requests"}]},"https://www.w3.org/TR/epub-a11y-11":{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility","type":"link","titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/Search":{"type":"topic","url":"\/