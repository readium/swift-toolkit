{"abstract":[{"text":"Errors while checking the status of the License, using the Status Document.","type":"text"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/Readium\/s5ErrorP","doc:\/\/Readium\/s8SendableP","doc:\/\/Readium\/s16SendableMetatypeP"],"title":"Conforms To"}],"variants":[{"paths":["\/documentation\/readiumlcp\/statuserror"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/ReadiumLCP"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError"},"metadata":{"title":"StatusError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusError","kind":"identifier"}],"symbolKind":"enum","externalID":"s:10ReadiumLCP11StatusErrorO","navigatorTitle":[{"text":"StatusError","kind":"identifier"}],"role":"symbol","roleHeading":"Enumeration","modules":[{"name":"ReadiumLCP"}]},"sections":[],"topicSections":[{"generated":true,"anchor":"Enumeration-Cases","identifiers":["doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/cancelled(_:)","doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/expired(start:end:)","doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/returned(_:)","doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/revoked(_:devicesCount:)"],"title":"Enumeration Cases"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/Error-Implementations"],"title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusError","kind":"identifier"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"For the case (revoked, returned, cancelled, expired), app should notify the","type":"text"},{"text":" ","type":"text"},{"text":"user and stop there. The message to the user must be clear about the status","type":"text"},{"text":" ","type":"text"},{"text":"of the license: don’t display “expired” if the status is “revoked”. The","type":"text"},{"text":" ","type":"text"},{"text":"date and time corresponding to the new status should be displayed (e.g.","type":"text"},{"text":" ","type":"text"},{"text":"“The license expired on 01 January 2018”).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the license has been revoked, the user message should display the number"},{"type":"text","text":" "},{"type":"text","text":"of devices which registered to the server. This count can be calculated"},{"type":"text","text":" "},{"type":"text","text":"from the number of “register” events in the status document. If no event is"},{"type":"text","text":" "},{"type":"text","text":"logged in the status document, no such message should appear (certainly not"},{"type":"text","text":" "},{"type":"text","text":"“The license was registered by 0 devices”)."}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Readium/documentation/ReadiumLCP/StatusError/cancelled(_:)":{"kind":"symbol","abstract":[{"text":"This license was cancelled on the given date.","type":"text"}],"role":"symbol","title":"StatusError.cancelled(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancelled"},{"kind":"text","text":"("},{"preciseIdentifier":"s:10Foundation4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":")"}],"url":"\/documentation\/readiumlcp\/statuserror\/cancelled(_:)","type":"topic","identifier":"doc:\/\/Readium\/documentation\/ReadiumLCP\/StatusError\/cancelled(_:)"},"doc://Readium/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/Readium\/s1