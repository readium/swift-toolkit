{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Checking if a publication is searchable","anchor":"Checking-if-a-publication-is-searchable"},{"inlineContent":[{"type":"text","text":"Not every publication has a search service attached. Check "},{"type":"strong","inlineContent":[{"code":"isSearchable","type":"codeVoice"}]},{"type":"text","text":" before offering a search UI."}],"type":"paragraph"},{"code":["guard publication.isSearchable else {","    \/\/ Hide or disable the search UI.","    return","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Performing-a-search","text":"Performing a search","type":"heading","level":2},{"inlineContent":[{"text":"Call ","type":"text"},{"type":"strong","inlineContent":[{"code":"publication.search(query:options:)","type":"codeVoice"}]},{"text":" to start a new search. This method returns a ","type":"text"},{"inlineContent":[{"type":"codeVoice","code":"SearchResult<SearchIterator>"}],"type":"strong"},{"text":" — either a cursor to page through results, or a ","type":"text"},{"inlineContent":[{"type":"codeVoice","code":"SearchError"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let result = await publication.search(query: \"red panda\")","","switch result {","case .success(let iterator):","    \/\/ Use the iterator to page through results.","case .failure(let error):","    handleSearchError(error)","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Iterating-through-results","text":"Iterating through results","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"strong","inlineContent":[{"code":"SearchIterator","type":"codeVoice"}]},{"type":"text","text":" is a cursor that fetches results one page at a time. Each page is a "},{"type":"strong","inlineContent":[{"code":"LocatorCollection","type":"codeVoice"}]},{"type":"text","text":" containing an array of "},{"type":"strong","inlineContent":[{"code":"Locator","type":"codeVoice"}]},{"type":"text","text":" values, one per match."}]},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"iterator.next()"}]},{"text":" to retrieve the next page. It returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" on success when all results have been exhausted, or ","type":"text"},{"code":".failure","type":"codeVoice"},{"text":" if a read error occurs.","type":"text"}]},{"code":["while let page = try await iterator.next().get() {","    for locator in page.locators {","        print(\"Found result at: \\(locator.href)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"To navigate directly to a result, pass the locator to the Navigator:","type":"text"}],"type":"paragraph"},{"code":["await navigator.go(to: locator)"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Pagination-strategies","level":3,"text":"Pagination strategies"},{"inlineContent":[{"text":"Results may arrive in pages to progressively load results. In practice there are two common approaches:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Background load:","type":"text"}],"type":"strong"},{"text":" start a ","type":"text"},{"type":"codeVoice","code":"Task"},{"text":" that accumulates every result progressively. Simple to implement; the full list updates every time a new page is fetched.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"On-scroll load:"}],"type":"strong"},{"text":" hold onto the iterator and call ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" only when the user scrolls to the bottom of the current batch. This keeps memory and CPU usage low, at the cost of slightly more state management.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Grouping-results-by-section","type":"heading","level":3,"text":"Grouping results by section"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"locator.title","type":"codeVoice"}]},{"type":"text","text":" is the title of the table of contents entry that contains the match — for example, a chapter or section title. Use it to group consecutive results that fall within the same entry:"}]},{"type":"codeListing","code":["var sections: [(title: String?, locators: [Locator])] = []","for locator in page.locators {","    if locator.title == sections.last?.title {","        sections[sections.count - 1].locators.append(locator)","    } else {","        sections.append((title: locator.title, locators: [locator]))","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This preserves order and keeps sections with the same title distinct when they are not consecutive."}]},{"anchor":"Displaying-a-result-snippet","type":"heading","level":3,"text":"Displaying a result snippet"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"locator.text"}]},{"text":" contains the matched text and its surrounding context:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"highlight"},{"text":" — the exact string that matched the query.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"before","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"after","type":"codeVoice"},{"text":" — a short snippet of text on either side of the match.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Here is a SwiftUI view that renders a single result with the matched text in bold:","type":"text"}]},{"syntax":"swift","code":["struct SearchResultRow: View {","    let locator: Locator","","    var body: some View {","        Text(snippet)","    }","","    private var snippet: AttributedString {","        var result = AttributedString()","        if let before = locator.text?.before {","            result += AttributedString(before)","        }","        if let highlight = locator.text?.highlight {","            var bold = AttributedString(highlight)","            bold.font = .body.bold()","            result += bold","        }","        if let after = locator.text?.after {","            result += AttributedString(after)","        }","        return result","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"In a real UI you will typically want to truncate ","type":"text"},{"type":"codeVoice","code":"before"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"after"},{"text":" so the UI stays compact.","type":"text"}]},{"text":"Search options","anchor":"Search-options","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass a "},{"type":"strong","inlineContent":[{"code":"SearchOptions","type":"codeVoice"}]},{"type":"text","text":" value to "},{"type":"codeVoice","code":"search(query:options:)"},{"type":"text","text":" to override the defaults. Any option you leave as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" falls back to the default behavior."}]},{"syntax":"swift","code":["let result = await publication.search(","    query: \"Red Panda\",","    options: SearchOptions(","        caseSensitive: true,","        diacriticSensitive: false","    )",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The full set of available options:"}]},{"rows":[[[{"inlineContent":[{"text":"Option","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"caseSensitive"}]}],[{"type":"paragraph","inlineContent":[{"code":"Bool?","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", the search distinguishes upper- and lower-case letters.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"diacriticSensitive"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bool?"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", accented and unaccented letters are treated as distinct.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"wholeWord","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Bool?","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}],[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", only complete words are matched, not substrings.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"exact","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Bool?","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the query is matched exactly, including stop words and word order."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"language","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Language?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Overrides the publication’s language for this search."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"regularExpression"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bool?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the query is interpreted as a regular expression."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"otherOptions","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"[String: String]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"–"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Custom options specific to the search service implementation.","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"inlineContent":[{"type":"text","text":"Built-in"}],"type":"strong"},{"text":" column indicates whether the default Readium configuration handles the option. Options marked ","type":"text"},{"type":"strong","inlineContent":[{"text":"No","type":"text"}]},{"type":"text","text":" are silently ignored unless you provide a custom algorithm that implements them."}]},{"level":3,"anchor":"Supported-options","type":"heading","text":"Supported options"},{"type":"paragraph","inlineContent":[{"text":"Before displaying search-option controls – e.g. a case sensitivity toggle, or regex mode – inspect ","type":"text"},{"type":"strong","inlineContent":[{"code":"publication.searchOptions","type":"codeVoice"}]},{"text":" to learn which options the service actually supports. An option whose value is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" is ","type":"text"},{"type":"strong","inlineContent":[{"text":"not supported","type":"text"}]},{"text":" by the current service; do not show it in the UI. The actual value indicates the default behavior when the option is not overridden.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let options = publication.searchOptions","","\/\/ Only show the case-sensitivity toggle if the service supports it.","if let caseSensitive = options.caseSensitive {","    showCaseSensitiveToggle(defaultValue: caseSensitive)","}"]},{"level":2,"anchor":"Error-handling","type":"heading","text":"Error handling"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"SearchError","type":"codeVoice"}]},{"type":"text","text":" describes what can go wrong:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".publicationNotSearchable","type":"codeVoice"}]},{"type":"text","text":" – The publication has no search service. Guard on "},{"type":"codeVoice","code":"isSearchable"},{"type":"text","text":" first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".badQuery(Error)"}],"type":"strong"},{"text":" – The query string is invalid. Not all implementations produce this; custom services may use it to signal a malformed query (for example, an invalid regular expression).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".reading(ReadError)"}],"type":"strong"},{"text":" – An I\/O error occurred while reading a resource.","type":"text"}]}]}]},{"syntax":"swift","code":["switch searchError {","case .publicationNotSearchable:","    break \/\/ Should not happen if you check isSearchable first.","case .badQuery(let error):","    showAlert(\"Invalid query\")","case .reading(let error):","    showAlert(\"Failed to read the publication resources\")","}"],"type":"codeListing"},{"level":2,"text":"Advanced customization","anchor":"Advanced-customization","type":"heading"},{"level":3,"text":"Configuring the search service","anchor":"Configuring-the-search-service","type":"heading"},{"inlineContent":[{"type":"text","text":"The default parsers automatically register "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"ContentSearchService"}]},{"type":"text","text":" for EPUB and PDF publications, which relies on the "},{"type":"reference","identifier":"Content.md","isActive":true},{"type":"text","text":" to inspect the publication content. You do not need to do anything for the default behavior."}],"type":"paragraph"},{"inlineContent":[{"text":"To customize the default service — for example, to adjust the snippet length or plug in a different search algorithm — override it in the ","type":"text"},{"type":"codeVoice","code":"onCreatePublication"},{"text":" callback when opening a publication:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true,","    onCreatePublication: { _, _, services in","        services.setSearchServiceFactory(","            ContentSearchService.makeFactory(","                snippetLength: 300,","                searchAlgorithm: BasicStringSearchAlgorithm()","            )","        )","    }",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"snippetLength"},{"type":"text","text":" parameter controls how many characters of context are included in the "},{"type":"codeVoice","code":"before"},{"type":"text","text":" and "},{"type":"codeVoice","code":"after"},{"type":"text","text":" text of each result’s "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"Locator.Text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"[!NOTE]","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ContentSearchService"},{"text":" depends on a ","type":"text"},{"type":"codeVoice","code":"ContentService"},{"text":" being registered for the publication. This is set up automatically by the default parsers.","type":"text"}]}],"type":"aside"},{"type":"heading","level":3,"text":"Implementing a custom search algorithm","anchor":"Implementing-a-custom-search-algorithm"},{"type":"paragraph","inlineContent":[{"text":"The actual text-matching logic is separated into the ","type":"text"},{"type":"strong","inlineContent":[{"code":"StringSearchAlgorithm","type":"codeVoice"}]},{"type":"text","text":" protocol. You can swap it out without changing anything else about the service."}]},{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"BasicStringSearchAlgorithm"}],"type":"strong"},{"type":"text","text":" is the built-in implementation. It uses the native "},{"type":"codeVoice","code":"String.range(of:options:)"},{"type":"text","text":" APIs and supports "},{"type":"codeVoice","code":"caseSensitive"},{"type":"text","text":", "},{"type":"codeVoice","code":"diacriticSensitive"},{"type":"text","text":", "},{"type":"codeVoice","code":"exact"},{"type":"text","text":", and "},{"type":"codeVoice","code":"regularExpression"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use a custom algorithm, pass it to "},{"type":"codeVoice","code":"ContentSearchService.makeFactory"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["ContentSearchService.makeFactory(searchAlgorithm: MyFuzzySearchAlgorithm())"]}]}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readium\/search"]}],"metadata":{"role":"article","title":"Searching a publication","roleHeading":"Article"},"abstract":[{"type":"text","text":"The Search API lets you look for a textual query in the content of a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":". EPUB and PDF publications are supported."}],"sections":[],"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Search","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"seeAlsoSe