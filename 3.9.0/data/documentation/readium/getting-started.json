{"identifier":{"url":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","interfaceLanguage":"swift"},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility","doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"],"anchor":"Guides","title":"Guides","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/readium\/getting-started"]}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}],"metadata":{"role":"article","title":"Getting started","roleHeading":"Article"},"primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"Readium offers only low-level tools. You are responsible for creating a user interface for reading and managing books, as well as a data layer to store the user’s publications. The Test App is an example of such integration."}],"type":"paragraph"}],"style":"note","name":"Note"},{"anchor":"Design-principles","type":"heading","level":2,"text":"Design principles"},{"inlineContent":[{"text":"The toolkit has been designed following these core tenets:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Modular"}],"type":"strong"},{"type":"text","text":": It is divided into separate modules that can be used independently."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Extensible","type":"text"}],"type":"strong"},{"type":"text","text":": Integrators should be able to support a custom DRM, publication format or inject their own stylesheets without modifying the toolkit itself."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Opiniated","type":"text"}]},{"type":"text","text":": We adhere to open standards but sometimes interpret them for practicality."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Packages","anchor":"Packages","type":"heading","level":2},{"text":"Main packages","anchor":"Main-packages","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumShared"},{"type":"text","text":" contains shared "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" models and utilities."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumStreamer"},{"type":"text","text":" parses publication files (e.g. an EPUB) into a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" object."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"Navigator\/Navigator.md","isActive":true},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"text":"Specialized packages","anchor":"Specialized-packages","type":"heading","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ReadiumOPDS"},{"text":" parses ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/opds.io"},{"text":" (both OPDS 1 and 2).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"Readium%20LCP.md","isActive":true},{"text":".","type":"text"}]}]}]},{"anchor":"Overview-of-the-shared-models-ReadiumShared","text":"Overview of the shared models (`ReadiumShared`)","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The Readium toolkit provides models used as exchange types between packages.","type":"text"}]},{"anchor":"Publication-models","text":"Publication models","level":3,"type":"heading"},{"anchor":"Publication","text":"Publication","level":4,"type":"heading"},{"type":"paragraph","inlineContent":[{"code":"Publication","type":"codeVoice"},{"type":"text","text":" and its sub-components represent a single publication – ebook, audiobook or comic. It is loosely based on the "},{"identifier":"https:\/\/readium.org\/webpub-manifest\/","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":" instance:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"holds the metadata of a publication, such as its author or table of contents,","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"allows to read the contents of a publication, e.g. XHTML or audio resources,","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"provides additional services, for example content extraction or text search."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Link","text":"Link","level":4,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object"},{"type":"text","text":" holds a pointer (URL) to a resource or service along with additional metadata, such as its media type or title."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" contains several "},{"type":"codeVoice","code":"Link"},{"type":"text","text":" collections, for example:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"readingOrder"},{"type":"text","text":" lists the publication resources arranged in the order they should be read."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"resources"},{"text":" contains secondary resources necessary for rendering the ","type":"text"},{"type":"codeVoice","code":"readingOrder"},{"text":", such as an image or a font file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"tableOfContents","type":"codeVoice"},{"text":" represents the table of contents as a tree of ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" objects.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"links","type":"codeVoice"},{"text":" exposes additional resources, such as a canonical link to the manifest or a search web service.","type":"text"}]}]}]},{"anchor":"Locator","text":"Locator","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","type":"reference"},{"text":" represents a precise location in a publication resource in a format that can be stored and shared across reading systems. It is more accurate than a ","type":"text"},{"code":"Link","type":"codeVoice"},{"text":" and contains additional information about the location, e.g. progression percentage, position or textual context.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Locator"},{"text":" objects are used for various features, including:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"reporting the current progression in the publication","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"saving bookmarks, highlights and annotations"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"navigating search results","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Data-models","text":"Data models","type":"heading","level":3},{"anchor":"Asset","text":"Asset","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":" represents a single file or package and provides access to its content. There are two types of ","type":"text"},{"code":"Asset","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ContainerAsset"},{"text":" for packages which contains several resources, such as a ZIP archive.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ResourceAsset"},{"type":"text","text":" for accessing a single resource, such as a JSON or PDF file."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Asset"},{"text":" instances are obtained through an ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the "},{"code":"asset.format","type":"codeVoice"},{"type":"text","text":" to identify the media type and capabilities of the asset."}]},{"type":"codeListing","syntax":"swift","code":["if asset.format.conformsTo(.lcp) {","    \/\/ The asset is protected with LCP.","}","if asset.format.conformsTo(.epub) {","    \/\/ The asset represents an EPUB publication.","}"]},{"type":"heading","text":"Resource","anchor":"Resource","level":4},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Resource","type":"codeVoice"},{"text":" provides read access to a single resource, such as a file or an entry in an archive.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"Resource","type":"codeVoice"},{"text":" instances are usually created by a ","type":"text"},{"code":"ResourceFactory","type":"codeVoice"},{"text":". The toolkit ships with various implementations supporting different data access protocols such as local files or HTTP.","type":"text"}]},{"type":"heading","text":"Container","anchor":"Container","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Container"},{"type":"text","text":" provides read access to a collection of resources. "},{"type":"codeVoice","code":"Container"},{"type":"text","text":" instances representing an archive are usually created by an "},{"type":"codeVoice","code":"ArchiveOpener"},{"type":"text","text":". The toolkit ships with a "},{"type":"codeVoice","code":"ZIPArchiveOpener"},{"type":"text","text":" supporting both local and remote (HTTP) ZIP files."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Publication"},{"type":"text","text":" objects internally use a "},{"type":"codeVoice","code":"Container"},{"type":"text","text":" to expose its content."}]},{"type":"heading","text":"Opening a publication (`ReadiumStreamer`)","anchor":"Opening-a-publication-ReadiumStreamer","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To retrieve a "},{"code":"Publication","type":"codeVoice"},{"type":"text","text":" object from a publication file like an EPUB or audiobook, you can use an "},{"code":"AssetRetriever","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever,","        pdfFactory: DefaultPDFDocumentFactory()","    )",")","","let url: URL = URL(...)","","\/\/ Retrieve an `Asset` to access the file content.","switch await assetRetriever.retrieve(url: url.anyURL.absoluteURL!) {","case .success(let asset):","    \/\/ Open a `Publication` from the `Asset`.","    switch await publicationOpener.open(asset: asset, allowUserInteraction: true) {","    case .success(let publication):","        print(\"Opened \\(publication.metadata.title)\")","","    case .failure(let error):","        \/\/ Failed to access or parse the publication","    }","","case .failure(let error):","    \/\/ Failed to retrieve the asset","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" parameter is useful when supporting a DRM like Readium LCP. It indicates if the toolkit can prompt the user for credentials when the publication is protected."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"Open%20Publication.md","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Accessing the metadata of a publication","anchor":"Accessing-the-metadata-of-a-publication","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"After opening a publication, you may want to read its metadata to insert a new entity into your bookshelf database, for instance. The "},{"type":"codeVoice","code":"publication.metadata"},{"type":"text","text":" object contains everything you need, including "},{"type":"codeVoice","code":"title"},{"type":"text","text":", "},{"type":"codeVoice","code":"authors"},{"type":"text","text":" and the "},{"type":"codeVoice","code":"published"},{"type":"text","text":" date."}],"type":"paragraph"},{"inlineContent":[{"text":"You can retrieve the publication cover using ","type":"text"},{"code":"await publication.cover()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Rendering the publication on the screen (`ReadiumNavigator`)","anchor":"Rendering-the-publication-on-the-screen-ReadiumNavigator","level":2,"type":"heading"},{"inlineContent":[{"text":"You can use a Readium navigator to present the publication to the user. The ","type":"text"},{"code":"Navigator","type":"codeVoice"},{"text":" renders resources on the screen and offers APIs and user interactions for navigating the contents.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Please refer to the ","type":"text"},{"identifier":"Navigator\/Navigator.md","overridingTitle":"Navigator guide","overridingTitleInlineContent":[{"type":"text","text":"Navigator guide"}],"isActive":true,"type":"reference"},{"text":" for more information.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"references":{"https://readium.org/architecture/models/locators/":{"titleInlineContent":[{"type":"codeVoice","code":"Locator"},{"type":"text","text":" object"}],"type":"link","title":"Locator object","identifier":"https:\/\/readium.org\/architecture\/models\/locators\/","url":"https:\/\/readium.org\/architecture\/models\/locators\/"},"doc://Readium/documentation/Readium":{"kind":"article","url":"\/documentation\/readium","identifier":"doc:\/\/Readium\/documentation\/Readium","abstract":[{"type":"text","text":"The Readium Swift Toolkit is a toolkit for ebooks, audiobooks, and comics written in Swift & Kotlin."}],"type":"topic","role":"collection","title":"Readium"},"https://www.w3.org/TR/epub-a11y-11":{"titleInlineContent":[{"type":"text","text":"EPUB Accessibility"}],"type":"link","title":"EPUB Accessibility","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","url":"https:\/\/www.w3.org\/TR\/epub-a11y-11"},"doc://Readium/documentation/Readium/Accessibility":{"role":"article","type":"topic","url":"\/documentation\/readium\/accessibility","title":"Accessibility","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","kind":"article","abstract":[{"type":"text","text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the "},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference","isActive":true},{"type":"text","text":" specification."}]},"doc://Readium/documentation/Readium/Readium-LCP":{"kind":"article","url":"\/documentation\/readium\/readium-lcp","title":"Supporting Readium LCP","role":"article","abstract":[{"text":"You can use the Readium Swift toolkit to download and read publications that are protected with the ","type":"text"},{"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","type":"reference","isActive":true},{"type":"text","text":" DRM."}],"type":"topic","identifier":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"},"doc://Readium/documentation/Readium/Migration-Guide":{"abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}],"title":"Migration Guide","type":"topic","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","url":"\/documentation\/readium\/migration-guide","role":"article"},"https://readium.org/webpub-manifest/#24-the-link-object":{"type":"link","title":"Link object","identifier":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object","titleInlineContent":[{"type":"codeVoice","code":"Link"},{"type":"text","text":" object"}],"url":"https:\/\/readium.org\/webpub-manifest\/#24-the-link-object"},"https://readium.org/webpub-manifest/":{"identifier":"https:\/\/readium.org\/webpub-manifest\/","type":"link","titleInlineContent":[{"text":"Readium Web Publication Manifest","type":"text"}],"title":"Readium Web Publication Manifest","url":"https:\/\/readium.org\/webpub-manifest\/"},"doc://Readium/documentation/Readium/Search":{"kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Search","url":"\/documentation\/readium\/search","abstract":[{"text":"The Search API lets you look for a textual query in the content of a ","type":"text"},{"type":"codeVoice","code":"Publication"},{"text":". EPUB and PDF publications are supported.","type":"text"}],"type":"topic","role":"article","title":"Searching a publication"},"Readium%20LCP.md":{"url":"Readium%20LCP.md","titleInlineContent":[{"type":"codeVoice","code":"ReadiumLCP"},{"text":" downloads and decrypts LCP-protected publications","type":"text"}],"type":"link","identifier":"Readium%20LCP.md","title":"ReadiumLCP downloads and decrypts LCP-protected publications"},"Navigator/Navigator.md":{"identifier":"Navigator\/Navigator.md","url":"Navigator\/Navigator.md","title":"ReadiumNavigator renders the content of a publication","type":"link","titleInlineContent":[{"type":"codeVoice","code":"ReadiumNavigator"},{"text":" renders the content of a publication","type":"text"}]},"doc://Readium/documentation/Readium/NavigatorOverview":{"role":"article","type":"topic","url":"\/documentation\/readium\/navigatoroverview","title":"Navigator Overview","identifier":"doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","kind":"article","abstract":[{"text":"Learn about the architecture, configuration, and usage of the Readium Navigator.","type":"text"}]},"https://opds.io":{"title":"OPDS catalog feeds","titleInlineContent":[{"text":"OPDS catalog feeds","type":"text"}],"type":"link","identifier":"https:\/\/opds.io","url":"https:\/\/opds.io"},"Open%20Publication.md":{"url":"Open%20Publication.md","titleInlineContent":[{"type":"text","text":"See the dedicated user guide for more information"}],"type":"link","identifier":"Open%20Publication.md","title":"See the dedicated user guide for more information"},"doc://Readium/documentation/Readium/Content":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","url":"\/documentation\/readium\/content","kind":"article","type":"topic","abstract":[],"role":"article","title":"Extracting the content of a publication"},"https://www.edrlab.org/readium-lcp/":{"url":"https:\/\/www.edrlab.org\/readium-lcp\/","title":"Readium LCP","type":"link","titleInlineContent":[{"text":"Readium LCP","type":"text"}],"identifier":"https:\/\/www.edrlab.org\/readium-lcp\/"},"doc://Readium/documentation/Readium/Open-Publication":{"abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":".","type":"text"}],"title":"Opening a publication","type":"topic","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","url":"\/documentation\/readium\/open-publication","role":"article"},"doc://Readium/documentation/Readium/TTS":{"kind":"article","url":"\/documentation\/readium\/tts","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","type":"topic","abstract":[],"role":"article","title":"Text-to-speech"}}}