{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Readium\/documentation\/Readium\/Readium-LCP"},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Readium\/documentation\/Readium\/Getting-Started","doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","doc:\/\/Readium\/documentation\/Readium\/Open-Publication","doc:\/\/Readium\/documentation\/Readium\/NavigatorOverview","doc:\/\/Readium\/documentation\/Readium\/Content","doc:\/\/Readium\/documentation\/Readium\/Search","doc:\/\/Readium\/documentation\/Readium\/TTS","doc:\/\/Readium\/documentation\/Readium\/Accessibility"],"generated":true,"title":"Guides","anchor":"Guides"}],"variants":[{"paths":["\/documentation\/readium\/readium-lcp"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Readium\/documentation\/Readium"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"You can use the Readium Swift toolkit to download and read publications that are protected with the "},{"type":"reference","identifier":"https:\/\/www.edrlab.org\/readium-lcp\/","isActive":true},{"type":"text","text":" DRM."}],"metadata":{"role":"article","title":"Supporting Readium LCP","roleHeading":"Article"},"primaryContentSections":[{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"content":[{"inlineContent":[{"text":"[!IMPORTANT]","type":"text"},{"text":" ","type":"text"},{"text":"To use LCP with the Readium toolkit, you must first obtain the ","type":"text"},{"type":"codeVoice","code":"R2LCPClient"},{"text":" private library by contacting ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.edrlab.org\/contact\/"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"An LCP publication is protected with a ","type":"text"},{"inlineContent":[{"type":"text","text":"user passphrase"}],"type":"emphasis"},{"text":" and distributed using an LCP License Document (","type":"text"},{"code":".lcpl","type":"codeVoice"},{"text":") .","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The user flow typically goes as follows:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The user imports a ","type":"text"},{"type":"codeVoice","code":".lcpl"},{"text":" file into your application.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The application uses the Readium toolkit to download the protected publication from the "},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":" file to the user’s bookshelf. The downloaded file can be a "},{"type":"codeVoice","code":".epub"},{"type":"text","text":", "},{"type":"codeVoice","code":".lcpdf"},{"type":"text","text":" (PDF), or "},{"type":"codeVoice","code":".lcpa"},{"type":"text","text":" (audiobook) package."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user opens the protected publication from the bookshelf.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If the passphrase isn’t already recorded in the ","type":"text"},{"type":"codeVoice","code":"ReadiumLCP"},{"text":" internal database, the user will be asked to enter it to unlock the contents.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The publication is decrypted and rendered on the screen.","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"Setup","text":"Setup"},{"type":"paragraph","inlineContent":[{"text":"To support LCP in your application, you require two components:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" package from the toolkit provides APIs for downloading and decrypting protected publications. Import it as you would any other Readium package, such as "},{"type":"codeVoice","code":"R2Navigator"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The private "},{"code":"R2LCPClient","type":"codeVoice"},{"type":"text","text":" library customized for your application "},{"overridingTitle":"is available from EDRLab","type":"reference","identifier":"https:\/\/www.edrlab.org\/contact\/","isActive":true,"overridingTitleInlineContent":[{"text":"is available from EDRLab","type":"text"}]},{"type":"text","text":". They will provide instructions for integrating the "},{"code":"R2LCPClient","type":"codeVoice"},{"type":"text","text":" framework into your application."}]}]}]},{"type":"heading","level":3,"anchor":"File-formats","text":"File formats"},{"type":"paragraph","inlineContent":[{"text":"Readium LCP specifies new file formats.","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Name"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"File extension"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Media type"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lcp\/latest.html#32-content-conformance","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":".lcpl","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/vnd.readium.lcp.license.v1.0+json"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":".lcpdf","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/pdf+lcp"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-audiobooks.html","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".lcpa"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"application\/audiobook+lcp"}]}]]]},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"EPUB files protected by LCP are supported without a special file extension or media type because EPUB accommodates any DRM scheme in its specification."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To support these formats in your application, you need to "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/defining_file_and_data_types_for_your_app","isActive":true},{"type":"text","text":" as imported types."}]},{"syntax":"xml","type":"codeListing","code":["<dict>","    <key>UTImportedTypeDeclarations<\/key>","    <array>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpl<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.json<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP License Document<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpl<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/vnd.readium.lcp.license.v1.0+json<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpdf<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for PDF package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpdf<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/pdf+lcp<\/string>","            <\/dict>","        <\/dict>","        <dict>","            <key>UTTypeIdentifier<\/key>","            <string>org.readium.lcpa<\/string>","            <key>UTTypeConformsTo<\/key>","            <array>","                <string>public.content<\/string>","                <string>public.data<\/string>","                <string>public.archive<\/string>","                <string>public.zip-archive<\/string>","            <\/array>","            <key>UTTypeDescription<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>UTTypeTagSpecification<\/key>","            <dict>","                <key>public.filename-extension<\/key>","                <array>","                    <string>lcpa<\/string>","                <\/array>","                <key>public.mime-type<\/key>","                <string>application\/audiobook+lcp<\/string>","            <\/dict>","        <\/dict>","    <\/array>","<\/dict>"]},{"type":"paragraph","inlineContent":[{"text":"Next, declare the imported types as ","type":"text"},{"identifier":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd","type":"reference","isActive":true},{"text":" in the ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":" to have your application listed in the “Open with…” dialogs.","type":"text"}]},{"syntax":"xml","type":"codeListing","code":["<dict>","    <key>CFBundleDocumentTypes<\/key>","    <array>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP License Document<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpl<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for PDF package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpdf<\/string>","            <\/array>","        <\/dict>","        <dict>","            <key>CFBundleTypeName<\/key>","            <string>LCP for Audiobooks package<\/string>","            <key>CFBundleTypeRole<\/key>","            <string>Viewer<\/string>","            <key>LSItemContentTypes<\/key>","            <array>","                <string>org.readium.lcpa<\/string>","            <\/array>","        <\/dict>","    <\/array>","<\/dict>"]},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"[!TIP]","type":"text"},{"text":" ","type":"text"},{"text":"If EPUB is not included in your document types, now is a good time to add it.","type":"text"}]}]},{"level":3,"anchor":"Allow-insecure-HTTP-requests","type":"heading","text":"Allow insecure HTTP requests"},{"inlineContent":[{"type":"text","text":"A file required by the LCP library needs to be downloaded from an insecure HTTP location. You must authorize this download by adding the following to your "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" file:"}],"type":"paragraph"},{"code":["<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSExceptionDomains<\/key>","    <dict>","        <key>crl.edrlab.telesec.de<\/key>","        <dict>","            <key>NSExceptionAllowsInsecureHTTPLoads<\/key>","            <true\/>","        <\/dict>","    <\/dict>","<\/dict>"],"type":"codeListing","syntax":"xml"},{"level":3,"anchor":"Device-name-for-LCP-registration","type":"heading","text":"Device name for LCP registration"},{"inlineContent":[{"text":"When registering a license with an LSD server, Readium LCP identifies the device by name using ","type":"text"},{"code":"UIDevice.current.name","type":"codeVoice"},{"text":". Since iOS 16, this returns a generic string such as “iPhone” instead of the user-assigned device name.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To obtain the actual device name, add the "},{"identifier":"https:\/\/developer.apple.com\/documentation\/bundleresources\/entitlements\/com_apple_developer_device-information_user-assigned-device-name","type":"reference","isActive":true},{"type":"text","text":" entitlement to your app’s "},{"code":".entitlements","type":"codeVoice"},{"type":"text","text":" file. This entitlement requires approval from Apple."}],"type":"paragraph"},{"code":["<key>com.apple.developer.device-information.user-assigned-device-name<\/key>","<true\/>"],"type":"codeListing","syntax":"xml"},{"inlineContent":[{"type":"text","text":"Alternatively, you can supply your own device name when initializing "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" via the "},{"type":"codeVoice","code":"deviceName"},{"type":"text","text":" parameter."}],"type":"paragraph"},{"level":2,"anchor":"Initializing-the-LCPService","type":"heading","text":"Initializing the `LCPService`"},{"inlineContent":[{"code":"ReadiumLCP","type":"codeVoice"},{"text":" offers an ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" object that exposes its API. Since the ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" package is not linked with ","type":"text"},{"code":"R2LCPClient","type":"codeVoice"},{"text":", you need to create your own adapter when setting up the ","type":"text"},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" expects repositories to store the opened licenses and passphrases. ","type":"text"},{"code":"ReadiumLCP","type":"codeVoice"},{"text":" provides built-in Keychain-based implementations that store data securely in the iOS\/macOS Keychain. Unlike database-based storage, Keychain data persists across app reinstalls and can optionally be synchronized across the user’s devices via iCloud Keychain.","type":"text"}]},{"code":["@preconcurrency import R2LCPClient","import ReadiumLCP","","let httpClient = DefaultHTTPClient()","","let assetRetriever = AssetRetriever(","    httpClient: httpClient",")","","let lcpService = LCPService(","    client: LCPClientAdapter(),","    licenseRepository: LCPKeychainLicenseRepository(),","    passphraseRepository: LCPKeychainPassphraseRepository(),","    assetRetriever: assetRetriever,","    httpClient: httpClient",")","","\/\/\/ Facade to the private R2LCPClient.framework.","class LCPClientAdapter: ReadiumLCP.LCPClient {","    func createContext(jsonLicense: String, hashedPassphrase: LCPPassphraseHash, pemCrl: String) throws -> LCPClientContext {","        try R2LCPClient.createContext(jsonLicense: jsonLicense, hashedPassphrase: hashedPassphrase, pemCrl: pemCrl)","    }","","    func decrypt(data: Data, using context: LCPClientContext) -> Data? {","        R2LCPClient.decrypt(data: data, using: context as! DRMContext)","    }","","    func findOneValidPassphrase(jsonLicense: String, hashedPassphrases: [LCPPassphraseHash]) -> LCPPassphraseHash? {","        R2LCPClient.findOneValidPassphrase(jsonLicense: jsonLicense, hashedPassphrases: hashedPassphrases)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To disable iCloud synchronization, pass "},{"type":"codeVoice","code":"synchronizable: false"},{"type":"text","text":" when creating the repositories."}]},{"type":"paragraph","inlineContent":[{"text":"You may also implement your own persistence layer by conforming to ","type":"text"},{"code":"LCPLicenseRepository","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"LCPPassphraseRepository","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"anchor":"Acquiring-a-publication-from-a-License-Document-LCPL","type":"heading","text":"Acquiring a publication from a License Document (LCPL)"},{"type":"paragraph","inlineContent":[{"text":"Users need to import a License Document into your application to download the protected publication (","type":"text"},{"code":".epub","type":"codeVoice"},{"text":", ","type":"text"},{"code":".lcpdf","type":"codeVoice"},{"text":", or ","type":"text"},{"code":".lcpa","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"LCPService"},{"type":"text","text":" offers an API to retrieve the full publication from an LCPL on the filesystem."}]},{"code":["let result = await lcpService.acquirePublication(","    from: .file(lcplURL),","    onProgress: { progress in","        switch progress {","            case .indefinite:","                \/\/ Display an activity indicator.","            case .percent(let percent):","                \/\/ Display a progress bar with percent from 0 to 1.","        }","    }",")","","switch result {","case let .success(publication):","    \/\/ Import the `publication.localURL` file as any publication.","case let .failure(error):","    \/\/ Display the error message.","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After the download is completed, import the "},{"code":"publication.localURL","type":"codeVoice"},{"type":"text","text":" file into the bookshelf like any other publication file."}]},{"text":"Opening a publication protected with LCP","type":"heading","level":2,"anchor":"Opening-a-publication-protected-with-LCP"},{"text":"Initializing the `PublicationOpener`","type":"heading","level":3,"anchor":"Initializing-the-PublicationOpener"},{"type":"paragraph","inlineContent":[{"text":"A publication protected with LCP can be opened using the ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":" component, just like a non-protected publication. However, you must provide a ","type":"text"},{"isActive":true,"identifier":"https:\/\/readium.org\/architecture\/proposals\/006-content-protection.html","type":"reference"},{"text":" implementation when initializing the ","type":"text"},{"code":"PublicationOpener","type":"codeVoice"},{"text":" to enable LCP. Luckily, ","type":"text"},{"code":"LCPService","type":"codeVoice"},{"text":" has you covered.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let httpClient = DefaultHTTPClient()","","let dialogPresenter = LCPDialogPresenter()","let authentication = LCPDialogAuthentication(delegate: dialogPresenter)","","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: AssetRetriever(httpClient: httpClient),","        pdfFactory: DefaultPDFDocumentFactory()","    ),","    contentProtections: [","        lcpService.contentProtection(with: authentication)","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An LCP package is secured with a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"user passphrase"}]},{"type":"text","text":" for decrypting the content. The "},{"type":"codeVoice","code":"LCPAuthenticating"},{"type":"text","text":" protocol used by "},{"type":"codeVoice","code":"LCPService.contentProtection(with:)"},{"type":"text","text":" provides the passphrase when needed. You can use the default UIKit "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" which displays a pop-up to enter the passphrase, or implement your own method for passphrase retrieval. If your application is built using SwiftUI, "},{"type":"reference","identifier":"#using-the-swiftui-lcp-authentication-dialog","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" delegates the presentation of the dialog to an "},{"type":"codeVoice","code":"LCPDialogAuthenticationDelegate"},{"type":"text","text":", for example on the top-most view controller of your application. As the delegate is held weakly, you must retain it yourself for the lifetime of the authentication."}]},{"syntax":"swift","type":"codeListing","code":["@MainActor","final class LCPDialogPresenter: LCPDialogAuthenticationDelegate {","    func lcpDialogAuthentication(","        _ authentication: LCPDialogAuthentication,","        present dialogViewController: UIViewController","    ) {","        \/\/ Present the dialog on your top-most view controller. It will","        \/\/ dismiss itself automatically once the user submits or cancels.","        hostViewController.present(dialogViewController, animated: true)","    }","}"]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!NOTE]"},{"type":"text","text":" "},{"type":"text","text":"The user will be prompted once per passphrase since "},{"type":"codeVoice","code":"ReadiumLCP"},{"type":"text","text":" stores known passphrases on the device."}]}],"name":"Note"},{"anchor":"Opening-the-publication","type":"heading","level":3,"text":"Opening the publication"},{"inlineContent":[{"type":"text","text":"You are now ready to open the publication file with your "},{"code":"PublicationOpener","type":"codeVoice"},{"type":"text","text":" instance."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Retrieve an `Asset` to access the file content.","let url = FileURL(path: \"\/path\/to\/lcp-protected-book.epub\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the `Asset`.","let result = await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true",")","","switch result {","case .success(let publication):","    \/\/ Import or present the publication.","case .failure(let error):","    \/\/ Present the error.","}"]},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" argument is forwarded to the "},{"type":"codeVoice","code":"LCPAuthenticating"},{"type":"text","text":" implementation when the passphrase is unknown. "},{"type":"codeVoice","code":"LCPDialogAuthentication"},{"type":"text","text":" shows a pop-up only if "},{"type":"codeVoice","code":"allowUserInteraction"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"When importing the publication to the bookshelf, set ","type":"text"},{"type":"codeVoice","code":"allowUserInteraction"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"false"},{"type":"text","text":" as you don’t need the passphrase for accessing the publication metadata and cover. If you intend to present the publication using a Navigator, set "},{"type":"codeVoice","code":"allowUserInteraction"},{"text":" to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" as decryption will be required.","type":"text"}],"type":"paragraph"},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!TIP]"},{"type":"text","text":" "},{"type":"text","text":"To check if an asset is protected with LCP before opening it, you can use "},{"type":"codeVoice","code":"asset.format.conformsTo(.lcp)"},{"text":".","type":"text"}]}],"style":"note"},{"level":3,"anchor":"Using-the-opened-Publication","type":"heading","text":"Using the opened `Publication`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After obtaining a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" instance, you can access the publication’s metadata to import it into the user’s bookshelf. The user passphrase is not needed for reading the metadata or cover."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"However, if you want to display the publication with a Navigator, verify it is not restricted. It could be restricted if the user passphrase is unknown or if the license is no longer valid (e.g., expired loan, revoked purchase, etc.)."}]},{"code":["if publication.isRestricted {","    if let error = publication.protectionError as? LCPError {","        \/\/ The user is not allowed to open the publication. You should display the error.","    } else {","        \/\/ We don't have the user passphrase.","        \/\/ You may use `publication` to access its metadata, but not to render its content.","    }","} else {","    \/\/ The publication is not restricted, you may render it with a Navigator component.","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Streaming an LCP protected package","level":2,"anchor":"Streaming-an-LCP-protected-package"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the server hosting the LCP protected package supports the "},{"type":"reference","identifier":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"https:\/\/httpwg.org\/specs\/rfc7233.html","isActive":true},{"type":"text","text":", it is possible to stream directly an LCP protected publication from a License Document ("},{"type":"codeVoice","code":".lcpl"},{"type":"text","text":") file, without downloading the whole publication first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Simply open the License Document directly using the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":". Make sure you provide an "},{"type":"codeVoice","code":"HTTPClient"},{"type":"text","text":" (or an "},{"type":"codeVoice","code":"HTTPResourceFactory"},{"text":" for additional customization) to the ","type":"text"},{"type":"codeVoice","code":"AssetRetriever"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Instantiate the required components.","let httpClient = DefaultHTTPClient()","let assetRetriever = AssetRetriever(httpClient: httpClient)","let publicationOpener = PublicationOpener(","    parser: DefaultPublicationParser(","        httpClient: httpClient,","        assetRetriever: assetRetriever","    ),","    contentProtections: [","        lcpService.contentProtection(with: LCPDialogAuthentication(delegate: dialogPresenter)),","    ]",")","","\/\/ Retrieve an `Asset` to access the LCPL content.","let url = FileURL(path: \"\/path\/to\/license.lcpl\", isDirectory: false)","let asset = try await assetRetriever.retrieve(url: url).get()"," ","\/\/ Open a `Publication` from the LCPL `Asset`.","let publication = try await publicationOpener.open(","    asset: asset,","    allowUserInteraction: true",").get()","    ","print(\"Opened \\(publication.metadata.title)\")"]},{"level":2,"type":"heading","text":"Obtaining information on an LCP license","anchor":"Obtaining-information-on-an-LCP-license"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An LCP License Document contains metadata such as its expiration date, the remaining number of characters to copy and the user name. You can access this information using an "},{"code":"LCPLicense","type":"codeVoice"},{"type":"text","text":" object."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"code":"LCPService","type":"codeVoice"},{"type":"text","text":" to retrieve the "},{"code":"LCPLicense","type":"codeVoice"},{"type":"text","text":" instance for a publication."}]},{"type":"codeListing","syntax":"swift","code":["let result = await lcpService.retrieveLicense(","    from: asset,","    authentication: LCPDialogAuthentication(delegate: dialogPresenter),","    allowUserInteraction: true",")","","switch result {","case .success(let lcpLicense):","    if let user = lcpLicense.license.user.name {","        print(\"The publication was acquired by \\(user)\")","    }","    if let endDate = lcpLicense.license.rights.end {","        print(\"The loan expires on \\(endDate)\")","    }","    if let copyLeft = await lcpLicense.charactersToCopyLeft() {","        print(\"You can copy up to \\(copyLeft) characters remaining.\")","    }","case .failure(let error):","    \/\/ Display the error.","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have already opened a "},{"type":"codeVoice","code":"Publication"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"PublicationOpener"},{"type":"text","text":", you can directly obtain the "},{"code":"LCPLicense","type":"codeVoice"},{"type":"text","text":" using "},{"code":"publication.lcpLicense","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","text":"Managing a loan","anchor":"Managing-a-loan","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Readium LCP allows borrowing publications for a specific period. Use the "},{"type":"codeVoice","code":"LCPLicense"},{"type":"text","text":" object to manage a loan and retrieve its end date using "},{"type":"codeVoice","code":"lcpLicense.license.rights.end"},{"type":"text","text":"."}]},{"level":3,"anchor":"Returning-a-loan","type":"heading","text":"Returning a loan"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some loans can be returned before the end date. You can confirm this by using "},{"type":"codeVoice","code":"lcpLicense.canReturnPublication"},{"type":"text","text":". To return the publication, execute:"}]},{"code":["let result = await lcpLicense.returnPublication()","switch result {","case .success:","    \/\/ The publication was returned.","case .failure(let error):","    \/\/ Present the error.","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Renewing-a-loan","type":"heading","text":"Renewing a loan"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The loan end date may also be extended. You can confirm this by using "},{"type":"codeVoice","code":"lcpLicense.canRenewLoan"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Readium LCP supports ","type":"text"},{"identifier":"https:\/\/readium.org\/lcp-specs\/releases\/lsd\/latest#35-renewing-a-license","type":"reference","isActive":true},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Programmatic: You show your own user interface.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Interactive: You display a web view, and the Readium LSD server manages the renewal for you."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"You need to support both interactions by implementing the "},{"type":"codeVoice","code":"LCPRenewDelegate"},{"type":"text","text":" protocol. A default implementation is available with "},{"type":"codeVoice","code":"LCPDefaultRenewDelegate"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let result = await lcpLicense.renewLoan(","    with: LCPDefaultRenewDelegate(","        presentingViewController: hostViewController","    )",")","","switch result {","case .success:","    \/\/ The publication was renewed.","case let .failure(error):","    \/\/ Display the error.","}"]},{"level":2,"type":"heading","text":"Handling `LCPError`","anchor":"Handling-LCPError"},{"inlineContent":[{"type":"text","text":"The APIs may fail with an "},{"type":"codeVoice","code":"LCPError"},{"type":"text","text":". These errors "},{"type":"strong","inlineContent":[{"type":"text","text":"must"}]},{"type":"text","text":" be displayed to the user with a suitable message."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For an example, "},{"type":"reference","identifier":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Using the SwiftUI LCP Authentication dialog","anchor":"Using-the-SwiftUI-LCP-Authentication-dialog"},{"inlineContent":[{"type":"text","text":"If your application is built using SwiftUI, you cannot use "},{"code":"LCPDialogAuthentication","type":"codeVoice"},{"type":"text","text":" because it requires a UIKit view controller as its host. Instead, use an "},{"code":"LCPObservableAuthentication","type":"codeVoice"},{"type":"text","text":" combined with our SwiftUI "},{"code":"LCPDialog","type":"codeVoice"},{"text":" presented as a sheet.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@main","struct MyApp: App {","    private let lcpService: LCPService","    private let publicationOpener: PublicationOpener","","    @StateObject private var lcpAuthentication: LCPObservableAuthentication","","    init() {","        \/\/ Create an `LCPObservableAuthentication` which will be used","        \/\/ to initialize the `LCPContentProtection`.","        \/\/","        \/\/ With SwiftUI, it must be stored in a `@StateObject` property","        \/\/ to observe the authentication requests.","        let lcpAuthentication = LCPObservableAuthentication()","        _lcpAuthentication = StateObject(wrappedValue: lcpAuthentication)","","        lcpService = LCPService(...)","","        publicationOpener = PublicationOpener(","            ...,","            contentProtections: [","                lcpService.contentProtection(with: lcpAuthentication)","            ]","        )","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                \/\/ You can present an `LCPDialog` when the `LCPObservableAuthentication`","                \/\/ `request` property is updated.","                .sheet(item: $lcpAuthentication.request) {","                    LCPDialog(request: $0)","                }","            }","        }","    }","}"]}],"kind":"content"}],"sections":[],"references":{"https://github.com/readium/swift-toolkit/blob/3.0.0/TestApp/Sources/App/Readium.swift#L221":{"identifier":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221","title":"take a look at the Test App","type":"link","titleInlineContent":[{"text":"take a look at the Test App","type":"text"}],"url":"https:\/\/github.com\/readium\/swift-toolkit\/blob\/3.0.0\/TestApp\/Sources\/App\/Readium.swift#L221"},"doc://Readium/documentation/Readium/Migration-Guide":{"abstract":[{"type":"text","text":"All migration steps necessary in reading apps to upgrade to major versions of the Swift Readium toolkit will be documented in this file."}],"title":"Migration Guide","type":"topic","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Migration-Guide","url":"\/documentation\/readium\/migration-guide","role":"article"},"doc://Readium/documentation/Readium/Accessibility":{"role":"article","type":"topic","url":"\/documentation\/readium\/accessibility","title":"Accessibility","identifier":"doc:\/\/Readium\/documentation\/Readium\/Accessibility","kind":"article","abstract":[{"type":"text","text":"Some publications declare their accessibility features and limitations as metadata which broadly mirror the "},{"identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11","type":"reference","isActive":true},{"type":"text","text":" specification."}]},"https://www.edrlab.org/contact/":{"title":"EDRLab","type":"link","identifier":"https:\/\/www.edrlab.org\/contact\/","titleInlineContent":[{"type":"text","text":"EDRLab"}],"url":"https:\/\/www.edrlab.org\/contact\/"},"doc://Readium/documentation/Readium/Open-Publication":{"abstract":[{"type":"text","text":"To open a publication with Readium, you need to instantiate a couple of components: an "},{"type":"codeVoice","code":"AssetRetriever"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"PublicationOpener"},{"text":".","type":"text"}],"title":"Opening a publication","type":"topic","kind":"article","identifier":"doc:\/\/Readium\/documentation\/Readium\/Open-Publication","url":"\/documentation\/readium\/open-publication","role":"article"},"https://readium.org/lcp-specs/notes/lcp-for-pdf.html":{"url":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html","title":"LCP for PDF package","type":"link","titleInlineContent":[{"type":"text","text":"LCP for PDF package"}],"identifier":"https:\/\/readium.org\/lcp-specs\/notes\/lcp-for-pdf.html"},"doc://Readium/documentation/Readium/Content":{"identifier":"doc:\/\/Readium\/documentation\/Readium\/Content","url":"\/documentation\/readium\/content","kind":"article","type":"topic","abstract":[],"role":"article","title":"Extracting the content of a publication"},"https://help.apple.com/xcode/mac/current/#/devddd273fdd":{"title":"Document Types","url":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd","type":"link","titleInlineContent":[{"type":"text","text":"Document Types"}],"identifier":"https:\/\/help.apple.com\/xcode\/mac\/current\/#\/devddd273fdd"},"https://httpwg.org/specs/rfc9110.html#HEAD":{"type":"link","identifier":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD","title":"HTTP HEAD method","titleInlineContent":[{"text":"HTTP ","type":"text"},{"type":"codeVoice","code":"HEAD"},{"type":"text","text":" method"}],"url":"https:\/\/httpwg.org\/specs\/rfc9110.html#HEAD"},"#using-the-swiftui-lcp-authentication-dialog":{"title":"prefer using the new LCPDialog","identifier":"#using-the-swiftui-lcp-authentication-dialog","type":"link","url":"#using-the-swif