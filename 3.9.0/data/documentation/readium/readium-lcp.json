fc7233.html":{"identifier":"https:\/\/httpwg.org\/specs\/rfc7233.html","title":"HTTP Range requests","titleInlineContent":[{"text":"HTTP Range requests","type":"text"}],"type":"link","url":"https:\/\/httpwg.org\/specs\/rfc7233.html"},"doc://Readium/documentation/Readium/Getting-Started":{"role":"article","type":"topic","url":"\/documentation\/readium\/getting-started","title":"Getting started","identifier":"doc:\/\/Readium\/documentation\/Readium\/Getting-Started","kind":"article","abstract":[{"type":"text","text":"The Readium Swift toolkit enables you to develop reading apps for iOS and iPadOS. It provides built-in support for multiple publication formats such as EPUB, PDF, audiobooks, and comics."}]},"doc://Readium/documentation/Readium/TTS":{"kind":"article","url":"\/documentation\/readium\/tts","identifier":"doc:\/\/Readium\/documentation\/Readium\/TTS","type":"topic","abstract":[],"role":"article","title":"Text-to-speech"},"https://www.w3.org/TR/epub-a11y-11":{"url":"https:\/\/www.w3.org\/TR\/epub-a11y-11","title":"EPUB Accessibility","titleInlineContent":[{"text":"EPUB Accessibility","type":"text"}],"type":"link","identifier":"https:\/\/www.w3.org\/TR\/epub-a11y-11"}}}